FUNCTION_BLOCK "FB_Axis_Home"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.4
// =============================================================================
// FB_Axis_Home -- Homing
//
// Mode options (MC_Home Mode parameter):
//   0 -- Passive: only set current position to Position value
//   2 -- Active:  go to reference switch, zero encoder
//   3 -- Active + Zero: go to reference switch, set Position value
//
// Default mode = 3 (matches DB_Manual.HomingMode).
//
// Safety note: Execute is rising-edge triggered -- even if Execute stays TRUE
// after Done/Error, a new homing will not start. Same pattern as FB_Axis_AbsPos.
// =============================================================================
   VAR_INPUT 
      Execute : Bool;   // Rising edge = start homing
      Mode : Int := 3;   // Homing mode (0=Passive, 2=Active, 3=Active+Zero)
      Position : Real := 0.0;   // Position value after homing (usually 0.0)
   END_VAR

   VAR_OUTPUT 
      Done : Bool;
      Busy : Bool;
      Error : Bool;
      ErrorID : Word;   // MC_Home TO error code -- converted to readable text via FC_TO_ErrorText
   END_VAR

   VAR_IN_OUT 
      Axis {InstructionName := 'TO_PositioningAxis'; LibVersion := '8.0'} : TO_PositioningAxis;
   END_VAR

   VAR 
      MC_Home_Instance {InstructionName := 'MC_Home'; LibVersion := '8.0'} : MC_Home;
      execInternal : Bool;   // Actual Execute sent to MC_Home
      prevExecute : Bool;   // Previous Execute value for edge detection
      doneLatch : Bool;   // Prevents re-trigger after Done/Error
   END_VAR


BEGIN
	
	// Rising edge: new command -- clear doneLatch
	IF #Execute AND NOT #prevExecute THEN
	    #doneLatch := FALSE;
	END_IF;
	#prevExecute := #Execute;
	
	// execInternal: run if new command and not yet done, OR still busy
	// This ensures Execute staying TRUE after Done does not restart homing
	#execInternal := (#Execute AND NOT #doneLatch) OR #MC_Home_Instance.Busy;
	
	#MC_Home_Instance(
	                  Axis := #Axis,
	                  Execute := #execInternal,
	                  Position := #Position,
	                  Mode := #Mode,
	                  Done => #Done,
	                  Busy => #Busy,
	                  Error => #Error
	);
	
	// Done or Error: set doneLatch -- cannot re-trigger without Execute FALSEâ†’TRUE
	IF #MC_Home_Instance.Done OR #MC_Home_Instance.Error THEN
	    #doneLatch := TRUE;
	END_IF;
	
	// Pass TO error code out -- written to DB_Diagnostic in FB_Process
	#ErrorID := #MC_Home_Instance.ErrorID;
	
END_FUNCTION_BLOCK

TYPE "RecipeHeader"
VERSION : 0.1
   STRUCT
      sName : String[20];   // Program name (max 20 chars)
      LineCount : Int;   // Total lines in program (0-999)
      Valid : Bool;   // Program is valid and loaded
      PreScanned : Bool;   // Pre-scan completed
      MinX : Real;   // Bounding box Min X
      MaxX : Real;   // Bounding box Max X
      MinZ : Real;   // Bounding box Min Z
      MaxZ : Real;   // Bounding box Max Z
   END_STRUCT;

END_TYPE

DATA_BLOCK "DB_ToolConfig"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.2
NON_RETAIN
// -----------------------------------------------------------------------------
// DB_ToolConfig - Tool changer configuration
// -----------------------------------------------------------------------------
// Slot angles -- automatically calculated by FC_ToolAngleCalc (AutoCalcAngles=TRUE)
// or manually entered from HMI Tool page (AutoCalcAngles=FALSE).
   VAR 
      Tool1_Position : Real;   // Slot 1 angle (degrees)
      Tool2_Position : Real;   // Slot 2 angle (degrees)
      Tool3_Position : Real;   // Slot 3 angle (degrees)
      Tool4_Position : Real;   // Slot 4 angle (degrees) Slot code mapping -- can be entered from HMI Tool page. Operator enters which head code is in which slot.
      ToolCode_List : Array[1..4] of Int;
      CurrentTool : Int;   // Active slot number (1-4) HMI Tool page: automatic angle calculation TRUE = calculate evenly spaced based on ToolCount (e.g. 4 slots â†’ 0/90/180/270) FALSE = Tool1..4_Position open for manual entry
      AutoCalcAngles : Bool;   // Calculated step angle -- displayed on HMI for information (e.g. "90Â°/slot")
      ToolStepAngle_Calc : Real;
   END_VAR


BEGIN
   Tool1_Position := 0.0;
   Tool2_Position := 120.0;
   Tool3_Position := 240.0;
   Tool4_Position := 360.0;
   ToolCode_List[1] := 101;
   ToolCode_List[2] := 102;
   ToolCode_List[3] := 103;
   ToolCode_List[4] := 104;
   CurrentTool := 1;
   AutoCalcAngles := TRUE;
   ToolStepAngle_Calc := 120.0;

END_DATA_BLOCK

DATA_BLOCK "DB_MachineConfig"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.2
NON_RETAIN
// -----------------------------------------------------------------------------
// DB_MachineConfig - Machine configuration parameters
// -----------------------------------------------------------------------------
// =====================================================================
// HMI-EDITABLE: Machine Physical Limits (mm)
// These values are NOT overwritten by FC_LoadConfig.
// Can be changed from HMI Setup screen; preserved on PLC restart.
// =====================================================================
   VAR 
      SoftLimit_MinX : Real;   // X minimum (home=0)
      SoftLimit_MaxX : Real;   // X maximum travel (mm)
      SoftLimit_MinZ : Real;   // Z minimum (negative = mandrel front / clearance)
      SoftLimit_MaxZ : Real;   // Z maximum (forming depth) HMI-EDITABLE: Safe Positions (mm)
      SafePos_X : Real;   // "Go Safe" X target
      SafePos_Z : Real;   // "Go Safe" Z target (clearance zone) HMI-EDITABLE: Pause Retract (mm / mm/s) On Pause, X and Z jog by these signed offsets to pull the tool clear (spindle keeps running). On Continue they return to the exact interruption point before the recipe resumes. Retract target is clamped to soft limits. Offset 0 = that axis does not move on pause. See docs/Pause_Retract_Plan.md.
      PauseRetract_X : Real;   // Pause retract offset X (signed, mm)
      PauseRetract_Z : Real;   // Pause retract offset Z (signed, mm)
      PauseRetract_Vel : Real;   // Retract/return velocity (mm/s) HMI-EDITABLE: Homing Parameters
      HomeOffset_X : Real;   // X set value after homing
      HomeOffset_Z : Real;   // Z set value after homing
      HomeVelocity : Real;   // Homing clearance velocity (mm/s)
      PostHome_Clearance : Real;   // Distance to clear PNP zone after homing (mm)
      AlwaysHomeOnAutoStart : Bool;   // TRUE = home all axes on every auto start (recommended) âš ï¸ UNUSED: The following two parameters are not read anywhere in PLC code. Recipe handler takes its own feedrate from the recipe line. Do not connect to HMI. May be used if manual tool change sequence is added later.
      ToolChangePos_X : Real;   // (Unused) Safe X for manual tool change
      ToolChangePos_Z : Real;   // (Unused) Safe Z for manual tool change
      DefaultFeedrate : Real;   // (Unused) Default feedrate ===================================================================== FIXED: Hardware/TO Limits -- must not be changed from HMI FC_LoadConfig (OB100) writes these values on every restart. =====================================================================
      MaxVelocity : Real;   // mm/s - TO max velocity
      RapidVelocity : Real;   // mm/s - G0 rapid speed
      MinVelocity : Real;   // mm/s - TO minimum
      FeedrateConvFactor : Real;   // divisor to convert recipe F (mm/min) to axis velocity (mm/s) Tool Configuration -- HMI-EDITABLE: active slot count (1-4)
      ToolCount : Int;
      ToolVelocity : Real;   // deg/s -- turret rotation speed (clamped by TO max) Hardware configuration -- set TRUE if this axis is not physically connected to the machine (different from HMI bypasses: this is a hardware presence flag)
      Bypass_ToolAxis : Bool;
      Bypass_MandrelLock : Bool;   // Spindle deceleration wait: time between RunCmd=FALSE and next RunCmd=TRUE. Set to match VFD deceleration ramp time. HMI-editable.
      SpindleDecelTime : Time;   // Proportional MandrelLock release wait (ITEM-28). SpindleStopSafeTime = full-speed stop safety margin (tune to measured VFD decel time + margin). Formula: PT = (capturedRPM / SpindleMaxRPM) * SpindleStopSafeTime
      SpindleMaxRPM : Real;   // RPM -- denominator for proportional wait (match DB_Spindle.MaxSpeed)
      SpindleStopSafeTime : Time;   // Full-speed decel safety margin (tune on-site) â”€â”€â”€ Cylinder stroke wait times (open-loop: tuned to physical stroke duration) These are deliberate waits with no sensor feedback. Set slightly above measured stroke time.
      CylMandrelLock_ClampTime : Time;   // STATE_SHEET_WAIT ph.2: MandrelLock clamp stroke
      CylSheetHolder_RetractTime : Time;   // STATE_SHEET_WAIT ph.3: SheetHolder retract stroke
      CylToolHeadLock_PreDelay : Time;   // STATE_LOCK_EXTEND_WAIT: pre-delay before solenoid energises
      CylToolHeadLock_RetractTime : Time;   // STATE_LOCK_RETRACT_WAIT: spring-return wait (no sensor) â”€â”€â”€ Process timeouts (trigger errors when limits exceeded)
      Timeout_DriveReady : Time;   // STATE_STARTING: drives not ready within this time â†’ error
      Timeout_Homing : Time;   // STATE_HOMING + STATE_STOP_GOHOME combined timeout
      Timeout_Motion : Time;   // Per-line G0/G1 motion timeout in FB_RecipeHandler
      Timeout_SpindleAtSpeed : Time;   // CMD=20: spindle must reach target speed within this time
      Timeout_SpindleStop : Time;   // CMD=21: spindle must reach zero within this time
      Timeout_ToolChange : Time;   // Turret rotation must complete within this time
      Timeout_EStopDiscrep : Time;   // E-Stop dual-channel discrepancy debounce
   END_VAR


BEGIN
   SoftLimit_MinX := -10.0;
   SoftLimit_MaxX := 500.0;
   SoftLimit_MinZ := -10.0;
   SoftLimit_MaxZ := 500.0;
   SafePos_X := 0.0;
   SafePos_Z := 0.0;
   PauseRetract_X := -10.0;
   PauseRetract_Z := -10.0;
   PauseRetract_Vel := 30.0;
   HomeOffset_X := 0.0;
   HomeOffset_Z := 0.0;
   HomeVelocity := 10.0;
   PostHome_Clearance := 10.0;
   AlwaysHomeOnAutoStart := TRUE;
   ToolChangePos_X := 0.0;
   ToolChangePos_Z := 0.0;
   DefaultFeedrate := 100.0;
   MaxVelocity := 40.0;
   RapidVelocity := 40.0;
   MinVelocity := 1.0;
   FeedrateConvFactor := 60.0;
   ToolCount := 3;
   ToolVelocity := 50.0;
   Bypass_ToolAxis := FALSE;
   Bypass_MandrelLock := FALSE;
   SpindleDecelTime := T#2S;
   SpindleMaxRPM := 2400.0;
   SpindleStopSafeTime := T#20S;
   CylMandrelLock_ClampTime := T#5S;
   CylSheetHolder_RetractTime := T#5S;
   CylToolHeadLock_PreDelay := T#1S;
   CylToolHeadLock_RetractTime := T#3S;
   Timeout_DriveReady := T#3S;
   Timeout_Homing := T#2M;
   Timeout_Motion := T#5M;
   Timeout_SpindleAtSpeed := T#10S;
   Timeout_SpindleStop := T#15S;
   Timeout_ToolChange := T#30S;
   Timeout_EStopDiscrep := T#500MS;

END_DATA_BLOCK

FUNCTION_BLOCK "FB_Axis_Halt"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.2
// =============================================================================
// FB_Axis_Halt -- Controlled stop
//
// Execute = TRUE â†’ MC_Halt called, axis decelerates to a stop.
// Cancels any active MC_MoveAbsolute.
// Done = TRUE â†’ axis has fully stopped.
// =============================================================================
   VAR_INPUT 
      Execute : Bool;   // TRUE = issue stop command
   END_VAR

   VAR_OUTPUT 
      Done : Bool;
      Busy : Bool;
      Error : Bool;
      ErrorID : Word;   // MC_Halt TO error code -- available for diagnostics on halt failure
   END_VAR

   VAR_IN_OUT 
      Axis {InstructionName := 'TO_PositioningAxis'; LibVersion := '8.0'} : TO_PositioningAxis;
   END_VAR

   VAR 
      MC_Halt_Instance {InstructionName := 'MC_Halt'; LibVersion := '8.0'} : MC_Halt;
   END_VAR


BEGIN
	
	#MC_Halt_Instance(
	                  Axis := #Axis,
	                  Execute := #Execute,
	                  Done => #Done,
	                  Busy => #Busy,
	                  Error => #Error,
	                  ErrorID => #ErrorID
	);
	
END_FUNCTION_BLOCK

TYPE "RecipeLine"
VERSION : 0.1
   STRUCT
      X : Real;   // 4 bytes - Target X position (mm)
      Z : Real;   // 4 bytes - Target Z position (mm)
      F : Int;   // 2 bytes - Feedrate (mm/min, 0=rapid)
      CMD : Byte;   // 1 byte  - Command: 0=G0, 1=G1, 10=Tool, 20=SpindleOn, 21=SpindleOff, 30=Dwell, 99=End
      Param : Byte;   // 1 byte  - CMD=10:ToolNum, CMD=20:RPM/10, CMD=30:Time*100ms
   END_STRUCT;

END_TYPE

DATA_BLOCK "DB_HMI"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.3
NON_RETAIN
// =============================================================================
// 02_DataBlocks.scl
// All non-recipe data blocks.
// Recipe program DBs (DB_RecipeProgram1..5) are in 02b_RecipePrograms.scl.
// Target: CPU 1214C (100KB work memory)
// =============================================================================
// -----------------------------------------------------------------------------
// DB_HMI - Human Machine Interface data
// -----------------------------------------------------------------------------
// ===========================================================
// BUTTONS (Input) - Version_GCODE compatible
// ===========================================================
   VAR 
      Btn_Start : Bool;   // Start machine
      Btn_Stop : Bool;   // Stop machine
      Btn_Pause : Bool;   // Pause/Resume toggle
      Btn_Reset : Bool;   // Reset program to beginning
      Btn_ApplyToolConfig : Bool;   // Apply tool-slot codes from HMI to DB_ToolConfig
      Btn_AckError : Bool;   // Acknowledge error â†’ transitions from STATE_ERROR to STOPPED
      Btn_Continue : Bool;   // Continue from pause (PAUSED) -- STATE_PAUSED â†’ RUNNING
      Btn_Restart : Bool;   // STATE_ERROR or PAUSED â†’ STOPPED (restart with Start)
      Btn_ProdReset : Bool;   // Reset production counters + history
      Btn_LastCycleReset : Bool;   // Reset last cycle summary only (counters preserved) NOTE: Btn_ProdReset already does this too. If not adding both as separate HMI buttons, Btn_LastCycleReset is redundant -- do not connect to HMI if unused. =========================================================== MODE SELECTION (Input) ===========================================================
      ProductSelect : Int;   // Recipe selector (1-5)
      FeedrateOverride : Real;   // Speed % for G1 moves (50-200, 100=normal)
      RapidOverride : Real;   // Speed % for G0 rapid moves (50-200)
      SingleStepMode : Bool;   // TRUE = stop after each line, wait for StepNext
      StepNext : Bool;   // Pulse to advance one step in SingleStepMode Program names and validity -- PLC does NOT write to these tags. Written by CAM post-processor or HMI operator. Can be read for displaying the program list on HMI.
      ProgramNames : Array[1..5] of String[20];   // Operator-defined program names
      ProgramValid : Array[1..5] of Bool;   // Is program loaded? (written by HMI/CAM) Tool slot codes editable from HMI. Enter external codes like 101, 406 etc. These are copied to DB_ToolConfig.ToolCode_List when operator presses Apply.
      ToolSlotCode : Array[1..4] of Int;   // =========================================================== POSITION DISPLAYS (Output) ===========================================================
      ActualX : Real;   // Current X position (mm)
      ActualZ : Real;   // Current Z position (mm) =========================================================== STATUS DISPLAYS (Output) ===========================================================
      StatusMsg : String[50];   // Status message text
      MachineState : Int;   // State machine state
      CurrentLine : Int;   // Current line being executed
      TotalLines : Int;   // Total lines in program
      ProgressPercent : Real;   // Progress 0-100%
      CurrentTool : Int;   // Active tool (1-4)
      FeedrateActive : Real;   // Actual feedrate (mm/min) âš ï¸ UNUSED: PLC code does not write to the Axis_Status_* tags below anywhere. They will always be 0 / empty if connected to HMI. Reserved for future use -- do not display on HMI for now.
      Axis_Status_X : Int;
      Axis_Status_Z : Int;
      Axis_Status_Spindle : Int;
      Axis_Status_Toolhead : Int;
      Axis_Status_X_Str : String[10];
      Axis_Status_Z_Str : String[10];
      Axis_Status_Spindle_Str : String[10];
      Axis_Status_Toolhead_Str : String[10];   // =========================================================== STATUS LAMPS (Output) ===========================================================
      IsRunning : Bool;   // Machine is running
      IsPaused : Bool;   // Machine is paused
      HasError : Bool;   // Error is active
      ElapsedTime : Time;   // Program elapsed time
      ElapsedSeconds : DInt;   // Elapsed time in seconds (for HMI display)
      CycleCount : Int;   // Number of completed programs =========================================================== ERROR DISPLAY (Output) ===========================================================
      ErrorID : Word;   // Error code (0=OK)
      ErrorText : String[100];   // Error description
      ErrorDetail : String[120];   // Additional error info =========================================================== WARNING DISPLAY (Output) ===========================================================
      HasWarning : Bool;   // TRUE when a non-blocking warning is active (E-Stop bypass or sheet insert prompt)
      WarningText : String[70];   // Warning message text -- English (E-Stop bypass or operator prompts only)
      ResumeLine : Int;   // Saved recipe line for warm restart (-1 = none). Set in STATE_ERROR, cleared on Btn_Restart. =========================================================== SPANISH TEXT MIRRORS (Output) -- for Mexican operator HMI PLC writes these every scan alongside the English equivalents. Connect to a second-language screen or a language-toggle switch. ===========================================================
      StatusMsg_ES : String[50];   // Estado actual (EspaÃ±ol)
      ErrorText_ES : String[100];   // Descripcion de error (EspaÃ±ol)
      ErrorDetail_ES : String[120];   // Detalle adicional (EspaÃ±ol)
      WarningText_ES : String[80];   // Advertencia (EspaÃ±ol) =========================================================== BYPASS SWITCHES (for testing) - Version_GCODE compatible âš ï¸ All bypasses reset to FALSE on restart (FC_LoadConfig). All must be FALSE in production. ===========================================================
      Bypass_EStop : Bool;   // Used in FB_SafetyMonitor âœ…
      Bypass_Door : Bool;   // Used in FB_SafetyMonitor âœ…
      Bypass_AirPressure : Bool;   // Used in FB_SafetyMonitor âœ…
      Bypass_Drives : Bool;   // Used in FB_SafetyMonitor âœ…
      Bypass_Spindle : Bool;   // Skips spindle commands in recipe (FB_RecipeHandler) -- dry run / commissioning
      Bypass_ToolChanger : Bool;   // âš ï¸ UNUSED -- not in safety monitor
      Bypass_MandrelLock : Bool;   // TRUE = machine variant without MandrelLock cylinder (manual clamping) =========================================================== BOUNDING BOX (Output - from pre-scan) ===========================================================
      BoundingBox_MinX : Real;
      BoundingBox_MaxX : Real;
      BoundingBox_MinZ : Real;
      BoundingBox_MaxZ : Real;
      BoundingBox_Valid : Bool;
      PreScanProgress : Real;   // Pre-scan progress 0-100% (written during STATE_PRE_SCAN) =========================================================== MANUAL > MANAGE: Contactor & Enable controls (Input) HMI writes these; PLC drives physical outputs in OB1. Buttons are toggles (maintained, not momentary). ===========================================================
      Btn_Contactor_X : Bool;   // Energize X driver contactor
      Btn_Contactor_Z : Bool;   // Energize Z driver contactor
      Btn_Contactor_Tool : Bool;   // Energize Tool driver contactor
      Btn_Contactor_Spindle : Bool;   // Energize Spindle driver contactor
      Btn_Enable_X : Bool;   // Send enable signal to X drive
      Btn_Enable_Z : Bool;   // Send enable signal to Z drive MANUAL > MANAGE: Status feedback (Output) for HMI lamps PLC writes these back after applying safety interlock.
      Contactor_X_On : Bool;
      Contactor_Z_On : Bool;
      Contactor_Tool_On : Bool;
      Contactor_Spindle_On : Bool;
      Enable_X_On : Bool;
      Enable_Z_On : Bool;   // =========================================================== E-STOP DUAL CHANNEL STATUS (Output - PLC writes, HMI reads) ===========================================================
      EStop_Ch1_OK : Bool;   // Channel 1 contact state (TRUE=closed=safe)
      EStop_Ch2_OK : Bool;   // Channel 2 contact state (TRUE=closed=safe)
      EStop_Discrepancy : Bool;   // Ch1 â‰  Ch2 â†’ contact fault, service required
   END_VAR


BEGIN
   ProductSelect := 1;
   FeedrateOverride := 100.0;
   RapidOverride := 100.0;
   SingleStepMode := FALSE;
   StepNext := FALSE;
   ToolSlotCode[1] := 101;
   ToolSlotCode[2] := 102;
   ToolSlotCode[3] := 103;
   ToolSlotCode[4] := 104;
   ResumeLine := -1;
   Bypass_EStop := FALSE;
   Bypass_Door := TRUE;
   Bypass_AirPressure := TRUE;
   Bypass_Drives := FALSE;
   Bypass_Spindle := FALSE;
   Bypass_ToolChanger := FALSE;
   Bypass_MandrelLock := FALSE;
   PreScanProgress := 0.0;

END_DATA_BLOCK

