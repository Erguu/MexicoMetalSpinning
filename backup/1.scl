   Actor.DriveParameter.PulsesPerDriveRevolution := 10000;
   Sensor[1].ActiveHoming.DigitalInputAddress.RID := 16#0200_0001;
   Sensor[1].ActiveHoming.DigitalInputAddress.AREA := 16#81;
   Sensor[1].ActiveHoming.DigitalInputAddress.OFFSET := 6;
   Sensor[1].ActiveHoming.HomePositionOffset := 5.45;
   Units.LengthUnit := 1005;
   Mechanics.LeadScrew := 36.0;
   DynamicLimits.MaxVelocity := 180.0;
   DynamicLimits.MinVelocity := 1.0;
   DynamicDefaults.Acceleration := 358.0;
   DynamicDefaults.Deceleration := 358.0;
   DynamicDefaults.EmergencyDeceleration := 89.5;
   DynamicDefaults.Jerk := 716.0;
   PositionLimits_SW.Active := FALSE;
   PositionLimits_SW.MinPosition := -200.0;
   PositionLimits_SW.MaxPosition := 700.0;
   PositionLimits_HW.Active := FALSE;
   Homing.AutoReversal := FALSE;
   Homing.ApproachDirection := FALSE;
