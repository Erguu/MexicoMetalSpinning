VERSION : 1.2
// =============================================================================
// Version_Recipe -- 00_Configuration.scl
// Central machine configuration -- called ONCE by OB100 (Startup) on every
// PLC power-up or program download.
//
// This file writes physical machine parameters (speed, limits, calibration, etc.)
// to DBs at PLC startup. Parameters that can be changed at runtime from HMI
// are NOT written here -- they remain as the DB initial values and revert to
// their initial values on warm-restart (NON_RETAIN DB).
//
// â”€â”€â”€ WHERE TO LOOK â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
//   Maximum axis velocity        â†’ Section 1: MaxVelocity, RapidVelocity
//   Homing speed and mode        â†’ Section 2: HomeVelocity, HomingMode
//   Tool slot and angle settings â†’ Section 3: ToolCount, AutoCalcAngles
//   Spindle min/max RPM          â†’ Section 4: MinSpeed, MaxSpeed
//   Jog speed and step size      â†’ Section 5: JogSpeed, JogIncrement
//   Linear ruler stroke          â†’ Section 6: Phys_Max
//   Cylinder config reference    â†’ Section 7: see 02_DataBlocks.scl DB_Cylinder1
//   HMI initial values           â†’ Section 8: FeedrateOverride, ProductSelect
//   Test/commissioning bypass    â†’ Section 9: Bypass_EStop, Bypass_Door...
//   All timer PT values          â†’ Section 10: cylinder waits + process timeouts
//
// â”€â”€â”€ HMI SCREEN MAP â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Lists which tags are used on which HMI screen.
// "(â†’PLC)" = HMI writes, PLC reads  |  "(PLCâ†’)" = PLC writes, HMI reads (read-only)
//
// â”Œâ”€ MAIN SCREEN / STATUS LAMPS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”
// â”‚  DB_HMI.StatusMsg          (String[50])  PLCâ†’  "Running/Stopped/Errorâ€¦"â”‚
// â”‚  DB_HMI.IsRunning          (Bool)        PLCâ†’  Green lamp               â”‚
// â”‚  DB_HMI.IsPaused           (Bool)        PLCâ†’  Yellow lamp              â”‚
// â”‚  DB_HMI.HasError           (Bool)        PLCâ†’  Red lamp                 â”‚
// â”‚  DB_HMI.ActualX            (Real, mm)    PLCâ†’  X axis current position  â”‚
// â”‚  DB_HMI.ActualZ            (Real, mm)    PLCâ†’  Z axis current position  â”‚
// â”‚  DB_HMI.CurrentLine        (Int)         PLCâ†’  Active recipe line       â”‚
// â”‚  DB_HMI.ProgressPercent    (Real, %)     PLCâ†’  Progress bar             â”‚
// â”‚  DB_HMI.ElapsedSeconds     (DInt, s)     PLCâ†’  Cycle elapsed time       â”‚
// â”‚  DB_HMI.CycleCount         (Int)         PLCâ†’  Completed cycle count    â”‚
// â””â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”˜
//
// â”Œâ”€ MAIN SCREEN / BUTTONS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”
// â”‚  DB_HMI.Btn_Start          (Bool)        â†’PLC  Start (rising edge)      â”‚
// â”‚  DB_HMI.Btn_Stop           (Bool)        â†’PLC  Stop (controlled stop)   â”‚
// â”‚  DB_HMI.Btn_Pause          (Bool)        â†’PLC  Pause                    â”‚
// â”‚  DB_HMI.Btn_Continue       (Bool)        â†’PLC  Resume from pause        â”‚
// â”‚  DB_HMI.Btn_AckError       (Bool)        â†’PLC  Acknowledge error + STOP â”‚
// â”‚  DB_HMI.Btn_Reset          (Bool)        â†’PLC  Full reset + STOPPED     â”‚
// â”‚  DB_HMI.ProductSelect      (Int, 1-5)    â†’PLC  Which program to run     â”‚
// â”‚  DB_HMI.FeedrateOverride   (Real, %)     â†’PLC  G1 speed multiplier      â”‚
// â”‚  DB_HMI.RapidOverride      (Real, %)     â†’PLC  G0 speed multiplier      â”‚
// â”‚  DB_HMI.SingleStepMode     (Bool)        â†’PLC  Line-by-line execution   â”‚
// â””â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”˜
//
// â”Œâ”€ ERROR / ALARM SCREEN â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”
// â”‚  DB_Error.Active           (Bool)        PLCâ†’  Is there an active error? â”‚
// â”‚  DB_Error.Code             (Word, hex)   PLCâ†’  Error code (e.g. 0x0401) â”‚
// â”‚  DB_Error.Details          (String[80])  PLCâ†’  Error description text   â”‚
// â”‚  DB_Error.Severity         (Byte)        PLCâ†’  3=fatal, 2=error, 1=warn â”‚
// â”‚  DB_Error.Source           (String[20])  PLCâ†’  "Safety"/"Axis"/"Limit"  â”‚
// â”‚  DB_Error.TimeStamp        (DTL)         PLCâ†’  Error timestamp          â”‚
// â”‚  -- Alarm History (last 10) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”‚
// â”‚  DB_Error.History_Code[1..10]   (Word)   PLCâ†’  Last 10 error codes      â”‚
// â”‚  DB_Error.History_Details[1..10](String) PLCâ†’  Last 10 error details    â”‚
// â”‚  DB_Error.History_Time[1..10]   (DTL)    PLCâ†’  Last 10 error timestamps â”‚
// â””â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”˜
//
// â”Œâ”€ MANUAL SCREEN / MOTION â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”
// â”‚  DB_Manual.ManualModeActive (Bool)       â†’PLC  Enable/disable manual modeâ”‚
// â”‚  DB_Manual.SelectedAxis    (Int, 0-3)    â†’PLC  0=X 1=Z 2=Tool 3=Spindle â”‚
// â”‚  DB_Manual.Btn_JogPlus     (Bool)        â†’PLC  Positive direction jog   â”‚
// â”‚  DB_Manual.Btn_JogMinus    (Bool)        â†’PLC  Negative direction jog   â”‚
// â”‚  DB_Manual.JogSpeed        (Real, mm/s)  â†’PLC  Jog speed                â”‚
// â”‚  DB_Manual.Btn_StepPlus    (Bool)        â†’PLC  +JogIncrement step       â”‚
// â”‚  DB_Manual.Btn_StepMinus   (Bool)        â†’PLC  -JogIncrement step       â”‚
// â”‚  DB_Manual.JogIncrement    (Real, mm)    â†’PLC  Step size                â”‚
// â”‚  DB_Manual.MoveToPosition  (Real, mm)    â†’PLC  Target absolute position â”‚
// â”‚  DB_Manual.Btn_MoveAbsolute(Bool)        â†’PLC  Start absolute move      â”‚
// â”‚  DB_Manual.Btn_HomeAll     (Bool)        â†’PLC  Home all axes             â”‚
// â”‚  DB_Manual.Btn_GoSafe      (Bool)        â†’PLC  Move to safe position    â”‚
// â”‚  DB_Manual.Btn_GoZero      (Bool)        â†’PLC  Move to zero position    â”‚
// â”‚  DB_Manual.SelectedAxisPos (Real, mm)    PLCâ†’  Selected axis position   â”‚
