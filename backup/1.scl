DATA_BLOCK "DB_Spindle"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.2
NON_RETAIN
// -----------------------------------------------------------------------------
// DB_Spindle - Spindle configuration and status
// -----------------------------------------------------------------------------
// Configuration
   VAR 
      MinSpeed : Real;   // Minimum spindle speed (RPM)
      MaxSpeed : Real;   // Maximum spindle speed (RPM)
      DefaultSpeed : Real;   // Default spindle speed (RPM)
      SpeedTolerance : Real;   // Speed tolerance for AtSpeed (%)
      Bypass_AtSpeed : Bool;   // TRUE = skip AtSpeed wait (use during commissioning without drive) Commands (input from HMI/Program)
      Cmd_SetSpeed : Real;   // Commanded speed
      Cmd_Direction : Int;   // 1=CW, -1=CCW
      SpeedOverride : Real;   // Speed override (%) Status (output)
      IsRunning : Bool;
      AtSpeed : Bool;
      ActualSpeed : Real;
      CommandedSpeed : Real;
      Error : Bool;
      ErrorID : Word;   // ===================================================================== DIAGNOSTICS -- written every scan; read from HMI watch table Use these to trace the spindle start chain without TIA Portal online. Chain:  ReqStart â†’ bSpindleStart â†’ StartInput â†’ PrevStart â†’ StartEdge â†’ state =====================================================================
      Diag_SpindleState : Int;   // FB_SpindleControl state (0=Idle, 10=Starting, 20=Running, 30=Stopping, 999=Error)
      Diag_StartInput : Bool;   // Actual Start pin arriving at FB_SpindleControl (Manual OR bSpindleStart)
      Diag_StopInput : Bool;   // Actual Stop pin arriving at FB_SpindleControl
      Diag_EnableInput : Bool;   // Actual Enable pin (bDrivesEnable)
      Diag_StartEdge : Bool;   // Rising edge computed inside FB_SpindleControl (TRUE = spindle command accepted)
      Diag_PrevStart : Bool;   // prevStart latch inside FB_SpindleControl (must go FALSE between starts)
      Diag_bSpindleStart : Bool;   // FB_Process internal flag bSpindleStart (set by recipe or RUNNING state)
      Diag_bSpindleStop : Bool;   // FB_Process internal flag bSpindleStop
      Diag_ReqStart : Bool;
      Diag_ReqStop : Bool;
      Diag_MoveVelBusy : Bool;   // MC_MoveVelocity.Busy   -- TO is processing the velocity command
      Diag_MoveVelInVel : Bool;   // MC_MoveVelocity.InVelocity -- motor reached commanded speed ===================================================================== HISTORY RING BUFFER -- last 20 state-change snapshots A new entry is pushed whenever SpindleState, PrevStart, ReqStart or StartEdge changes, capturing every meaningful transition in sequence. How to read:   1. Hist_Count tells you how many valid entries exist (0..20).   2. Hist_Head-1 (mod 20) is the MOST RECENT entry.   3. Entries are indexed [0..19]; read them in Seq order.   4. Write Hist_Clear := TRUE from HMI to wipe and start fresh. =====================================================================
      Hist_Head : Int;   // Next write position (0..19, wraps)
      Hist_Count : Int;   // Number of valid entries (0..20)
      Hist_SeqNum : Int;   // Rolling sequence counter
      Hist_Clear : Bool;   // HMI: write TRUE to clear buffer (auto-resets)
      Hist_Log : Array[0..19] of "UDT_SpindleSnap";
   END_VAR


BEGIN
   MinSpeed := 120.0;
   MaxSpeed := 3000.0;
   DefaultSpeed := 1200.0;
   SpeedTolerance := 5.0;
   Bypass_AtSpeed := FALSE;
   SpeedOverride := 100.0;
   IsRunning := FALSE;
   AtSpeed := FALSE;
   ActualSpeed := 0.0;
   CommandedSpeed := 0.0;
   Error := FALSE;
   ErrorID := 0;
   Hist_Head := 0;
   Hist_Count := 0;
   Hist_SeqNum := 0;
   Hist_Clear := FALSE;

END_DATA_BLOCK

DATA_BLOCK "DB_SystemEvents"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.2
NON_RETAIN
// =============================================================================
// Version_Recipe - 07_ReportError.scl
// Central helper to report errors from any FB/FC/FCU without duplicating logic.
// =============================================================================
// ---------------------------------------------------------------------------
// DB_SystemEvents - small DB for inter-block requests (error reporting)
// ---------------------------------------------------------------------------
// Error queue: ring buffer (4 slots) -- prevents silent loss when two errors
// occur in the same scan before FB_AlarmManager can consume the first entry.
// FC_ReportError enqueues; FB_AlarmManager dequeues one item per scan.
   VAR 
      EQ_Head : Int;   // Next slot to dequeue (read index)
      EQ_Tail : Int;   // Next slot to enqueue (write index)
      EQ_Count : Int;   // Number of pending items (0..4)
      EQ_Code : Array[0..3] of Word;
      EQ_Details : Array[0..3] of String[80];
      EQ_Source : Array[0..3] of String[20];
   END_VAR


BEGIN
   EQ_Head := 0;
   EQ_Tail := 0;
   EQ_Count := 0;

END_DATA_BLOCK

FUNCTION_BLOCK "FB_Axis_AbsPos"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.0
// =============================================================================
// 03_AxisControl.scl
// Axis control wrapper function blocks
//
// This file wraps Siemens PLCopen MC_ commands with project-specific thin wrappers.
// All FBs accept a TO_PositioningAxis VAR_IN_OUT reference.
//
// FB List:
//   FB_Axis_AbsPos  -- Absolute position move (MC_MoveAbsolute wrapper)
//   FB_Axis_Power   -- Drive enable/disable (MC_Power wrapper)
//   FB_Axis_Home    -- Homing (MC_Home wrapper)
//   FB_Axis_Halt    -- Controlled stop (MC_Halt wrapper)
//   FB_Axis_Jog     -- Continuous jog (MC_MoveJog wrapper)
//   FB_Axis_Reset   -- TO error reset (MC_Reset wrapper)
//
// Units: mm and mm/s (must match Technology Object configuration).
// =============================================================================
// =============================================================================
// FB_Axis_AbsPos -- Absolute position move
//
// Behavior:
//   Starts a new move on the rising edge of Execute.
//   Done = TRUE remains set while Execute is TRUE after completion.
//   Clearing Execute also clears Done -- ready for the next command.
//
// Usage note:
//   Used by FB_RecipeHandler and FB_ManualMode.
//   Two simultaneous Execute signals must not be sent to the same axis.
// =============================================================================
   VAR_INPUT 
      Execute : Bool;   // Rising edge = new move command
      Position : Real;   // Target position (mm)
      Velocity : Real;   // Move velocity (mm/s)
   END_VAR

   VAR_OUTPUT 
      Done : Bool;   // Move completed
      Busy : Bool;   // Move in progress
      Error : Bool;   // TO/drive error
      ErrorID : Word;   // MC_ error code (compare with TO diagnostics)
   END_VAR

   VAR_IN_OUT 
      Axis {InstructionName := 'TO_PositioningAxis'; LibVersion := '8.0'} : TO_PositioningAxis;
   END_VAR

   VAR 
      MC_MoveAbsolute_Instance {InstructionName := 'MC_MoveAbsolute'; LibVersion := '8.0'} : MC_MoveAbsolute;
      execLatch : Bool;   // MC_MoveAbsolute Execute latch -- ensures single command
      doneLatch : Bool;   // Holds Done result until Execute goes FALSE
      prevExecute : Bool;   // Previous Execute value for edge detection
   END_VAR


BEGIN
	
	// Rising edge: new command starting -- clear previous Done
	IF #Execute AND NOT #prevExecute THEN
	    #doneLatch := FALSE;
	END_IF;
	#prevExecute := #Execute;
	
	// If Execute is active, not yet done, and latch not set -- start move
	IF #Execute AND NOT #execLatch AND NOT #doneLatch THEN
	    #execLatch := TRUE;
	END_IF;
	
	// MC_MoveAbsolute call
	#MC_MoveAbsolute_Instance(
	                          Axis := #Axis,
	                          Execute := #execLatch,
	                          Position := #Position,
	                          Velocity := #Velocity,
	                          Done => #Done,
	                          Busy => #Busy,
	                          Error => #Error,
	                          ErrorID => #ErrorID
	);
	
	// Done: release latch, hold done result
	IF #MC_MoveAbsolute_Instance.Done THEN
	    #execLatch := FALSE;
	    #doneLatch := TRUE;
	    // Error or CommandAborted: release latch, do NOT set doneLatch
	    // CommandAborted happens when MC_Halt interrupts a running move (stop/pause/reset).
	    // Without this branch execLatch stays TRUE across recipe runs, MC never gets a new
	    // rising edge on Execute, and the axis stands still on the next start.
	ELSIF #MC_MoveAbsolute_Instance.Error OR #MC_MoveAbsolute_Instance.CommandAborted THEN
	    #execLatch := FALSE;
	END_IF;
	
	// Done: latch or MC instant done -- visible while Execute is TRUE
	#Done := #doneLatch OR #MC_MoveAbsolute_Instance.Done;
	#Error := #MC_MoveAbsolute_Instance.Error;
	
END_FUNCTION_BLOCK

FUNCTION_BLOCK "FB_InputManager"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.0
// =============================================================================
// Version_Recipe - 06_MainProcess.scl
// Main process with recipe-based G-code and pre-scan validation
// =============================================================================
// -----------------------------------------------------------------------------
// FB_InputManager - OR-combine inputs from HMI, Panel, Remote
// DOC:
//  purpose: Create single rising-edge command outputs (Cmd_*) from multiple input sources.
//  inputs: HMI_*, Panel_*, Rem_* (Bool) - raw button states (level)
//  outputs: Cmd_* (Bool) - one-shot rising-edge commands for the system
//  notes: Uses prev* latches to detect rising edges; keeps logic simple for deterministic behavior.
// -----------------------------------------------------------------------------
   VAR_INPUT 
      HMI_Start : Bool;   // HMI Start button (level)
      HMI_Stop : Bool;   // HMI Stop button (level)
      HMI_Pause : Bool;   // HMI Pause button (level)
      HMI_Reset : Bool;   // HMI Reset button (level)
      Panel_Start : Bool;   // Physical panel Start
      Panel_Stop : Bool;   // Physical panel Stop
      Panel_Pause : Bool;   // Physical panel Pause
      Panel_Reset : Bool;   // Physical panel Reset
      Rem_Start : Bool;   // Remote Start (e.g. PLC network)
      Rem_Stop : Bool;   // Remote Stop One-shot command outputs (rising edge true for one cycle)
   END_VAR

   VAR_OUTPUT 
      Cmd_Start : Bool;
      Cmd_Stop : Bool;
      Cmd_Pause : Bool;
      Cmd_Reset : Bool;   // Previous sampled raw values for edge detection
   END_VAR

   VAR 
      prevStart : Bool;
      prevStop : Bool;
      prevPause : Bool;
      prevReset : Bool;   // Combined raw inputs for current cycle
      rawStart : Bool;
      rawStop : Bool;
      rawPause : Bool;
      rawReset : Bool;
   END_VAR


BEGIN
	
	#rawStart := #HMI_Start OR #Panel_Start OR #Rem_Start;
	#rawStop := #HMI_Stop OR #Panel_Stop OR #Rem_Stop;
	#rawPause := #HMI_Pause OR #Panel_Pause;
	#rawReset := #HMI_Reset OR #Panel_Reset;
	#Cmd_Start := #rawStart AND NOT #prevStart;
	#Cmd_Stop := #rawStop AND NOT #prevStop;
	#Cmd_Pause := #rawPause AND NOT #prevPause;
	#Cmd_Reset := #rawReset AND NOT #prevReset;
	#prevStart := #rawStart;
	#prevStop := #rawStop;
	#prevPause := #rawPause;
	#prevReset := #rawReset;
	
END_FUNCTION_BLOCK

