// This DB is retained so TIA Portal does not lose the symbol. Do not call from OB1.
// DB_Spindle (separate) â†’ spindle status + HMI outputs (IsRunning, AtSpeed, etc.)
// -----------------------------------------------------------------------------
"FB_SpindleControl"

BEGIN

