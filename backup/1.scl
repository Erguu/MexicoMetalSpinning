TYPE "UDT_CylDiag"
VERSION : 0.1
// -----------------------------------------------------------------------------
// Cylinder Diagnostic - Per-cylinder runtime snapshot
// Used as: DB_Diagnostic.CylDiag[1..8]  (indexed by cylinder number)
// Add new cylinders in OB1 without changing DB_Diagnostic.
// -----------------------------------------------------------------------------
   STRUCT
      State : Int;   // FB_CylinderControl state (-1=EStop 0=Idle 1=Ext... 10=Err)
      Pos : Real;   // Ruler position (mm); 0.0 if no analog sensor connected
      Sol_A : Bool;   // Solenoid A output (extend coil)
      Sol_B : Bool;   // Solenoid B output (retract coil)
      Error : Bool;   // Active error flag
      ErrorID : Word;   // Error code (16#05xx)
   END_STRUCT;

END_TYPE

TYPE "UDT_SpindleSnap"
VERSION : 0.1
// -----------------------------------------------------------------------------
// Spindle Diagnostic Snapshot - one entry in the spindle history ring buffer
// DB_Spindle.Hist_Log[0..19] stores the last 20 state-change events.
// A new entry is pushed whenever SpindleState, PrevStart, ReqStart or StartEdge
// changes value -- so the log captures every meaningful transition without
// flooding with identical scans.
// -----------------------------------------------------------------------------
   STRUCT
      Seq : Int;   // Rolling sequence number
      MachineState : Int;   // FB_Process.State
      State : Int;   // FB_SpindleControl state: 0=Idle 20=Running 30=Halt 999=Error
      ReqStart : Bool;   // FB_RecipeHandler.SpindleReqStart
      ReqStop : Bool;   // FB_RecipeHandler.SpindleReqStop
      bStart : Bool;   // FB_Process bSpindleStart
      bStop : Bool;   // FB_Process bSpindleStop
      StartInput : Bool;   // Composite Start pin at FB_SpindleControl
      StopInput : Bool;   // Composite Stop pin
      EnableIn : Bool;   // bDrivesEnable
      PrevStart : Bool;   // prevStart latch inside FB_SpindleControl
      StartEdge : Bool;   // Rising edge accepted by FB_SpindleControl
      MoveVelBusy : Bool;   // MC_MoveVelocity.Busy  -- TO accepted and processing command
      MoveVelInVel : Bool;   // MC_MoveVelocity.InVelocity -- motor at commanded speed
   END_STRUCT;

END_TYPE

TYPE "AlarmEntry"
VERSION : 0.1
// -----------------------------------------------------------------------------
// Alarm Entry for history
// -----------------------------------------------------------------------------
   STRUCT
      Timestamp {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;   // RD_SYS_T() at moment of alarm
      ErrorCode : Word;   // 16#xxxx error code
      ProgramNum : Int;   // Active recipe program at fault time (0 = none)
      LineNum : Int;   // Active recipe line at fault time (-1 = outside recipe)
      ErrorText : String[40];   // ITEM-26: English error text snapshot (first 40 chars of DB_HMI.ErrorText)
   END_STRUCT;

END_TYPE

DATA_BLOCK "DB_Error"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
// DB_ErrorCodes removed -- error codes are used as inline hex constants.
// Severity: 0=info, 1=warn, 2=error, 3=fatal
// -----------------------------------------------------------------------------
// DB_Error - Centralized error snapshot for debugging (non-invasive to HMI)
// -----------------------------------------------------------------------------
   VAR 
      Active : Bool;   // TRUE when an active error is present
      Code : Word;   // Error code (matches DB_ErrorCodes)
      Severity : Byte;   // Priority tier: 1=warning, 2=project, 3=motion/TO, 4=safety (higher preempts lower on HMI display)
      Source : String[20];   // Originating FB or category (e.g. 'Recipe', 'Safety')
      Line : Int;   // Recipe line (if applicable) or -1
      TimeStamp {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;   // Timestamp captured with RD_SYS_T
      Details : String[120];   // Free text details / ActiveErrorText History ring buffer (last 10 errors) for post-mortem analysis
      History_Code : Array[1..10] of Word;
      History_Time {InstructionName := 'DTL'; LibVersion := '1.0'} : Array[1..10] of DTL;
      History_Source : Array[1..10] of String[20];
      History_Details : Array[1..10] of String[80];
      History_Index : Int;   // 1..10
      History_Count : Int;   // Number of valid entries (<=10)
      TotalErrorCount : DInt;   // Lifetime error count (incremented on each new error)
   END_VAR


BEGIN
   Active := FALSE;
   Code := 0;
   Severity := 0;
   Line := -1;
   History_Index := 0;
   History_Count := 0;
   TotalErrorCount := 0;

END_DATA_BLOCK

FUNCTION_BLOCK "FB_Axis_RelPos"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
// =============================================================================
// FB_Axis_RelPos -- Relative position move (MC_MoveRelative wrapper)
//
// Unlike MC_MoveAbsolute, does not require homing.
// Distance: positive = forward, negative = backward.
// =============================================================================
   VAR_INPUT 
      Execute : Bool;
      Distance : Real;   // Relative distance (mm or degrees)
      Velocity : Real;
   END_VAR

   VAR_OUTPUT 
      Done : Bool;
      Busy : Bool;
      Error : Bool;
      ErrorID : Word;   // TO error code (MC_MoveRelative.ErrorID)
   END_VAR

   VAR_IN_OUT 
      Axis {InstructionName := 'TO_PositioningAxis'; LibVersion := '8.0'} : TO_PositioningAxis;
   END_VAR

   VAR 
      MC_MoveRelative_Instance {InstructionName := 'MC_MoveRelative'; LibVersion := '8.0'} : MC_MoveRelative;
      execLatch : Bool;
      prevExec : Bool;
      doneLatch : Bool;
   END_VAR


BEGIN
	
	IF #Execute AND NOT #prevExec THEN
	    #doneLatch := FALSE;
	    #execLatch := TRUE;
	END_IF;
	#prevExec := #Execute;
	
	#MC_MoveRelative_Instance(
	                          Axis := #Axis,
	                          Execute := #execLatch,
	                          Distance := #Distance,
	                          Velocity := #Velocity,
	                          Done => #Done,
	                          Busy => #Busy,
	                          Error => #Error
	);
	#ErrorID := #MC_MoveRelative_Instance.ErrorID;
	
	IF #MC_MoveRelative_Instance.Done OR #MC_MoveRelative_Instance.Error THEN
	    #execLatch := FALSE;
	    #doneLatch := TRUE;
	END_IF;
	
END_FUNCTION_BLOCK

FUNCTION_BLOCK "FB_Axis_Jog"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
// =============================================================================
// FB_Axis_Jog -- Continuous jog move
//
// JogForward and JogBackward are level inputs (not edge).
// Axis decelerates when button is released.
// Velocity: jog speed (mm/s) -- fed from DB_Manual.JogSpeed.
// =============================================================================
   VAR_INPUT 
      JogForward : Bool;   // Continuous jog in positive direction (level)
      JogBackward : Bool;   // Continuous jog in negative direction (level)
      Velocity : Real;   // Jog speed (mm/s)
   END_VAR

   VAR_OUTPUT 
      Busy : Bool;
      Error : Bool;
   END_VAR

   VAR_IN_OUT 
      Axis {InstructionName := 'TO_PositioningAxis'; LibVersion := '8.0'} : TO_PositioningAxis;
   END_VAR

   VAR 
      MC_MoveJog_Instance {InstructionName := 'MC_MoveJog'; LibVersion := '8.0'} : MC_MoveJog;
   END_VAR


BEGIN
	
	#MC_MoveJog_Instance(
	                     Axis := #Axis,
	                     JogForward := #JogForward,
	                     JogBackward := #JogBackward,
	                     Velocity := #Velocity,
	                     Busy => #Busy,
	                     Error => #Error
	);
	
END_FUNCTION_BLOCK

DATA_BLOCK "DB_AlarmHistory"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
// -----------------------------------------------------------------------------
// DB_AlarmHistory - 20-entry alarm ring buffer for HMI history table (ITEM-26)
// NON_RETAIN: cleared on PLC power cycle. Survives Cmd_Reset (soft reset).
// HMI: connect Hist_Log[0..19] to a table, poll Hist_SeqNum for change detection,
//      sort by Timestamp descending. Hist_Clear = TRUE wipes manually.
// -----------------------------------------------------------------------------
   VAR 
      Hist_Head : Int;   // Next write slot (0..19, wraps on overflow)
      Hist_Count : Int;   // Number of valid entries (0..20)
      Hist_SeqNum : DInt;   // Monotonically increasing â€” HMI polls for change detection
      Hist_Clear : Bool;   // HMI writes TRUE to clear history; auto-resets next scan
      Hist_Log : Array[0..19] of "AlarmEntry";
   END_VAR


BEGIN
   Hist_Head := 0;
   Hist_Count := 0;
   Hist_SeqNum := 0;
   Hist_Clear := FALSE;

END_DATA_BLOCK

