FUNCTION_BLOCK "FB_ManualMode"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.2
// -----------------------------------------------------------------------------
// FB_ManualMode - Manual jog, home, move operations
// DOC:
//  purpose: Provide manual control and single-axis operations for operator (jog, absolute move, homing).
//  inputs: Enable (activation), SelectedAxis, Jog buttons, MoveAbsolute, Home commands, SafeToJog
//  outputs: Busy/Done/Error flags, AxisName/Position, ToolPosition
//  notes: Designed to be used in Manual mode only; delegates axis operations to axis FBs.
// -----------------------------------------------------------------------------
   VAR_INPUT 
      Enable : Bool;   // Enable manual mode (true = active)
      SelectedAxis : Int;   // 0=X,1=Z,2=Tool,3=Spindle
      Jog_Plus : Bool;   // Jog positive direction (level)
      Jog_Minus : Bool;   // Jog negative direction (level)
      JogSpeed : Real;   // Jog velocity (mm/s)
      MoveAbsolute : Bool;   // Trigger absolute move
      TargetPosition : Real;   // Absolute target position (mm)
      HomeAxis : Bool;   // Home selected axis
      HomeAll : Bool;   // Home all axes
      HomingMode : Int;   // Homing mode selection
      HomePosition : Real;   // Home position parameter (if used)
      GoSafe : Bool;   // Move to safe position
      GoZero : Bool;   // Move to zero position
      SafeToJog : Bool;   // From safety monitor
      Reset : Bool;   // Reset manual FB state
      PNP_X_Min : Bool;   // X min PNP sensor -- TRUE = in limit zone (for pre-homing clearance)
      PNP_Z_Min : Bool;   // Z min PNP sensor -- TRUE = in limit zone
      ToolStepCW : Bool;   // Tool step clockwise
      ToolStepCCW : Bool;   // Tool step counter-clockwise
      ToolStepAngle : Real;   // Angle per tool step (deg)
      ToolStepSpeed : Real;   // Velocity for tool step (deg/s)
   END_VAR

   VAR_OUTPUT 
      Busy : Bool;
      Done : Bool;
      Error : Bool;
      ErrorID : Word;
      AxisName : String[10];   // Display name for selected axis
      AxisPosition : Real;   // Current axis position reported
      AxisHomed : Bool;
      AxisReady : Bool;
      ToolPosition : Real;
      ActiveAxis : Int;   // Axis currently controlled (-1 = none)
      HomingActive : Bool;   // TRUE = homing motion in progress (for limit bypass)
   END_VAR

   VAR_IN_OUT 
      Axis_X {InstructionName := 'TO_PositioningAxis'; LibVersion := '8.0'} : TO_PositioningAxis;   // Axis technology objects (in/out interface)
      Axis_Z {InstructionName := 'TO_PositioningAxis'; LibVersion := '8.0'} : TO_PositioningAxis;
      Axis_Tool {InstructionName := 'TO_PositioningAxis'; LibVersion := '8.0'} : TO_PositioningAxis;
      Axis_Spindle {InstructionName := 'TO_PositioningAxis'; LibVersion := '8.0'} : TO_PositioningAxis;
   END_VAR

   VAR 
      state : Int;   // Local state for manual FB Motion FB instances used by manual mode
      fbJogX : "FB_Axis_Jog";
      fbJogZ : "FB_Axis_Jog";
      fbJogTool : "FB_Axis_Jog";
      fbMoveX : "FB_Axis_AbsPos";
      fbMoveZ : "FB_Axis_AbsPos";
      fbMoveToolAbs : "FB_Axis_AbsPos";   // Manual > MOVE ABSOLUTE (requires homing)
      fbMoveTool : "FB_Axis_RelPos";   // Manual > TOOL STEP (does not require homing)
      fbHomeX : "FB_Axis_Home";   // Previous input state for edge detection and one-shot triggers
      fbHomeZ : "FB_Axis_Home";   // Previous input state for edge detection and one-shot triggers
      fbHomeTool : "FB_Axis_Home";   // Previous input state for edge detection and one-shot triggers
      prevMoveAbs : Bool;
      prevHomeAxis : Bool;
      prevHomeAll : Bool;
      prevGoSafe : Bool;
      prevGoZero : Bool;
      prevToolStepCW : Bool;
      prevToolStepCCW : Bool;   // Internal control flags
      bMoveX : Bool;
      bMoveZ : Bool;
      bMoveTool : Bool;
      bMoveToolAbs : Bool;
      bHomeX : Bool;
      bHomeZ : Bool;
      bHomeTool : Bool;
      bHomeAllExec : Bool;   // TRUE while HomeAll sequence is active
      homeAllStep : Int;   // HomeAll step: 1=X, 2=Z, 3=Tool Homing clearance -- escape from PNP zone / move away after homing
      fbClearX : "FB_Axis_AbsPos";   // X clearance move
      fbClearZ : "FB_Axis_AbsPos";   // Z clearance hareketi
      bClearX : Bool;   // X clearance execute flag
      bClearZ : Bool;   // Z clearance execute flag
      bToolStepExec : Bool;
      jogAxis : Int;   // Axis selected for jogging during a jog session
      stepTarget : Real;
      moveVelocity : Real;
   END_VAR


BEGIN
	
	IF NOT #Enable THEN
	    #state := 0;
	    #Busy := FALSE;
	    #Done := FALSE;
	    #bMoveX := FALSE;
	    #bMoveZ := FALSE;
	    #bMoveTool := FALSE;
	    #bHomeX := FALSE;
	    #bHomeZ := FALSE;
	    #bHomeTool := FALSE;
	    #bHomeAllExec := FALSE;
	    #homeAllStep := 0;
	    RETURN;
	END_IF;
	
	IF NOT #SafeToJog THEN
	    #Error := TRUE;
	    #ErrorID := 16#0005;
	    #state := 999;
	    "DB_HMI".ErrorDetail := 'Manual: drives not ready or E-Stop active';
	    "DB_HMI".ErrorDetail_ES := 'Manual: variadores no listos o Paro de Emergencia activo';
	END_IF;
	IF #Reset THEN
	    #state := 0;
	    #Error := FALSE;
	    #ErrorID := 0;
	    #Done := FALSE;
	END_IF;
	
	#ToolPosition := #Axis_Tool.ActualPosition;
	
	CASE #SelectedAxis OF
	    0:
	        #AxisName := 'X';
	        #AxisPosition := #Axis_X.ActualPosition;
	        #AxisHomed := #Axis_X.StatusBits.HomingDone;
	        #AxisReady := #Axis_X.StatusBits.DriveReady;
	    1:
	        #AxisName := 'Z';
	        #AxisPosition := #Axis_Z.ActualPosition;
	        #AxisHomed := #Axis_Z.StatusBits.HomingDone;
	        #AxisReady := #Axis_Z.StatusBits.DriveReady;
	    2:
	        #AxisName := 'Tool';
	        #AxisPosition := #Axis_Tool.ActualPosition;
	        #AxisHomed := #Axis_Tool.StatusBits.HomingDone;
	        #AxisReady := #Axis_Tool.StatusBits.DriveReady;
	    3:
	        #AxisName := 'Spindle';
	        #AxisPosition := #Axis_Spindle.ActualVelocity;
	        #AxisHomed := TRUE;
	        #AxisReady := #Axis_Spindle.StatusBits.DriveReady;
	END_CASE;
	
	CASE #state OF
	    0: // IDLE
	        #Busy := FALSE;
	        #Done := FALSE;
	        #ActiveAxis := -1;
	        #HomingActive := FALSE;
	        IF (#Jog_Plus OR #Jog_Minus) AND #SafeToJog THEN
	            #jogAxis := #SelectedAxis;
	            #state := 10;
	        END_IF;
	        IF #MoveAbsolute AND NOT #prevMoveAbs THEN
	            #state := 30;
	        END_IF;
	        IF #HomeAxis AND NOT #prevHomeAxis THEN
	            #state := 40;
	        END_IF;
	        IF #HomeAll AND NOT #prevHomeAll THEN
	            #state := 50;
	        END_IF;
	        IF #GoSafe AND NOT #prevGoSafe THEN
	            #state := 60;
	        END_IF;
	        IF #GoZero AND NOT #prevGoZero THEN
	            #state := 70;
	        END_IF;
	        // moveVelocity must be set here -- FB call comes at the end of the same scan;
	        // if set in state 20 it arrives one scan late and MC_MoveRelative starts at 0 speed.
	        IF #ToolStepCW AND NOT #prevToolStepCW THEN
	            #stepTarget := #ToolStepAngle;
	            #moveVelocity := #ToolStepSpeed;
	            #bMoveTool := TRUE;
	            #state := 20;
	        END_IF;
	        IF #ToolStepCCW AND NOT #prevToolStepCCW THEN
	            #stepTarget := - #ToolStepAngle;
	            #moveVelocity := #ToolStepSpeed;
	            #bMoveTool := TRUE;
	            #state := 20;
	        END_IF;
	        
	    10: // JOGGING
	        #Busy := TRUE;
	        #ActiveAxis := #jogAxis;
	        IF NOT #Jog_Plus AND NOT #Jog_Minus THEN
	            #state := 99;
	        END_IF;
	        
	    20: // TOOL STEP
	        #Busy := TRUE;
	        #ActiveAxis := 2;
	        #moveVelocity := #ToolStepSpeed;
	        #state := 80;
	        
	    30: // MOVE ABSOLUTE
	        #Busy := TRUE;
	        // Soft-limit guard: once the axis is homed, reject targets outside the
	        // configured soft limits (no motion started, hint shown, back to IDLE).
	        // Un-homed axes are not checked -- position is meaningless before homing
	        // (AbsPos on an un-homed axis is rejected by the TO itself anyway).
	        IF (#SelectedAxis = 0 AND #Axis_X.StatusBits.HomingDone
	            AND (#TargetPosition < "DB_MachineConfig".SoftLimit_MinX
	            OR #TargetPosition > "DB_MachineConfig".SoftLimit_MaxX))
	            OR (#SelectedAxis = 1 AND #Axis_Z.StatusBits.HomingDone
	            AND (#TargetPosition < "DB_MachineConfig".SoftLimit_MinZ
	            OR #TargetPosition > "DB_MachineConfig".SoftLimit_MaxZ)) THEN
	            "DB_HMI".ErrorDetail := 'Manual: target outside soft limits - move rejected';
	            "DB_HMI".ErrorDetail_ES := 'Manual: objetivo fuera de limites - movimiento rechazado';
	            #state := 0;
	        ELSE
	            #stepTarget := #TargetPosition;
	            #moveVelocity := #JogSpeed;
	            CASE #SelectedAxis OF
	                0:
	                    #bMoveX := TRUE;
	                    #ActiveAxis := 0;
	                1:
	                    #bMoveZ := TRUE;
	                    #ActiveAxis := 1;
	                2:
	                    #bMoveToolAbs := TRUE;
	                    #ActiveAxis := 2;  // AbsPos -- requires prior homing
	            END_CASE;
	            #state := 80;
	        END_IF;
	        
	    40: // HOME AXIS INIT -- if in PNP zone, clear it first, then home
	        #Busy := TRUE;
	        #HomingActive := TRUE;
	        CASE #SelectedAxis OF
	            0: // X axis
	                #ActiveAxis := 0;
	                IF #PNP_X_Min THEN
	                    // In X min PNP zone â†’ clearance move first
	                    #bClearX := TRUE;
	                    #state := 41;
	                ELSE
	                    #bHomeX := TRUE;
	                    #state := 80;
	                END_IF;
	            1: // Z axis
	                #ActiveAxis := 1;
	                IF #PNP_Z_Min THEN
	                    #bClearZ := TRUE;
	                    #state := 41;
	                ELSE
	                    #bHomeZ := TRUE;
	                    #state := 80;
	                END_IF;
	            2: // Tool axis -- no PNP zone
	                #bHomeTool := TRUE;
	                #ActiveAxis := 2;
	                #state := 80;
	        END_CASE;
	        
	    41: // PRE-HOME CLEARANCE WAIT -- wait for clearance move out of PNP zone to finish
	        #Busy := TRUE;
	        #HomingActive := TRUE;
	        IF #bClearX AND #fbClearX.Done THEN
	            #bClearX := FALSE;
	            #bHomeX := TRUE;
	            #state := 80;
	        ELSIF #bClearZ AND #fbClearZ.Done THEN
	            #bClearZ := FALSE;
	            #bHomeZ := TRUE;
	            #state := 80;
	        ELSIF (#bClearX AND #fbClearX.Error) OR (#bClearZ AND #fbClearZ.Error) THEN
	            #bClearX := FALSE;
	            #bClearZ := FALSE;
	            #state := 999;
	            #ErrorID := 16#0001;
	            "DB_HMI".ErrorDetail := 'Manual: pre-home clearance move failed';
	            "DB_HMI".ErrorDetail_ES := 'Manual: fallo al liberar zona PNP antes de referenciar';
	        END_IF;
	        
	    50: // HOME ALL INIT -- clear required axes from PNP zone, then home X â†’ Z â†’ Tool
	        #Busy := TRUE;
	        #HomingActive := TRUE;
	        #ActiveAxis := -1;
	        #bClearX := #PNP_X_Min;   // Clearance only needed if inside PNP zone
	        #bClearZ := #PNP_Z_Min;
	        IF #bClearX OR #bClearZ THEN
	            #state := 51;          // Clearance first
	        ELSE
	            #homeAllStep := 1;
	            #bHomeX := TRUE;
	            #bHomeAllExec := TRUE;
	            #state := 80;
	        END_IF;
	        
	    51: // HOME ALL PRE-CLEARANCE WAIT -- wait until both axes have cleared PNP zone
	        #Busy := TRUE;
	        #HomingActive := TRUE;
	        IF (NOT #bClearX OR #fbClearX.Done) AND (NOT #bClearZ OR #fbClearZ.Done) THEN
	            #bClearX := FALSE;
	            #bClearZ := FALSE;
	            #homeAllStep := 1;
	            #bHomeX := TRUE;
	            #bHomeAllExec := TRUE;
	            #state := 80;
	        ELSIF (#bClearX AND #fbClearX.Error) OR (#bClearZ AND #fbClearZ.Error) THEN
	            #bClearX := FALSE;
	            #bClearZ := FALSE;
	            #state := 999;
	            #ErrorID := 16#0001;
	            "DB_HMI".ErrorDetail := 'Manual: pre-home clearance move failed (Home All)';
	            "DB_HMI".ErrorDetail_ES := 'Manual: fallo al liberar zona PNP antes de referenciar (Ref. Todo)';
	        END_IF;
	        
	    60: // GO SAFE
	        #Busy := TRUE;
	        #moveVelocity := "DB_MachineConfig".RapidVelocity;
	        CASE #SelectedAxis OF
	            0:
	                #bMoveX := TRUE;
	                #stepTarget := "DB_MachineConfig".SafePos_X;
	                #ActiveAxis := 0;
	            1:
	                #bMoveZ := TRUE;
	                #stepTarget := "DB_MachineConfig".SafePos_Z;
	                #ActiveAxis := 1;
	        END_CASE;
	        #state := 80;
	        
	    70: // GO ZERO
	        #Busy := TRUE;
	        #stepTarget := 0.0;
	        #moveVelocity := "DB_MachineConfig".RapidVelocity;
	        CASE #SelectedAxis OF
	            0:
	                #bMoveX := TRUE;
	                #ActiveAxis := 0;
	            1:
	                #bMoveZ := TRUE;
	                #ActiveAxis := 1;
	        END_CASE;
	        #state := 80;
	        
	    80: // WAIT FOR COMPLETE
	        #Busy := TRUE;
	        // HomingActive: set while any homing flag is still active
	        #HomingActive := #bHomeX OR #bHomeZ OR #bHomeTool OR #bHomeAllExec;
	        // Normal moves -- go directly to 99 on completion
	        IF #bMoveX AND #fbMoveX.Done THEN
	            #state := 99;
	        END_IF;
	        IF #bMoveX AND #fbMoveX.Error THEN
	            #state := 999;
	            #ErrorID := 16#0001;
	            "DB_HMI".ErrorDetail := CONCAT(IN1 := 'Manual X move: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbMoveX.ErrorID));
	            "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'Manual mov. X: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbMoveX.ErrorID));
	        END_IF;
	        IF #bMoveZ AND #fbMoveZ.Done THEN
	            #state := 99;
	        END_IF;
	        IF #bMoveZ AND #fbMoveZ.Error THEN
	            #state := 999;
	            #ErrorID := 16#0002;
	            "DB_HMI".ErrorDetail := CONCAT(IN1 := 'Manual Z move: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbMoveZ.ErrorID));
	            "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'Manual mov. Z: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbMoveZ.ErrorID));
	        END_IF;
	        IF #bMoveTool AND #fbMoveTool.Done THEN
	            #state := 99;
	        END_IF;
	        IF #bMoveTool AND #fbMoveTool.Error THEN
	            #state := 999;
	            #ErrorID := 16#0006;
	            "DB_HMI".ErrorDetail := CONCAT(IN1 := 'Manual tool step: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbMoveTool.ErrorID));
	            "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'Manual paso herr: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbMoveTool.ErrorID));
	        END_IF;
	        IF #bMoveToolAbs AND #fbMoveToolAbs.Done THEN
	            #state := 99;
	        END_IF;
	        IF #bMoveToolAbs AND #fbMoveToolAbs.Error THEN
	            #state := 999;
	            #ErrorID := 16#0006;
	            "DB_HMI".ErrorDetail := CONCAT(IN1 := 'Manual tool abs: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbMoveToolAbs.ErrorID));
	            "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'Manual herr abs: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbMoveToolAbs.ErrorID));
	        END_IF;
	        // Single-axis homing -- on completion go to post-clearance (guarded: not during HomeAll)
	        IF #bHomeX AND NOT #bHomeAllExec AND #fbHomeX.Done THEN
	            #bHomeX := FALSE;
	            #bClearX := TRUE;
	            #state := 82;
	        END_IF;
	        IF #bHomeZ AND NOT #bHomeAllExec AND #fbHomeZ.Done THEN
	            #bHomeZ := FALSE;
	            #bClearZ := TRUE;
	            #state := 82;
	        END_IF;
	        IF #bHomeTool AND NOT #bHomeAllExec AND #fbHomeTool.Done THEN
	            #state := 99;
	        END_IF;  // Tool axis has no PNP zone (individual home)
	        IF #bHomeTool AND NOT #bHomeAllExec AND #fbHomeTool.Error THEN
	            #state := 999;
	            #ErrorID := 16#0007;
	            "DB_HMI".ErrorDetail := CONCAT(IN1 := 'Manual tool home: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbHomeTool.ErrorID));
	            "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'Manual ref herr: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbHomeTool.ErrorID));
	        END_IF;
	        // HomeAll: sequential X â†’ Z â†’ Tool
	        IF #bHomeAllExec THEN
	            IF #homeAllStep = 1 THEN
	                // Step 1: home X
	                IF #fbHomeX.Done THEN
	                    #bHomeX := FALSE;
	                    #homeAllStep := 2;
	                    #bHomeZ := TRUE;
	                ELSIF #fbHomeX.Error THEN
	                    #bHomeX := FALSE;
	                    #bHomeAllExec := FALSE;
	                    #homeAllStep := 0;
	                    #state := 999;
	                    #ErrorID := 16#0003;
	                    "DB_HMI".ErrorDetail := CONCAT(IN1 := 'Manual home all X: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbHomeX.ErrorID));
	                    "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'Manual ref. todo X: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbHomeX.ErrorID));
	                END_IF;
	            ELSIF #homeAllStep = 2 THEN
	                // Step 2: home Z
	                IF #fbHomeZ.Done THEN
	                    #bHomeZ := FALSE;
	                    IF NOT "DB_MachineConfig".Bypass_ToolAxis THEN
	                        #homeAllStep := 3;
	                        #bHomeTool := TRUE;
	                    ELSE
	                        #bHomeAllExec := FALSE;
	                        #homeAllStep := 0;
	                        #bClearX := TRUE;
	                        #bClearZ := TRUE;
	                        #state := 82;
	                    END_IF;
	                ELSIF #fbHomeZ.Error THEN
	                    #bHomeZ := FALSE;
	                    #bHomeAllExec := FALSE;
	                    #homeAllStep := 0;
	                    #state := 999;
	                    #ErrorID := 16#0004;
	                    "DB_HMI".ErrorDetail := CONCAT(IN1 := 'Manual home all Z: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbHomeZ.ErrorID));
	                    "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'Manual ref. todo Z: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbHomeZ.ErrorID));
	                END_IF;
	            ELSIF #homeAllStep = 3 THEN
	                // Step 3: home Tool
	                IF #fbHomeTool.Done THEN
	                    #bHomeTool := FALSE;
	                    #bHomeAllExec := FALSE;
	                    #homeAllStep := 0;
	                    #bClearX := TRUE;
	                    #bClearZ := TRUE;
	                    #state := 82;
	                ELSIF #fbHomeTool.Error THEN
	                    #bHomeTool := FALSE;
	                    #bHomeAllExec := FALSE;
	                    #homeAllStep := 0;
	                    #state := 999;
	                    #ErrorID := 16#0007;
	                    "DB_HMI".ErrorDetail := CONCAT(IN1 := 'Manual home all Tool: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbHomeTool.ErrorID));
	                    "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'Manual ref. todo herr: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbHomeTool.ErrorID));
	                END_IF;
	            END_IF;
	        END_IF;
	        
	    82: // POST-HOME CLEARANCE WAIT -- move away from PNP zone after homing
	        #Busy := TRUE;
	        #HomingActive := FALSE;  // Homing done, clearance move in progress
	        IF (NOT #bClearX OR #fbClearX.Done) AND (NOT #bClearZ OR #fbClearZ.Done) THEN
	            #bClearX := FALSE;
	            #bClearZ := FALSE;
	            #state := 99;
	        ELSIF (#bClearX AND #fbClearX.Error) OR (#bClearZ AND #fbClearZ.Error) THEN
	            #bClearX := FALSE;
	            #bClearZ := FALSE;
	            #state := 999;
	            #ErrorID := 16#0001;
	            "DB_HMI".ErrorDetail := 'Manual: post-home clearance move failed';
	            "DB_HMI".ErrorDetail_ES := 'Manual: fallo al liberar zona PNP despues de referenciar';
	        END_IF;
	        
	    99: // COMPLETE
	        #Busy := FALSE;
	        #Done := TRUE;
	        #HomingActive := FALSE;
	        #bMoveX := FALSE;
	        #bMoveZ := FALSE;
	        #bMoveTool := FALSE;
	        #bMoveToolAbs := FALSE;
	        #bHomeX := FALSE;
	        #bHomeZ := FALSE;
	        #bHomeTool := FALSE;
	        #bHomeAllExec := FALSE;
	        #homeAllStep := 0;
	        #bClearX := FALSE;
	        #bClearZ := FALSE;
	        #ActiveAxis := -1;
	        #state := 0;
	        
	    999: // ERROR
	        #Error := TRUE;
	        #Busy := FALSE;
	        #HomingActive := FALSE;
	        #bMoveX := FALSE;
	        #bMoveZ := FALSE;
	        #bMoveTool := FALSE;
	        #bMoveToolAbs := FALSE;
	        #bHomeAllExec := FALSE;
	        #homeAllStep := 0;
	        #bClearX := FALSE;
	        #bClearZ := FALSE;
	END_CASE;
	
	IF #state = 0 THEN
	    #prevMoveAbs := #MoveAbsolute;
	    #prevHomeAxis := #HomeAxis;
	    #prevHomeAll := #HomeAll;
	    #prevGoSafe := #GoSafe;
	    #prevGoZero := #GoZero;
	END_IF;
	
	// FB Calls
	#fbJogX(JogForward := (#Jog_Plus AND #jogAxis = 0 AND #state = 10),
	        JogBackward := (#Jog_Minus AND #jogAxis = 0 AND #state = 10),
	        Velocity := #JogSpeed,
	        Axis := #Axis_X);
	#fbJogZ(JogForward := (#Jog_Plus AND #jogAxis = 1 AND #state = 10),
	        JogBackward := (#Jog_Minus AND #jogAxis = 1 AND #state = 10),
	        Velocity := #JogSpeed,
	        Axis := #Axis_Z);
	#fbJogTool(JogForward := (#Jog_Plus AND #jogAxis = 2 AND #state = 10),
	           JogBackward := (#Jog_Minus AND #jogAxis = 2 AND #state = 10),
	           Velocity := #JogSpeed,
	           Axis := #Axis_Tool);
	#fbMoveX(Execute := #bMoveX,
	         Position := #stepTarget,
	         Velocity := #moveVelocity,
	         Axis := #Axis_X);
	#fbMoveZ(Execute := #bMoveZ,
	         Position := #stepTarget,
	         Velocity := #moveVelocity,
	         Axis := #Axis_Z);
	#fbMoveTool(Execute := #bMoveTool,
	            Distance := #stepTarget,
	            Velocity := #moveVelocity,
	            Axis := #Axis_Tool);
	#fbMoveToolAbs(Execute := #bMoveToolAbs,
	               Position := #stepTarget,
	               Velocity := #moveVelocity,
	               Axis := #Axis_Tool);
	#fbHomeX(Execute := #bHomeX,
	         Mode := #HomingMode,
	         Position := #HomePosition,
	         Axis := #Axis_X);
	#fbHomeZ(Execute := #bHomeZ,
	         Mode := #HomingMode,
	         Position := #HomePosition,
	         Axis := #Axis_Z);
	#fbHomeTool(Execute := #bHomeTool,
	            Mode := #HomingMode,
	            Position := #HomePosition,
	            Axis := #Axis_Tool);
	// Homing clearance moves:
	//   Pre-home:  when in PNP zone, move to safe position before starting homing
	//   Post-home: move away from PNP zone after homing completes
	//   Target: HomeOffset + PostHome_Clearance (same position in both cases)
	#fbClearX(Execute := #bClearX,
	          Position := "DB_MachineConfig".HomeOffset_X + "DB_MachineConfig".PostHome_Clearance,
	          Velocity := "DB_MachineConfig".HomeVelocity,
	          Axis := #Axis_X);
	#fbClearZ(Execute := #bClearZ,
	          Position := "DB_MachineConfig".HomeOffset_Z + "DB_MachineConfig".PostHome_Clearance,
	          Velocity := "DB_MachineConfig".HomeVelocity,
	          Axis := #Axis_Z);
	#prevToolStepCW := #ToolStepCW;
	#prevToolStepCCW := #ToolStepCCW;
	
END_FUNCTION_BLOCK

FUNCTION "FC_ReportError" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.1
// ---------------------------------------------------------------------------
// FC_ReportError - Utility to request a centralized error handling via DB_SystemEvents
// Usage: FC_ReportError(Code := <word>, Details := 'text', Source := 'Recipe');
// ---------------------------------------------------------------------------
   VAR_INPUT 
      Code : Word;
      Details : String;
      Source : String;
   END_VAR

   VAR_TEMP 
      tail : Int;
   END_VAR


BEGIN
	
	// Enqueue into ring buffer. If full (4 concurrent errors in one scan) the entry is
	// silently dropped -- in practice this cannot happen with the current call sites.
	IF "DB_SystemEvents".EQ_Count < 4 THEN
	    #tail := "DB_SystemEvents".EQ_Tail;
	    "DB_SystemEvents".EQ_Code[#tail] := #Code;
	    "DB_SystemEvents".EQ_Details[#tail] := #Details;
	    "DB_SystemEvents".EQ_Source[#tail] := #Source;
	    "DB_SystemEvents".EQ_Tail := (#tail + 1) MOD 4;
	    "DB_SystemEvents".EQ_Count := "DB_SystemEvents".EQ_Count + 1;
	END_IF;
	
END_FUNCTION

DATA_BLOCK "DB_RecipeProgram5"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
// -----------------------------------------------------------------------------
// DB_RecipeProgram5 - Recipe data for Program 5
// -----------------------------------------------------------------------------
   VAR 
      Header : "RecipeHeader";
      Lines : Array[0..349] of "RecipeLine";
   END_VAR


BEGIN

END_DATA_BLOCK

FUNCTION_BLOCK "FB_ToolChanger"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.2
// =============================================================================
// 04_ToolChanger.scl
// FB_ToolChanger -- Turret rotation controller
//
// Purpose:
//   Rotates the turret to the target tool angle only.
//   X/Z axis movement is NOT the responsibility of this FB.
//   In auto mode, the caller (FB_RecipeHandler/FB_Process) handles positioning.
//   In manual mode, FB_ManualMode handles it.
//
// Usage:
//   Execute = TRUE (level) â†’ rotation starts and Busy=TRUE until complete.
//   Execute = FALSE â†’ FB resets (Done/Error cleared).
//   ToolNumber (1-4) â†’ angle is read from DB_ToolConfig and turret moves there.
//
// Error codes:
//   16#0202 -- Invalid tool number (outside ToolCount range)
//   16#0205 -- Turret rotation failed (TO/drive error)
//   16#0206 -- Turret rotation timeout (Done not received within 30s)
// =============================================================================
   VAR_INPUT 
      Execute : Bool;   // TRUE = start and hold rotation; FALSE = reset
      ToolNumber : Int;   // Target tool number (1 - DB_MachineConfig.ToolCount)
   END_VAR

   VAR_OUTPUT 
      Done : Bool;   // Rotation completed successfully (remains while Execute TRUE)
      Busy : Bool;   // Rotation in progress
      Error : Bool;   // Error occurred (see ErrorID)
      ErrorID : Word;   // Error code (16#0202 or 16#0205)
      CurrentTool : Int;   // Active tool number after successful change
   END_VAR

   VAR_IN_OUT 
      Axis_Tool {InstructionName := 'TO_PositioningAxis'; LibVersion := '8.0'} : TO_PositioningAxis;   // Turret servo Technology Object
   END_VAR

   VAR 
      state : Int;   // Internal state machine
      targetToolPos : Real;   // Target turret angle (degrees)
      fbMoveTool : "FB_Axis_AbsPos";   // Absolute position FB instance
      bExecMoveTool : Bool;   // FB_Axis_AbsPos Execute trigger flag
      tonTimeout {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;   // 30s rotation timeout
   END_VAR


BEGIN
	
	// -------------------------------------------------------------------------
	// Execute = FALSE: reset all outputs (caller preparing new command)
	// -------------------------------------------------------------------------
	IF NOT #Execute THEN
	    #state := 0;
	    #Done := FALSE;
	    #Busy := FALSE;
	    #Error := FALSE;
	    #ErrorID := 0;
	    #bExecMoveTool := FALSE;
	    // BUG FIX: fbMoveTool must be called every scan, even while idle.
	    // RETURNing without this call froze the inner FB_Axis_AbsPos when a tool
	    // change was aborted mid-rotation (stop/error dropped Execute): its
	    // internal latches stayed at "command already sent", so the next tool
	    // change never generated a rising edge for MC_MoveAbsolute -- the turret
	    // stood still until the 30s timeout (16#0206). Calling with Execute=FALSE
	    // lets it process Done/Error/CommandAborted and rearm itself; Siemens MC
	    // instructions must be called cyclically while a job is active anyway.
	    #fbMoveTool(
	                Execute := FALSE,
	                Position := #targetToolPos,
	                Velocity := "DB_MachineConfig".ToolVelocity,
	                Axis := #Axis_Tool
	    );
	    RETURN;
	END_IF;
	
	#Busy := TRUE;
	
	CASE #state OF
	        
	        // ---------------------------------------------------------------
	        // STATE 0: Validate tool number, read target angle from DB
	        // ---------------------------------------------------------------
	    0:
	        IF #ToolNumber < 1 OR #ToolNumber > "DB_MachineConfig".ToolCount THEN
	            // Invalid tool number -- recipe or operator error
	            #ErrorID := 16#0202;
	            "DB_Diagnostic".Error_Text := 'ToolChanger: Invalid tool number';
	            "DB_Diagnostic".Error_Code := #ErrorID;
	            #state := 999;
	        ELSE
	            // Read physical turret angle from DB_ToolConfig
	            CASE #ToolNumber OF
	                1:
	                    #targetToolPos := "DB_ToolConfig".Tool1_Position;
	                2:
	                    #targetToolPos := "DB_ToolConfig".Tool2_Position;
	                3:
	                    #targetToolPos := "DB_ToolConfig".Tool3_Position;
	                4:
	                    #targetToolPos := "DB_ToolConfig".Tool4_Position;
	            END_CASE;
	            #state := 10;
	        END_IF;
	        
	        // ---------------------------------------------------------------
	        // STATE 10: Start turret rotation
	        // ---------------------------------------------------------------
	    10:
	        #bExecMoveTool := TRUE;
	        #tonTimeout(IN := FALSE,
	                    PT := "DB_MachineConfig".Timeout_ToolChange);  // Reset timer
	        #state := 20;
	        
	        // ---------------------------------------------------------------
	        // STATE 20: Wait for rotation to complete
	        // ---------------------------------------------------------------
	    20:
	        #tonTimeout(IN := TRUE,
	                    PT := "DB_MachineConfig".Timeout_ToolChange);
	        IF #fbMoveTool.Done THEN
	            // Rotation complete -- update active tool
	            #bExecMoveTool := FALSE;
	            #CurrentTool := #ToolNumber;
	            #state := 99;
	        ELSIF #tonTimeout.Q THEN
	            // Done not received within 30s -- mechanical blockage or TO issue
	            #bExecMoveTool := FALSE;
	            #ErrorID := 16#0206;
	            "DB_Diagnostic".Error_Text := CONCAT(IN1 := 'ToolChanger: Timeout T', IN2 := INT_TO_STRING(#ToolNumber));
	            "DB_Diagnostic".Error_Code := #ErrorID;
	            // Single-writer: DB_HMI.ErrorText comes from FB_AlarmManager (FB_Process
	            // forwards #ErrorID in STATE_TOOL_WAIT); tool number is in ErrorDetail there.
	            #state := 999;
	        ELSIF #fbMoveTool.Error THEN
	            // TO/drive error -- turret could not reach target angle
	            #bExecMoveTool := FALSE;
	            #ErrorID := 16#0205;
	            "DB_Diagnostic".TO_ErrorText := "FC_TO_ErrorText"(Code := #fbMoveTool.ErrorID);
	            "DB_Diagnostic".Error_Text := CONCAT(IN1 := 'ToolChanger: Rotation failed T',
	                                                 IN2 := CONCAT(IN1 := INT_TO_STRING(#ToolNumber),
	                                                               IN2 := CONCAT(IN1 := ' TO:', IN2 := "DB_Diagnostic".TO_ErrorText)));
	            "DB_Diagnostic".Error_Code := #ErrorID;
	            // Single-writer: DB_HMI.ErrorText comes from FB_AlarmManager via FB_Process forward.
	            "DB_HMI".ErrorDetail := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
	            "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
	            #state := 999;
	        END_IF;
	        
	        // ---------------------------------------------------------------
	        // STATE 99: Completed successfully
	        // ---------------------------------------------------------------
	    99:
	        #Done := TRUE;
	        #Busy := FALSE;
	        
	        // ---------------------------------------------------------------
	        // STATE 999: Error state -- remains until Execute goes FALSE
	        // ---------------------------------------------------------------
	    999:
	        #Error := TRUE;
	        #Busy := FALSE;
	        
	END_CASE;
	
	// FB_Axis_AbsPos called every scan -- Execute flag managed by state machine
	#fbMoveTool(
	            Execute := #bExecMoveTool,
	            Position := #targetToolPos,
	            Velocity := "DB_MachineConfig".ToolVelocity,
	            Axis := #Axis_Tool
	);
	
	
END_FUNCTION_BLOCK

FUNCTION_BLOCK "FB_RecipePreScan"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
// =============================================================================
// Version_Recipe - 05_RecipeHandler.scl
// Recipe-based motion handler with pre-scan validation
// No string parsing - direct array access for maximum efficiency
// =============================================================================
// -----------------------------------------------------------------------------
// FB_RecipePreScan - Pre-scan recipe for limit validation
// DOC:
//  purpose: Scan recipe lines before execution to compute bounding box and detect
//           any soft-limit violations. Runs in batches to avoid long PLC scan times.
//  inputs: Execute (rising edge), LineCount
//  outputs: Done, Valid, ErrorLine (first offending line), MinX/MaxX, MinZ/MaxZ
//  notes: Designed for non-blocking operation - processes N lines per PLC cycle.
// -----------------------------------------------------------------------------
   VAR_INPUT 
      Execute : Bool;   // Rising edge starts pre-scan (level input)
      LineCount : Int;   // Number of lines to scan
   END_VAR

   VAR_OUTPUT 
      Done : Bool;   // TRUE when pre-scan finished
      Valid : Bool;   // TRUE if no limit violations found
      ErrorLine : Int := -1;   // Line with first error (-1 = none)
      ErrorDesc : String[60];   // Human-readable description of first violation
      MinX : Real;   // Computed bounding box minimum X
      MaxX : Real;   // Computed bounding box maximum X
      MinZ : Real;   // Computed bounding box minimum Z
      MaxZ : Real;   // Computed bounding box maximum Z
      Progress : Real;   // Pre-scan progress 0-100% for HMI display
   END_VAR

   VAR_IN_OUT 
      Lines : Array[0..349] of "RecipeLine";   // Recipe lines storage (in/out DB reference)
   END_VAR

   VAR 
      state : Int;   // Local state machine
      scanIndex : Int;   // Current scan index (next line to process)
      scanEndIndex : Int;   // End index for current batch
      rtExecute : Bool;   // Rising-edge start detection
      prevExecute : Bool;   // Previous execute level (for edge) Temp vars for pre-scan checks (#4 feedrate/spindle, #5 tool mapping)
      spindleRPM : Real;   // Decoded spindle RPM from Param byte
      tmpToolCode : Int;   // Tool code from recipe Param
      mapIndex : Int;   // Tool mapping loop index
      mapFound : Bool;   // Tool mapping search result
      cylTarget : Real;   // reserved (ITEM-38 ruler range check removed -- BackSupport is full-stroke on this machine) Recipe format: RecipeLine.Param encodes spindle speed as RPM Ã· 10. Range: 0â€“255 byte â†’ 0â€“2550 RPM. Clamp to DB_Spindle.MaxSpeed at runtime. See PLC_Recipe_Format_Spec.md CMD_SPINDLE_ON.
   END_VAR

   VAR CONSTANT 
      SPINDLE_PARAM_TO_RPM : Real := 10.0;
   END_VAR


BEGIN
	
	// -------------------------------------------------------------------------
	// Rising edge detection -- start once when Execute level rises
	// -------------------------------------------------------------------------
	#rtExecute := #Execute AND NOT #prevExecute;
	#prevExecute := #Execute;
	
	// NOTE: PreScan processes 10 lines per PLC scan cycle to avoid long scan blocks.
	// This preserves CPU responsiveness.
	// ErrorLine: the first line with a limit violation -- helps operator locate the issue.
	
	CASE #state OF
	        
	        // -----------------------------------------------------------------
	        // === STATE_IDLE (0) ===
	        // -----------------------------------------------------------------
	    0: // IDLE -- waiting for Execute rising edge
	        #Done := FALSE;
	        #Progress := 0.0;
	        IF #rtExecute THEN
	            #scanIndex := 0;
	            #MinX := "DB_MachineConfig".SoftLimit_MaxX;
	            #MaxX := "DB_MachineConfig".SoftLimit_MinX;
	            #MinZ := "DB_MachineConfig".SoftLimit_MaxZ;
	            #MaxZ := "DB_MachineConfig".SoftLimit_MinZ;
	            #ErrorLine := -1;
	            #Valid := TRUE;
	            #state := 10;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_SCANNING (10) ===
	        // -----------------------------------------------------------------
	    10: // SCANNING -- 10 lines scanned per cycle (batch processing)
	        // Bounding box updated and soft limit checked for each G0/G1 line.
	        // Other commands (SpindleOn, ToolChange, Dwell, End) skipped -- contain no position.
	        #scanEndIndex := #scanIndex + 9;
	        IF #scanEndIndex > #LineCount - 1 THEN
	            #scanEndIndex := #LineCount - 1;
	        END_IF;
	        
	        FOR #scanIndex := #scanIndex TO #scanEndIndex DO
	            // Only check motion commands (G0=0, G1=1) for bounding box and limits
	            IF #Lines[#scanIndex].CMD <= 1 THEN
	                // Update bounding box
	                IF #Lines[#scanIndex].X < #MinX THEN
	                    #MinX := #Lines[#scanIndex].X;
	                END_IF;
	                IF #Lines[#scanIndex].X > #MaxX THEN
	                    #MaxX := #Lines[#scanIndex].X;
	                END_IF;
	                IF #Lines[#scanIndex].Z < #MinZ THEN
	                    #MinZ := #Lines[#scanIndex].Z;
	                END_IF;
	                IF #Lines[#scanIndex].Z > #MaxZ THEN
	                    #MaxZ := #Lines[#scanIndex].Z;
	                END_IF;
	                
	                // Check limits -- records which axis/direction was violated
	                IF #Lines[#scanIndex].X < "DB_MachineConfig".SoftLimit_MinX THEN
	                    IF #ErrorLine < 0 THEN
	                        #ErrorLine := #scanIndex;
	                        #ErrorDesc := CONCAT(IN1 := 'X below min (',
	                                             IN2 := CONCAT(IN1 := REAL_TO_STRING("DB_MachineConfig".SoftLimit_MinX),
	                                                           IN2 := ')'));
	                    END_IF;
	                    #Valid := FALSE;
	                ELSIF #Lines[#scanIndex].X > "DB_MachineConfig".SoftLimit_MaxX THEN
	                    IF #ErrorLine < 0 THEN
	                        #ErrorLine := #scanIndex;
	                        #ErrorDesc := CONCAT(IN1 := 'X above max (',
	                                             IN2 := CONCAT(IN1 := REAL_TO_STRING("DB_MachineConfig".SoftLimit_MaxX),
	                                                           IN2 := ')'));
	                    END_IF;
	                    #Valid := FALSE;
	                ELSIF #Lines[#scanIndex].Z < "DB_MachineConfig".SoftLimit_MinZ THEN
	                    IF #ErrorLine < 0 THEN
	                        #ErrorLine := #scanIndex;
	                        #ErrorDesc := CONCAT(IN1 := 'Z below min (',
	                                             IN2 := CONCAT(IN1 := REAL_TO_STRING("DB_MachineConfig".SoftLimit_MinZ),
	                                                           IN2 := ')'));
	                    END_IF;
	                    #Valid := FALSE;
	                ELSIF #Lines[#scanIndex].Z > "DB_MachineConfig".SoftLimit_MaxZ THEN
	                    IF #ErrorLine < 0 THEN
	                        #ErrorLine := #scanIndex;
	                        #ErrorDesc := CONCAT(IN1 := 'Z above max (',
	                                             IN2 := CONCAT(IN1 := REAL_TO_STRING("DB_MachineConfig".SoftLimit_MaxZ),
	                                                           IN2 := ')'));
	                    END_IF;
	                    #Valid := FALSE;
	                END_IF;
	            END_IF;
	            
	            // #4 -- Feedrate check: G1 F-value above MaxVelocity (mm/min â†’ mm/s for comparison)
	            IF #Lines[#scanIndex].CMD = 1 AND #Lines[#scanIndex].F > 0 THEN
	                IF INT_TO_REAL(#Lines[#scanIndex].F) / "DB_MachineConfig".FeedrateConvFactor > "DB_MachineConfig".MaxVelocity THEN
	                    IF #ErrorLine < 0 THEN
	                        #ErrorLine := #scanIndex;
	                        #ErrorDesc := CONCAT(IN1 := 'F exceeds MaxVelocity (',
	                                             IN2 := CONCAT(IN1 := REAL_TO_STRING("DB_MachineConfig".MaxVelocity * "DB_MachineConfig".FeedrateConvFactor),
	                                                           IN2 := ' mm/min)'));
	                    END_IF;
	                    #Valid := FALSE;
	                END_IF;
	            END_IF;
	            
	            // #4 -- Spindle speed check: CMD_SPINDLE_ON Param*10 RPM vs DB_Spindle.MaxSpeed
	            IF #Lines[#scanIndex].CMD = 20 THEN   // CMD_SPINDLE_ON
	                #spindleRPM := INT_TO_REAL(BYTE_TO_INT(#Lines[#scanIndex].Param)) * #SPINDLE_PARAM_TO_RPM;
	                IF #spindleRPM > "DB_Spindle".MaxSpeed THEN
	                    IF #ErrorLine < 0 THEN
	                        #ErrorLine := #scanIndex;
	                        #ErrorDesc := CONCAT(IN1 := 'Spindle RPM exceeds max (',
	                                             IN2 := CONCAT(IN1 := REAL_TO_STRING("DB_Spindle".MaxSpeed),
	                                                           IN2 := ' RPM)'));
	                    END_IF;
	                    #Valid := FALSE;
	                END_IF;
	            END_IF;
	            
	            // #5 -- Tool mapping check: CMD_TOOL_CHANGE Param must exist in ToolCode_List
	            // Skip if Bypass_ToolAxis=TRUE -- runtime also skips tool changes on bypass machines
	            IF #Lines[#scanIndex].CMD = 10 AND NOT "DB_MachineConfig".Bypass_ToolAxis THEN
	                #tmpToolCode := BYTE_TO_INT(#Lines[#scanIndex].Param);
	                #mapFound := FALSE;
	                FOR #mapIndex := 1 TO "DB_MachineConfig".ToolCount DO
	                    IF "DB_ToolConfig".ToolCode_List[#mapIndex] = #tmpToolCode THEN
	                        #mapFound := TRUE;
	                    END_IF;
	                END_FOR;
	                IF NOT #mapFound THEN
	                    IF #ErrorLine < 0 THEN
	                        #ErrorLine := #scanIndex;
	                        #ErrorDesc := CONCAT(IN1 := 'Tool code not mapped: T',
	                                             IN2 := INT_TO_STRING(#tmpToolCode));
	                    END_IF;
	                    #Valid := FALSE;
	                END_IF;
	            END_IF;
	            
	            
	        END_FOR;
	        
	        // #13 -- Progress: updated each batch so HMI shows scanning progress
	        IF #LineCount > 0 THEN
	            #Progress := INT_TO_REAL(#scanIndex) / INT_TO_REAL(#LineCount) * 100.0;
	        END_IF;
	        
	        // NOTE: FOR loop auto-increments #scanIndex, extra +1 removed
	        
	        IF #scanIndex >= #LineCount THEN
	            #state := 99;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_DONE (99) ===
	        // -----------------------------------------------------------------
	    99: // DONE
	        #Done := TRUE;
	        #Progress := 100.0;
	        IF NOT #Execute THEN
	            #Done := FALSE;  // Drop Done on the release scan so a stale TRUE
	            // cannot be misread as a fresh result by the caller
	            #state := 0;
	        END_IF;
	END_CASE;
	
END_FUNCTION_BLOCK

FUNCTION_BLOCK "FB_RecipeHandler"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
// -----------------------------------------------------------------------------
// FB_RecipeHandler - Execute recipe program line by line
// DOC:
//  purpose: Main recipe execution engine. Reads Lines[] and issues axis/spindle/tool requests.
//  inputs: Start/Stop/Pause/Reset control signals, LineCount
//  outputs: Busy/Done/Error, CurrentLine, Tool/Spindle requests, ActiveFeedrate, Progress
//  notes: No string parsing; recipe lines are pre-parsed into RecipeLine UDTs stored in DBs.
//         Designed to be deterministic and yield frequently to PLC scan cycle.
// -----------------------------------------------------------------------------
   VAR_INPUT 
      Start : Bool;   // Rising-edge or level to start/continue execution
      Stop : Bool;   // Stop execution (controlled stop)
      bStartEdge : Bool;   // Rising edge from Panel_Start_A AND Panel_Start_B (for sheet load confirm)
      Pause : Bool;   // Pause execution (retain position)
      Reset : Bool;   // Reset to beginning (clear internal state)
      StartLine : Int := 0;   // First line to execute on next run (0 = beginning; use savedLineIndex for warm restart)
      LineCount : Int;   // Total lines in program
   END_VAR

   VAR_OUTPUT 
      Busy : Bool;   // Execution in progress
      Done : Bool;   // Program complete
      Paused : Bool;   // Execution paused (SingleStep or Pause)
      Error : Bool;   // Error occurred
      ErrorID : Word;   // Error code (DB_ErrorCodes)
      CurrentLine : Int;   // Current line index being executed
      ToolChangeReq : Bool;   // Tool change requested by recipe
      ToolReqNumber : Int;   // Requested tool number (from recipe Param)
      SpindleReqStart : Bool;   // Spindle start request flag
      SpindleReqStop : Bool;   // Spindle stop request flag
      SpindleReqSpeed : Real;   // Spindle speed request (RPM)
      ActiveFeedrate : Real;   // Current feedrate (mm/min) for HMI display
      Progress : Real;   // Progress percentage 0-100
   END_VAR

   VAR_IN_OUT 
      Lines : Array[0..349] of "RecipeLine";   // Reference to recipe lines in DB
      Axis_X {InstructionName := 'TO_PositioningAxis'; LibVersion := '8.0'} : TO_PositioningAxis;   // Axis TO IN_OUT
      Axis_Z {InstructionName := 'TO_PositioningAxis'; LibVersion := '8.0'} : TO_PositioningAxis;
   END_VAR

   VAR 
      state : Int;   // Internal state machine
      lineIndex : Int;   // Current executing line index Current motion targets and feedback
      targX : Real;   // Target X for current line
      targZ : Real;   // Target Z for current line
      currX : Real;   // Current X tracked by handler
      currZ : Real;   // Current Z tracked by handler
      velX : Real;   // Velocity command for X (mm/s)
      velZ : Real;   // Velocity command for Z (mm/s) Temporary calculation variables
      deltaX : Real;
      deltaZ : Real;
      totalDist : Real;
      feedrate : Real;   // Calculated feedrate (mm/s) Tool mapping helpers
      tmpToolCode : Int;   // Raw tool code from recipe Param (e.g. 101)
      mapIndex : Int;   // Loop index for mapping lookup
      mapFound : Bool;   // TRUE if mapping found Move control flags
      bTrigMove : Bool;   // Trigger movement this cycle
      bMoveX : Bool;   // X axis needs to move
      bMoveZ : Bool;   // Z axis needs to move
      bHaltTrig : Bool;   // Trigger halt (Stop) BUG FIX: resume target after PAUSED. Pause from STATE_WAIT resumes via STATE_EXEC (recalculate move from actual position). Pause from the non-motion states (SPINDLE_WAIT/DWELL/SPINDLE_STOP_WAIT) must return to that same state -- resuming via STATE_EXEC executed a move to the non-motion line's X/Z placeholders (0,0) and drove both axes to home.
      pauseReturnState : Int := 20;   // 20 = STATE_EXEC (safe default) Pause-retract: interruption point captured on pause, returned to on resume.
      resumeX : Real;   // Interruption-point X (return target after retract)
      resumeZ : Real;   // Interruption-point Z Motion FB instances used by handler
      fbMoveX : "FB_Axis_AbsPos";
      fbMoveZ : "FB_Axis_AbsPos";
      fbHaltX : "FB_Axis_Halt";
      fbHaltZ : "FB_Axis_Halt";   // Timers for move timeout and dwell
      tonMoveTimeout {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;
      tonPauseMove {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;   // Timeout guard for pause retract/return moves
      tonDwell {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;   // Dwell timer for CMD_DWELL
      tonAtSpeed {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;   // Timeout timer for spindle at-speed wait (STATE_SPINDLE_WAIT)
      dwellTime : Time;   // Calculated dwell duration Edge detection for Start/StepNext
      prevStart : Bool;   // previous Start level
      rtStart : Bool;   // rising edge Start
      prevStepNext : Bool;   // previous StepNext level
      rtStepNext : Bool;   // rising edge StepNext Override temporary
      overridePercent : Real;   // Feedrate override percent (50..200)
   END_VAR

   VAR CONSTANT 
      STATE_IDLE : Int := 0;
      STATE_READ : Int := 10;
      STATE_EXEC : Int := 20;
      STATE_WAIT : Int := 30;
      STATE_TOOL_REQ : Int := 40;
      STATE_TOOL_WAIT : Int := 50;
      STATE_SPINDLE : Int := 55;   // Spindle command processing
      STATE_SPINDLE_WAIT : Int := 56;   // Wait for spindle AtSpeed after start command
      STATE_DWELL : Int := 57;   // Dwell/wait timer
      STATE_SPINDLE_STOP_WAIT : Int := 58;   // Wait for spindle to fully stop before proceeding
      STATE_NEXT : Int := 60;
      STATE_STEP_WAIT : Int := 65;   // Wait for StepNext in SingleStepMode
      STATE_CYL_GOTO : Int := 70;   // CMD=40: set BackSupport TargetPos and trigger extend
      STATE_CYL_GOTO_WAIT : Int := 71;   // CMD=40: wait for BackSupport AtSetpoint or error
      STATE_DONE : Int := 99;
      STATE_PAUSED : Int := 800;   // Pause entry: halt axes, then retract
      STATE_PAUSE_RETRACT : Int := 801;   // Moving to retracted (tool-clear) position
      STATE_PAUSE_HOLD : Int := 802;   // Held at retracted position, waiting for Continue
      STATE_PAUSE_RETURN : Int := 803;   // Moving back to interruption point before resume
      STATE_STOPPING : Int := 850;   // Halt triggered, waiting for axes to stop
      STATE_ERROR : Int := 999;
      CMD_RAPID : Byte := 0;
      CMD_LINEAR : Byte := 1;
      CMD_TOOL_CHANGE : Byte := 10;
      CMD_SPINDLE_ON : Byte := 20;
      CMD_SPINDLE_OFF : Byte := 21;
      CMD_DWELL : Byte := 30;
      CMD_CYLINDER_GOTO : Byte := 40;   // BackSupport full extend (PositioningMode=0 on this machine; Param ignored)
      CMD_ATMO : Byte := 41;   // BackSupport atmosphere: Param=1 â†’ Sol_B+SolAtmo ON; Param=2 â†’ SolAtmo OFF
      CMD_END : Byte := 99;   // Recipe format: RecipeLine.Param encodes spindle speed as RPM Ã· 10. Range: 0â€“255 byte â†’ 0â€“2550 RPM. Clamp to DB_Spindle.MaxSpeed at runtime. See PLC_Recipe_Format_Spec.md CMD_SPINDLE_ON.
      SPINDLE_PARAM_TO_RPM : Real := 10.0;
   END_VAR


BEGIN
	
	// =========================================================================
	// FB_RecipeHandler -- Execution logic summary
	// =========================================================================
	// Called every PLC scan cycle.
	// State machine:
	//   IDLE(0) â†’ READ(10) â†’ EXEC(20) â†’ WAIT(30) â†’ NEXT(60) â†’ READ(10) â†’ ...
	//   Special branches: TOOL_REQ(40)â†’TOOL_WAIT(50), SPINDLE(55), DWELL(57),
	//                     STEP_WAIT(65), PAUSED(800), STOPPING(850), DONE(99), ERROR(999)
	// All axis moves are performed via fbMoveX / fbMoveZ.
	// Spindle and tool change requests are passed to FB_Process via flags (no direct drive access).
	// =========================================================================
	
	// Rising edge detection -- Start button
	#rtStart := #Start AND NOT #prevStart;
	#prevStart := #Start;
	
	// NOTE: prevStart is cleared on Reset -- consecutive starts are reliably detected.
	
	// SingleStep edge detection
	#rtStepNext := "DB_HMI".StepNext AND NOT #prevStepNext;
	#prevStepNext := "DB_HMI".StepNext;
	
	// -------------------------------------------------------------------------
	// RESET -- Rewind program to beginning, clear all flags
	// Can be applied while running; caller must stop axes first.
	// -------------------------------------------------------------------------
	IF #Reset THEN
	    #lineIndex := #StartLine;   // 0 = normal start; >0 = warm restart from saved line
	    #state := #STATE_IDLE;
	    #Error := FALSE;
	    #ErrorID := 0;
	    #Busy := FALSE;
	    #Done := FALSE;
	    #Paused := FALSE;
	    #ToolChangeReq := FALSE;
	    // BUG FIX: Clear internal flags so rising-edge detection works on next Start
	    #prevStart := FALSE;
	    #bTrigMove := FALSE;
	    #bMoveX := FALSE;
	    #bMoveZ := FALSE;
	    #bHaltTrig := FALSE;
	    #pauseReturnState := #STATE_EXEC;  // Clear stale resume target from a previous pause
	    #SpindleReqStart := FALSE;
	    #SpindleReqStop := FALSE;
	    // Reset timers -- no stale ET remains on next run
	    #tonMoveTimeout(IN := FALSE,
	                    PT := "DB_MachineConfig".Timeout_Motion);
	    #tonPauseMove(IN := FALSE,
	                  PT := "DB_MachineConfig".Timeout_Motion);
	    #tonDwell(IN := FALSE,
	              PT := T#0S);
	    // Clear CMD=40/41 BackSupport overrides so next run starts clean
	    "DB_Cylinder_BackSupport".Cmd_Extend := FALSE;
	    "DB_Cylinder_BackSupport".SolB_Cmd41 := FALSE;
	    "DB_Cylinder_BackSupport".SolAtmo_Cmd := FALSE;
	END_IF;
	
	// -------------------------------------------------------------------------
	// STOP -- Controlled, error-free stop sequence
	// Halt triggered â†’ waits in STATE_STOPPING until both axes fully stop
	// â†’ STATE_DONE. Error/ErrorID untouched (operator stop is not an error).
	// -------------------------------------------------------------------------
	IF #Stop AND #state <> #STATE_IDLE AND #state <> #STATE_ERROR
	    AND #state <> #STATE_STOPPING AND #state <> #STATE_DONE THEN
	    // User Stop = controlled, error-free stop
	    // Safely interrupt moves using FB_Axis_Halt.
	    // Waits in STATE_STOPPING until halt completes, then STATE_DONE.
	    #bHaltTrig := TRUE;
	    // Drop any active move trigger so the pending halt has sole control of the axes.
	    // Required because the pause-retract states (801/803) leave bTrigMove TRUE;
	    // without this, MC_MoveAbsolute and MC_Halt would fight on the same axis.
	    #bTrigMove := FALSE;
	    #Paused := FALSE;
	    // Clear BackSupport Cmd_Extend -- if stop fires during CMD=40 (STATE_CYL_GOTO_WAIT),
	    // without this the cylinder keeps extending through the entire stop/home sequence.
	    "DB_Cylinder_BackSupport".Cmd_Extend := FALSE;
	    #state := #STATE_STOPPING;
	END_IF;
	
	// Move timeout timer -- only counts during STATE_WAIT (30 seconds)
	// If axis does not return Done within 30s, error 16#0008 (Motion Timeout) is generated.
	#tonMoveTimeout(IN := #state = #STATE_WAIT,
	                PT := "DB_MachineConfig".Timeout_Motion);
	
	// Pause retract/return move timeout -- counts only while a pause move is in progress.
	// Guards against a stuck axis hanging the machine in the retract or return phase.
	#tonPauseMove(IN := (#state = #STATE_PAUSE_RETRACT OR #state = #STATE_PAUSE_RETURN),
	              PT := "DB_MachineConfig".Timeout_Motion);
	
	// State machine
	CASE #state OF
	        
	        // -----------------------------------------------------------------
	        // === STATE_IDLE (0) ===
	        // -----------------------------------------------------------------
	    0: // IDLE
	        #Busy := FALSE;
	        #Done := FALSE;
	        #Paused := FALSE;
	        #bTrigMove := FALSE;
	        #bHaltTrig := FALSE;
	        
	        IF #rtStart AND #LineCount > 0 THEN
	            #lineIndex := #StartLine;   // 0 = normal start; >0 = warm restart
	            #currX := #Axis_X.ActualPosition;
	            #currZ := #Axis_Z.ActualPosition;
	            #Busy := TRUE;
	            #state := #STATE_READ;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_READ (10) ===
	        // -----------------------------------------------------------------
	    10: // READ - Read current line
	        IF #lineIndex >= #LineCount THEN
	            #state := #STATE_DONE;
	        ELSE
	            // Read line data
	            #targX := #Lines[#lineIndex].X;
	            #targZ := #Lines[#lineIndex].Z;
	            
	            // Check command type
	            CASE #Lines[#lineIndex].CMD OF
	                #CMD_END:
	                    #state := #STATE_DONE;
	                    
	                #CMD_TOOL_CHANGE:
	                    // Read raw tool code (supports post-processed codes like 101)
	                    #tmpToolCode := BYTE_TO_INT(#Lines[#lineIndex].Param);
	                    #mapFound := FALSE;
	                    // Try explicit mapping in DB_ToolConfig.ToolCode_List
	                    FOR #mapIndex := 1 TO "DB_MachineConfig".ToolCount DO
	                        IF "DB_ToolConfig".ToolCode_List[#mapIndex] = #tmpToolCode THEN
	                            #ToolReqNumber := #mapIndex;
	                            #mapFound := TRUE;
	                        END_IF;
	                    END_FOR;
	                    // If mapping not found -> report recipe tool number error (operator must map codes via HMI)
	                    IF NOT #mapFound THEN
	                        #ErrorID := 16#0308; // Recipe: Invalid tool number
	                        "DB_Diagnostic".Error_Text := CONCAT(IN1 := 'Tool code ', IN2 := INT_TO_STRING(#tmpToolCode));
	                        "DB_Diagnostic".Error_Line := #lineIndex;
	                        "DB_Diagnostic".Error_Code := #ErrorID;
	                        // Single-writer: ErrorText comes from FB_AlarmManager (FB_Process forwards
	                        // #ErrorID from STATE_RUNNING). The missing code number goes into ErrorDetail.
	                        "DB_HMI".ErrorDetail := CONCAT(IN1 := 'Tool code ', IN2 := CONCAT(
	                                                                                                                         IN1 := INT_TO_STRING(#tmpToolCode),
	                                                                                                                         IN2 := ' not mapped. Open Tool Setup, enter slot code & Apply.'));
	                        "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'Codigo herramienta ', IN2 := CONCAT(
	                                                                                                                                        IN1 := INT_TO_STRING(#tmpToolCode),
	                                                                                                                                        IN2 := ' sin asignar. Ir a Config. Herramienta y Aplicar.'));
	                        #state := #STATE_ERROR;
	                    ELSE
	                        // Mapping found -> request tool change for mapped slot
	                        #state := #STATE_TOOL_REQ;
	                    END_IF;
	                    
	                #CMD_SPINDLE_ON, #CMD_SPINDLE_OFF:
	                    IF "DB_HMI".Bypass_Spindle THEN
	                        #state := #STATE_NEXT;
	                    ELSE
	                        #state := #STATE_SPINDLE;
	                    END_IF;
	                    
	                #CMD_DWELL:
	                    // Dwell = wait for Param * 100ms
	                    #dwellTime := INT_TO_TIME(BYTE_TO_INT(#Lines[#lineIndex].Param) * 100);
	                    #tonDwell(IN := FALSE,
	                              PT := #dwellTime); // Reset timer
	                    #state := #STATE_DWELL;
	                    
	                #CMD_CYLINDER_GOTO:
	                    // BackSupport full extend -- waits AtSetpoint (Mode=0: after Timeout_Extend)
	                    #state := #STATE_CYL_GOTO;
	                    
	                #CMD_ATMO:
	                    // BackSupport atmosphere control â€” fire-and-go (no axis wait)
	                    IF #Lines[#lineIndex].Param = 1 THEN
	                        "DB_Cylinder_BackSupport".SolB_Cmd41 := TRUE;   // hold Sol_B ON independently
	                        "DB_Cylinder_BackSupport".SolAtmo_Cmd := TRUE;   // energise atmosphere valve
	                    ELSIF #Lines[#lineIndex].Param = 2 THEN
	                        "DB_Cylinder_BackSupport".SolAtmo_Cmd := FALSE;  // de-energise atmosphere valve
	                        // SolB_Cmd41 stays TRUE â€” Sol_B remains energised
	                    END_IF;
	                    #state := #STATE_NEXT;
	                    
	                #CMD_RAPID, #CMD_LINEAR:
	                    #state := #STATE_EXEC;
	                    
	                ELSE
	                    // Unknown command - skip
	                    #state := #STATE_NEXT;
	            END_CASE;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_EXEC (20) ===
	        // -----------------------------------------------------------------
	    20: // EXEC -- Calculate motion parameters and start move
	        // Linear interpolation: both axes start and finish simultaneously.
	        // velX/velZ split proportionally over total distance.
	        // This ensures X and Z reach target in the same time (true linear path).
	        #deltaX := ABS(#targX - #currX);
	        #deltaZ := ABS(#targZ - #currZ);
	        #totalDist := SQRT(#deltaX * #deltaX + #deltaZ * #deltaZ);
	        
	        // Determine which axes need to move
	        #bMoveX := #deltaX > 0.01;  // 0.01mm threshold
	        #bMoveZ := #deltaZ > 0.01;
	        
	        // Calculate velocity
	        IF #Lines[#lineIndex].CMD = #CMD_RAPID OR #Lines[#lineIndex].F = 0 THEN
	            // Rapid move - use max velocity with RapidOverride
	            #feedrate := "DB_MachineConfig".RapidVelocity;
	            #overridePercent := "DB_HMI".RapidOverride;
	        ELSE
	            // Linear move - convert mm/min to mm/s with FeedrateOverride
	            #feedrate := INT_TO_REAL(#Lines[#lineIndex].F) / "DB_MachineConfig".FeedrateConvFactor;
	            #overridePercent := "DB_HMI".FeedrateOverride;
	        END_IF;
	        
	        // Apply override (clamp to 50-200%)
	        IF #overridePercent < 50.0 THEN
	            #overridePercent := 50.0;
	        END_IF;
	        IF #overridePercent > 200.0 THEN
	            #overridePercent := 200.0;
	        END_IF;
	        #feedrate := #feedrate * (#overridePercent / 100.0);
	        
	        // Clamp velocity to limits
	        IF #feedrate > "DB_MachineConfig".MaxVelocity THEN
	            #feedrate := "DB_MachineConfig".MaxVelocity;
	        ELSIF #feedrate < "DB_MachineConfig".MinVelocity THEN
	            #feedrate := "DB_MachineConfig".MinVelocity;
	        END_IF;
	        
	        // Calculate axis velocities for linear interpolation
	        IF #totalDist > 0.01 THEN
	            #velX := #feedrate * #deltaX / #totalDist;
	            #velZ := #feedrate * #deltaZ / #totalDist;
	        ELSE
	            #velX := #feedrate;
	            #velZ := #feedrate;
	        END_IF;
	        
	        // Ensure minimum velocity
	        IF #bMoveX AND #velX < "DB_MachineConfig".MinVelocity THEN
	            #velX := "DB_MachineConfig".MinVelocity;
	        END_IF;
	        IF #bMoveZ AND #velZ < "DB_MachineConfig".MinVelocity THEN
	            #velZ := "DB_MachineConfig".MinVelocity;
	        END_IF;
	        
	        // Skip if no movement needed
	        IF NOT #bMoveX AND NOT #bMoveZ THEN
	            #state := #STATE_NEXT;
	        ELSE
	            // Trigger movement
	            #bTrigMove := TRUE;
	            #tonMoveTimeout(IN := FALSE,
	                            PT := "DB_MachineConfig".Timeout_Motion);
	            #state := #STATE_WAIT;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_WAIT (30) ===
	        // -----------------------------------------------------------------
	    30: // WAIT - Wait for motion complete
	        #bTrigMove := FALSE;
	        
	        // Pause handling
	        IF #Pause THEN
	            #bHaltTrig := TRUE;
	            #pauseReturnState := #STATE_EXEC;  // motion pause: recalc move from actual position
	            #state := #STATE_PAUSED;
	        ELSE
	            // Check completion based on which axes are moving
	            IF (#bMoveX AND #bMoveZ) THEN
	                IF #fbMoveX.Done AND #fbMoveZ.Done THEN
	                    #currX := #targX;
	                    #currZ := #targZ;
	                    #state := #STATE_NEXT;
	                END_IF;
	            ELSIF #bMoveX THEN
	                IF #fbMoveX.Done THEN
	                    #currX := #targX;
	                    #state := #STATE_NEXT;
	                END_IF;
	            ELSIF #bMoveZ THEN
	                IF #fbMoveZ.Done THEN
	                    #currZ := #targZ;
	                    #state := #STATE_NEXT;
	                END_IF;
	            ELSE
	                #state := #STATE_NEXT;
	            END_IF;
	            
	            // Error check -- TO/drive error or mechanical blockage
	            // TO ErrorID: Siemens TO diagnostics code -- converted to readable text via FC_TO_ErrorText.
	            // DB_Diagnostic.MoveX/Z_ErrorID: readable directly on HMI diagnostic page.
	            IF (#bMoveX AND #fbMoveX.Error) OR (#bMoveZ AND #fbMoveZ.Error) THEN
	                IF #bMoveX AND #fbMoveX.Error THEN
	                    #ErrorID := 16#0001;
	                    "DB_Diagnostic".MoveX_ErrorID := #fbMoveX.ErrorID;
	                    "DB_Diagnostic".TO_ErrorText := "FC_TO_ErrorText"(Code := #fbMoveX.ErrorID);
	                    "DB_Diagnostic".Error_Text := CONCAT(IN1 := 'X Move Failed: ', IN2 := "DB_Diagnostic".TO_ErrorText);
	                    // Single-writer: ErrorText from FB_AlarmManager (FB_Process forwards #ErrorID)
	                    "DB_HMI".ErrorDetail := CONCAT(IN1 := 'Ln:', IN2 := CONCAT(
	                                                                                                              IN1 := INT_TO_STRING(#lineIndex), IN2 := CONCAT(
	                                                                                                                                                              IN1 := ' TO:', IN2 := "DB_Diagnostic".TO_ErrorText)));
	                    "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'Ln:', IN2 := CONCAT(
	                                                                                                                    IN1 := INT_TO_STRING(#lineIndex), IN2 := CONCAT(
	                                                                                                                                                                    IN1 := ' TO:', IN2 := "DB_Diagnostic".TO_ErrorText)));
	                ELSE
	                    #ErrorID := 16#0002;
	                    "DB_Diagnostic".MoveZ_ErrorID := #fbMoveZ.ErrorID;
	                    "DB_Diagnostic".TO_ErrorText := "FC_TO_ErrorText"(Code := #fbMoveZ.ErrorID);
	                    "DB_Diagnostic".Error_Text := CONCAT(IN1 := 'Z Move Failed: ', IN2 := "DB_Diagnostic".TO_ErrorText);
	                    // Single-writer: ErrorText from FB_AlarmManager (FB_Process forwards #ErrorID)
	                    "DB_HMI".ErrorDetail := CONCAT(IN1 := 'Ln:', IN2 := CONCAT(
	                                                                                                              IN1 := INT_TO_STRING(#lineIndex), IN2 := CONCAT(
	                                                                                                                                                              IN1 := ' TO:', IN2 := "DB_Diagnostic".TO_ErrorText)));
	                    "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'Ln:', IN2 := CONCAT(
	                                                                                                                    IN1 := INT_TO_STRING(#lineIndex), IN2 := CONCAT(
	                                                                                                                                                                    IN1 := ' TO:', IN2 := "DB_Diagnostic".TO_ErrorText)));
	                END_IF;
	                "DB_Diagnostic".Error_Line := #lineIndex;
	                "DB_Diagnostic".Error_Code := #ErrorID;
	                #state := #STATE_ERROR;
	            ELSIF #tonMoveTimeout.Q THEN
	                // Axis did not return Done within 30s -- mechanical blockage, drive fault or TO issue
	                #ErrorID := 16#0008;
	                "DB_Diagnostic".Error_Line := #lineIndex;
	                "DB_Diagnostic".Error_Code := #ErrorID;
	                // Determine which axis is stuck (based on bMoveX/Z state).
	                // Single-writer: ErrorText from FB_AlarmManager; axis goes into ErrorDetail.
	                IF #bMoveX AND #bMoveZ THEN
	                    "DB_Diagnostic".Error_Text := 'Motion Timeout: X+Z axes';
	                    "DB_HMI".ErrorDetail := CONCAT(IN1 := 'X+Z Ln:', IN2 := CONCAT(
	                                                                                                                  IN1 := INT_TO_STRING(#lineIndex), IN2 := ' (30s limit)'));
	                    "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'X+Z Ln:', IN2 := CONCAT(
	                                                                                                                        IN1 := INT_TO_STRING(#lineIndex), IN2 := ' (limite 30s)'));
	                ELSIF #bMoveX THEN
	                    "DB_Diagnostic".Error_Text := 'Motion Timeout: X axis';
	                    "DB_HMI".ErrorDetail := CONCAT(IN1 := 'X axis Ln:', IN2 := CONCAT(
	                                                                                                                     IN1 := INT_TO_STRING(#lineIndex), IN2 := ' (30s limit)'));
	                    "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'Eje X Ln:', IN2 := CONCAT(
	                                                                                                                          IN1 := INT_TO_STRING(#lineIndex), IN2 := ' (limite 30s)'));
	                ELSE
	                    "DB_Diagnostic".Error_Text := 'Motion Timeout: Z axis';
	                    "DB_HMI".ErrorDetail := CONCAT(IN1 := 'Z axis Ln:', IN2 := CONCAT(
	                                                                                                                     IN1 := INT_TO_STRING(#lineIndex), IN2 := ' (30s limit)'));
	                    "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'Eje Z Ln:', IN2 := CONCAT(
	                                                                                                                          IN1 := INT_TO_STRING(#lineIndex), IN2 := ' (limite 30s)'));
	                END_IF;
	                #state := #STATE_ERROR;
	            END_IF;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_TOOL_REQ (40) ===
	        // -----------------------------------------------------------------
	    40: // TOOL_REQ
	        #ToolChangeReq := TRUE;
	        #state := #STATE_TOOL_WAIT;
	        
	        // -----------------------------------------------------------------
	        // === STATE_TOOL_WAIT (50) ===
	        // -----------------------------------------------------------------
	    50: // TOOL_WAIT
	        // Wait for external tool change completion from FB_Process
	        // FB_Process sets ToolChangeReq := FALSE when done
	        // BUG FIX: also wait for Start (bStartSeq) to be TRUE before advancing.
	        // Without this, the recipe races ahead through READâ†’SPINDLE while the machine
	        // is still in STATE_LOCK_EXTEND_WAIT (17) where bStartSeq=FALSE.
	        // The spindle-start latch is only checked in CASE 20 (RUNNING), so any
	        // SpindleReqStart pulse that fires in state 17 is silently missed.
	        IF NOT #ToolChangeReq AND #Start THEN
	            #state := #STATE_NEXT;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_SPINDLE (55) ===
	        // -----------------------------------------------------------------
	    55: // SPINDLE -- Forward spindle command to FB_Process (via flag)
	        IF #Lines[#lineIndex].CMD = #CMD_SPINDLE_ON THEN
	            #SpindleReqStart := TRUE;
	            #SpindleReqStop := FALSE;
	            #SpindleReqSpeed := INT_TO_REAL(BYTE_TO_INT(#Lines[#lineIndex].Param)) * #SPINDLE_PARAM_TO_RPM;
	            #tonAtSpeed(IN := FALSE,
	                        PT := "DB_MachineConfig".Timeout_SpindleAtSpeed);  // reset timer before waiting
	            #state := #STATE_SPINDLE_WAIT;           // wait for AtSpeed before next motion
	        ELSE
	            #SpindleReqStart := FALSE;
	            #SpindleReqStop := TRUE;
	            #SpindleReqSpeed := 0.0;
	            #tonAtSpeed(IN := FALSE,
	                        PT := "DB_MachineConfig".Timeout_SpindleStop);  // reset timer for stop wait
	            #state := #STATE_SPINDLE_STOP_WAIT;      // wait for full stop before tool change / next motion
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_SPINDLE_WAIT (56) ===
	        // -----------------------------------------------------------------
	    56: // SPINDLE_WAIT -- Wait for spindle to reach commanded speed (AtSpeed)
	        // DB_Spindle.AtSpeed = TRUE when actual speed is within SpeedTolerance % of commanded.
	        // Timeout 10s: error 16#030A. Adjust DB_Spindle.SpeedTolerance if triggering too early.
	        // BUG FIX: Clear SpindleReqStart here (one scan after state 55 set it) so it is a
	        // true one-shot flag. Without this, FB_Process re-sets bSpindleStart=TRUE every scan
	        // because SpindleReqStart was never cleared, preventing FB_SpindleControl from ever
	        // seeing a FALSE on its Start input and therefore never generating a rising startEdge.
	        #SpindleReqStart := FALSE;
	        #tonAtSpeed(IN := TRUE,
	                    PT := "DB_MachineConfig".Timeout_SpindleAtSpeed);
	        IF "DB_Spindle".AtSpeed OR "DB_Spindle".Bypass_AtSpeed THEN
	            #tonAtSpeed(IN := FALSE,
	                        PT := "DB_MachineConfig".Timeout_SpindleAtSpeed);  // reset for next use
	            #state := #STATE_NEXT;
	        ELSIF #tonAtSpeed.Q THEN
	            #tonAtSpeed(IN := FALSE,
	                        PT := "DB_MachineConfig".Timeout_SpindleAtSpeed);  // reset
	            #ErrorID := 16#030A;
	            "DB_Diagnostic".Error_Text := 'Spindle did not reach target speed (timeout)';
	            "DB_Diagnostic".Error_Line := #lineIndex;
	            "DB_Diagnostic".Error_Code := #ErrorID;
	            // Single-writer: ErrorText from FB_AlarmManager (FB_Process forwards #ErrorID)
	            "DB_HMI".ErrorDetail := CONCAT(IN1 := 'Ln:', IN2 := CONCAT(
	                                                                                                      IN1 := INT_TO_STRING(#lineIndex), IN2 := ' (10s limit)'));
	            "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'Ln:', IN2 := CONCAT(
	                                                                                                            IN1 := INT_TO_STRING(#lineIndex), IN2 := ' (limite 10s)'));
	            #state := #STATE_ERROR;
	        ELSIF #Pause THEN
	            #tonAtSpeed(IN := FALSE,
	                        PT := "DB_MachineConfig".Timeout_SpindleAtSpeed);
	            #bHaltTrig := TRUE;
	            #pauseReturnState := #STATE_SPINDLE_WAIT;  // resume re-waits AtSpeed, NOT a move
	            #state := #STATE_PAUSED;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_DWELL (57) ===
	        // -----------------------------------------------------------------
	    57: // DWELL -- Wait Param*100ms (equivalent to G4 command)
	        // Example: Param=10 â†’ 1000ms (1 second) wait.
	        // No axis movement during dwell; spindle continues running.
	        IF #Pause THEN
	            // Pause pressed -- stop timer and go to PAUSED state
	            #tonDwell(IN := FALSE,
	                      PT := #dwellTime);
	            #bHaltTrig := TRUE;
	            #pauseReturnState := #STATE_DWELL;  // resume restarts the full dwell, NOT a move
	            #state := #STATE_PAUSED;
	        ELSE
	            #tonDwell(IN := TRUE,
	                      PT := #dwellTime);
	            IF #tonDwell.Q THEN
	                #tonDwell(IN := FALSE,
	                          PT := #dwellTime); // Reset timer
	                #state := #STATE_NEXT;
	            END_IF;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_SPINDLE_STOP_WAIT (58) ===
	        // -----------------------------------------------------------------
	    58: // SPINDLE_STOP_WAIT -- Wait for spindle to fully stop before continuing.
	        // Prevents a tool change (or next motion line) while spindle is still coasting.
	        // DB_Spindle.IsRunning goes FALSE when FB_SpindleControl reaches idle state.
	        // Timeout 15s â†’ error 16#030B.
	        // BUG FIX: Clear SpindleReqStop here (one scan after state 55 set it) so it is a
	        // true one-shot flag. Mirrors the SpindleReqStart fix in state 56.
	        #SpindleReqStop := FALSE;
	        #tonAtSpeed(IN := TRUE,
	                    PT := "DB_MachineConfig".Timeout_SpindleStop);
	        IF NOT "DB_Spindle".IsRunning THEN
	            #tonAtSpeed(IN := FALSE,
	                        PT := "DB_MachineConfig".Timeout_SpindleStop);
	            #state := #STATE_NEXT;
	        ELSIF #tonAtSpeed.Q THEN
	            #tonAtSpeed(IN := FALSE,
	                        PT := "DB_MachineConfig".Timeout_SpindleStop);
	            #ErrorID := 16#030B;
	            "DB_Diagnostic".Error_Text := 'Spindle did not stop (timeout)';
	            "DB_Diagnostic".Error_Line := #lineIndex;
	            "DB_Diagnostic".Error_Code := #ErrorID;
	            // Single-writer: ErrorText from FB_AlarmManager (FB_Process forwards #ErrorID)
	            "DB_HMI".ErrorDetail := CONCAT(IN1 := 'Ln:', IN2 := CONCAT(
	                                                                                                      IN1 := INT_TO_STRING(#lineIndex), IN2 := ' (15s limit)'));
	            "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'Ln:', IN2 := CONCAT(
	                                                                                                            IN1 := INT_TO_STRING(#lineIndex), IN2 := ' (limite 15s)'));
	            #state := #STATE_ERROR;
	        ELSIF #Pause THEN
	            #tonAtSpeed(IN := FALSE,
	                        PT := "DB_MachineConfig".Timeout_SpindleStop);
	            #bHaltTrig := TRUE;
	            #pauseReturnState := #STATE_SPINDLE_STOP_WAIT;  // resume re-waits spindle stop, NOT a move
	            #state := #STATE_PAUSED;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_CYL_GOTO (70) ===
	        // CMD=40: Trigger BackSupport full extension (PositioningMode=0, no ruler).
	        // AtSetpoint fires after Timeout_Extend. Param value is ignored.
	        // -----------------------------------------------------------------
	    70: // STATE_CYL_GOTO
	        "DB_Cylinder_BackSupport".Cmd_Extend := TRUE;
	        #state := #STATE_CYL_GOTO_WAIT;
	        
	        // -----------------------------------------------------------------
	        // === STATE_CYL_GOTO_WAIT (71) ===
	        // CMD=40: Wait for BackSupport AtSetpoint (Mode=0: after Timeout_Extend elapses).
	        // Cmd_Extend re-written every scan to hold the extend command.
	        // On done: clear Cmd_Extend (5/3 blocked-center valve holds mechanically).
	        // On error: report and go to STATE_ERROR.
	        // -----------------------------------------------------------------
	    71: // STATE_CYL_GOTO_WAIT
	        "DB_Cylinder_BackSupport".Cmd_Extend := TRUE;
	        IF #Pause THEN
	            // ITEM-39: Pause during BackSupport extension. Clear Cmd_Extend --
	            // the 5/3 blocked-centre valve holds position mechanically.
	            // Resume re-enters STATE_CYL_GOTO and re-triggers Cmd_Extend.
	            "DB_Cylinder_BackSupport".Cmd_Extend := FALSE;
	            #bHaltTrig := TRUE;
	            #pauseReturnState := #STATE_CYL_GOTO;
	            #state := #STATE_PAUSED;
	        ELSIF "DB_Cylinder_BackSupport".AtSetpoint THEN
	            "DB_Cylinder_BackSupport".Cmd_Extend := FALSE;  // 5/3 blocked-center holds position
	            #state := #STATE_NEXT;
	        ELSIF "DB_Cylinder_BackSupport".Error THEN
	            "DB_Cylinder_BackSupport".Cmd_Extend := FALSE;
	            #ErrorID := 16#0309;
	            "DB_Diagnostic".Error_Text := CONCAT(IN1 := 'CMD40 BackSupport cyl error, Param=',
	                                                 IN2 := INT_TO_STRING(BYTE_TO_INT(#Lines[#lineIndex].Param)));
	            "DB_Diagnostic".Error_Line := #lineIndex;
	            "DB_Diagnostic".Error_Code := #ErrorID;
	            // Single-writer: ErrorText from FB_AlarmManager (FB_Process forwards #ErrorID)
	            "DB_HMI".ErrorDetail := CONCAT(IN1 := 'Ln:', IN2 := CONCAT(
	                                                                                                      IN1 := INT_TO_STRING(#lineIndex), IN2 := ' target not reached'));
	            "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'Ln:', IN2 := CONCAT(
	                                                                                                            IN1 := INT_TO_STRING(#lineIndex), IN2 := ' objetivo no alcanzado'));
	            #state := #STATE_ERROR;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_NEXT (60) ===
	        // -----------------------------------------------------------------
	    60: // NEXT
	        #lineIndex := #lineIndex + 1;
	        // SingleStepMode: wait for user to press StepNext before continuing
	        IF "DB_HMI".SingleStepMode THEN
	            #state := #STATE_STEP_WAIT;
	        ELSE
	            #state := #STATE_READ;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_STEP_WAIT (65) ===
	        // -----------------------------------------------------------------
	    65: // STEP_WAIT - Wait for StepNext pulse in SingleStep mode
	        #Paused := TRUE;  // Show as paused in HMI
	        IF #rtStepNext THEN
	            // User pressed StepNext, continue to next line
	            #Paused := FALSE;
	            #state := #STATE_READ;
	        ELSIF NOT "DB_HMI".SingleStepMode THEN
	            // SingleStepMode turned off, continue normally
	            #Paused := FALSE;
	            #prevStepNext := FALSE;  // Clear stale edge -- prevents false trigger when mode re-enabled
	            #state := #STATE_READ;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_DONE (99) ===
	        // -----------------------------------------------------------------
	    99: // DONE
	        #Busy := FALSE;
	        #Done := TRUE;
	        #ToolChangeReq := FALSE;
	        
	        // -----------------------------------------------------------------
	        // === STATE_PAUSED (800) ===
	        // -----------------------------------------------------------------
	        // Pause sequence (return-before-resume): 800 halt/capture -> 801 retract ->
	        // 802 hold -> 803 return -> pauseReturnState. Spindle keeps running throughout.
	        // See docs/Pause_Retract_Plan.md. Offset/velocity from DB_MachineConfig.
	        // -----------------------------------------------------------------
	    800: // PAUSED -- fully stop axes, capture interruption point, then retract
	        #Paused := TRUE;
	        IF NOT (#fbHaltX.Done OR NOT #bMoveX) OR NOT (#fbHaltZ.Done OR NOT #bMoveZ) THEN
	            // Axes not yet stopped -- hold halt command
	            #bHaltTrig := TRUE;
	        ELSE
	            // Axes stopped -- release halt, capture return point, arm retract move.
	            #bHaltTrig := FALSE;
	            #resumeX := #Axis_X.ActualPosition;   // exact interruption point
	            #resumeZ := #Axis_Z.ActualPosition;
	            // Retract targets = interruption point + operator offset, clamped to soft limits
	            // so a pause near home cannot drive an axis past its limit and fault.
	            #targX := LIMIT(MN := "DB_MachineConfig".SoftLimit_MinX,
	                            IN := #resumeX + "DB_MachineConfig".PauseRetract_X,
	                            MX := "DB_MachineConfig".SoftLimit_MaxX);
	            #targZ := LIMIT(MN := "DB_MachineConfig".SoftLimit_MinZ,
	                            IN := #resumeZ + "DB_MachineConfig".PauseRetract_Z,
	                            MX := "DB_MachineConfig".SoftLimit_MaxZ);
	            #velX := "DB_MachineConfig".PauseRetract_Vel;
	            #velZ := "DB_MachineConfig".PauseRetract_Vel;
	            #bMoveX := ABS(#targX - #resumeX) > 0.01;   // skip axis if no net offset
	            #bMoveZ := ABS(#targZ - #resumeZ) > 0.01;
	            #bTrigMove := FALSE;   // ensure clean FALSE->TRUE edge for fbMove next scan
	            #tonPauseMove(IN := FALSE,
	                          PT := "DB_MachineConfig".Timeout_Motion);
	            #state := #STATE_PAUSE_RETRACT;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_PAUSE_RETRACT (801) ===
	        // -----------------------------------------------------------------
	    801: // Move to retracted (tool-clear) position. bHaltTrig stays FALSE (no conflict).
	        #Paused := TRUE;
	        #bTrigMove := TRUE;   // FALSE->TRUE rising edge triggers fbMoveX/fbMoveZ
	        IF (#bMoveX AND #fbMoveX.Error) OR (#bMoveZ AND #fbMoveZ.Error) THEN
	            "DB_Diagnostic".Error_Line := #lineIndex;
	            IF #bMoveX AND #fbMoveX.Error THEN
	                #ErrorID := 16#0001;
	            ELSE
	                #ErrorID := 16#0002;
	            END_IF;
	            "DB_Diagnostic".Error_Code := #ErrorID;
	            "DB_Diagnostic".Error_Text := 'Pause retract move failed';
	            #bTrigMove := FALSE;
	            #state := #STATE_ERROR;
	        ELSIF #tonPauseMove.Q THEN
	            #ErrorID := 16#0008;
	            "DB_Diagnostic".Error_Line := #lineIndex;
	            "DB_Diagnostic".Error_Code := #ErrorID;
	            "DB_Diagnostic".Error_Text := 'Pause retract timeout';
	            #bTrigMove := FALSE;
	            #state := #STATE_ERROR;
	        ELSIF (NOT #bMoveX OR #fbMoveX.Done) AND (NOT #bMoveZ OR #fbMoveZ.Done) THEN
	            #bTrigMove := FALSE;   // drop so a fresh edge can start the return move
	            #currX := #targX;      // handler now tracks the retracted position
	            #currZ := #targZ;
	            #state := #STATE_PAUSE_HOLD;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_PAUSE_HOLD (802) ===
	        // -----------------------------------------------------------------
	    802: // Held at retracted position. Wait for Continue (Pause released).
	        #Paused := TRUE;
	        #bTrigMove := FALSE;
	        IF NOT #Pause THEN
	            // Arm the return move back to the exact interruption point.
	            #targX := #resumeX;
	            #targZ := #resumeZ;
	            #velX := "DB_MachineConfig".PauseRetract_Vel;
	            #velZ := "DB_MachineConfig".PauseRetract_Vel;
	            #bMoveX := ABS(#targX - #Axis_X.ActualPosition) > 0.01;
	            #bMoveZ := ABS(#targZ - #Axis_Z.ActualPosition) > 0.01;
	            #bTrigMove := FALSE;   // clean edge next scan
	            #tonPauseMove(IN := FALSE,
	                          PT := "DB_MachineConfig".Timeout_Motion);
	            #state := #STATE_PAUSE_RETURN;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_PAUSE_RETURN (803) ===
	        // -----------------------------------------------------------------
	    803: // Move back to the interruption point, then resume the original toolpath.
	        #Paused := TRUE;
	        #bTrigMove := TRUE;
	        IF (#bMoveX AND #fbMoveX.Error) OR (#bMoveZ AND #fbMoveZ.Error) THEN
	            "DB_Diagnostic".Error_Line := #lineIndex;
	            IF #bMoveX AND #fbMoveX.Error THEN
	                #ErrorID := 16#0001;
	            ELSE
	                #ErrorID := 16#0002;
	            END_IF;
	            "DB_Diagnostic".Error_Code := #ErrorID;
	            "DB_Diagnostic".Error_Text := 'Pause return move failed';
	            #bTrigMove := FALSE;
	            #state := #STATE_ERROR;
	        ELSIF #tonPauseMove.Q THEN
	            #ErrorID := 16#0008;
	            "DB_Diagnostic".Error_Line := #lineIndex;
	            "DB_Diagnostic".Error_Code := #ErrorID;
	            "DB_Diagnostic".Error_Text := 'Pause return timeout';
	            #bTrigMove := FALSE;
	            #state := #STATE_ERROR;
	        ELSIF (NOT #bMoveX OR #fbMoveX.Done) AND (NOT #bMoveZ OR #fbMoveZ.Done) THEN
	            #bTrigMove := FALSE;
	            #Paused := FALSE;
	            #currX := #resumeX;    // back on the original path
	            #currZ := #resumeZ;
	            // Resume the state the pause was taken from (EXEC recalculates the
	            // remaining move from currX/currZ; dwell/spindle-wait continue in place).
	            #state := #pauseReturnState;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_STOPPING (850) ===
	        // -----------------------------------------------------------------
	    850: // STOPPING -- Halt active, waiting for both axes to fully stop
	        // fbHaltX and fbHaltZ continue to be called with Execute=TRUE.
	        // When both return Done, bHaltTrig=FALSE and STATE_DONE is entered.
	        // This allows STATE_STOPPING (18) in FB_Process to safely see Busy=FALSE.
	        #bHaltTrig := TRUE;
	        IF #fbHaltX.Done AND #fbHaltZ.Done THEN
	            #bHaltTrig := FALSE;
	            #Busy := FALSE;
	            #Done := TRUE;
	            #Paused := FALSE;
	            #state := #STATE_DONE;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_ERROR (999) ===
	        // -----------------------------------------------------------------
	    999: // ERROR
	        #Error := TRUE;
	        #Busy := FALSE;
	        #ToolChangeReq := FALSE;
	        #bTrigMove := FALSE;  // Stop move commands -- prevent other axis from running free
	        #bMoveX := FALSE;
	        #bMoveZ := FALSE;
	        #bHaltTrig := TRUE;   // Safely stop both axes (was FALSE -- BUG FIX)
	        // Ensure diagnostic block contains the latest recipe error context
	        "DB_Diagnostic".Error_ProcessState := #state;
	        "DB_Diagnostic".Error_Code := #ErrorID;
	        "DB_Diagnostic".Error_Line := #lineIndex;
	END_CASE;
	
	// -------------------------------------------------------------------------
	// Motion FB calls -- run at end of every scan (after state machine)
	// bTrigMove AND bMoveX/Z: active only in EXEC state and when axis is needed
	// bHaltTrig: TRUE in STOPPING and PAUSED states -- decelerates axis to stop
	// -------------------------------------------------------------------------
	#fbMoveX(Execute := #bTrigMove AND #bMoveX,
	         Position := #targX,
	         Velocity := #velX,
	         Axis := #Axis_X);
	#fbMoveZ(Execute := #bTrigMove AND #bMoveZ,
	         Position := #targZ,
	         Velocity := #velZ,
	         Axis := #Axis_Z);
	#fbHaltX(Execute := #bHaltTrig,
	         Axis := #Axis_X);
	#fbHaltZ(Execute := #bHaltTrig,
	         Axis := #Axis_Z);
	
	// Calculate progress
	IF #LineCount > 0 THEN
	    #Progress := INT_TO_REAL(#lineIndex) / INT_TO_REAL(#LineCount) * 100.0;
	ELSE
	    #Progress := 0.0;
	END_IF;
	
	// Update active feedrate for HMI (convert mm/s back to mm/min using same factor as forward conversion)
	#ActiveFeedrate := #feedrate * "DB_MachineConfig".FeedrateConvFactor;
	
	// Outputs
	#CurrentLine := #lineIndex;
	
	// Diagnostics
	"DB_Diagnostic".Recipe_CurrentLine := #lineIndex;
	"DB_Diagnostic".Recipe_TargetX := #targX;
	"DB_Diagnostic".Recipe_TargetZ := #targZ;
	"DB_Diagnostic".Recipe_Velocity := #velX;
	"DB_Diagnostic".bMoveX := #bMoveX;
	"DB_Diagnostic".bMoveZ := #bMoveZ;
	"DB_Diagnostic".MoveX_Busy := #fbMoveX.Busy;
	"DB_Diagnostic".MoveX_Done := #fbMoveX.Done;
	"DB_Diagnostic".MoveX_Error := #fbMoveX.Error;
	"DB_Diagnostic".MoveZ_Busy := #fbMoveZ.Busy;
	"DB_Diagnostic".MoveZ_Done := #fbMoveZ.Done;
	"DB_Diagnostic".MoveZ_Error := #fbMoveZ.Error;
	
END_FUNCTION_BLOCK

DATA_BLOCK "DB_Production"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
// -----------------------------------------------------------------------------
// DB_Production - Production counters and last cycles
// -----------------------------------------------------------------------------
// Overall counters
   VAR 
      TotalStarted : DInt;   // All cycles that entered PRE_SCAN
      TotalOK : DInt;   // Completed successfully (STATE=100)
      TotalNOK : DInt;   // Ended in ERROR (STATE=999)
      TotalStopped : DInt;   // Stopped by operator (STOP sequence) Current active cycle
      CurrentActive : Bool;
      CurrentProgram : Int;   // Active program number
      CurrentStartTime {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;   // Cycle start timestamp Last cycle summary 0=None, 1=OK, 2=NOK, 3=STOP
      LastResult : Byte;
      LastProgram : Int;
      LastDuration_s : DInt;   // Duration in seconds
      LastErrorCode : Word;   // 0 if OK/STOP
      LastErrorLine : Int;   // -1 if not applicable
      LastEndTime {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;   // End timestamp History buffer (ring) - last 100 cycles
      Hist_Index : Int;   // 1..100
      Hist_Count : Int;   // Number of valid entries (<=100)
      Hist_Result : Array[1..100] of Byte;
      Hist_Program : Array[1..100] of Int;
      Hist_Duration_s : Array[1..100] of DInt;
      Hist_ErrorCode : Array[1..100] of Word;
      Hist_ErrorLine : Array[1..100] of Int;
      Hist_Time {InstructionName := 'DTL'; LibVersion := '1.0'} : Array[1..100] of DTL;
   END_VAR


BEGIN
   TotalStarted := 0;
   TotalOK := 0;
   TotalNOK := 0;
   TotalStopped := 0;
   CurrentActive := FALSE;
   CurrentProgram := 0;
   LastResult := 0;
   LastProgram := 0;
   LastDuration_s := 0;
   LastErrorCode := 0;
   LastErrorLine := -1;
   Hist_Index := 0;
   Hist_Count := 0;

END_DATA_BLOCK

FUNCTION_BLOCK "FB_Axis_Reset"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
// =============================================================================
// FB_Axis_Reset -- TO error reset
//
// When a TO enters an error state (e.g. limit switch, drive fault),
// MC_Reset clears it. Will not re-execute until the fault is resolved.
// Triggered by FB_Process when AckError or Reset button is pressed.
// =============================================================================
   VAR_INPUT 
      Execute : Bool;   // Rising edge = reset TO error
   END_VAR

   VAR_OUTPUT 
      Done : Bool;
      Busy : Bool;
      Error : Bool;
   END_VAR

   VAR_IN_OUT 
      Axis {InstructionName := 'TO_PositioningAxis'; LibVersion := '8.0'} : TO_PositioningAxis;
   END_VAR

   VAR 
      MC_Reset_Instance {InstructionName := 'MC_Reset'; LibVersion := '8.0'} : MC_Reset;
   END_VAR


BEGIN
	
	#MC_Reset_Instance(
	                   Axis := #Axis,
	                   Execute := #Execute,
	                   Done => #Done,
	                   Busy => #Busy,
	                   Error => #Error
	);
	
END_FUNCTION_BLOCK

DATA_BLOCK "DB_RecipeProgram2"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
// -----------------------------------------------------------------------------
// DB_RecipeProgram2 - Recipe data for Program 2
// -----------------------------------------------------------------------------
   VAR 
      Header : "RecipeHeader";
      Lines : Array[0..349] of "RecipeLine";
   END_VAR


BEGIN

END_DATA_BLOCK

