// â”‚     turn them off manually. Verify before going into production.         â”‚
// â”‚  NOTE: DB_HMI.Bypass_Spindle and Bypass_ToolChanger are defined but     â”‚
// â”‚        not used in the safety monitor -- do not connect them.            â”‚
// â””â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”˜
// =============================================================================
// -----------------------------------------------------------------------------
// FC_LoadConfig -- Runs once at PLC startup (called by OB100)
// Values here can be thought of as the PLC "factory defaults".
// Parameters that can be changed at runtime from HMI are NOT written here --
// the initial value in the DB definition applies.
// -----------------------------------------------------------------------------

BEGIN
	
	
	// =========================================================================
	// SECTION 1 -- AXIS VELOCITY LIMITS (mm/s)
	// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	// âš ï¸ These values MUST match the Technology Object (TO) settings in TIA Portal.
	//    If the TO has a different limit, the PLC may report an error.
	//    Should not be changed from HMI -- edit here instead.
	// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	//  MaxVelocity   : Must match "Maximum velocity" in TO
	//  RapidVelocity : Used for G0 command (in recipe)
	//  MinVelocity   : Must match "Minimum velocity" in TO
	// =========================================================================
	"DB_MachineConfig".MaxVelocity := 40.0;   // mm/s -- match TO max velocity
	"DB_MachineConfig".RapidVelocity := 30.0;   // mm/s -- G0 (rapid move) speed
	"DB_MachineConfig".MinVelocity := 0.001;    // mm/s -- match TO min velocity
	"DB_MachineConfig".FeedrateConvFactor := 60.0;    // divisor: recipe F (mm/min) / this = axis velocity (mm/s)
	// Standard mm/minâ†’mm/s = divide by 60; adjust if TO uses different units
	
	// =========================================================================
	// SECTION 2 -- HOMING (REFERENCE SEEK)
	// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	//  HomingMode:
	//    0 = Passive  â†’ Motor does not move, encoder is zeroed at current position
	//    2 = Active   â†’ Moves to reference switch, encoder is zeroed
	//    3 = Active+Zero â†’ Moves to reference switch, set to HomeOffset_X/Z value
	//                    (recommended mode for production)
	//
	//  HomeVelocity and HomeOffset_X/Z are defined as initial values in
	//  DB_MachineConfig and can be edited from the HMI Machine Limits screen.
	//  Writing here will always reset to the same value on restart.
	// =========================================================================
	"DB_Manual".HomingMode := 3;   // 0=Passive | 2=Active | 3=Active+Zero (recommended)
	"DB_MachineConfig".PostHome_Clearance := 0.0;  // mm -- clearance distance from PNP zone after homing
	"DB_MachineConfig".HomeVelocity := 5.0;         // mm/s -- speed for pre/post-homing clearance move
	// NOTE: MC_Home search speed comes from TO, PLC cannot change it
	"DB_MachineConfig".AlwaysHomeOnAutoStart := TRUE; // Home all axes on every auto start (set FALSE for fast test cycles)
	
	// =========================================================================
	// SECTION 3 -- TOOL CHANGER
	// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	//  ToolCount: How many slots are physically installed (1-4)
	//    â†’ FC_ToolAngleCalc automatically calculates angles based on this value
	//    â†’ Can also be changed on the HMI Tool page (runtime)
	//
	//  AutoCalcAngles = TRUE  â†’ Equally spaced angles based on ToolCount
	//                           (2 slots: 0Â°/180Â°, 3 slots: 0Â°/120Â°/240Â°, etc.)
	//  AutoCalcAngles = FALSE â†’ Tool1..4_Position can be entered manually from HMI
	//                           (use when unequal angles are needed)
	//
	//  CurrentTool: Which slot is active at startup (usually 1)
	// =========================================================================
	"DB_MachineConfig".ToolCount := 3;     // Physical slot count
	"DB_ToolConfig".AutoCalcAngles := TRUE;  // Automatic angle calculation
	"DB_ToolConfig".CurrentTool := 1;     // Initial active slot
	
	// =========================================================================
	// SECTION 4 -- SPINDLE SPEED
	// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	//  MinSpeed      : Commands below this value are clamped to this value
	//  MaxSpeed      : Commands above this value are clamped to this value
	//  DefaultSpeed  : Default speed in manual mode (initial Manual_SpindleSpeed)
	//  SpeedTolerance: Tolerance for "AtSpeed" decision -- keep small (Â±5% recommended)
	//  SpeedOverride : 100% = normal, can be changed at runtime from HMI
	//
	//  âš ï¸ MaxSpeed must not exceed motor or coupling component ratings
	// =========================================================================
	"DB_Spindle".MinSpeed := 100.0;   // RPM -- lower limit
	"DB_Spindle".MaxSpeed := 3000.0;  // RPM -- upper limit (do not exceed motor max)
	"DB_Spindle".DefaultSpeed := 1000.0;  // RPM -- manual mode initial value
	"DB_Spindle".SpeedTolerance := 5.0;     // % -- AtSpeed tolerance
	"DB_Spindle".SpeedOverride := 100.0;   // % -- 100% at startup (normal)
	"DB_MachineConfig".SpindleMaxRPM := 2400.0;  // RPM -- denominator for proportional MandrelLock wait (ITEM-28)
	"DB_MachineConfig".SpindleStopSafeTime := T#10S;   // Full-speed decel safety margin -- tune to measured VFD ramp + margin
	
	// =========================================================================
	// SECTION 5 -- MANUAL MODE DEFAULTS
	// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	//  JogSpeed      : Speed used when jog button is pressed
	//                  Can be connected to a slider/input field on HMI Manual screen
	//  JogIncrement  : Distance traveled per press on "Step" button
	//  ToolStepAngle : Rotation angle for CW/CCW buttons on Manual Tool screen
	//                  (e.g. 90Â° can be used to step slot-to-slot)
	//  Manual_SpindleSpeed: Initial speed on manual spindle screen
	//  Manual_SpindleDir  : 1=CW (clockwise), -1=CCW (counter-clockwise)
	// =========================================================================
	"DB_Manual".JogSpeed := 30.0;   // mm/s
	"DB_Manual".JogIncrement := 1.0;    // mm -- step size
	"DB_Manual".ToolStepAngle := 120.0;   // degrees -- tool step angle
	"DB_Manual".Manual_SpindleSpeed := 500.0;  // RPM
	"DB_Manual".Manual_SpindleDir := 1;      // 1=CW | -1=CCW
	
	// =========================================================================
	// SECTION 6 -- LINEAR RULER CALIBRATION
	// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	//  S7-1200 AI module standard output values:
	//    0 V  (or 4  mA) â†’ Raw_Min  (typically 0 or 5530)
	//    10 V (or 20 mA) â†’ Raw_Max  (typically 27648)
	//
	//  Phys_Min / Phys_Max: Mechanical stroke limits of the sensor (mm)
	//    Example: For a ruler with 0-200 mm stroke: Phys_Min=0, Phys_Max=200
	//
	//  âš ï¸ Always update Phys_Max according to the sensor stroke.
	//  These values revert here on restart -- for permanent changes write here,
	//  changes made only from HMI will be lost on restart.
	// =========================================================================
	"DB_Cylinder_LinearRuler_BackSupport".Raw_Min := 0;       // AI at full extend (~0V)
	"DB_Cylinder_LinearRuler_BackSupport".Raw_Max := 31433;   // AI at full retract (measured; update once hardware is within 0-10V)
	"DB_Cylinder_LinearRuler_BackSupport".Phys_Min := 0.0;     // mm physical reference at Raw_Min end
	"DB_Cylinder_LinearRuler_BackSupport".Phys_Max := 300.0;   // mm physical reference at Raw_Max end (full stroke)
	"DB_Cylinder_LinearRuler_BackSupport".InvertSignal := TRUE;    // Sensor wired reverse: 0V = full extend (300mm), ~10V = retracted (0mm)
	
	// â”€â”€ CMD=40 gain defaults â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	// TargetPos = Param Ã— Cmd40_Gain (mm). Default 10.0 (no scaling).
	// Tune on-site: measure how far BackSupport travels per Param unit and update.
	// Example: if Param=20 should send BackSupport to 200mm â†’ Cmd40_Gain = 10.0
	"DB_Cylinder_BackSupport".Cmd40_Gain := 10.0;   // BackSupport: mm per CMD=40 Param unit
	
	// =========================================================================
	// SECTION 7 -- PNEUMATIC CYLINDER CONFIGURATION REFERENCE
	// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	//  Cylinder parameters (ValveType, MaxPos, TargetPos, Timeout, UseRulerPos)
	//  are VAR_INPUT in FB_CylinderControl. In optimized S7 blocks VAR_INPUT
	//  fields cannot be written from an FC at runtime. Factory defaults must be
	//  set in the BEGIN section of DB_Cylinder1 in 02_DataBlocks.scl.
	//
	//  Current Cylinder 1 factory defaults (02_DataBlocks.scl â†’ DB_Cylinder1):
	//    ValveType       = 3       (5/3 blocked center -- piston locked in hold)
	//    UseRulerPos     = TRUE    (analog position control via DB_LinearRuler)
	//    TargetPos       = 300.0   (mm -- default: full extend)
	//    MaxPos          = 300.0   (mm -- software extend clamp)
	//    ExtendOffset    = 5.0     (mm -- tune on site)
	//    RetractOffset   = 5.0     (mm -- tune on site)
	//    Tolerance       = 2.0     (mm -- AtTarget window)
	//    Timeout_Extend  = T#5S
	//    Timeout_Retract = T#5S
	//
	//  âš ï¸ VALVE TYPE SELECTION IS CRITICAL:
	//    ValveType=2 BLOCKED CENTER â†’ Piston mechanically locked in hold. âœ… USE THIS
	//    ValveType=3 EXHAUST CENTER â†’ Piston free to move in hold.        âŒ Do not use
	// =========================================================================
	// (No runtime writes here -- edit 02_DataBlocks.scl DB_Cylinder1 BEGIN section)
	
	// =========================================================================
	// SECTION 8 -- HMI INITIAL VALUES
	// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	//  FeedrateOverride: Speed multiplier for recipe G1 moves.
	//    100% = normal speed, 50% = half speed, 200% = double speed
	//    HMI slider should be connected to this tag (recommend min 50, max 200)
	//  RapidOverride: Same logic for G0 rapid moves
	//  ProductSelect: Which program is active at startup (1-5)
	// =========================================================================
	"DB_HMI".FeedrateOverride := 100.0;   // % -- initial feed rate multiplier
	"DB_HMI".RapidOverride := 100.0;   // % -- initial rapid rate multiplier
	"DB_HMI".SingleStepMode := FALSE;   // Line-by-line mode off
	"DB_HMI".ProductSelect := 1;       // Initial program selection
	
	// =========================================================================
	// SECTION 9 -- SAFETY BYPASSES
	// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	//  âš ï¸âš ï¸ WARNING: These bypasses are for commissioning and testing only!
	//  Verify that ALL are FALSE before production.
	//
	//  PLC resets these to FALSE on every restart (safe default).
	//  Show a warning on HMI when any bypass is active (AnyBypassActive tag recommended).
	//
	//  Bypass_EStop       : Ignore physical E-Stop circuit
	//  Bypass_Door        : Ignore safety door sensor
	//  Bypass_AirPressure : Ignore air pressure sensor
	//  Bypass_Drives      : Ignore drive ready signal
	//
	//  Bypass_ToolAxis    : This bypass is DIFFERENT -- set TRUE if the tool axis
	//    (turret) is NOT physically connected to this machine.
	//    This is a hardware presence flag, not a safety bypass.
	//
	//  âš ï¸ NOTE: DB_HMI.Bypass_Spindle and DB_HMI.Bypass_ToolChanger are defined
	//    but not used in the safety monitor. Do not connect them to HMI.
	// =========================================================================
	"DB_HMI".Bypass_EStop := FALSE;
	"DB_HMI".Bypass_Door := TRUE; // NOT USED -- reserved for future use
	"DB_HMI".Bypass_AirPressure := TRUE; // NOT USED -- reserved for future use
	"DB_HMI".Bypass_Drives := FALSE;
	"DB_HMI".Bypass_Spindle := FALSE;
	"DB_HMI".Bypass_ToolChanger := FALSE;
	"DB_MachineConfig".Bypass_ToolAxis := FALSE;  // Set TRUE if tool axis is not connected
	"DB_MachineConfig".Bypass_MandrelLock := FALSE;  // Set TRUE on variants without MandrelLock cylinder
	
	// =========================================================================
	// SECTION 10 -- TIMER DEFAULTS
	// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	//  All timer PT values used in the project are set here.
	//  Change a value here to reconfigure every call site at once.
	//  Values revert to these defaults on PLC restart (NON_RETAIN DB).
	// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	//  Cylinder stroke wait times:
	//    Set each slightly above the measured full-stroke time.
	//    No sensor feedback on these â€” machine waits the full duration every cycle.
	// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	//  Process timeouts:
	//    These trigger errors when exceeded; they are safety nets, not normal waits.
	//    Set well above the expected operation time but short enough to catch faults promptly.
	// =========================================================================
	// Cylinder stroke waits
	"DB_MachineConfig".CylMandrelLock_ClampTime := T#0.5S;
	"DB_MachineConfig".CylSheetHolder_RetractTime := T#0.5S;
	"DB_MachineConfig".CylToolHeadLock_PreDelay := T#0.5S;
	"DB_MachineConfig".CylToolHeadLock_RetractTime := T#2S;
	// Process timeouts
	"DB_MachineConfig".Timeout_DriveReady := T#3S;
	"DB_MachineConfig".Timeout_Homing := T#120S;
	"DB_MachineConfig".Timeout_Motion := T#300S;
	"DB_MachineConfig".Timeout_SpindleAtSpeed := T#10S;
	"DB_MachineConfig".Timeout_SpindleStop := T#15S;
	"DB_MachineConfig".Timeout_ToolChange := T#30S;
	"DB_MachineConfig".Timeout_EStopDiscrep := T#500MS;
	
	
END_FUNCTION

