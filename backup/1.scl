FUNCTION_BLOCK "FB_EStopDualChannel"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.1
// =============================================================================
// Version_Recipe - 08_Main_OB1.scl
// Main organization block - entry point for cyclic execution
// =============================================================================
// =============================================================================
// FB_EStopDualChannel -- Dual-channel emergency stop (E-Stop) monitoring
//
// Physical wiring:
//   Safety_Estop_Ch1 â†’ PLC DI  NC contact -- normally CLOSED (TRUE)
//   Safety_Estop_Ch2 â†’ PLC DI  NO contact -- normally OPEN   (FALSE)
//   Safety_Estop     â†’ Marker (%M), written by this FB
//
// Normal state (button not pressed):
//   NC=TRUE,  NO=FALSE  â†’  EStop_OK=TRUE  (machine may run)
//
// Emergency stop (button pressed):
//   NC=FALSE, NO=TRUE   â†’  EStop_OK=FALSE (controlled stop)
//
// Discrepancy (contact/wiring fault):
//   NC=TRUE,  NO=TRUE   â†’  EStop_OK=FALSE + DiscrepancyAlarm  (NO contact stuck)
//   NC=FALSE, NO=FALSE  â†’  EStop_OK=FALSE + DiscrepancyAlarm  (NC contact stuck)
//   In both cases the machine fails safe.
//
// Discrepancy alarm behavior:
//   If channels remain inconsistent for DiscrepancyTimeout, DiscrepancyAlarm is TRUE for one scan.
//   This alarm generates error code 16#0406 via FC_ReportError.
//   HMI: DB_HMI.EStop_Discrepancy + DB_HMI.EStop_Ch1_OK + DB_HMI.EStop_Ch2_OK
// =============================================================================
   VAR_INPUT 
      Ch1_NC : Bool;   // NC contact -- normal: TRUE (closed)
      Ch2_NO : Bool;   // NO contact -- normal: FALSE (open)
      DiscrepancyTimeout : Time := T#500MS;   // Discrepancy debounce time
   END_VAR

   VAR_OUTPUT 
      EStop_OK : Bool;   // TRUE = button not pressed = machine may run
      Discrepancy : Bool;   // TRUE = channels inconsistent = contact/wiring fault (instantaneous)
      DiscrepancyAlarm : Bool;   // TRUE = timeout exceeded â†’ generate alarm (rising edge)
   END_VAR

   VAR 
      tonDiscrepancy {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;   // Discrepancy debounce timer
      prevTimerQ : Bool;   // Previous timer output for rising edge detection
   END_VAR


BEGIN
	
	// Safe state: NC closed (TRUE) AND NO open (FALSE)
	// E-Stop OK as long as neither channel breaks this condition
	#EStop_OK := #Ch1_NC AND NOT #Ch2_NO;
	
	// Discrepancy: channels must always be opposite (NCâ‰ NO)
	// When NC=NO (both TRUE or both FALSE) â†’ contact fault
	#Discrepancy := NOT (#Ch1_NC XOR #Ch2_NO);
	
	// Debounce: filter simultaneous switching delays
	#tonDiscrepancy(IN := #Discrepancy,
	                PT := #DiscrepancyTimeout);
	
	// Alarm: rising edge -- triggered once per discrepancy event
	#DiscrepancyAlarm := #tonDiscrepancy.Q AND NOT #prevTimerQ;
	#prevTimerQ := #tonDiscrepancy.Q;
	
END_FUNCTION_BLOCK

FUNCTION_BLOCK "FB_SafetyMonitor"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.0
// -----------------------------------------------------------------------------
// FB_SafetyMonitor - Check E-Stop, Door, Air Pressure, Drives
// DOC:
//  purpose: Evaluate hardware safety inputs and bypass flags, produce SafeToRun/SafeToJog.
//  inputs: EStop_OK, Door_Closed, AirPressure_OK, DrivesReady and bypass flags.
//  outputs: SafeToRun (machine may start), SafeToJog (manual jog allowed), ErrorCode (if unsafe).
//  notes: Returns immediately on first fatal safety failure to minimize decision latency.
// -----------------------------------------------------------------------------
   VAR_INPUT 
      EStop_OK : Bool;   // TRUE if E-stop circuit is OK (no emergency)
      Door_Closed : Bool;   // TRUE if safety door closed
      AirPressure_OK : Bool;   // TRUE if air pressure sufficient
      DrivesReady : Bool;   // TRUE if drives report ready Bypass flags (from HMI) used only for testing; production should disable
      Bypass_EStop : Bool;
      Bypass_Door : Bool;
      Bypass_AirPressure : Bool;
      Bypass_Drives : Bool;
   END_VAR

   VAR_OUTPUT 
      SafeToRun : Bool;   // TRUE => allowed to start program execution
      SafeToJog : Bool;   // TRUE => manual jogging permitted
      ErrorCode : Word;   // Non-zero if unsafe (map to DB_ErrorCodes)
   END_VAR


BEGIN
	
	// Runs every scan. RETURNs on first failing condition -- priority order matters.
	// EStop and Drive fault disable both SafeToRun and SafeToJog (jogging also forbidden).
	// Door and air pressure only disable SafeToRun (manual jog still permitted).
	#ErrorCode := 0;
	IF NOT #EStop_OK AND NOT #Bypass_EStop THEN
	    // EMERGENCY STOP active -- all motion forbidden
	    #SafeToRun := FALSE;
	    #SafeToJog := FALSE;
	    #ErrorCode := 16#0401;
	    "DB_Diagnostic".Error_Text := 'Safety: EMERGENCY STOP active';
	    RETURN;
	END_IF;
	// Drive readiness is NOT checked here.
	// In STATE_STOPPED, contactors are physically blocked (modePermit=0), so drives can never
	// report ready before starting. Blocking SafeToRun/SafeToJog here creates a deadlock.
	// Drive enable is handled automatically in STATE_STARTING (tonDriveReady timeout).
	// Drive faults while running are caught by prevDriveFaultX/Z detection â†’ STATE_ERROR.
	#SafeToJog := TRUE;
	IF NOT #Door_Closed AND NOT #Bypass_Door THEN
	    // Safety door open -- auto run forbidden, manual jog allowed
	    #SafeToRun := FALSE;
	    #ErrorCode := 16#0402;
	    "DB_Diagnostic".Error_Text := 'Safety: Safety door is open';
	    RETURN;
	END_IF;
	IF NOT #AirPressure_OK AND NOT #Bypass_AirPressure THEN
	    // Air pressure insufficient -- pneumatic system will not operate
	    #SafeToRun := FALSE;
	    #ErrorCode := 16#0404;
	    "DB_Diagnostic".Error_Text := 'Safety: Air pressure too low';
	    RETURN;
	END_IF;
	#SafeToRun := TRUE;
	
END_FUNCTION_BLOCK

FUNCTION_BLOCK "FB_LimitMonitor"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.0
// -----------------------------------------------------------------------------
// FB_LimitMonitor - Check soft and hard limits
// DOC:
//  purpose: Validate current axis positions against configured soft limits and hardware limit switches.
//  inputs: ActualPos_X/Z, Homed_X/Z, HW limit switches.
//  outputs: LimitError (TRUE if any violation), ErrorCode (first matching error code).
//  notes: Soft limits from DB_MachineConfig are used; hardware limit switches take precedence.
//         Soft limits are only checked for a HOMED axis (Homed_X/Z = StatusBits.HomingDone):
//         before homing the TO position is meaningless (0 after restart, stale after a run),
//         so comparing it against limits would produce false trips.
// -----------------------------------------------------------------------------
   VAR_INPUT 
      ActualPos_X : Real;   // Current X position (mm)
      ActualPos_Z : Real;   // Current Z position (mm)
      Homed_X : Bool;   // X axis homed (StatusBits.HomingDone) -- soft limits checked only when TRUE
      Homed_Z : Bool;   // Z axis homed (StatusBits.HomingDone) -- soft limits checked only when TRUE NC limit switches: TRUE=closed=OK, FALSE=open=limit triggered Cable break also reads FALSE â†’ fail-safe behavior
      HW_NC_X_Min : Bool;   // NC switch: X min (FALSE = limit hit)
      HW_NC_X_Max : Bool;   // NC switch: X max (FALSE = limit hit)
      HW_NC_Z_Min : Bool;   // NC switch: Z min (FALSE = limit hit)
      HW_NC_Z_Max : Bool;   // NC switch: Z max (FALSE = limit hit) PNP NO proximity sensors: TRUE=target detected=entered limit zone Triggered BEFORE NC switch â†’ early warning + second safety layer
      HW_PNP_X_Min : Bool;   // PNP NO sensor: X min (TRUE = limit zone)
      HW_PNP_X_Max : Bool;   // PNP NO sensor: X max (TRUE = limit zone)
      HW_PNP_Z_Min : Bool;   // PNP NO sensor: Z min (TRUE = limit zone)
      HW_PNP_Z_Max : Bool;   // PNP NO sensor: Z max (TRUE = limit zone)
   END_VAR

   VAR_OUTPUT 
      LimitError : Bool;   // TRUE if any soft/hard limit violated
      ErrorCode : Word;   // Specific error code for HMI/alarm
   END_VAR


BEGIN
	
	// Runs every scan. Soft limits are read from DB_MachineConfig.
	// Hardware limit switches take priority over soft limits (physical end stop).
	// ErrorCode shows the last triggered fault -- multiple can be active simultaneously.
	#LimitError := FALSE;
	#ErrorCode := 0;
	// --- Software (Soft) Limits ---
	// Only checked while the axis is homed: an un-homed axis has no valid position
	// reference, so soft limits cannot mean anything before the reference seek completes.
	IF #Homed_X THEN
	    IF #ActualPos_X < "DB_MachineConfig".SoftLimit_MinX THEN
	        #LimitError := TRUE;
	        #ErrorCode := 16#0101;
	        "DB_Diagnostic".Error_Text := 'Limit: X axis below minimum soft limit';
	    END_IF;
	    IF #ActualPos_X > "DB_MachineConfig".SoftLimit_MaxX THEN
	        #LimitError := TRUE;
	        #ErrorCode := 16#0102;
	        "DB_Diagnostic".Error_Text := 'Limit: X axis above maximum soft limit';
	    END_IF;
	END_IF;
	IF #Homed_Z THEN
	    IF #ActualPos_Z < "DB_MachineConfig".SoftLimit_MinZ THEN
	        #LimitError := TRUE;
	        #ErrorCode := 16#0103;
	        "DB_Diagnostic".Error_Text := 'Limit: Z axis below minimum soft limit';
	    END_IF;
	    IF #ActualPos_Z > "DB_MachineConfig".SoftLimit_MaxZ THEN
	        #LimitError := TRUE;
	        #ErrorCode := 16#0104;
	        "DB_Diagnostic".Error_Text := 'Limit: Z axis above maximum soft limit';
	    END_IF;
	END_IF;
	// --- Hardware Limit Switches ---
	// NC switches: the TO (Technology Object) is configured with these as HW limits.
	// The TO handles deceleration and stop directly -- no PLC action required.
	// Only E-Stop cuts contactor power; PLC does NOT raise LimitError on NC hits.
	//
	// PNP proximity sensors: handled separately in FB_Process (inline halt block).
	// In auto mode: PNP â†’ MC_Halt on triggered axis + STATE_ERROR (codes 16#0121-0124).
	// In homing and manual mode: PNP is bypassed (expected zone during reference seek / manual op).
	
END_FUNCTION_BLOCK

FUNCTION_BLOCK "FB_Axis_Power"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.2
// =============================================================================
// FB_Axis_Power -- Drive power enable/disable
//
// Enable = TRUE  â†’ MC_Power called, drive enabled.
// Enable = FALSE â†’ MC_Power stopped, drive disabled.
// Status = TRUE  â†’ Drive ready and enabled.
// =============================================================================
   VAR_INPUT 
      Enable : Bool;   // TRUE = enable drive
   END_VAR

   VAR_OUTPUT 
      Status : Bool;   // TRUE = drive active and ready
      Error : Bool;   // Drive enable error
      ErrorID : Word;   // MC_Power TO error code -- for drive fault details
   END_VAR

   VAR_IN_OUT 
      Axis {InstructionName := 'TO_PositioningAxis'; LibVersion := '8.0'} : TO_PositioningAxis;
   END_VAR

   VAR 
      MC_Power_Instance {InstructionName := 'MC_Power'; LibVersion := '8.0'} : MC_Power;
   END_VAR


BEGIN
	
	#MC_Power_Instance(
	                   Axis := #Axis,
	                   Enable := #Enable,
	                   Status => #Status,
	                   Error => #Error,
	                   ErrorID => #ErrorID
	);
	
END_FUNCTION_BLOCK

FUNCTION "FC_TO_ErrorText" : String
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.0
// ---------------------------------------------------------------------------
// FC_TO_ErrorText -- Converts a Siemens TO (Technology Object) error code to a
// readable short string. All MC_ error outputs (MC_Home, MC_MoveAbsolute, etc.)
// return a 16-bit WORD; this FC converts it to String[20].
//
// Reference: TIA Portal Help â†’ S7-1200 Technology Objects â†’ ErrorIDs
// Full list: TIA Portal â†’ Online â†’ TO Diagnostics â†’ Error Description
//
// Usage:
//   detail := FC_TO_ErrorText(Code := fbMoveX.ErrorID);
//   â†’ 'FollowError', 'NotHomed', '+HWLimit', etc.
// ---------------------------------------------------------------------------
   VAR_INPUT 
      Code : Word;   // TO error code from MC_ function block
   END_VAR


BEGIN
	
	// Siemens S7-1200/1500 TO motion error codes (most common)
	CASE #Code OF
	    16#0000:
	        #FC_TO_ErrorText := 'OK';
	        // State / command errors
	    16#8001:
	        #FC_TO_ErrorText := 'AxisDisabled';      // Axis is disabled
	    16#8002:
	        #FC_TO_ErrorText := 'CmdNotAccepted';    // Command rejected in current state
	    16#8003:
	        #FC_TO_ErrorText := 'HomingRequired';    // Homing must be done first
	    16#8004:
	        #FC_TO_ErrorText := 'AxisInError';       // Axis is in error state
	    16#8005:
	        #FC_TO_ErrorText := 'LimitedByCfg';      // Vel/acc limited by TO config
	    16#8010:
	        #FC_TO_ErrorText := 'NotHomed';          // Homing not done
	    16#8011:
	        #FC_TO_ErrorText := 'AxisBusy';          // Axis busy with another command
	    16#8012:
	        #FC_TO_ErrorText := 'HomingActive';      // Homing already in progress
	    16#8013:
	        #FC_TO_ErrorText := 'NotEnabled';        // MC_Power not enabled
	    16#8014:
	        #FC_TO_ErrorText := 'DriveNotReady';     // Drive not ready (STO active?)
	    16#8015:
	        #FC_TO_ErrorText := 'STOActive';         // Safe Torque Off active
	    16#8016:
	        #FC_TO_ErrorText := 'SafeStopActive';    // Safe Stop function active
	        // Config / parameter errors
	    16#8100:
	        #FC_TO_ErrorText := 'ConfigError';       // TO configuration error
	    16#8101:
	        #FC_TO_ErrorText := 'InvalidParam';      // Parameter out of TO range
	    16#8102:
	        #FC_TO_ErrorText := 'HomingModeErr';     // Homing mode not supported
	        // Velocity / acceleration errors
	    16#8200:
	        #FC_TO_ErrorText := 'VelTooHigh';        // Velocity exceeds TO limit
	    16#8201:
	        #FC_TO_ErrorText := 'AccTooHigh';        // Acceleration exceeds TO limit
	    16#8202:
	        #FC_TO_ErrorText := 'JerkTooHigh';       // Jerk exceeds TO limit
	        // Stop / emergency
	    16#8500:
	        #FC_TO_ErrorText := 'EmergencyStop';     // TO emergency stop
	    16#8501:
	        #FC_TO_ErrorText := 'PowerRemoved';      // Power removed (E-Stop?)
	    16#8502:
	        #FC_TO_ErrorText := 'ErrorStop';         // Error-triggered stop
	        // Limit switch errors
	    16#8600:
	        #FC_TO_ErrorText := '+SoftLimit';        // Positive soft limit exceeded
	    16#8601:
	        #FC_TO_ErrorText := '-SoftLimit';        // Negative soft limit exceeded
	    16#8602:
	        #FC_TO_ErrorText := '+HWLimit';          // Positive hardware limit switch
	    16#8603:
	        #FC_TO_ErrorText := '-HWLimit';          // Negative hardware limit switch
	    16#8604:
	        #FC_TO_ErrorText := 'DriveFault';        // Servo drive fault
	    16#8605:
	        #FC_TO_ErrorText := 'EncoderErr';        // Encoder error
	    16#8606:
	        #FC_TO_ErrorText := 'DriveCommsLost';    // Drive communication timeout
	        // Following / deviation errors
	    16#8A00:
	        #FC_TO_ErrorText := 'FollowError';       // Following error too large
	    16#8A01:
	        #FC_TO_ErrorText := 'PosDeviation';      // Position deviation exceeded
	    16#8A02:
	        #FC_TO_ErrorText := 'SpdDeviation';      // Speed deviation exceeded
	    16#8A03:
	        #FC_TO_ErrorText := 'TorqueLimited';     // Torque limit active
	    ELSE
	        // Unknown code -- use TIA Portal Online â†’ TO Diagnostics for details
	        #FC_TO_ErrorText := 'UnknownTO';
	END_CASE;
	
END_FUNCTION

