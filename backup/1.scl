FUNCTION "FC_ToolAngleCalc" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
// -----------------------------------------------------------------------------
// FC_ToolAngleCalc -- Automatically calculates tool slot angles based on slot count
//
// When DB_ToolConfig.AutoCalcAngles = TRUE, evenly-spaced angles are calculated
// each scan according to ToolCount:
//   1 slot: [0Â°]
//   2 slot: [0Â°, 180Â°]
//   3 slot: [0Â°, 120Â°, 240Â°]
//   4 slot: [0Â°, 90Â°,  180Â°, 270Â°]
//   General: stepDeg = 360 / ToolCount
//
// When AutoCalcAngles = FALSE, no calculation is performed and Tool1..4_Position
// can be entered manually from the HMI Tool page.
//
// HMI Tool page mapping:
//   DB_MachineConfig.ToolCount        â†’ slot count (1-4, writable)
//   DB_ToolConfig.ToolCode_List[1..4] â†’ slot code (writable, e.g. T101)
//   DB_ToolConfig.Tool1..4_Position   â†’ slot angle (writable when AutoCalcAngles=FALSE)
//   DB_ToolConfig.ToolStepAngle_Calc  â†’ calculated step angle (read-only info)
//   DB_ToolConfig.AutoCalcAngles      â†’ calculation mode (writable)
// -----------------------------------------------------------------------------
   VAR_TEMP 
      tc : Int;
      stepDeg : Real;
   END_VAR


BEGIN
	
	IF NOT "DB_ToolConfig".AutoCalcAngles THEN
	    RETURN;   // Manual mode: do not touch angles
	END_IF;
	
	// Clamp slot count to 1-4
	#tc := LIMIT(MN := 1, IN := "DB_MachineConfig".ToolCount, MX := 4);
	"DB_MachineConfig".ToolCount := #tc;   // write back clamped value
	
	// Step angle: 0 for 1 slot (no rotation), equal division for 2+
	IF #tc = 1 THEN
	    #stepDeg := 0.0;
	ELSE
	    #stepDeg := 360.0 / INT_TO_REAL(#tc);
	END_IF;
	"DB_ToolConfig".ToolStepAngle_Calc := #stepDeg;   // for HMI info display
	
	// Populate slot positions (unused slots remain at 0)
	"DB_ToolConfig".Tool1_Position := 0.0;
	"DB_ToolConfig".Tool2_Position := SEL(G := #tc >= 2, IN0 := 0.0, IN1 := #stepDeg);
	"DB_ToolConfig".Tool3_Position := SEL(G := #tc >= 3, IN0 := 0.0, IN1 := #stepDeg * 2.0);
	"DB_ToolConfig".Tool4_Position := SEL(G := #tc >= 4, IN0 := 0.0, IN1 := #stepDeg * 3.0);
	
END_FUNCTION

FUNCTION_BLOCK "FB_CylinderControl"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 3.0
// =============================================================================
// FB_CylinderControl -- Pneumatic cylinder control (supports 5/2 and 5/3)
// =============================================================================
//
// â”€â”€â”€ QUICK SETUP â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
//
//  1) Define physical I/O tags in TIA Portal:
//       "In_Cyl1_AtSetpoint"  Bool  DI   â†’ Mid/target point magnetic switch
//       "In_Cyl1_AtRetract"   Bool  DI   â†’ Retract end magnetic switch (skip if none)
//       "Output_Cyl1_SolA"    Bool  DO   â†’ Solenoid A (extend coil)
//       "Output_Cyl1_SolB"    Bool  DO   â†’ Solenoid B (retract coil, for 5/3)
//
//  2) Call in OB1 in this order (order matters -- sensors must run before cylinder FB):
//       "DB_Sen_Cyl1_Setpt"(RawInput := "In_Cyl1_AtSetpoint");
//       "DB_Sen_Cyl1_Ret"(RawInput   := "In_Cyl1_AtRetract");   // optional
//       "DB_Cylinder1"(
//           SafetyOK       := "Safety_Estop" OR "DB_HMI".Bypass_EStop,
//           Sen_AtSetpoint := "DB_Sen_Cyl1_Setpt".State,
//           Sen_AtRetract  := "DB_Sen_Cyl1_Ret".State
//       );
//       "Output_Cyl1_SolA" := "DB_Cylinder1".Sol_A;
//       "Output_Cyl1_SolB" := "DB_Cylinder1".Sol_B;
//
//  3) Connect DB_Cylinder1 tags in HMI (see table below)
//
//  4) Set DB_Cylinder1.ValveType correctly:
//       2 = 5/3 blocked center  (default, required for ruler mode)
//       1 = 5/2 spring return   (single solenoid, intermediate hold not reliable)
//
// â”€â”€â”€ HMI SCREEN CONNECTIONS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
//
//  Writable (HMI â†’ PLC):
//    DB_Cylinder1.Cmd_Extend      Bool   Extend button
//    DB_Cylinder1.Cmd_ExtendFull  Bool   Full extend button -- bypass sensors/ruler; release = stop (pulse use)
//    DB_Cylinder1.Cmd_Retract     Bool   Retract button
//    DB_Cylinder1.Cmd_RetractFull Bool   Full retract button -- bypass sensors/ruler; release = stop (pulse use)
//    DB_Cylinder1.Timeout_Extend  Time   Extend timeout (Modes 0/1/3, default T#5S)
//    DB_Cylinder1.Timeout_Retract Time   Retract timeout (Modes 0/1, default T#5S)
//    DB_Cylinder1.TargetPos       Real   Mode 3: ruler stop position (mm) -- set from HMI or recipe
//    DB_Cylinder1.ValveType       Byte   Valve type (set during commissioning)
//
//  Read-only (PLC â†’ HMI):
//    DB_Cylinder1.State           Int    State code (see STATE CODES)
//    DB_Cylinder1.StateText       String State text
//    DB_Cylinder1.AtSetpoint      Bool   Lamp: locked at setpoint (Modes 0/1)
//    DB_Cylinder1.AtRetract       Bool   Lamp: at retract end (Modes 0/1)
//    DB_Cylinder1.AtTarget        Bool   Lamp: within Tolerance of TargetPos (Mode 2)
//    DB_Cylinder1.PosError        Real   Position error mm (Mode 2)
//    DB_Cylinder1.Error           Bool   Lamp: error present
//    DB_Cylinder1.ErrorID         Word   Error code (display in hex)
//    DB_Cylinder1.Sol_A           Bool   Lamp: SolA energized (for debug)
//    DB_Cylinder1.Sol_B           Bool   Lamp: SolB energized (for debug)
//
//  Sensor status (read-only, for debug screen):
//    DB_Sen_Cyl1_Setpt.State      Bool   Setpoint sensor active?
//    DB_Sen_Cyl1_Ret.State        Bool   Retract end sensor active?
//
// â”€â”€â”€ MANUAL TEST USAGE â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
//
//  Cylinder FB is called every scan from OB1 -- independent of the state machine.
//  While SafetyOK=TRUE (E-Stop OK or bypass), HMI commands work regardless of
//  whether the machine is in MANUAL, AUTO, or STOPPED mode.
//
//  Test scenarios:
//
//  [A] Full extend (Modes 0/1):
//        Cmd_ExtendFull = TRUE (maintained button)
//        Cylinder extends until Timeout_Extend expires.
//        Returns to Idle when button is released.
//
//  [B] Move to setpoint and hold (5/3 valve, Mode 1):
//        Give Cmd_Extend = TRUE once (momentary sufficient)
//        When Sen_AtSetpoint=TRUE, FB stops and locks. State=3.
//        To retract: Cmd_Retract = TRUE.
//
//  [C] Move to setpoint and hold (5/2 valve, Mode 1):
//        Cmd_Extend = TRUE MUST BE HELD.
//        When Sen_AtSetpoint=TRUE, Sol_A=TRUE is maintained (pressure hold).
//        If button released, spring retracts.
//
//  [D] Retract without sensor (Mode 0):
//        Cmd_Retract = TRUE
//        Transitions to Idle after Timeout_Retract -- no error.
//
//  [E] Ruler zone-pulse positioning (Mode 2, ValveType=2):
//        Set TargetPos (mm). Give Cmd_GotoPos rising edge (or Cmd_Extend/Cmd_Retract).
//        FB fires zone-calculated pulses. Direction auto-selected from PosError sign.
//        After each pulse: solenoid off (mechanical lock) â†’ wait SettleTime â†’ evaluate.
//        Repeats until within Tolerance or MaxCorrections reached (error 16#0505).
//        Each pulse lets the piston travel, then holds; position approaches target step by step.
//
//  [F] Clear error:
//        State=10 (ERROR) â†’ give any command â†’ State=0 (Idle).
//
// â”€â”€â”€ VALVE TYPE SELECTION â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
//
//  ValveType=1 (5/2 Spring Return):
//    Sol_A=TRUE  â†’ piston extends.  Sol_A=FALSE â†’ piston retracts (spring).
//    Sol_B is never used.
//    âš  On power loss, piston returns to spring position (retracted).
//
//  ValveType=2 (5/3 Blocked Center) -- recommended, required for Mode 2:
//    Sol_A=TRUE, Sol_B=FALSE â†’ extends
//    Sol_A=FALSE, Sol_B=TRUE â†’ retracts
//    Sol_A=FALSE, Sol_B=FALSE â†’ mechanical lock (piston stays in place)
//    âš  On power loss, piston is locked (remains in current position).
//    âš  Purchase BLOCKED CENTER -- do NOT use EXHAUST CENTER (releases on power loss).
//
//  ValveType=3 (5/3 Exhaust Center):
//    Not suitable for holding intermediate positions.
//
// â”€â”€â”€ POSITIONING MODES â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
//
//  Mode 0 (No sensor):      Cmd_Extend = full stroke; timeout = done, no error.
//  Mode 1 (Magn. switch):   Cmd_Extend waits for Sen_AtSetpoint; timeout = error 16#0501.
//  Mode 2 (Linear ruler):   Zone-pulse positioning. ValveType must be 2.
//                           No digital end sensors used in this mode.
//  Mode 3 (Ruler setpoint): Cmd_Extend/Cmd_GotoPos extends until RulerValue >= TargetPos; solenoid cuts immediately.
//                           TargetPos (mm) is set from HMI (Cyl_TargetPos) or recipe CMD=40 (Param Ã— Cmd40_Gain).
//                           Sol_A held on during extend; solenoid cuts when position reached.
//                           5/3 blocked-center valve recommended (mechanical lock holds position).
//                           RulerValid=FALSE â†’ error 16#0504. Timeout â†’ error 16#0506.
//
// â”€â”€â”€ STATE CODES â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
//   -1 = E-Stop        SafetyOK=FALSE, all outputs off
//    0 = Idle           No command / waiting
//    1 = Extending      Sol_A=TRUE, waiting for setpoint or timeout (Modes 0/1)
//    2 = Retracting     5/3:Sol_B=TRUE / 5/2:spring (Modes 0/1)
//    3 = At Setpoint    Held at target position, locked (Modes 1/3)
//    4 = At Retract     Retract end sensor triggered (Mode 1)
//    5 = Ruler Pulse    Solenoid firing for zone-calculated duration (Mode 2)
//    7 = Ruler Hold     Both solenoids off (mechanical lock); settles then evaluates (Mode 2)
//   10 = ERROR          Fault condition -- clears on next command
//
// â”€â”€â”€ ERROR CODES â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
//   16#0501 = Extend timeout   -- Sen_AtSetpoint not received within Timeout_Extend (Mode 1)
//   16#0502 = Retract timeout  -- reserved
//   16#0503 = Sensor conflict        -- Sen_AtSetpoint AND Sen_AtRetract TRUE simultaneously
//   16#0504 = Ruler invalid          -- RulerValid=FALSE during ruler motion (Mode 2)
//   16#0505 = Max corrections        -- MaxCorrections pulses fired without reaching Tolerance (Mode 2)
//   16#0506 = Ruler setpoint timeout -- RulerValue did not reach TargetPos within Timeout_Extend (Mode 3)
//
// â”€â”€â”€ RULER MODE ZONE-PULSE PARAMETERS (Mode 2) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
//
//   Zone boundaries are distances from target (mm), all HMI-configurable.
//   The FB selects the pulse duration based on ABS(PosError):
//
//     ABS(PosError) <= Zone1_Limit              â†’ Pulse_Short
//     Zone1_Limit  < ABS(PosError) <= Zone2_Limit â†’ Pulse_Medium
//     Zone2_Limit  < ABS(PosError) <= Zone3_Limit â†’ Pulse_Long
//                    ABS(PosError)  > Zone3_Limit â†’ Pulse_Max
//
//   After each pulse: solenoid off â†’ wait SettleTime â†’ evaluate position â†’ repeat or done.
//   Direction (extend/retract) is auto-selected each pulse from PosError sign.
//   The solenoid is never on longer than the selected pulse duration.
//
// â”€â”€â”€ ADDING A NEW CYLINDER â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
//   1) Add new instance DBs to 02_DataBlocks.scl:
//        DATA_BLOCK "DB_Cylinder2" ... "FB_CylinderControl"
//        DATA_BLOCK "DB_Sen_Cyl2_Setpt" ... "FB_DigitalSensor"
//   2) Define physical tags in TIA Portal
//   3) Add calls to 08_Main_OB1.scl (sensors before cylinder FB)
//   4) Connect physical outputs: Output_Cyl2_SolA/B := DB_Cylinder2.Sol_A/B
// -----------------------------------------------------------------------------
   VAR_INPUT 
      ValveType : Byte := 2;   // 1=5/2_spring  2=5/3_blocked  3=5/3_exhaust Safety -- connected in OB1
      SafetyOK : Bool := FALSE;   // E-Stop OK â†’ output permission Commands -- HMI writes to instance DB, not connected in OB1
      Cmd_Extend : Bool := FALSE;   // Extend: move to setpoint (Mode 1) or TargetPos (Mode 2)
      Cmd_ExtendFull : Bool := FALSE;   // Full extend: bypass sensors/ruler, timeout = done; release = stop (pulse use)
      Cmd_Retract : Bool := FALSE;   // Retract
      Cmd_RetractFull : Bool := FALSE;   // Full retract: bypass sensors/ruler, timeout = done; release = stop (pulse use) Sensor inputs -- connected from FB_DigitalSensor.State in OB1 (Modes 0/1)
      Sen_AtSetpoint : Bool := FALSE;   // Mid/target point magnetic switch (Mode 1)
      Sen_AtRetract : Bool := FALSE;   // Retract end magnetic switch (optional) Timeout -- Modes 0, 1, and 3
      Timeout_Extend : Time := T#5S;
      Timeout_Retract : Time := T#5S;   // Positioning mode -- set from HMI during commissioning 0 = No sensor:     Cmd_Extend acts as full stroke; timeout = done, no error 1 = Magn. switch:  Cmd_Extend waits for Sen_AtSetpoint; timeout = error 16#0501 2 = Linear ruler:  Zone-pulse positioning toward TargetPos; ValveType must be 2 3 = Ruler setpoint: Extend until RulerValue >= TargetPos; solenoid cuts immediately; timeout = error 16#0506
      PositioningMode : Byte := 0;   // Ruler inputs (Modes 2 and 3) -- connect in OB1
      Cmd_GotoPos : Bool := FALSE;   // Rising edge: go to TargetPos (Mode 2 = zone-pulse, Mode 3 = extend until reached)
      RulerValue : Real := 0.0;   // [Modes 2+3] Current position (mm) -- connect to DB_LinearRuler.Value
      RulerValid : Bool := FALSE;   // [Modes 2+3] Measurement valid -- connect to DB_LinearRuler.Valid
      TargetPos : Real := 0.0;   // [Modes 2+3] Target position (mm); clamped by MinPos/MaxPos Ruler position clamp (Modes 2 and 3, 0 = disabled)
      MaxPos : Real := 0.0;   // Max allowed position (mm); clamps TargetPos
      MinPos : Real := 0.0;   // Min allowed position (mm); clamps TargetPos [Mode 2 - Zone-pulse] Accuracy
      Tolerance : Real := 20.0;   // Acceptable position error (mm)
      MaxCorrections : Int := 10;   // Max total pulses before error 16#0505 [Mode 2 - Zone-pulse] Timing
      SettleTime : Time := T#300MS;   // Wait after each pulse before evaluating position [Mode 2 - Zone-pulse] Zone thresholds and pulse durations -- all HMI-configurable Pulse duration is selected by ABS(PosError):   ABS(error) <= Zone1_Limit              â†’ Pulse_Short   (fine correction, near target)   Zone1_Limit < ABS(error) <= Zone2_Limit â†’ Pulse_Medium   Zone2_Limit < ABS(error) <= Zone3_Limit â†’ Pulse_Long                ABS(error)  > Zone3_Limit  â†’ Pulse_Max    (large initial move)
      Zone1_Limit : Real := 10.0;   // [Mode 2 - Zone-pulse] Fine zone boundary (mm)
      Zone2_Limit : Real := 50.0;   // [Mode 2 - Zone-pulse] Medium zone boundary (mm)
      Zone3_Limit : Real := 100.0;   // [Mode 2 - Zone-pulse] Coarse zone boundary (mm)
      Pulse_Short : Time := T#50MS;   // [Mode 2 - Zone-pulse] Finest correction pulse
      Pulse_Medium : Time := T#100MS;   // [Mode 2 - Zone-pulse]
      Pulse_Long : Time := T#250MS;   // [Mode 2 - Zone-pulse]
      Pulse_Max : Time := T#1S;   // [Mode 2 - Zone-pulse] Large initial move pulse
   END_VAR

   VAR_OUTPUT 
      Sol_A : Bool;   // Extend solenoid output
      Sol_B : Bool;   // Retract solenoid output (5/3 only)
      State : Int;   // State code
      StateText : String[14];   // HMI state text
      AtSetpoint : Bool;   // Held at setpoint sensor (Modes 0/1)
      AtRetract : Bool;   // Confirmed at retract end (Modes 0/1)
      AtTarget : Bool;   // Mode 2: within Tolerance of TargetPos
      PosError : Real;   // Mode 2: RulerValue - TargetPos (mm)
      Error : Bool;   // Active error
      ErrorID : Word;   // Error code (16#05xx)
   END_VAR

   VAR 
      extendFull : Bool;   // ExtendFull mode active (Modes 0/1)
      retractFull : Bool;   // RetractFull mode active
      gotoTargetLatch : Bool;   // GotoPos latch for Mode 3: keeps extending after button release
      tExtend {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;   // Extend timeout (Modes 0/1/3)
      tRetract {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;   // Retract timeout (Modes 0/1) Recipe CMD=40 gain: TargetPos = Param Ã— Cmd40_Gain (mm). Set in FC_LoadConfig; adjustable from HMI at runtime.
      Cmd40_Gain : Real := 1.0;
      prevCmdGotoPos : Bool;   // Previous Cmd_GotoPos value (rising edge detection)
      corrAttempts : Int;   // Total pulses fired this move (reset on new command)
      tPulse {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;   // Mode 2: pulse duration timer (State 5)
      pulseExtend : Bool;   // Mode 2: TRUE = current pulse is extend direction
      calculatedPulse : Time;   // Mode 2: zone-selected pulse duration
      tSettle {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;   // Mode 2: post-pulse settle timer (State 7)
      inSettling : Bool;   // Mode 2: TRUE = waiting for piston to stop CMD=41 atmosphere override (BackSupport only; unused/FALSE on all other cylinders) Written by FB_RecipeHandler; consumed as OR override in OB1 output assignment.
      SolB_Cmd41 : Bool := FALSE;   // CMD=41 Param=1: hold Sol_B ON independently of state machine
      SolAtmo_Cmd : Bool := FALSE;   // CMD=41 Param=1: ON / Param=2: OFF
   END_VAR

   VAR_TEMP 
      effectiveTarget : Real;   // TargetPos clamped to MinPos/MaxPos
      absError : Real;   // ABS(PosError) used for zone selection
   END_VAR


BEGIN
	
	// â”€â”€ Safety: SafetyOK=FALSE â†’ all outputs off, state=-1 â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	IF NOT #SafetyOK THEN
	    #Sol_A := FALSE;
	    #Sol_B := FALSE;
	    #State := -1;
	    #StateText := 'E-Stop';
	    #AtSetpoint := FALSE;
	    #AtRetract := FALSE;
	    RETURN;
	END_IF;
	
	// â”€â”€ Sensor conflict check (Modes 0/1) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	IF #Sen_AtSetpoint AND #Sen_AtRetract THEN
	    #Sol_A := FALSE;
	    #Sol_B := FALSE;
	    #State := 10;
	    #Error := TRUE;
	    #ErrorID := 16#0503;
	    #StateText := 'ERROR';
	    RETURN;
	END_IF;
	
	// â”€â”€ Timeout timers (Modes 0/1 only -- States 1 and 2) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	#tExtend(IN := (#State = 1),
	         PT := #Timeout_Extend);
	#tRetract(IN := (#State = 2),
	          PT := #Timeout_Retract);
	
	// â”€â”€ Effective target: clamp TargetPos to MinPos/MaxPos â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	IF #MaxPos > 0.0 AND #TargetPos > #MaxPos THEN
	    #effectiveTarget := #MaxPos;
	ELSIF #MinPos > 0.0 AND #TargetPos < #MinPos THEN
	    #effectiveTarget := #MinPos;
	ELSE
	    #effectiveTarget := #TargetPos;
	END_IF;
	
	// â”€â”€ State machine â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	CASE #State OF
	        
	    -1: // E-Stop cleared â†’ go to Idle
	        #State := 0;
	        
	    0: // IDLE -- waiting for command
	        #Error := FALSE;
	        #ErrorID := 16#0000;
	        #AtTarget := FALSE;
	        #PosError := 0.0;
	        #corrAttempts := 0;
	        #inSettling := FALSE;
	        #gotoTargetLatch := FALSE;
	        
	        IF #Cmd_ExtendFull THEN
	            // Full stroke: ignores all sensors, timeout = mechanical end = done
	            #extendFull := TRUE;
	            #State := 1;
	            
	        ELSIF #Cmd_Extend THEN
	            CASE #PositioningMode OF
	                0: // No sensor -- full stroke
	                    #extendFull := TRUE;
	                    #State := 1;
	                1: // Magnetic switch
	                    #extendFull := FALSE;
	                    #State := 1;
	                2: // Ruler -- zone-pulse toward TargetPos (direction auto-selected)
	                    IF NOT #RulerValid THEN
	                        #State := 10;
	                        #Error := TRUE;
	                        #ErrorID := 16#0504;
	                    ELSE
	                        #State := 5;
	                    END_IF;
	                3: // Ruler setpoint -- extend until RulerValue >= TargetPos
	                    IF NOT #RulerValid THEN
	                        #State := 10;
	                        #Error := TRUE;
	                        #ErrorID := 16#0504;
	                    ELSIF #effectiveTarget > 0.0 AND #RulerValue >= #effectiveTarget THEN
	                        #State := 3;   // Already at or past target position: lock immediately
	                    ELSE
	                        #extendFull := FALSE;
	                        #State := 1;
	                    END_IF;
	                ELSE:
	                    #extendFull := TRUE;
	                    #State := 1;
	            END_CASE;
	            
	        ELSIF #Cmd_Retract THEN
	            IF #PositioningMode = 2 THEN
	                // Ruler mode: zone-pulse toward TargetPos (direction auto-selected)
	                IF NOT #RulerValid THEN
	                    #State := 10;
	                    #Error := TRUE;
	                    #ErrorID := 16#0504;
	                ELSE
	                    #State := 5;
	                END_IF;
	            ELSE
	                #State := 2;
	            END_IF;
	            
	        ELSIF #Cmd_RetractFull THEN
	            // Full retract: bypass all sensors and ruler, retract while held
	            #retractFull := TRUE;
	            #State := 2;
	            
	        ELSIF #Cmd_GotoPos AND NOT #prevCmdGotoPos AND (#PositioningMode = 2 OR #PositioningMode = 3) THEN
	            // Rising edge: go to configured target (Mode 2 = zone-pulse, Mode 3 = extend to level)
	            IF #PositioningMode = 2 THEN
	                IF NOT #RulerValid THEN
	                    #State := 10;
	                    #Error := TRUE;
	                    #ErrorID := 16#0504;
	                ELSIF ABS(#RulerValue - #effectiveTarget) <= #Tolerance THEN
	                    #State := 7;   // Already within tolerance -- lock immediately
	                ELSE
	                    #State := 5;
	                END_IF;
	            ELSE // Mode 3: latched extend to TargetPos
	                IF NOT #RulerValid THEN
	                    #State := 10;
	                    #Error := TRUE;
	                    #ErrorID := 16#0504;
	                ELSIF #effectiveTarget > 0.0 AND #RulerValue >= #effectiveTarget THEN
	                    #State := 3;   // Already at or past target -- lock immediately
	                ELSE
	                    #gotoTargetLatch := TRUE;
	                    #extendFull := FALSE;
	                    #State := 1;
	                END_IF;
	            END_IF;
	        END_IF;
	        #prevCmdGotoPos := #Cmd_GotoPos;
	        
	    1: // EXTENDING -- Sol_A=TRUE, waiting for setpoint or timeout (Modes 0/1/3)
	        IF #PositioningMode = 3 AND NOT #extendFull THEN
	            // Mode 3: watch ruler every scan; cut solenoid when position reached
	            IF NOT #RulerValid THEN
	                #State := 10;
	                #Error := TRUE;
	                #ErrorID := 16#0504;
	            ELSIF #effectiveTarget > 0.0 AND #RulerValue >= #effectiveTarget THEN
	                #State := 3;                  // Position reached: solenoid cuts next scan
	            ELSIF #tExtend.Q THEN
	                #State := 10;
	                #Error := TRUE;
	                #ErrorID := 16#0506;
	            ELSIF NOT #Cmd_Extend AND NOT #Cmd_ExtendFull AND NOT #gotoTargetLatch THEN
	                #State := 0;
	            END_IF;
	        ELSIF #Sen_AtSetpoint AND NOT #extendFull AND #PositioningMode = 1 THEN
	            #State := 3;
	            #extendFull := FALSE;
	        ELSIF #tExtend.Q THEN
	            IF #extendFull THEN
	                // ExtendFull: timeout = mechanical end = success
	                #extendFull := FALSE;
	                #State := 3;
	            ELSE
	                #State := 10;
	                #Error := TRUE;
	                #ErrorID := 16#0501;
	            END_IF;
	        ELSIF NOT #Cmd_Extend AND NOT #Cmd_ExtendFull THEN
	            #State := 0;
	            #extendFull := FALSE;
	        END_IF;
	        
	    2: // RETRACTING -- 5/3:Sol_B=TRUE / 5/2:spring (Modes 0/1)
	        IF #Sen_AtRetract THEN
	            #retractFull := FALSE;
	            #State := 4;
	        ELSIF #tRetract.Q THEN
	            // Timeout = normal completion (no sensor, or sensor absent)
	            #retractFull := FALSE;
	            IF #PositioningMode = 0 THEN
	                #State := 4;   // Mode 0: hold retract solenoid until extend commanded
	            ELSE
	                #State := 0;
	            END_IF;
	        ELSIF NOT #Cmd_Retract AND NOT #Cmd_RetractFull THEN
	            #retractFull := FALSE;
	            #State := 0;
	        END_IF;
	        
	    3: // AT SETPOINT -- held at sensor (Mode 1/3)
	        #gotoTargetLatch := FALSE;
	        IF #Cmd_Retract OR #Cmd_RetractFull THEN
	            #retractFull := #Cmd_RetractFull;
	            #State := 2;
	        ELSIF #Cmd_ExtendFull THEN
	            // Pulse extend from locked position: bypass ruler/sensor
	            #extendFull := TRUE;
	            #State := 1;
	        ELSIF #ValveType = 1 AND NOT #Cmd_Extend AND NOT #Cmd_ExtendFull AND #PositioningMode <> 0 THEN
	            // 5/2: Cmd_Extend released â†’ spring retracts (Mode 0: hold until retract commanded)
	            #State := 2;
	        END_IF;
	        
	    4: // AT RETRACT -- confirmed by Sen_AtRetract=TRUE (Mode 1)
	        IF #Cmd_ExtendFull THEN
	            #extendFull := TRUE;
	            #State := 1;
	        ELSIF #Cmd_Extend THEN
	            CASE #PositioningMode OF
	                0:
	                    #extendFull := TRUE;
	                    #State := 1;
	                1:
	                    #extendFull := FALSE;
	                    #State := 1;
	                2:
	                    IF NOT #RulerValid THEN
	                        #State := 10;
	                        #Error := TRUE;
	                        #ErrorID := 16#0504;
	                    ELSE
	                        #State := 5;
	                    END_IF;
	                3: // Ruler setpoint -- extend until RulerValue >= TargetPos
	                    IF NOT #RulerValid THEN
	                        #State := 10;
	                        #Error := TRUE;
	                        #ErrorID := 16#0504;
	                    ELSIF #effectiveTarget > 0.0 AND #RulerValue >= #effectiveTarget THEN
	                        #State := 3;   // Already at or past target position
	                    ELSE
	                        #extendFull := FALSE;
	                        #State := 1;
	                    END_IF;
	                ELSE:
	                    #extendFull := TRUE;
	                    #State := 1;
	            END_CASE;
	        ELSIF #Cmd_GotoPos AND NOT #prevCmdGotoPos AND (#PositioningMode = 2 OR #PositioningMode = 3) THEN
	            IF #PositioningMode = 2 THEN
	                IF NOT #RulerValid THEN
	                    #State := 10;
	                    #Error := TRUE;
	                    #ErrorID := 16#0504;
	                ELSIF ABS(#RulerValue - #effectiveTarget) <= #Tolerance THEN
	                    #State := 7;
	                ELSE
	                    #corrAttempts := 0;
	                    #State := 5;
	                END_IF;
	            ELSE // Mode 3: latched extend to TargetPos
	                IF NOT #RulerValid THEN
	                    #State := 10;
	                    #Error := TRUE;
	                    #ErrorID := 16#0504;
	                ELSIF #effectiveTarget > 0.0 AND #RulerValue >= #effectiveTarget THEN
	                    #State := 3;
	                ELSE
	                    #gotoTargetLatch := TRUE;
	                    #extendFull := FALSE;
	                    #State := 1;
	                END_IF;
	            END_IF;
	        END_IF;
	        
	    5: // RULER_PULSE -- fires solenoid for zone-calculated duration (Mode 2)
	        //
	        // On first scan in this state (tPulse not yet running):
	        //   1. Calculate PosError and direction (pulseExtend).
	        //   2. Select pulse duration from zone table.
	        //   3. Start tPulse.
	        // On subsequent scans: hold solenoid on until tPulse.Q.
	        // No operator escape during pulse -- SettleTime is short, wait for State 7.
	        // Only exception: ruler loss â†’ immediate fault.
	        IF NOT #RulerValid THEN
	            // Safety: ruler lost during pulse -- cut solenoid and fault
	            #tPulse(IN := FALSE,
	                    PT := T#0ms);
	            #State := 10;
	            #Error := TRUE;
	            #ErrorID := 16#0504;
	        ELSE
	            // Entry: calculate direction and zone-pulse duration
	            IF #tPulse.ET = T#0ms THEN
	                #PosError := #RulerValue - #effectiveTarget;
	                #pulseExtend := #PosError < 0.0;    // undershoot â†’ extend; overshoot â†’ retract
	                #absError := ABS(#PosError);
	                
	                IF #absError <= #Zone1_Limit THEN
	                    #calculatedPulse := #Pulse_Short;
	                ELSIF #absError <= #Zone2_Limit THEN
	                    #calculatedPulse := #Pulse_Medium;
	                ELSIF #absError <= #Zone3_Limit THEN
	                    #calculatedPulse := #Pulse_Long;
	                ELSE
	                    #calculatedPulse := #Pulse_Max;
	                END_IF;
	            END_IF;
	            
	            // Run pulse timer
	            #tPulse(IN := TRUE,
	                    PT := #calculatedPulse);
	            
	            IF #tPulse.Q THEN
	                // Pulse complete: cut solenoid, go to settle + evaluate
	                #tPulse(IN := FALSE,
	                        PT := #calculatedPulse);
	                #corrAttempts := #corrAttempts + 1;
	                #inSettling := TRUE;
	                #State := 7;
	            END_IF;
	        END_IF;
	        
	    7: // RULER_HOLD -- both solenoids off, 5/3 mechanical lock (Mode 2)
	        //
	        // Phase 1 (inSettling=TRUE): wait SettleTime for piston to stop.
	        // Phase 2 (inSettling=FALSE): evaluate position.
	        //   - Within Tolerance â†’ AtTarget=TRUE, hold here.
	        //   - Not at target, pulses remaining â†’ fire next pulse (State 5).
	        //   - Not at target, pulses exhausted â†’ error 16#0505.
	        // Operator commands always take priority in Phase 2.
	        // During Phase 1: wait it out (SettleTime is short).
	        #tSettle(IN := #inSettling,
	                 PT := #SettleTime);
	        IF #tSettle.Q THEN
	            #inSettling := FALSE;
	            #tSettle(IN := FALSE,
	                     PT := #SettleTime);
	        END_IF;
	        
	        IF NOT #inSettling THEN
	            // Phase 2: evaluate position
	            #PosError := #RulerValue - #effectiveTarget;
	            #AtTarget := ABS(#PosError) <= #Tolerance;
	            
	            // Operator commands take priority
	            IF #Cmd_GotoPos AND NOT #prevCmdGotoPos THEN
	                // Re-issue (e.g. TargetPos changed): restart pulse loop
	                IF #RulerValid AND NOT #AtTarget THEN
	                    #corrAttempts := 0;
	                    #inSettling := TRUE;
	                    #State := 5;
	                END_IF;
	            ELSIF #Cmd_ExtendFull THEN
	                // Full stroke override
	                #AtTarget := FALSE;
	                #PosError := 0.0;
	                #corrAttempts := 0;
	                #extendFull := TRUE;
	                #State := 1;
	            ELSIF #Cmd_Retract OR #Cmd_Extend THEN
	                // Manual command while holding: restart toward TargetPos only if not already there
	                IF NOT #AtTarget THEN
	                    #AtTarget := FALSE;
	                    #PosError := 0.0;
	                    #corrAttempts := 0;
	                    #inSettling := TRUE;
	                    #State := 5;
	                END_IF;
	            ELSIF NOT #AtTarget AND #corrAttempts < #MaxCorrections THEN
	                // Auto: fire next correction pulse
	                #inSettling := TRUE;
	                #State := 5;
	            ELSIF NOT #AtTarget AND #corrAttempts >= #MaxCorrections THEN
	                #State := 10;
	                #Error := TRUE;
	                #ErrorID := 16#0505;
	            END_IF;
	        END_IF;
	        
	    10: // ERROR -- clears on any new command, on GotoPos retry, or auto-clears when
	        // idle (no command held). The idle auto-clear prevents a stale cylinder error
	        // (e.g. from an extend timeout) from blocking the next machine run without
	        // requiring the operator to press E-Stop to cycle SafetyOK.
	        IF #Cmd_Extend OR #Cmd_ExtendFull OR #Cmd_Retract OR #Cmd_RetractFull THEN
	            #Error := FALSE;
	            #ErrorID := 16#0000;
	            #State := 0;
	        ELSIF #Cmd_GotoPos AND NOT #prevCmdGotoPos AND (#PositioningMode = 2 OR #PositioningMode = 3) THEN
	            // GotoPos rising edge clears error and restarts motion
	            #Error := FALSE;
	            #ErrorID := 16#0000;
	            #corrAttempts := 0;
	            IF #PositioningMode = 2 THEN
	                IF NOT #RulerValid THEN
	                    #State := 10;
	                    #Error := TRUE;
	                    #ErrorID := 16#0504;
	                ELSIF ABS(#RulerValue - #effectiveTarget) <= #Tolerance THEN
	                    #State := 7;
	                ELSE
	                    #State := 5;
	                END_IF;
	            ELSE // Mode 3
	                IF NOT #RulerValid THEN
	                    #State := 10;
	                    #Error := TRUE;
	                    #ErrorID := 16#0504;
	                ELSIF #effectiveTarget > 0.0 AND #RulerValue >= #effectiveTarget THEN
	                    #State := 3;
	                ELSE
	                    #gotoTargetLatch := TRUE;
	                    #extendFull := FALSE;
	                    #State := 1;
	                END_IF;
	            END_IF;
	        ELSE
	            // No command held and no GotoPos request: auto-clear to IDLE.
	            // The cylinder will retry normally on the next Cmd_Extend.
	            #Error := FALSE;
	            #ErrorID := 16#0000;
	            #State := 0;
	        END_IF;
	        
	    ELSE
	        #State := 0;
	        
	END_CASE;
	
	// â”€â”€ Solenoid outputs â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	CASE #State OF
	    1: // EXTENDING (Modes 0/1)
	        #Sol_A := TRUE;
	        #Sol_B := FALSE;
	    2: // RETRACTING (Modes 0/1)
	        IF #ValveType = 1 THEN
	            #Sol_A := FALSE;
	            #Sol_B := FALSE;
	        ELSE
	            #Sol_A := FALSE;
	            #Sol_B := TRUE;
	        END_IF;
	    3: // AT SETPOINT (Mode 0/1/3)
	        IF #PositioningMode = 0 THEN
	            #Sol_A := TRUE;                              // Mode 0: hold until retract commanded
	            #Sol_B := FALSE;
	        ELSIF #ValveType = 1 THEN
	            #Sol_A := #Cmd_Extend OR #Cmd_ExtendFull;   // pressure hold
	            #Sol_B := FALSE;
	        ELSE
	            #Sol_A := FALSE;                             // 5/3 blocked: mechanical lock
	            #Sol_B := FALSE;
	        END_IF;
	    5: // RULER_PULSE: fire in zone-calculated direction (Mode 2)
	        IF #pulseExtend THEN
	            #Sol_A := TRUE;
	            #Sol_B := FALSE;
	        ELSE
	            #Sol_A := FALSE;
	            #Sol_B := TRUE;     // 5/3 blocked: active retract
	        END_IF;
	    4: // AT RETRACT (Mode 0/1)
	        IF #PositioningMode = 0 AND #ValveType <> 1 THEN
	            #Sol_A := FALSE;
	            #Sol_B := TRUE;                              // Mode 0 + 5/3: hold retract solenoid
	        ELSE
	            #Sol_A := FALSE;                             // Mode 1 or 5/2: both off
	            #Sol_B := FALSE;
	        END_IF;
	    7: // RULER_HOLD: mechanical lock (Mode 2)
	        #Sol_A := FALSE;
	        #Sol_B := FALSE;
	    ELSE
	        // IDLE, E-STOP, ERROR: both off
	        #Sol_A := FALSE;
	        #Sol_B := FALSE;
	END_CASE;
	
	// â”€â”€ Edge latch for Cmd_GotoPos -- updated every scan after state machine â”€â”€
	#prevCmdGotoPos := #Cmd_GotoPos;
	
	// â”€â”€ State text â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	CASE #State OF
	    -1:
	        #StateText := 'E-Stop';
	    0:
	        #StateText := 'Idle';
	    1:
	        IF #extendFull THEN
	            #StateText := 'Extend Full';
	        ELSE
	            #StateText := 'Extending';
	        END_IF;
	    2:
	        IF #retractFull THEN
	            #StateText := 'Retract Full';
	        ELSE
	            #StateText := 'Retracting';
	        END_IF;
	    3:
	        #StateText := 'At Setpoint';
	    4:
	        #StateText := 'At Retract';
	    5:
	        IF #pulseExtend THEN
	            #StateText := 'Pulse Extend';
	        ELSE
	            #StateText := 'Pulse Retract';
	        END_IF;
	    7:
	        #StateText := 'Ruler Hold';
	    10:
	        #StateText := 'ERROR';
	    ELSE:
	        #StateText := '?';
	END_CASE;
	
	// â”€â”€ Position confirmation outputs â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	#AtSetpoint := (#State = 3);
	#AtRetract := (#State = 4);
	// AtTarget and PosError are updated continuously in State 7 (RULER_HOLD)
	
END_FUNCTION_BLOCK

FUNCTION_BLOCK "FB_Process"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 4.0
// -----------------------------------------------------------------------------
// FB_Process - Main supervisory state machine with PRE-SCAN
// -----------------------------------------------------------------------------
   VAR_INPUT 
      Panel_Start : Bool;
      Panel_Stop : Bool;
      Panel_Pause : Bool;
      Panel_Reset : Bool;
      Rem_Start : Bool;
      Rem_Stop : Bool;
      EStop_OK : Bool := TRUE;   // NC limit switches (FALSE = limit hit, fail-safe)
      Door_Closed : Bool := TRUE;
      AirPressure_OK : Bool := TRUE;
      HW_NC_X_Min : Bool;   // PNP NO proximity sensors (TRUE = limit zone, pre-warning before NC)
      HW_NC_X_Max : Bool;
      HW_NC_Z_Min : Bool;
      HW_NC_Z_Max : Bool;
      HW_PNP_X_Min : Bool;
      HW_PNP_X_Max : Bool;
      HW_PNP_Z_Min : Bool;
      HW_PNP_Z_Max : Bool;
   END_VAR

   VAR_OUTPUT 
      Running : Bool;
      IsPaused : Bool;
      Error : Bool;
      StatusID : Int;
      CurrentTool : Int;
      SafeToRun : Bool;
   END_VAR

   VAR_IN_OUT 
      Axis_X {InstructionName := 'TO_PositioningAxis'; LibVersion := '8.0'} : TO_PositioningAxis;
      Axis_Z {InstructionName := 'TO_PositioningAxis'; LibVersion := '8.0'} : TO_PositioningAxis;
      Axis_Tool {InstructionName := 'TO_PositioningAxis'; LibVersion := '8.0'} : TO_PositioningAxis;
      Axis_Spindle {InstructionName := 'TO_PositioningAxis'; LibVersion := '8.0'} : TO_PositioningAxis;
   END_VAR

   VAR 
      State : Int;   // Recipe handlers (one per program for flexibility)
      fbRecipeHandler : "FB_RecipeHandler";
      fbPreScan : "FB_RecipePreScan";   // Support FBs
      fbToolChanger : "FB_ToolChanger";
      fbHomeX : "FB_Axis_Home";
      fbHomeZ : "FB_Axis_Home";
      fbHomeTool : "FB_Axis_Home";
      fbSpindleControl : "FB_SpindleControl";
      fbManualMode : "FB_ManualMode";
      fbPowerX : "FB_Axis_Power";
      fbPowerZ : "FB_Axis_Power";
      fbPowerTool : "FB_Axis_Power";
      fbResetX : "FB_Axis_Reset";
      fbResetZ : "FB_Axis_Reset";
      fbResetTool : "FB_Axis_Reset";
      fbResetSpindle : "FB_Axis_Reset";
      fbInputs : "FB_InputManager";
      fbLimitMonitor : "FB_LimitMonitor";
      fbSafetyMonitor : "FB_SafetyMonitor";
      fbAlarmManager : "FB_AlarmManager";   // Additional motion FBs for moving to position 0 after stop
      fbMoveX_Stop : "FB_Axis_AbsPos";   // Homing clearance moves (pre + post homing)
      fbMoveZ_Stop : "FB_Axis_AbsPos";   // Homing clearance moves (pre + post homing)
      fbMoveX_HomeClr : "FB_Axis_AbsPos";
      fbMoveZ_HomeClr : "FB_Axis_AbsPos";
      bHomeClrX : Bool;   // PNP proximity sensor halt: controlled stop when PNP zone entered in auto mode
      bHomeClrZ : Bool;   // PNP proximity sensor halt: controlled stop when PNP zone entered in auto mode
      fbHaltX_PNP : "FB_Axis_Halt";
      fbHaltZ_PNP : "FB_Axis_Halt";
      bHaltX_PNP : Bool;   // Halt execute flags (cleared when state returns to STOPPED) ITEM-31: reset/startup halt â€” aborts any MC_Home the TO may resume after drive power-cycle or warm restart
      bHaltZ_PNP : Bool;   // Halt execute flags (cleared when state returns to STOPPED) ITEM-31: reset/startup halt â€” aborts any MC_Home the TO may resume after drive power-cycle or warm restart
      fbHaltX_Reset : "FB_Axis_Halt";
      fbHaltZ_Reset : "FB_Axis_Halt";
      fbHaltTool_Reset : "FB_Axis_Halt";
      bHaltAllAxes : Bool;   // Pulse: TRUE for one scan; set by bDoHardReset + first-scan startup; cleared after FB calls Control flags
      bPreScanExec : Bool;
      bResetRecipe : Bool;   // One-shot flag to reset FB_RecipeHandler
      bStartSeq : Bool;
      bToolExecute : Bool;
      bPauseActive : Bool;
      bStopMoveX : Bool;   // Flags for moving to position 0 after stop Sequential homing (startup): home X then Z then Tool in active mode (mode 3)
      bStopMoveZ : Bool;   // Flags for moving to position 0 after stop Sequential homing (startup): home X then Z then Tool in active mode (mode 3)
      bHomeXExec : Bool;
      bHomeZExec : Bool;
      bHomeToolExec : Bool;
      homeSeqState : Int;   // 0=idle, 1=homing X, 2=homing Z, 3=homing Tool
      activeToolReq : Int;
      activeToolDone : Bool;
      newErrorFlag : Bool;
      newErrorCode : Word;
      bSpindleStart : Bool;
      bSpindleStop : Bool;
      bDrivesEnable : Bool;
      prevAckError : Bool;
      prevRestart : Bool;
      prevContinue : Bool;
      ackEdge : Bool;
      restartEdge : Bool;
      continueEdge : Bool;
      prevApplyToolConfig : Bool;   // previous ApplyToolConfig button state
      applyToolEdge : Bool;   // rising edge for apply tool mapping
      prevProdReset : Bool;
      prevLastCycleReset : Bool;
      prodResetEdge : Bool;
      lastCycleResetEdge : Bool;
      prevSafetyError : Bool;
      prevDriveFaultX : Bool;   // Edge detection: X drive power failure
      prevDriveFaultZ : Bool;   // Edge detection: Z drive power failure
      prevDriveFaultTool : Bool;   // ITEM-29: edge detection: tool axis drive power failure
      prevTOFaultX : Bool;   // Edge detection: X axis TO fault (StatusBits.Error poller)
      prevTOFaultZ : Bool;   // Edge detection: Z axis TO fault
      prevTOFaultTool : Bool;   // Edge detection: Tool axis TO fault
      prevTOFaultSpindle : Bool;   // Edge detection: Spindle TO fault
      bJogBlockPlus : Bool;   // Manual soft-limit jog gate: block jog+ (recomputed every scan)
      bJogBlockMinus : Bool;   // Manual soft-limit jog gate: block jog- (recomputed every scan)
      prevManualError : Bool;   // Edge detection: manual mode error
      bInitDone : Bool;   // TRUE after first PLC scan; prevents re-triggering startup reset
      bDoHardReset : Bool;   // Pulse: set TRUE to trigger hard-reset block this scan (startup + Cmd_Reset)
      applyIndex : Int;   // Loop index for tool config apply Active recipe reference
      activeProgram : Int;
      activeLineCount : Int;   // ToolHeadLock timers
      tonLockWait {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;   // Fallback timeout for states 17 and 29 (T#3S)
      tonLockPreDelay {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;   // Pre-delay before commanding extend in state 17 (T#1S) TRUE = LOCK_RETRACT_WAIT exits to STATE_STOPPED (axes already at zero from STOPPING) FALSE = exits to STATE_TOOL_CHANGE
      bLockAfterHoming : Bool;   // Sheet wait (STATE_SHEET_WAIT = 14)
      bSheetWaitPhase2 : Bool;   // Phase 2: MandrelLock extending (T#5S)
      bSheetWaitPhase3 : Bool;   // Phase 3: SheetHolder retracting (T#5S)
      tonMandrelWait {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;   // T#5S open-loop stroke wait for MandrelLock (phase 2)
      tonSheetHolderRetract {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;   // T#5S open-loop wait for SheetHolder retract (phase 3)
      bMandrelRetractPulse : Bool;   // One-shot: pulse Cmd_Retract for one scan to release MandrelLock FB from State 3
      bMandrelRetractPending : Bool;   // ITEM-32: deferred retract â€” unsafe paths (Reset/Error/Complete) set this; SpindleStopSafeTime timer promotes to pulse
      tonMandrelRetractWait {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;   // ITEM-32: safety gate timer for deferred retract (PT = DB_MachineConfig.SpindleStopSafeTime)
      bSheetHolderRetractPulse : Bool;   // One-shot: pulse Cmd_Retract for one scan to release SheetHolder FB from State 3
      bWaitingSpindleStop : Bool;   // TRUE while STATE_STOPPING waits for spindle decel before retracting MandrelLock
      tonSpindleStopWait {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;   // Proportional wait before MandrelLock retract (see SpindleStopSafeTime). Fires immediately if speed was 0.
      capturedSpindleRPM : Real;   // Speed captured when bWaitingSpindleStop is set (ITEM-28)
      spindleStopPT : Time;   // Proportional PT for tonSpindleStopWait (ITEM-28)
      bCycleCountDone : Bool;   // One-shot: prevents multiple CycleCount increments per cycle (ITEM-20) Cycle timer
      tonElapsed {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;   // Homing timeout: fires if STATE_HOMING sequence takes longer than 120s
      tonHomingTimeout {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;   // ITEM-30: independent timeout for STATE_STOP_GOHOME (was sharing tonHomingTimeout â€” risky if a normal homing cycle consumed most of the budget, leaving too little time for post-stop homing)
      tonStopHomeTimeout {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;   // Drive ready timeout: fires if drives do not become ready within 3s of STATE_STARTING
      tonDriveReady {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;   // Spindle deceleration wait
      tonSpindleDecel {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;   // Decel wait timer
      bSpindleDecelWait : Bool;   // TRUE while waiting for decel to complete
      bSpindlePendingStart : Bool;   // Deferred start captured during decel wait
      pendingSpindleSpeed : Real;   // Speed to apply when timer expires
      elapsedAccum : Time;   // Accumulated elapsed time
      timerRunning : Bool;   // Timer active flag
      elapsedSeconds : DInt;   // Seconds counter Warm restart
      savedLineIndex : Int := -1;   // Saved line for restart (-1 = none)
      savedProgram : Int := -1;   // Saved program for restart Production logging
      prevState : Int;   // For state edge detection
      prodTimeNow {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;
      prodTimeStatus : Int;   // Spindle history ring buffer: previous values for change detection A new snapshot is pushed only when one of these changes.
      prevSnap_State : Int;
      prevSnap_PrevStart : Bool;
      prevSnap_ReqStart : Bool;
      prevSnap_StartEdge : Bool;
      prevSnap_MoveVelBusy : Bool;   // MC_MoveVelocity.Busy -- triggers snapshot when TO accepts/drops command
   END_VAR

   VAR CONSTANT 
      STATE_STOPPED : Int := 0;
      STATE_MANUAL : Int := 5;
      STATE_STARTING : Int := 10;
      STATE_PRE_SCAN : Int := 12;
      STATE_PRE_HOME_CLR : Int := 13;   // Pre-homing clearance move out of PNP zone
      STATE_SHEET_WAIT : Int := 14;   // Sheet insertion: Ph1=SheetHolder extends+prompt, Ph2=MandrelLock T#5S, Ph3=SheetHolder retract T#5S â†’ LOCK_EXTEND_WAIT
      STATE_HOMING : Int := 15;
      STATE_POST_HOME_CLR : Int := 16;   // Post-homing clearance move away from PNP zone
      STATE_STOPPING : Int := 18;
      STATE_STOP_GOHOME : Int := 19;
      STATE_STOP_GOTOZERO : Int := 21;
      STATE_PNP_HALT : Int := 22;   // PNP limit zone -- halt active, reverse jog allowed
      STATE_RUNNING : Int := 20;
      STATE_PAUSED : Int := 25;
      STATE_TOOL_CHANGE : Int := 30;
      STATE_TOOL_WAIT : Int := 35;
      STATE_LOCK_EXTEND_WAIT : Int := 17;   // ToolHeadLock engaging before RUNNING
      STATE_LOCK_RETRACT_WAIT : Int := 29;   // ToolHeadLock releasing before tool change or homing
      STATE_ERROR : Int := 999;
   END_VAR


BEGIN
	
	// Update HMI displays
	"DB_HMI".ActualX := #Axis_X.ActualPosition;
	"DB_HMI".ActualZ := #Axis_Z.ActualPosition;
	"DB_HMI".MachineState := #State;
	
	// =========================================================================
	// FIRST-SCAN STARTUP INIT
	// =========================================================================
	// On the very first PLC scan after power-up or warm restart, trigger a hard
	// reset. This forces a known-clean machine state explicitly rather than
	// relying solely on NON_RETAIN default values. Covers any case where the
	// state machine variable did not reset cleanly (e.g. mid-homing on restart).
	IF NOT #bInitDone THEN
	    #bDoHardReset := TRUE;
	    #bHaltAllAxes := TRUE;   // ITEM-31: abort any MC_Home the TO may auto-resume on power-up
	    #bInitDone := TRUE;
	END_IF;
	
	// Edge detection for buttons
	#ackEdge := "DB_HMI".Btn_AckError AND NOT #prevAckError;
	#prevAckError := "DB_HMI".Btn_AckError;
	#restartEdge := "DB_HMI".Btn_Restart AND NOT #prevRestart;
	#prevRestart := "DB_HMI".Btn_Restart;
	#continueEdge := "DB_HMI".Btn_Continue AND NOT #prevContinue;
	#prevContinue := "DB_HMI".Btn_Continue;
	// Apply Tool Config edge
	#applyToolEdge := "DB_HMI".Btn_ApplyToolConfig AND NOT #prevApplyToolConfig;
	#prevApplyToolConfig := "DB_HMI".Btn_ApplyToolConfig;
	#prodResetEdge := "DB_HMI".Btn_ProdReset AND NOT #prevProdReset;
	#prevProdReset := "DB_HMI".Btn_ProdReset;
	#lastCycleResetEdge := "DB_HMI".Btn_LastCycleReset AND NOT #prevLastCycleReset;
	#prevLastCycleReset := "DB_HMI".Btn_LastCycleReset;
	
	// Get active program from HMI (lock during RUNNING to prevent mid-program switch)
	IF #State < #STATE_STARTING OR #State >= #STATE_ERROR THEN
	    #activeProgram := "DB_HMI".ProductSelect;
	    IF #activeProgram < 1 THEN
	        #activeProgram := 1;
	    END_IF;
	    IF #activeProgram > 5 THEN
	        #activeProgram := 5;
	    END_IF;
	END_IF;
	
	// Apply tool-slot mapping from HMI -> DB_ToolConfig when operator requests it.
	IF #applyToolEdge THEN
	    // Only copy up to 4 slots; respect configured ToolCount
	    FOR #applyIndex := 1 TO 4 DO
	        IF #applyIndex <= "DB_MachineConfig".ToolCount THEN
	            "DB_ToolConfig".ToolCode_List[#applyIndex] := "DB_HMI".ToolSlotCode[#applyIndex];
	        END_IF;
	    END_FOR;
	END_IF;
	
	// Safety monitor
	#fbSafetyMonitor(EStop_OK := #EStop_OK,
	                 Door_Closed := #Door_Closed,
	                 AirPressure_OK := #AirPressure_OK,
	                 DrivesReady := #fbPowerX.Status AND #fbPowerZ.Status,
	                 Bypass_EStop := "DB_HMI".Bypass_EStop,
	                 Bypass_Door := "DB_HMI".Bypass_Door,
	                 Bypass_AirPressure := "DB_HMI".Bypass_AirPressure,
	                 Bypass_Drives := "DB_HMI".Bypass_Drives);
	
	// Power control
	#bDrivesEnable := (#EStop_OK OR "DB_HMI".Bypass_EStop) AND (#State <> #STATE_ERROR);
	#fbPowerX(Enable := #bDrivesEnable,
	          Axis := #Axis_X);
	#fbPowerZ(Enable := #bDrivesEnable,
	          Axis := #Axis_Z);
	#fbPowerTool(Enable := #bDrivesEnable AND NOT "DB_MachineConfig".Bypass_ToolAxis,
	             Axis := #Axis_Tool);
	
	// Drive power failure detection -- capture TO ErrorID and write to diagnostic
	// Checked every scan; alarm is raised only when a new error occurs (rising edge).
	// STATE_PRE_SCAN(12) is treated like STATE_STOPPED(0): contactors are still open during
	// pre-scan (closed only in STATE_STARTING), so a drive fault here is typically a latched
	// fault from a previous run or a transient after TO reset -- not a new startup failure.
	// The drive ready check (tonDriveReady) and MC_Home.Error in STATE_STARTING handle genuine
	// startup faults. Firing STATE_ERROR in PRE_SCAN would abort the recipe validation for no reason.
	IF #fbPowerX.Error THEN
	    "DB_Diagnostic".Power_X_ErrorID := #fbPowerX.ErrorID;
	    "DB_Diagnostic".TO_ErrorText := "FC_TO_ErrorText"(Code := #fbPowerX.ErrorID);
	    IF NOT #prevDriveFaultX THEN
	        #newErrorFlag := TRUE;
	        #newErrorCode := 16#0009;
	        "DB_HMI".ErrorDetail := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
	        "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
	        IF #State <> #STATE_ERROR AND #State <> 0 AND #State <> #STATE_PRE_SCAN THEN
	            #State := #STATE_ERROR;
	        END_IF;
	    END_IF;
	    #prevDriveFaultX := TRUE;
	ELSE
	    #prevDriveFaultX := FALSE;
	END_IF;
	
	IF #fbPowerZ.Error THEN
	    "DB_Diagnostic".Power_Z_ErrorID := #fbPowerZ.ErrorID;
	    "DB_Diagnostic".TO_ErrorText := "FC_TO_ErrorText"(Code := #fbPowerZ.ErrorID);
	    IF NOT #prevDriveFaultZ THEN
	        #newErrorFlag := TRUE;
	        #newErrorCode := 16#000A;
	        "DB_HMI".ErrorDetail := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
	        "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
	        IF #State <> #STATE_ERROR AND #State <> 0 AND #State <> #STATE_PRE_SCAN THEN
	            #State := #STATE_ERROR;
	        END_IF;
	    END_IF;
	    #prevDriveFaultZ := TRUE;
	ELSE
	    #prevDriveFaultZ := FALSE;
	END_IF;
	
	// ITEM-29: tool axis drive power fault monitoring (mirrors X/Z pattern above)
	IF #fbPowerTool.Error THEN
	    "DB_Diagnostic".TO_ErrorText := "FC_TO_ErrorText"(Code := #fbPowerTool.ErrorID);
	    IF NOT #prevDriveFaultTool THEN
	        #newErrorFlag := TRUE;
	        #newErrorCode := 16#000D;
	        "DB_HMI".ErrorDetail := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
	        "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
	        IF #State <> #STATE_ERROR AND #State <> 0 AND #State <> #STATE_PRE_SCAN THEN
	            #State := #STATE_ERROR;
	        END_IF;
	    END_IF;
	    #prevDriveFaultTool := TRUE;
	ELSE
	    #prevDriveFaultTool := FALSE;
	END_IF;
	
	// =========================================================================
	// TO (Technology Object) FAULT POLLER
	// =========================================================================
	// Guarantees axis TO errors ALWAYS reach the HMI. The MC_ wrapper FBs only report
	// an ErrorID while their own command is active; a TO fault outside an active command
	// (following error, TO-internal soft-limit trip, encoder/drive fault at rest) was
	// previously visible only on the TIA Portal TO diagnostics page.
	// Polls <axis>.StatusBits.Error every scan, raises a motion-tier alarm on the rising
	// edge. Skipped while the matching MC_Power FB reports a fault (the drive-power blocks
	// above already raise the more specific 16#0009/16#000A/16#000D) and while E-Stop is
	// active (the safety tier owns that case; power removal marks every axis in error).
	// TO errors are cleared by the MC_Reset calls on AckError/Reset (fbResetX/Z/Tool/Spindle).
	IF #Axis_X.StatusBits.Error AND NOT #fbPowerX.Error AND #EStop_OK THEN
	    IF NOT #prevTOFaultX THEN
	        #newErrorFlag := TRUE;
	        #newErrorCode := 16#0021;
	        "DB_Diagnostic".Error_Text := 'TO fault: X axis (StatusBits.Error) - check TO diagnostics';
	        "DB_HMI".ErrorDetail := 'X axis technology object fault - press Ack/Reset to clear';
	        "DB_HMI".ErrorDetail_ES := 'Fallo de objeto tecnologico eje X - presionar Ack/Reset para borrar';
	        IF #State <> #STATE_ERROR AND #State <> 0 AND #State <> #STATE_PRE_SCAN THEN
	            #State := #STATE_ERROR;
	        END_IF;
	    END_IF;
	    #prevTOFaultX := TRUE;
	ELSE
	    #prevTOFaultX := FALSE;
	END_IF;
	
	IF #Axis_Z.StatusBits.Error AND NOT #fbPowerZ.Error AND #EStop_OK THEN
	    IF NOT #prevTOFaultZ THEN
	        #newErrorFlag := TRUE;
	        #newErrorCode := 16#0022;
	        "DB_Diagnostic".Error_Text := 'TO fault: Z axis (StatusBits.Error) - check TO diagnostics';
	        "DB_HMI".ErrorDetail := 'Z axis technology object fault - press Ack/Reset to clear';
	        "DB_HMI".ErrorDetail_ES := 'Fallo de objeto tecnologico eje Z - presionar Ack/Reset para borrar';
	        IF #State <> #STATE_ERROR AND #State <> 0 AND #State <> #STATE_PRE_SCAN THEN
	            #State := #STATE_ERROR;
	        END_IF;
	    END_IF;
	    #prevTOFaultZ := TRUE;
	ELSE
	    #prevTOFaultZ := FALSE;
	END_IF;
	
	IF #Axis_Tool.StatusBits.Error AND NOT #fbPowerTool.Error AND #EStop_OK
	    AND NOT "DB_MachineConfig".Bypass_ToolAxis THEN
	    IF NOT #prevTOFaultTool THEN
	        #newErrorFlag := TRUE;
	        #newErrorCode := 16#0023;
	        "DB_Diagnostic".Error_Text := 'TO fault: Tool axis (StatusBits.Error) - check TO diagnostics';
	        "DB_HMI".ErrorDetail := 'Tool axis technology object fault - press Ack/Reset to clear';
	        "DB_HMI".ErrorDetail_ES := 'Fallo de objeto tecnologico eje herramienta - presionar Ack/Reset para borrar';
	        IF #State <> #STATE_ERROR AND #State <> 0 AND #State <> #STATE_PRE_SCAN THEN
	            #State := #STATE_ERROR;
	        END_IF;
	    END_IF;
	    #prevTOFaultTool := TRUE;
	ELSE
	    #prevTOFaultTool := FALSE;
	END_IF;
	
	// Spindle: MC_Power lives inside fbSpindleControl (no fbPowerSpindle guard here).
	// A same-scan specific spindle error (16#05xx) from FB_SpindleControl wins the display
	// anyway (same tier, first-in latch); this poller is the safety net for faults at rest.
	IF #Axis_Spindle.StatusBits.Error AND #EStop_OK THEN
	    IF NOT #prevTOFaultSpindle THEN
	        #newErrorFlag := TRUE;
	        #newErrorCode := 16#0024;
	        "DB_Diagnostic".Error_Text := 'TO fault: Spindle (StatusBits.Error) - check TO diagnostics';
	        "DB_HMI".ErrorDetail := 'Spindle technology object fault - press Ack/Reset to clear';
	        "DB_HMI".ErrorDetail_ES := 'Fallo de objeto tecnologico husillo - presionar Ack/Reset para borrar';
	        IF #State <> #STATE_ERROR AND #State <> 0 AND #State <> #STATE_PRE_SCAN THEN
	            #State := #STATE_ERROR;
	        END_IF;
	    END_IF;
	    #prevTOFaultSpindle := TRUE;
	ELSE
	    #prevTOFaultSpindle := FALSE;
	END_IF;
	
	// Limit monitor
	#fbLimitMonitor(ActualPos_X := #Axis_X.ActualPosition,
	                ActualPos_Z := #Axis_Z.ActualPosition,
	                Homed_X := #Axis_X.StatusBits.HomingDone,
	                Homed_Z := #Axis_Z.StatusBits.HomingDone,
	                HW_NC_X_Min := #HW_NC_X_Min,
	                HW_NC_X_Max := #HW_NC_X_Max,
	                HW_NC_Z_Min := #HW_NC_Z_Min,
	                HW_NC_Z_Max := #HW_NC_Z_Max,
	                HW_PNP_X_Min := #HW_PNP_X_Min,
	                HW_PNP_X_Max := #HW_PNP_X_Max,
	                HW_PNP_Z_Min := #HW_PNP_Z_Min,
	                HW_PNP_Z_Max := #HW_PNP_Z_Max);
	// NOTE: FB_LimitMonitor itself now checks soft limits only for HOMED axes
	// (Homed_X/Z inputs = StatusBits.HomingDone) -- an un-homed axis can never trip a
	// soft limit. The state bypasses below remain as defense in depth:
	// During homing the axis may move outside soft limits (moving toward home switch).
	// All four homing-related states are bypassed: PRE_HOME_CLR, HOMING, POST_HOME_CLR,
	// and STOP_GOHOME. Without bypassing PRE/POST_HOME_CLR the clearance moves could
	// trip a spurious soft-limit fault before homing even begins (TO position = 0 after restart).
	// STATE_MANUAL and STATE_PNP_HALT are also bypassed: manual mode enforces soft limits
	// via directional jog gating + MoveAbsolute target rejection (never faults, so the
	// operator can always jog back into range).
	// STATE_PRE_SCAN(12) and STATE_STARTING(10) are bypassed because:
	//   PRE_SCAN: pure software validation, no motion -- TO position may be stale from last run.
	//   STARTING: contactors just closing, drives not yet ready -- homing will establish real position.
	// HW limit switch faults are caught by TO â†’ MC_Home.Error â†’ handled in state machine.
	IF #State = #STATE_HOMING OR #State = #STATE_STOP_GOHOME
	    OR #State = #STATE_PRE_HOME_CLR OR #State = #STATE_POST_HOME_CLR
	    OR #State = #STATE_MANUAL OR #State = #STATE_PNP_HALT
	    OR #State = #STATE_PRE_SCAN OR #State = #STATE_STARTING THEN
	    #SafeToRun := #fbSafetyMonitor.SafeToRun;   // Soft limit bypass
	ELSE
	    #SafeToRun := #fbSafetyMonitor.SafeToRun AND NOT #fbLimitMonitor.LimitError;
	END_IF;
	
	// Safety error handling
	// NOTE: Alarm is only raised from active states such as RUNNING/MANUAL.
	// No new alarm is raised in STOPPED (0) or ERROR (999) state;
	// this prevents drive enable delay after ACK/Reset from creating spurious alarms.
	IF NOT #fbSafetyMonitor.SafeToRun AND #fbSafetyMonitor.ErrorCode <> 0 THEN
	    IF NOT #prevSafetyError AND #State <> 0 AND #State <> #STATE_ERROR THEN
	        #newErrorFlag := TRUE;
	        #newErrorCode := #fbSafetyMonitor.ErrorCode;
	    END_IF;
	    IF #State <> 0 AND #State <> #STATE_ERROR THEN
	        #State := #STATE_ERROR;
	    END_IF;
	    #prevSafetyError := TRUE;
	ELSE
	    #prevSafetyError := FALSE;
	END_IF;
	
	// Soft limit error handling -- triggers STATE_ERROR when axis exceeds configured soft limits.
	// Un-homed axes never trip (FB_LimitMonitor Homed_X/Z gating -- position is meaningless
	// before the reference seek completes).
	// NC hardware limit switches are removed from LimitMonitor; TO handles them natively.
	// Bypassed in all four homing-related states: during homing the axis may legitimately
	// travel outside the configured limits while seeking the reference switch.
	// STATE_MANUAL and STATE_PNP_HALT also bypassed: manual mode enforces soft limits via
	// directional jog gating + MoveAbsolute target rejection instead of faulting.
	// STATE_PRE_SCAN(12) and STATE_STARTING(10) bypassed: TO position may be stale
	// from the previous run; firing here would abort startup for a position that was valid last run.
	IF #fbLimitMonitor.LimitError AND #fbLimitMonitor.ErrorCode <> 0
	    AND #State <> #STATE_HOMING AND #State <> #STATE_STOP_GOHOME
	    AND #State <> #STATE_PRE_HOME_CLR AND #State <> #STATE_POST_HOME_CLR
	    AND #State <> #STATE_MANUAL AND #State <> #STATE_PNP_HALT
	    AND #State <> #STATE_PRE_SCAN AND #State <> #STATE_STARTING
	    AND #State <> #STATE_STOPPED AND #State <> #STATE_ERROR THEN
	    #newErrorFlag := TRUE;
	    #newErrorCode := #fbLimitMonitor.ErrorCode;
	    #State := #STATE_ERROR;
	END_IF;
	
	// PNP proximity sensor halt -- auto mode only.
	// Bypassed in: homing states (PNP zone expected during reference seek),
	//              manual mode (operator in direct control, TO handles HW limits),
	//              STOPPED, PNP_HALT, and ERROR (no active motion to halt).
	// Triggers: MC_Halt on affected axis + STATE_PNP_HALT.
	// In STATE_PNP_HALT: drives stay ON, FB_ManualMode active, reverse jog allowed to escape zone.
	IF #State <> #STATE_HOMING AND #State <> #STATE_STOP_GOHOME
	    AND #State <> #STATE_PRE_HOME_CLR AND #State <> #STATE_POST_HOME_CLR
	    AND #State <> #STATE_MANUAL AND #State <> #STATE_STOPPED
	    AND #State <> #STATE_PNP_HALT AND #State <> #STATE_ERROR THEN
	    IF #HW_PNP_X_Min AND NOT #bHaltX_PNP THEN
	        #bHaltX_PNP := TRUE;
	        #newErrorFlag := TRUE;
	        #newErrorCode := 16#0121;
	        "DB_HMI".ErrorDetail := 'X axis MIN proximity triggered - select X, jog + to escape';
	        "DB_HMI".ErrorDetail_ES := 'Proximidad MIN Eje X activa - seleccionar X, joguear + para salir';
	        #State := #STATE_PNP_HALT;
	    END_IF;
	    IF #HW_PNP_X_Max AND NOT #bHaltX_PNP THEN
	        #bHaltX_PNP := TRUE;
	        #newErrorFlag := TRUE;
	        #newErrorCode := 16#0122;
	        "DB_HMI".ErrorDetail := 'X axis MAX proximity triggered - select X, jog - to escape';
	        "DB_HMI".ErrorDetail_ES := 'Proximidad MAX Eje X activa - seleccionar X, joguear - para salir';
	        #State := #STATE_PNP_HALT;
	    END_IF;
	    IF #HW_PNP_Z_Min AND NOT #bHaltZ_PNP THEN
	        #bHaltZ_PNP := TRUE;
	        #newErrorFlag := TRUE;
	        #newErrorCode := 16#0123;
	        "DB_HMI".ErrorDetail := 'Z axis MIN proximity triggered - select Z, jog + to escape';
	        "DB_HMI".ErrorDetail_ES := 'Proximidad MIN Eje Z activa - seleccionar Z, joguear + para salir';
	        #State := #STATE_PNP_HALT;
	    END_IF;
	    IF #HW_PNP_Z_Max AND NOT #bHaltZ_PNP THEN
	        #bHaltZ_PNP := TRUE;
	        #newErrorFlag := TRUE;
	        #newErrorCode := 16#0124;
	        "DB_HMI".ErrorDetail := 'Z axis MAX proximity triggered - select Z, jog - to escape';
	        "DB_HMI".ErrorDetail_ES := 'Proximidad MAX Eje Z activa - seleccionar Z, joguear - para salir';
	        #State := #STATE_PNP_HALT;
	    END_IF;
	END_IF;
	// Safety clear: halt flags released when we return to idle
	IF #State = #STATE_STOPPED THEN
	    #bHaltX_PNP := FALSE;
	    #bHaltZ_PNP := FALSE;
	END_IF;
	
	// Input manager
	#fbInputs(HMI_Start := "DB_HMI".Btn_Start,
	          HMI_Stop := "DB_HMI".Btn_Stop,
	          HMI_Pause := "DB_HMI".Btn_Pause,
	          HMI_Reset := "DB_HMI".Btn_Reset,
	          Panel_Start := #Panel_Start,
	          Panel_Stop := #Panel_Stop,
	          Panel_Pause := #Panel_Pause,
	          Panel_Reset := #Panel_Reset,
	          Rem_Start := #Rem_Start,
	          Rem_Stop := #Rem_Stop);
	
	// Command processing
	IF #fbInputs.Cmd_Stop THEN
	    // STOP: controlled stop without generating an error + return to safe position
	    #bPauseActive := FALSE;
	    #bStartSeq := FALSE;
	    // If running, go to special STOP sequence; otherwise go directly to STOPPED
	    IF (#State >= #STATE_STARTING AND #State < #STATE_ERROR AND #State <> 100) OR (#State = #STATE_PAUSED) THEN
	        #State := #STATE_STOPPING;
	    ELSE
	        #State := #STATE_STOPPED;
	    END_IF;
	END_IF;
	// Reset and Restart are blocked while E-Stop is active.
	// Operator must physically release E-Stop before clearing any error state.
	IF #fbInputs.Cmd_Reset AND (#EStop_OK OR "DB_HMI".Bypass_EStop) THEN
	    #bDoHardReset := TRUE;
	END_IF;
	
	// Btn_Restart - restart program from beginning (from ERROR or PAUSED).
	// This block fires BEFORE the CASE state machine, so CASE 999/25 restart handlers
	// are bypassed. All required cleanup must be done here.
	IF #restartEdge AND (#State = #STATE_ERROR OR #State = #STATE_PAUSED)
	    AND (#EStop_OK OR "DB_HMI".Bypass_EStop) THEN
	    #State := #STATE_STOPPED;
	    #bPauseActive := FALSE;
	    #Error := FALSE;
	    #bResetRecipe := TRUE;      // Reset recipe handler to IDLE (was missing -- bug fix)
	    #prevSafetyError := FALSE;  // Fresh safety evaluation on restart
	    #savedLineIndex := -1;
	    #savedProgram := -1;
	    "DB_HMI".ResumeLine := -1;
	    IF NOT "DB_MachineConfig".Bypass_MandrelLock THEN
	        #bMandrelRetractPending := TRUE;  // ITEM-32: deferred â€” spindle may still be spinning; wait SpindleStopSafeTime
	    END_IF;
	    #fbAlarmManager(NewError := FALSE,
	                    NewErrorCode := 0,
	                    AcknowledgeError := TRUE);  // Clear active alarm (was missing -- bug fix)
	END_IF;
	
	// Pause - one-shot SET only (no toggle). Only Btn_Continue resumes.
	IF #fbInputs.Cmd_Pause AND #Running AND NOT #bPauseActive THEN
	    #bPauseActive := TRUE;
	END_IF;
	
	#Running := (#State >= 10) AND (#State < #STATE_ERROR);
	#IsPaused := (#State = #STATE_PAUSED);
	
	// Update HMI status lamps
	"DB_HMI".IsRunning := #Running;
	"DB_HMI".IsPaused := #IsPaused;
	"DB_HMI".HasError := (#State = #STATE_ERROR);
	
	// Warning: only E-Stop bypass is shown on HMI (Door/Air/Drive bypasses silently permitted for setup)
	"DB_HMI".HasWarning := "DB_HMI".Bypass_EStop;
	IF "DB_HMI".Bypass_EStop THEN
	    "DB_HMI".WarningText := 'E-Stop bypass ON - auto start blocked';
	    "DB_HMI".WarningText_ES := 'Paro de emergencia desactivado - inicio automatico bloqueado';
	ELSE
	    "DB_HMI".WarningText := '';
	    "DB_HMI".WarningText_ES := '';
	END_IF;
	
	// Update HMI status message based on state (English + Spanish)
	CASE #State OF
	    0:
	        "DB_HMI".StatusMsg := 'Stopped';
	        "DB_HMI".StatusMsg_ES := 'Detenido';
	    5:
	        "DB_HMI".StatusMsg := 'Manual Mode';
	        "DB_HMI".StatusMsg_ES := 'Modo Manual';
	    10:
	        "DB_HMI".StatusMsg := 'Starting...';
	        "DB_HMI".StatusMsg_ES := 'Iniciando...';
	    12:
	        "DB_HMI".StatusMsg := 'Pre-scanning...';
	        "DB_HMI".StatusMsg_ES := 'Verificando receta...';
	    13:
	        "DB_HMI".StatusMsg := 'Clearing PNP zone...';
	        "DB_HMI".StatusMsg_ES := 'Liberando zona PNP...';
	    14:
	        "DB_HMI".StatusMsg := 'Waiting for sheet...';
	        "DB_HMI".StatusMsg_ES := 'Esperando lamina...';
	    15:
	        "DB_HMI".StatusMsg := 'Homing...';
	        "DB_HMI".StatusMsg_ES := 'Referenciando...';
	    16:
	        "DB_HMI".StatusMsg := 'Post-home clearance...';
	        "DB_HMI".StatusMsg_ES := 'Despejando zona PNP...';
	    17:
	        "DB_HMI".StatusMsg := 'Lock engaging...';
	        "DB_HMI".StatusMsg_ES := 'Bloqueando cabezal...';
	    18:
	        "DB_HMI".StatusMsg := 'Stopping...';
	        "DB_HMI".StatusMsg_ES := 'Deteniendo...';
	    29:
	        "DB_HMI".StatusMsg := 'Lock releasing...';
	        "DB_HMI".StatusMsg_ES := 'Liberando bloqueo...';
	    19:
	        "DB_HMI".StatusMsg := 'Homing (post-stop)...';
	        "DB_HMI".StatusMsg_ES := 'Referenciando (post-paro)...';
	    20:
	        "DB_HMI".StatusMsg := 'Running';
	        "DB_HMI".StatusMsg_ES := 'Ejecutando';
	    21:
	        "DB_HMI".StatusMsg := 'Returning to zero...';
	        "DB_HMI".StatusMsg_ES := 'Retornando a cero...';
	    22:
	        "DB_HMI".StatusMsg := 'PNP Halt - jog to escape limit zone';
	        "DB_HMI".StatusMsg_ES := 'Zona PNP - joguear para salir';
	    25:
	        "DB_HMI".StatusMsg := 'Paused';
	        "DB_HMI".StatusMsg_ES := 'Pausado';
	    30:
	        "DB_HMI".StatusMsg := 'Tool Change';
	        "DB_HMI".StatusMsg_ES := 'Cambio de Herramienta';
	    35:
	        "DB_HMI".StatusMsg := 'Tool Change Wait';
	        "DB_HMI".StatusMsg_ES := 'Esperando cambio...';
	    100:
	        "DB_HMI".StatusMsg := 'Program Complete';
	        "DB_HMI".StatusMsg_ES := 'Programa Completado';
	    999:
	        "DB_HMI".StatusMsg := 'ERROR';
	        "DB_HMI".StatusMsg_ES := 'ERROR';
	END_CASE;
	
	// =========================================================================
	// ALARM MANAGER - call FIRST so outputs are ready for DB_HMI
	// =========================================================================
	// NOTE: Acknowledge is done only on edge (ackEdge), not level.
	// This keeps ActiveError/HMI bools visible until the operator actually presses Ack.
	#fbAlarmManager(NewError := #newErrorFlag,
	                NewErrorCode := #newErrorCode,
	                AcknowledgeError := #ackEdge OR #fbInputs.Cmd_Reset,
	                ActiveProgram := #activeProgram,
	                ActiveLine := #fbRecipeHandler.CurrentLine);  // ITEM-26
	#newErrorFlag := FALSE;
	
	// Debug helpers: copy alarm/diagnostic info into DB_Diagnostic for easy tracing
	// This ensures a snapshot of the latest active error code is always visible for debugging.
	"DB_Diagnostic".Error_ProcessState := #State;
	"DB_Diagnostic".Error_Code := #fbAlarmManager.ActiveErrorCode;
	// If recipe reported a line error, keep that; otherwise -1
	IF "DB_Diagnostic".Error_Line < 0 THEN
	    "DB_Diagnostic".Error_Line := -1;
	END_IF;
	
	// Copy alarm outputs to HMI (now reads CURRENT scan values)
	"DB_HMI".ErrorID := #fbAlarmManager.ActiveErrorCode;
	"DB_HMI".ErrorText := #fbAlarmManager.ActiveErrorText;
	"DB_HMI".ErrorText_ES := #fbAlarmManager.ActiveErrorText_ES;
	// ITEM-08: If no active alarm text but a safety condition is blocking, show it.
	// This covers the case where the operator is in STOPPED state with door open / E-Stop active
	// after a previous error was acknowledged â€” AlarmManager cleared its text but the safety
	// condition is still live and writing to DB_Diagnostic.Error_Text.
	// Use compact customer-facing text here; DB_Diagnostic keeps the developer detail.
	// ITEM-16: ErrorDetail is also written here so the operator does not need DB_Diagnostic.
	IF "DB_HMI".ErrorText = '' AND NOT #fbSafetyMonitor.SafeToRun THEN
	    CASE #fbSafetyMonitor.ErrorCode OF
	        16#0401:
	            "DB_HMI".ErrorText := 'EMERGENCY STOP active';
	            "DB_HMI".ErrorText_ES := 'PARO DE EMERGENCIA activo';
	            "DB_HMI".ErrorDetail := 'Check E-Stop pushbutton and wiring';
	            "DB_HMI".ErrorDetail_ES := 'Revisar boton de emergencia y cableado';
	        16#0402:
	            "DB_HMI".ErrorText := 'Safety door open';
	            "DB_HMI".ErrorText_ES := 'Puerta de seguridad abierta';
	            "DB_HMI".ErrorDetail := 'Close the safety door to continue';
	            "DB_HMI".ErrorDetail_ES := 'Cerrar la puerta de seguridad para continuar';
	        16#0403:
	            "DB_HMI".ErrorText := 'Drives not ready';
	            "DB_HMI".ErrorText_ES := 'Variadores no listos';
	            "DB_HMI".ErrorDetail := 'Check contactor, enable wiring and drive status';
	            "DB_HMI".ErrorDetail_ES := 'Revisar contactor, cableado de habilitacion y estado del variador';
	        16#0404:
	            "DB_HMI".ErrorText := 'Air pressure low';
	            "DB_HMI".ErrorText_ES := 'Presion de aire baja';
	            "DB_HMI".ErrorDetail := 'Check air compressor and pressure switch';
	            "DB_HMI".ErrorDetail_ES := 'Revisar compresor y sensor de presion de aire';
	        ELSE:
	            "DB_HMI".ErrorText := 'Safety interlock active';
	            "DB_HMI".ErrorText_ES := 'Interlock de seguridad activo';
	            "DB_HMI".ErrorDetail := '';
	            "DB_HMI".ErrorDetail_ES := '';
	    END_CASE;
	END_IF;
	"DB_HMI".CurrentTool := #CurrentTool;
	
	// Reset TO errors (only on AckError or full reset)
	// BUG FIX: MC_Reset is triggered only by edge signals. Btn_AckError level signal
	// is not used -- when the button is held, Execute stays HIGH continuously, which
	// adversely affects TO error management (new errors may be masked).
	#fbResetX(Execute := #ackEdge OR #fbInputs.Cmd_Reset,
	          Axis := #Axis_X);
	#fbResetZ(Execute := #ackEdge OR #fbInputs.Cmd_Reset,
	          Axis := #Axis_Z);
	#fbResetTool(Execute := #ackEdge OR #fbInputs.Cmd_Reset,
	             Axis := #Axis_Tool);
	#fbResetSpindle(Execute := #ackEdge OR #fbInputs.Cmd_Reset,
	                Axis := #Axis_Spindle);
	
	// =========================================================================
	// HARD RESET
	// =========================================================================
	// Single place that defines what a full reset clears.
	// Triggered from exactly two places:
	//   1. bInitDone block (first PLC scan after power-up / warm restart)
	//   2. Cmd_Reset handler (operator presses Reset button)
	// Motion-FB execute flags (bHomeXExec, bStopMoveX, etc.) are cleared by the
	// STATE_STOPPED CASE block which runs on this same scan right after this block.
	IF #bDoHardReset THEN
	    #bHaltAllAxes := TRUE;   // ITEM-31: abort any in-progress MC_Home before clearing state
	    #State := #STATE_STOPPED;
	    #Error := FALSE;
	    #bPauseActive := FALSE;
	    #savedLineIndex := -1;
	    #savedProgram := -1;
	    "DB_HMI".ResumeLine := -1;
	    #prevSafetyError := FALSE;
	    #bResetRecipe := TRUE;
	    #bSheetWaitPhase2 := FALSE;
	    #bSheetWaitPhase3 := FALSE;
	    IF NOT "DB_MachineConfig".Bypass_MandrelLock THEN
	        #bMandrelRetractPending := TRUE;   // ITEM-32: deferred â€” machine may have been RUNNING; wait SpindleStopSafeTime
	    END_IF;
	    #bSheetHolderRetractPulse := TRUE;   // Release sheet holder regardless of which state was active
	    #bWaitingSpindleStop := FALSE;  // Cancel any pending spindle-stop wait
	    #capturedSpindleRPM := 0.0;
	    #spindleStopPT := T#0MS;
	    #bCycleCountDone := FALSE;  // Allow CycleCount to increment on next completion
	    #bDoHardReset := FALSE;
	END_IF;
	
	// =========================================================================
	// MAIN STATE MACHINE
	// =========================================================================
	CASE #State OF
	        
	        // -----------------------------------------------------------------
	        // === STATE_STOPPED (0) ===
	        // -----------------------------------------------------------------
	    0: // STOPPED
	        #StatusID := 0;
	        #bStartSeq := FALSE;
	        #bPreScanExec := FALSE;
	        // ITEM-34 FIX: clear only when no safety condition is blocking a start.
	        // The ITEM-08 fallback (runs BEFORE this CASE) writes the door-open /
	        // E-Stop / air-pressure hint into ErrorText when SafeToRun is FALSE;
	        // clearing unconditionally here erased that hint every scan, so the
	        // operator saw a machine that refused to start with no explanation.
	        IF #fbSafetyMonitor.SafeToRun THEN
	            "DB_HMI".ErrorText := '';
	            "DB_HMI".ErrorText_ES := '';
	            "DB_HMI".ErrorDetail := '';
	            "DB_HMI".ErrorDetail_ES := '';
	        END_IF;
	        // Clear ALL motion-FB execute flags every scan while stopped.
	        // Every path that reaches STATE_STOPPED (Cmd_Reset, Ack, Continue,
	        // Restart, normal stop sequence) therefore clears these automatically.
	        // Without this, a flag stuck TRUE (e.g. bHomeXExec after a homing error)
	        // keeps its MC_ FB running â†’ error re-triggers immediately after reset.
	        #bHomeXExec := FALSE;
	        #bHomeZExec := FALSE;
	        #bHomeToolExec := FALSE;
	        #homeSeqState := 0;
	        #bToolExecute := FALSE;
	        #bStopMoveX := FALSE;
	        #bStopMoveZ := FALSE;
	        #bHomeClrX := FALSE;
	        #bHomeClrZ := FALSE;
	        #bLockAfterHoming := FALSE;
	        // Spindle
	        #bSpindleStart := FALSE;
	        #bSpindleStop := FALSE;
	        #bSpindleDecelWait := FALSE;
	        #bSpindlePendingStart := FALSE;
	        // MandrelLock: clear Cmd_Extend (spring retracts on EStop/power-loss).
	        // Cmd_Retract is pulsed by bMandrelRetractPulse (set in STATE_STOPPING only â€” safe path) to
	        // force FB out of State 3 â€” Mode=0 does not auto-retract on Cmd_Extend=FALSE alone.
	        // All other paths (Reset/Error/Complete) use bMandrelRetractPending + tonMandrelRetractWait (ITEM-32).
	        "DB_Cylinder_MandrelLock".Cmd_Extend := FALSE;
	        // SheetHolder: clear Cmd_Extend so it does not extend on the next cycle entry.
	        "DB_Cylinder_SheetHolder".Cmd_Extend := FALSE;
	        // BackSupport CMD=41 overrides: de-energise Sol_B and atmosphere valve at rest
	        "DB_Cylinder_BackSupport".SolB_Cmd41 := FALSE;
	        "DB_Cylinder_BackSupport".SolAtmo_Cmd := FALSE;
	        
	        IF "DB_Manual".ManualModeActive AND #fbSafetyMonitor.SafeToJog THEN
	            #State := #STATE_MANUAL;
	        ELSIF #fbInputs.Cmd_Start AND #SafeToRun AND NOT "DB_HMI".Bypass_EStop THEN
	            // Start pre-scan before running.
	            // Always reset fbRecipeHandler here: after any stop or error the handler
	            // ends up in STATE_DONE (Done=TRUE). Without this reset, the first scan
	            // of RUNNING sees Done=TRUE and immediately reports "recipe complete".
	            // (STATE_COMPLETE already does this correctly before its own PRE_SCAN.)
	            #bResetRecipe := TRUE;
	            #State := #STATE_PRE_SCAN;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_MANUAL (5) ===
	        // -----------------------------------------------------------------
	    5: // MANUAL
	        #StatusID := 50;
	        IF NOT "DB_Manual".ManualModeActive THEN
	            // Clear manual contactor flags before returning to STOPPED
	            // so stale HMI button states cannot activate outputs in STATE_STOPPED.
	            "DB_HMI".Btn_Contactor_X := FALSE;
	            "DB_HMI".Btn_Contactor_Z := FALSE;
	            "DB_HMI".Btn_Contactor_Tool := FALSE;
	            "DB_HMI".Btn_Contactor_Spindle := FALSE;
	            "DB_HMI".Btn_Enable_X := FALSE;
	            "DB_HMI".Btn_Enable_Z := FALSE;
	            #State := 0;
	        ELSIF #fbInputs.Cmd_Start AND #SafeToRun AND NOT "DB_HMI".Bypass_EStop THEN
	            // Bypass_EStop blocks transition to auto: must be cleared before running
	            "DB_Manual".ManualModeActive := FALSE;
	            #bResetRecipe := TRUE;  // Same as STATE_STOPPED Cmd_Start handler (see comment there)
	            #State := #STATE_PRE_SCAN;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_PRE_SCAN (12) ===
	        // -----------------------------------------------------------------
	    12: // PRE-SCAN - Validate recipe before running
	        #StatusID := 12;
	        #bPreScanExec := TRUE;
	        #bResetRecipe := FALSE;  // Clear one-shot reset flag (consumed this scan)
	        
	        // Line count read from the active recipe DB Header (written by CAM post-processor)
	        CASE #activeProgram OF
	            1:
	                #activeLineCount := "DB_RecipeProgram1".Header.LineCount;
	            2:
	                #activeLineCount := "DB_RecipeProgram2".Header.LineCount;
	            3:
	                #activeLineCount := "DB_RecipeProgram3".Header.LineCount;
	            4:
	                #activeLineCount := "DB_RecipeProgram4".Header.LineCount;
	            5:
	                #activeLineCount := "DB_RecipeProgram5".Header.LineCount;
	        END_CASE;
	        
	        // Validate: 0 = recipe not loaded (Header not written yet); >999 = impossible
	        IF #activeLineCount <= 0 OR #activeLineCount > 999 THEN
	            #newErrorFlag := TRUE;     // BUG FIX: was missing -- alarm manager never latched 16#0310,
	            // so HMI showed ERROR state with empty text and no history entry
	            #newErrorCode := 16#0310;  // Recipe: invalid line count (not loaded?)
	            #bPreScanExec := FALSE;    // Do not start a scan on garbage LineCount
	            "DB_Diagnostic".Error_Text := 'Recipe not loaded: Header.LineCount invalid';
	            // Single-writer: HMI text comes from FB_AlarmManager (CASE 16#0310)
	            #State := #STATE_ERROR;
	        END_IF;
	        
	        // NOTE: fbPreScan is called unconditionally at the bottom of this FB
	        // (next to fbRecipeHandler), NOT here. BUG FIX: when it was called only
	        // inside this CASE branch, Execute never went FALSE between runs, so the
	        // FB stayed latched in its DONE state and every start after the first
	        // returned the PREVIOUS run's Valid/bounding-box instantly -- recipe
	        // validation was silently skipped from the second cycle onward.
	        
	        // Update progress every scan during pre-scan (HMI bar)
	        "DB_HMI".PreScanProgress := #fbPreScan.Progress;
	        
	        IF #fbPreScan.Done THEN
	            #bPreScanExec := FALSE;
	            
	            // Update HMI with bounding box
	            "DB_HMI".BoundingBox_MinX := #fbPreScan.MinX;
	            "DB_HMI".BoundingBox_MaxX := #fbPreScan.MaxX;
	            "DB_HMI".BoundingBox_MinZ := #fbPreScan.MinZ;
	            "DB_HMI".BoundingBox_MaxZ := #fbPreScan.MaxZ;
	            "DB_HMI".BoundingBox_Valid := #fbPreScan.Valid;
	            
	            // Update diagnostic
	            "DB_Diagnostic".PreScan_Complete := TRUE;
	            "DB_Diagnostic".PreScan_Valid := #fbPreScan.Valid;
	            "DB_Diagnostic".PreScan_ErrorLine := #fbPreScan.ErrorLine;
	            
	            IF #fbPreScan.Valid THEN
	                #State := #STATE_STARTING;
	            ELSE
	                // Pre-scan failed - limits exceeded.
	                // Single-writer: report via queue so the failing line number reaches the
	                // displayed text (queue path shows Details as the EN ErrorText; ES comes
	                // from the FB_AlarmManager CASE table for 16#0305).
	                "FC_ReportError"(Code := 16#0305,
	                                 Details := CONCAT(IN1 := 'PreScan Ln', IN2 := CONCAT(
	                                                                                                        IN1 := INT_TO_STRING(#fbPreScan.ErrorLine), IN2 := CONCAT(
	                                                                                                                                                                  IN1 := ': ', IN2 := #fbPreScan.ErrorDesc))),
	                                 Source := 'Recipe');
	                "DB_HMI".ErrorDetail := CONCAT(IN1 := 'Check line ', IN2 := INT_TO_STRING(#fbPreScan.ErrorLine));
	                "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'Revisar linea ', IN2 := INT_TO_STRING(#fbPreScan.ErrorLine));
	                "DB_Diagnostic".Error_Text := CONCAT(IN1 := 'PreScan failed Ln',
	                                                     IN2 := CONCAT(IN1 := INT_TO_STRING(#fbPreScan.ErrorLine),
	                                                                   IN2 := CONCAT(IN1 := ': ', IN2 := #fbPreScan.ErrorDesc)));
	                #State := #STATE_ERROR;
	            END_IF;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_STARTING (10) ===
	        // -----------------------------------------------------------------
	    10: // STARTING
	        #StatusID := 1;
	        // Auto-enable drives for auto mode -- contactors and enable signals are set automatically.
	        // In manual mode (STATE_MANUAL) they are under HMI control; PLC takes over when switching to auto.
	        "DB_HMI".Btn_Contactor_X := TRUE;
	        "DB_HMI".Btn_Contactor_Z := TRUE;
	        "DB_HMI".Btn_Contactor_Tool := NOT "DB_MachineConfig".Bypass_ToolAxis;
	        "DB_HMI".Btn_Contactor_Spindle := NOT "DB_HMI".Bypass_Spindle;
	        "DB_HMI".Btn_Enable_X := TRUE;
	        "DB_HMI".Btn_Enable_Z := TRUE;
	        // Wait for both drives to report ready before issuing any motion command.
	        // Physical contactor close + drive boot can take up to several hundred ms.
	        // tonDriveReady is called unconditionally near the timer section (auto-resets on exit).
	        IF #fbPowerX.Status AND #fbPowerZ.Status THEN
	            // Drives ready -- proceed to homing or running
	            IF NOT #Axis_X.StatusBits.HomingDone OR NOT #Axis_Z.StatusBits.HomingDone
	                OR (NOT #Axis_Tool.StatusBits.HomingDone AND NOT "DB_MachineConfig".Bypass_ToolAxis)
	                OR "DB_MachineConfig".AlwaysHomeOnAutoStart THEN
	                // If in PNP zone, clear it first
	                #bHomeClrX := #HW_PNP_X_Min AND NOT #Axis_X.StatusBits.HomingDone;
	                #bHomeClrZ := #HW_PNP_Z_Min AND NOT #Axis_Z.StatusBits.HomingDone;
	                IF #bHomeClrX OR #bHomeClrZ THEN
	                    #State := #STATE_PRE_HOME_CLR;
	                ELSE
	                    #homeSeqState := 1;
	                    #bHomeXExec := TRUE;
	                    #bHomeZExec := FALSE;
	                    #State := #STATE_HOMING;
	                END_IF;
	            ELSE
	                // Axes already homed: engage lock before entering RUNNING
	                #State := #STATE_LOCK_EXTEND_WAIT;
	            END_IF;
	        ELSIF #tonDriveReady.Q THEN
	            // Timeout: drives did not become ready within 3s
	            #newErrorFlag := TRUE;
	            #newErrorCode := 16#000C;
	            "DB_HMI".ErrorDetail := 'Contactor closed but drive not enabled - check wiring';
	            "DB_HMI".ErrorDetail_ES := 'Contactor cerrado pero variador no habilitado - revisar cableado';
	            #State := #STATE_ERROR;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_HOMING (15) ===
	        // -----------------------------------------------------------------
	    15: // HOMING (sequential: X then Z in active homing mode 3)
	        #StatusID := 2;
	        // Ensure other stop/homing triggers are not interfering
	        IF #homeSeqState = 1 THEN
	            // Homing X
	            #bHomeXExec := TRUE;
	            #bHomeZExec := FALSE;
	            IF #fbHomeX.Done THEN
	                #bHomeXExec := FALSE;
	                #homeSeqState := 2;    // proceed to homing Z
	                #bHomeZExec := TRUE;
	            ELSIF #fbHomeX.Error THEN
	                #bHomeXExec := FALSE;
	                #bHomeZExec := FALSE;
	                #State := #STATE_ERROR;
	                #newErrorFlag := TRUE;
	                #newErrorCode := 16#0003;
	                "DB_Diagnostic".HomeX_ErrorID := #fbHomeX.ErrorID;
	                "DB_Diagnostic".TO_ErrorText := "FC_TO_ErrorText"(Code := #fbHomeX.ErrorID);
	                "DB_HMI".ErrorDetail := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
	                "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
	            END_IF;
	        ELSIF #homeSeqState = 2 THEN
	            // Homing Z
	            #bHomeXExec := FALSE;
	            #bHomeZExec := TRUE;
	            IF #fbHomeZ.Done THEN
	                #bHomeZExec := FALSE;
	                IF NOT "DB_MachineConfig".Bypass_ToolAxis THEN
	                    // Proceed to tool axis homing (step 3)
	                    #homeSeqState := 3;
	                    #bHomeToolExec := TRUE;
	                ELSE
	                    // Tool axis bypassed -- go to post-homing clearance
	                    #homeSeqState := 0;
	                    #bHomeClrX := TRUE;
	                    #bHomeClrZ := TRUE;
	                    #CurrentTool := 1;  // Tool axis homed to slot 1 position
	                    #State := #STATE_POST_HOME_CLR;
	                END_IF;
	            ELSIF #fbHomeZ.Error THEN
	                #bHomeZExec := FALSE;
	                #State := #STATE_ERROR;
	                #newErrorFlag := TRUE;
	                #newErrorCode := 16#0004;
	                "DB_Diagnostic".HomeZ_ErrorID := #fbHomeZ.ErrorID;
	                "DB_Diagnostic".TO_ErrorText := "FC_TO_ErrorText"(Code := #fbHomeZ.ErrorID);
	                "DB_HMI".ErrorDetail := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
	                "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
	            END_IF;
	        ELSIF #homeSeqState = 3 THEN
	            // Homing Tool axis
	            #bHomeToolExec := TRUE;
	            IF #fbHomeTool.Done THEN
	                #bHomeToolExec := FALSE;
	                #homeSeqState := 0;
	                // Tool done -- proceed to post-homing clearance for X and Z
	                #bHomeClrX := TRUE;
	                #bHomeClrZ := TRUE;
	                #CurrentTool := 1;  // Tool axis homed to slot 1 position
	                #State := #STATE_POST_HOME_CLR;
	            ELSIF #fbHomeTool.Error THEN
	                #bHomeToolExec := FALSE;
	                #State := #STATE_ERROR;
	                #newErrorFlag := TRUE;
	                #newErrorCode := 16#0007;
	                "DB_Diagnostic".HomeTool_ErrorID := #fbHomeTool.ErrorID;
	                "DB_Diagnostic".TO_ErrorText := "FC_TO_ErrorText"(Code := #fbHomeTool.ErrorID);
	                "DB_HMI".ErrorDetail := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
	                "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
	            END_IF;
	        ELSE
	            // Fallback: if homeSeqState not set, go to STARTING check
	            #homeSeqState := 0;
	            #State := #STATE_STARTING;
	        END_IF;
	        // Homing timeout: X+Z+Tool combined must complete within 120s
	        IF #tonHomingTimeout.Q THEN
	            #bHomeXExec := FALSE;
	            #bHomeZExec := FALSE;
	            #bHomeToolExec := FALSE;
	            #homeSeqState := 0;
	            #State := #STATE_ERROR;
	            #newErrorFlag := TRUE;
	            #newErrorCode := 16#000B;
	            "DB_HMI".ErrorDetail := 'Homing did not complete - check reference switch/drive';
	            "DB_HMI".ErrorDetail_ES := 'Referenciado no completado - revisar sensor/variador';
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_PRE_HOME_CLR (13) ===
	        // -----------------------------------------------------------------
	    13: // PRE_HOME_CLR -- Clear PNP zone before homing
	        #StatusID := 2;
	        // Transition to homing as soon as clearance move finishes
	        IF (NOT #bHomeClrX OR #fbMoveX_HomeClr.Done) AND (NOT #bHomeClrZ OR #fbMoveZ_HomeClr.Done) THEN
	            #bHomeClrX := FALSE;
	            #bHomeClrZ := FALSE;
	            #homeSeqState := 1;
	            #bHomeXExec := TRUE;
	            #bHomeZExec := FALSE;
	            #State := #STATE_HOMING;
	        ELSIF (#bHomeClrX AND #fbMoveX_HomeClr.Error) OR (#bHomeClrZ AND #fbMoveZ_HomeClr.Error) THEN
	            #bHomeClrX := FALSE;
	            #bHomeClrZ := FALSE;
	            // Single-writer: queue path keeps the clearance-move context in the displayed text
	            "FC_ReportError"(Code := 16#0001,
	                             Details := 'Pre-home clearance move failed - axis could not clear PNP zone',
	                             Source := 'Process');
	            "DB_HMI".ErrorDetail := 'Axis could not clear PNP zone before homing - check drive';
	            "DB_HMI".ErrorDetail_ES := 'Eje no pudo liberar zona PNP antes del referenciado - revisar variador';
	            #State := #STATE_ERROR;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_POST_HOME_CLR (16) ===
	        // -----------------------------------------------------------------
	    16: // POST_HOME_CLR -- Move away from PNP zone after homing
	        #StatusID := 2;
	        IF (NOT #bHomeClrX OR #fbMoveX_HomeClr.Done) AND (NOT #bHomeClrZ OR #fbMoveZ_HomeClr.Done) THEN
	            #bHomeClrX := FALSE;
	            #bHomeClrZ := FALSE;
	            // Homing done: wait for sheet insertion before engaging ToolHeadLock
	            #bSheetWaitPhase2 := FALSE;  // Always start in phase 1 (show prompt)
	            #State := #STATE_SHEET_WAIT;
	        ELSIF (#bHomeClrX AND #fbMoveX_HomeClr.Error) OR (#bHomeClrZ AND #fbMoveZ_HomeClr.Error) THEN
	            #bHomeClrX := FALSE;
	            #bHomeClrZ := FALSE;
	            // Single-writer: queue path keeps the clearance-move context in the displayed text
	            "FC_ReportError"(Code := 16#0001,
	                             Details := 'Post-home clearance move failed - axis could not leave PNP zone',
	                             Source := 'Process');
	            "DB_HMI".ErrorDetail := 'Axis could not move from PNP zone after homing - check drive';
	            "DB_HMI".ErrorDetail_ES := 'Eje no pudo salir de zona PNP despues del referenciado - revisar variador';
	            #State := #STATE_ERROR;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_SHEET_WAIT (14) ===
	        // Phase 1: SheetHolder extends to hold the form; HMI prompt; wait operator
	        //          both-button confirm (Cmd_Start rising edge).
	        // Phase 2: MandrelLock extends (open-loop T#5S) to clamp the mandrel.
	        // Phase 3: SheetHolder retracts (open-loop T#5S) to clear; then â†’ LOCK_EXTEND_WAIT
	        //          so ToolHeadLock engages before RUNNING.
	        // -----------------------------------------------------------------
	    14: // SHEET_WAIT
	        #StatusID := 14;
	        IF NOT #bSheetWaitPhase2 AND NOT #bSheetWaitPhase3 THEN
	            // Phase 1: extend SheetHolder and prompt operator to insert the sheet
	            "DB_Cylinder_SheetHolder".Cmd_Extend := TRUE;
	            "DB_HMI".HasWarning := TRUE;
	            "DB_HMI".WarningText := 'Insert sheet, then press both start buttons';
	            "DB_HMI".WarningText_ES := 'Inserte la lamina y presione ambos botones de inicio';
	            IF #fbInputs.Cmd_Start THEN
	                // Operator confirmed â€” clear prompt
	                "DB_HMI".HasWarning := FALSE;
	                "DB_HMI".WarningText := '';
	                "DB_HMI".WarningText_ES := '';
	                IF NOT "DB_MachineConfig".Bypass_MandrelLock THEN
	                    // Normal: extend MandrelLock (Ph2), then SheetHolder retracts (Ph3)
	                    "DB_Cylinder_MandrelLock".Cmd_Extend := TRUE;
	                    #bSheetWaitPhase2 := TRUE;
	                ELSE
	                    // Bypass: no MandrelLock cylinder â€” skip Ph2, go straight to Ph3 (SheetHolder retract)
	                    "DB_Cylinder_SheetHolder".Cmd_Extend := FALSE;
	                    #bSheetHolderRetractPulse := TRUE;
	                    #bSheetWaitPhase3 := TRUE;
	                END_IF;
	            END_IF;
	        ELSIF #bSheetWaitPhase2 THEN
	            // Phase 2: open-loop wait T#5S for MandrelLock full stroke
	            // tonMandrelWait is driven by the global timer section below (IN when state=14 AND phase2)
	            IF #tonMandrelWait.Q THEN
	                // MandrelLock assumed clamped â€” retract SheetHolder
	                "DB_Cylinder_SheetHolder".Cmd_Extend := FALSE;
	                #bSheetHolderRetractPulse := TRUE;  // Force FB out of State 3 â†’ spring retracts
	                #bSheetWaitPhase2 := FALSE;
	                #bSheetWaitPhase3 := TRUE;
	            END_IF;
	        ELSE
	            // Phase 3: open-loop wait T#5S for SheetHolder to fully retract
	            // tonSheetHolderRetract driven by global timer section below (IN when state=14 AND phase3)
	            IF #tonSheetHolderRetract.Q THEN
	                #State := #STATE_LOCK_EXTEND_WAIT;  // ToolHeadLock engages, then â†’ RUNNING
	            END_IF;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_RUNNING (20) ===
	        // -----------------------------------------------------------------
	    20: // RUNNING
	        #StatusID := 3;
	        #bStartSeq := TRUE;
	        #timerRunning := TRUE;  // Start cycle timer
	        
	        // Update HMI
	        "DB_HMI".CurrentLine := #fbRecipeHandler.CurrentLine;
	        "DB_HMI".ProgressPercent := #fbRecipeHandler.Progress;
	        "DB_HMI".FeedrateActive := #fbRecipeHandler.ActiveFeedrate;
	        
	        IF #bPauseActive THEN
	            #State := #STATE_PAUSED;
	        END_IF;
	        
	        // Tool change request (bypass if no tool axis)
	        IF #fbRecipeHandler.ToolChangeReq THEN
	            IF "DB_MachineConfig".Bypass_ToolAxis THEN
	                // Skip tool change - clear request and continue
	                #fbRecipeHandler.ToolChangeReq := FALSE;
	            ELSIF #fbRecipeHandler.ToolReqNumber = #CurrentTool THEN
	                // Requested tool already in position (e.g. home = slot 1) - skip retract/rotate/extend
	                #fbRecipeHandler.ToolChangeReq := FALSE;
	            ELSE
	                #activeToolReq := #fbRecipeHandler.ToolReqNumber;
	                #bStartSeq := FALSE;
	                // Release lock before rotating turret: wait T#2S in LOCK_RETRACT_WAIT,
	                // then proceed to STATE_TOOL_CHANGE.
	                #bLockAfterHoming := FALSE;  // LOCK_RETRACT_WAIT exits to STATE_TOOL_CHANGE
	                #State := #STATE_LOCK_RETRACT_WAIT;
	            END_IF;
	        END_IF;
	        
	        // Spindle control from recipe
	        IF #fbRecipeHandler.SpindleReqStart THEN
	            IF #bSpindleDecelWait THEN
	                // Decel timer still running â€” capture for deferred apply
	                #bSpindlePendingStart := TRUE;
	                #pendingSpindleSpeed := #fbRecipeHandler.SpindleReqSpeed;
	            ELSE
	                #bSpindleStart := TRUE;
	                "DB_Spindle".Cmd_SetSpeed := #fbRecipeHandler.SpindleReqSpeed;
	            END_IF;
	        END_IF;
	        IF #fbRecipeHandler.SpindleReqStop THEN
	            #bSpindleStart := FALSE;  // Drop RunCmd level
	            #bSpindleDecelWait := TRUE;   // Start decel wait
	            #bSpindlePendingStart := FALSE; // Cancel any previous pending start
	        END_IF;
	        
	        // Complete
	        IF #fbRecipeHandler.Done THEN
	            #State := 100;  // Go to COMPLETE state, not IDLE
	            "DB_HMI".ProgressPercent := 100.0;
	            #bSpindleStart := FALSE;  // Drop RunCmd level on completion
	            #timerRunning := FALSE; // Stop cycle timer
	            #savedLineIndex := -1;  // Clear saved position
	            #savedProgram := -1;
	        END_IF;
	        
	        // Error
	        IF #fbRecipeHandler.Error THEN
	            #State := #STATE_ERROR;
	            #newErrorFlag := TRUE;
	            #newErrorCode := #fbRecipeHandler.ErrorID;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_LOCK_EXTEND_WAIT (17) ===
	        // -----------------------------------------------------------------
	    17: // LOCK_EXTEND_WAIT -- commanding ToolHeadLock to extend; sensor must confirm before RUNNING
	        // Cmd_Extend=TRUE is driven outside the CASE (see ToolHeadLock section below).
	        // No timer fallback -- lock MUST be confirmed by sensor before machining starts.
	        
	        #StatusID := 17;
	        IF "DB_Cylinder_ToolHeadLock".AtSetpoint THEN
	            #State := #STATE_RUNNING;
	        ELSIF "DB_Cylinder_ToolHeadLock".Error THEN
	            // Sensor did not confirm within Timeout_Extend (T#3S) â€” abort
	            #newErrorFlag := TRUE;
	            #newErrorCode := 16#0012;
	            "DB_Diagnostic".Error_Text := 'LockExtendWait: CylFB.Error=TRUE, AtSetpoint=FALSE - check air supply and magnetic sensor';
	            "DB_HMI".ErrorDetail := 'Lock sensor (AtSetpoint) not confirmed - check cylinder/sensor';
	            "DB_HMI".ErrorDetail_ES := 'Sensor de bloqueo (AtSetpoint) no confirmado - revisar cilindro/sensor';
	            #State := #STATE_ERROR;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_LOCK_RETRACT_WAIT (29) ===
	        // -----------------------------------------------------------------
	    29: // LOCK_RETRACT_WAIT -- ToolHeadLock releasing (spring return); wait T#2S before proceeding
	        // Cmd_Extend=FALSE here (state not RUNNING/PAUSED/LOCK_EXTEND_WAIT); spring retracts.
	        // No sensor yet: proceed after timeout regardless.
	        // bLockAfterHoming selects exit:
	        //   TRUE  = coming from STOPPING â†’ go to STATE_STOPPED (axes already at zero from STOPPING)
	        //   FALSE = coming from RUNNING (tool change) â†’ go to STATE_TOOL_CHANGE
	        #StatusID := 29;
	        IF #tonLockWait.Q THEN
	            IF #bLockAfterHoming THEN
	                #State := #STATE_STOPPED;  // Axes already at zero from STOPPING; no homing needed
	            ELSE
	                #State := #STATE_TOOL_CHANGE;
	            END_IF;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_STOPPING (18) ===
	        // -----------------------------------------------------------------
	    18: // STOPPING - Stop program without generating an error.
	        // Phase 1: recipe executor halts â†’ command spindle stop â†’ start axis return to zero.
	        // Axes move X=0 then Z=0 (MC_MoveAbsolute, rapid) in parallel with spindle decel wait.
	        // Phase 2: release MandrelLock once BOTH spindle timer elapsed AND axes done â†’ LOCK_RETRACT_WAIT â†’ STOPPED.
	        #StatusID := 18;
	        #Running := FALSE;
	        #timerRunning := FALSE;
	        // Axis return completion check â€” runs BEFORE the start-trigger so that a stale
	        // Done latch from the previous stop cycle (FB_Axis_AbsPos holds Done after Execute
	        // drops) cannot immediately cancel bStopMoveX/Z on the same scan they are set.
	        // When this check runs first, bStopMoveX/Z are still FALSE on the first scan of
	        // STOPPING (no action), and the start-trigger below then sets them correctly.
	        IF #bStopMoveX THEN
	            IF #fbMoveX_Stop.Done OR #fbMoveX_Stop.Error THEN
	                #bStopMoveX := FALSE;
	            END_IF;
	        END_IF;
	        IF #bStopMoveZ THEN
	            IF #fbMoveZ_Stop.Done OR #fbMoveZ_Stop.Error THEN
	                #bStopMoveZ := FALSE;
	            END_IF;
	        END_IF;
	        // Phase 1: wait for recipe executor to finish, then command spindle stop and
	        // begin waiting for the spindle to reach zero speed before releasing MandrelLock.
	        // MandrelLock stays extended (sheet clamped) while the spindle decelerates --
	        // retracting while spinning could throw the sheet at the operator.
	        IF NOT #fbRecipeHandler.Busy AND NOT #bWaitingSpindleStop THEN
	            #bSpindleStop := TRUE;
	            #bSheetHolderRetractPulse := TRUE;  // One-shot: release sheet holder (may be extended if stopped during SHEET_WAIT Ph1/2)
	            #bSheetWaitPhase2 := FALSE;
	            #bSheetWaitPhase3 := FALSE;
	            // ITEM-28: capture commanded speed before issuing stop; compute proportional wait time.
	            // Cmd_SetSpeed holds the VFD setpoint from the previous scan (FB_SpindleControl not yet called this scan).
	            #capturedSpindleRPM := "DB_Spindle".Cmd_SetSpeed;
	            IF "DB_MachineConfig".SpindleMaxRPM > 0.0 THEN
	                #spindleStopPT := DINT_TO_TIME(
	                                               REAL_TO_DINT(
	                                                            DINT_TO_REAL(TIME_TO_DINT("DB_MachineConfig".SpindleStopSafeTime))
	                                                            * (#capturedSpindleRPM / "DB_MachineConfig".SpindleMaxRPM)
	                                               )
	                );
	            ELSE
	                #spindleStopPT := "DB_MachineConfig".SpindleStopSafeTime;  // safe fallback if MaxRPM not configured
	            END_IF;
	            #bWaitingSpindleStop := TRUE;   // Enable phase 2 (proportional spindle decel wait)
	            // fbMoveX/Z_Stop called at bottom of FB with Execute := bStopMoveX/Z,
	            // position 0.0 at RapidVelocity. Both axes start simultaneously.
	            #bStopMoveX := TRUE;   // Start X return immediately (parallel with spindle decel and Z)
	            #bStopMoveZ := TRUE;   // Start Z return simultaneously with X
	        END_IF;
	        // Phase 2: release MandrelLock once proportional spindle decel timer has elapsed AND axes are at zero.
	        // Bypass_MandrelLock: no cylinder on this variant â€” skip decel wait, go directly to LOCK_RETRACT_WAIT.
	        // No physical encoder -- ActualSpeed is a TO estimate only. tonSpindleStopWait is sole release condition.
	        IF #bWaitingSpindleStop AND NOT #bStopMoveX AND NOT #bStopMoveZ
	            AND ("DB_MachineConfig".Bypass_MandrelLock OR #tonSpindleStopWait.Q) THEN
	            IF NOT "DB_MachineConfig".Bypass_MandrelLock THEN
	                "DB_Cylinder_MandrelLock".Cmd_Extend := FALSE;
	                #bMandrelRetractPulse := TRUE;  // One-shot: release mandrel lock
	            END_IF;
	            #bWaitingSpindleStop := FALSE;
	            #bLockAfterHoming := TRUE;  // LOCK_RETRACT_WAIT exits to STATE_STOPPED
	            #State := #STATE_LOCK_RETRACT_WAIT;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_STOP_GOHOME (19) ===
	        // -----------------------------------------------------------------
	    19: // STOP_GOHOME - Active homing after stop (X then Z, sequential)
	        // BUG FIX: Previous implementation homed X and Z simultaneously.
	        // Using the same sequential pattern as STATE_HOMING: X first, then Z.
	        #StatusID := 19;
	        #Running := FALSE;
	        IF #homeSeqState = 1 THEN
	            // X homing
	            #bHomeXExec := TRUE;
	            #bHomeZExec := FALSE;
	            IF #fbHomeX.Done THEN
	                #bHomeXExec := FALSE;
	                #homeSeqState := 2;
	                #bHomeZExec := TRUE;
	            ELSIF #fbHomeX.Error THEN
	                #bHomeXExec := FALSE;
	                #homeSeqState := 0;
	                #State := #STATE_ERROR;
	                #newErrorFlag := TRUE;
	                #newErrorCode := 16#0003;
	                "DB_Diagnostic".HomeX_ErrorID := #fbHomeX.ErrorID;
	                "DB_Diagnostic".TO_ErrorText := "FC_TO_ErrorText"(Code := #fbHomeX.ErrorID);
	                "DB_HMI".ErrorDetail := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
	                "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
	            END_IF;
	        ELSIF #homeSeqState = 2 THEN
	            // Z homing
	            #bHomeXExec := FALSE;
	            #bHomeZExec := TRUE;
	            IF #fbHomeZ.Done THEN
	                #bHomeZExec := FALSE;
	                IF NOT "DB_MachineConfig".Bypass_ToolAxis THEN
	                    // Proceed to tool axis homing (step 3)
	                    #homeSeqState := 3;
	                    #bHomeToolExec := TRUE;
	                ELSE
	                    // Tool axis bypassed -- homing complete
	                    #homeSeqState := 0;
	                    #State := #STATE_STOPPED;
	                END_IF;
	            ELSIF #fbHomeZ.Error THEN
	                #bHomeZExec := FALSE;
	                #homeSeqState := 0;
	                #State := #STATE_ERROR;
	                #newErrorFlag := TRUE;
	                #newErrorCode := 16#0004;
	                "DB_Diagnostic".HomeZ_ErrorID := #fbHomeZ.ErrorID;
	                "DB_Diagnostic".TO_ErrorText := "FC_TO_ErrorText"(Code := #fbHomeZ.ErrorID);
	                "DB_HMI".ErrorDetail := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
	                "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
	            END_IF;
	        ELSIF #homeSeqState = 3 THEN
	            // Homing Tool axis
	            #bHomeToolExec := TRUE;
	            IF #fbHomeTool.Done THEN
	                #bHomeToolExec := FALSE;
	                #homeSeqState := 0;
	                #State := #STATE_STOPPED;
	            ELSIF #fbHomeTool.Error THEN
	                #bHomeToolExec := FALSE;
	                #homeSeqState := 0;
	                #State := #STATE_ERROR;
	                #newErrorFlag := TRUE;
	                #newErrorCode := 16#0007;
	                "DB_Diagnostic".HomeTool_ErrorID := #fbHomeTool.ErrorID;
	                "DB_Diagnostic".TO_ErrorText := "FC_TO_ErrorText"(Code := #fbHomeTool.ErrorID);
	                "DB_HMI".ErrorDetail := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
	                "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
	            END_IF;
	        ELSE
	            // homeSeqState invalid -- safe fallback
	            #homeSeqState := 0;
	            #bHomeXExec := FALSE;
	            #bHomeZExec := FALSE;
	            #bHomeToolExec := FALSE;
	            #State := #STATE_STOPPED;
	        END_IF;
	        // ITEM-30: independent 120s timeout for STATE_STOP_GOHOME (tonStopHomeTimeout)
	        // Previously used tonHomingTimeout which could be nearly exhausted by a preceding STATE_HOMING run.
	        IF #tonStopHomeTimeout.Q THEN
	            #bHomeXExec := FALSE;
	            #bHomeZExec := FALSE;
	            #bHomeToolExec := FALSE;
	            #homeSeqState := 0;
	            #State := #STATE_ERROR;
	            #newErrorFlag := TRUE;
	            #newErrorCode := 16#000B;
	            "DB_HMI".ErrorDetail := 'Post-stop homing did not complete - check reference switch/drive';
	            "DB_HMI".ErrorDetail_ES := 'Referenciado post-paro no completado - revisar sensor/variador';
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_STOP_GOTOZERO (21) ===
	        // -----------------------------------------------------------------
	    21: // STOP_GOTOZERO - Go to position 0 after stop
	        #StatusID := 21;
	        #Running := FALSE;
	        // Has X axis motion completed?
	        IF #bStopMoveX AND #fbMoveX_Stop.Done THEN
	            #bStopMoveX := FALSE;
	        ELSIF #bStopMoveX AND #fbMoveX_Stop.Error THEN
	            #bStopMoveX := FALSE;
	            #State := #STATE_ERROR;
	            #newErrorFlag := TRUE;
	            #newErrorCode := 16#0001; // X move failed
	            "DB_HMI".ErrorDetail := 'X axis could not return to zero after stop';
	            "DB_HMI".ErrorDetail_ES := 'Eje X no pudo retornar a cero despues del paro';
	        END_IF;
	        // Has Z axis motion completed?
	        IF #bStopMoveZ AND #fbMoveZ_Stop.Done THEN
	            #bStopMoveZ := FALSE;
	        ELSIF #bStopMoveZ AND #fbMoveZ_Stop.Error THEN
	            #bStopMoveZ := FALSE;
	            #State := #STATE_ERROR;
	            #newErrorFlag := TRUE;
	            #newErrorCode := 16#0002; // Z move failed
	            "DB_HMI".ErrorDetail := 'Z axis could not return to zero after stop';
	            "DB_HMI".ErrorDetail_ES := 'Eje Z no pudo retornar a cero despues del paro';
	        END_IF;
	        // When both axes are done, return to STOPPED
	        IF NOT #bStopMoveX AND NOT #bStopMoveZ AND (#State = #STATE_STOP_GOTOZERO) THEN
	            #State := #STATE_STOPPED;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_PNP_HALT (22) ===
	        // -----------------------------------------------------------------
	    22: // PNP_HALT -- axis halted at proximity zone; drives ON, reverse jog allowed to escape
	        #StatusID := 22;
	        #Running := FALSE;
	        // Auto-exit: PNP zone cleared (axis has moved away) -- return to STOPPED
	        IF NOT #HW_PNP_X_Min AND NOT #HW_PNP_X_Max THEN
	            #bHaltX_PNP := FALSE;
	        END_IF;
	        IF NOT #HW_PNP_Z_Min AND NOT #HW_PNP_Z_Max THEN
	            #bHaltZ_PNP := FALSE;
	        END_IF;
	        IF NOT #bHaltX_PNP AND NOT #bHaltZ_PNP THEN
	            #State := #STATE_STOPPED;
	        END_IF;
	        // Manual exit: operator presses AckError or Reset
	        IF (#ackEdge OR #fbInputs.Cmd_Reset) AND (#EStop_OK OR "DB_HMI".Bypass_EStop) THEN
	            #bHaltX_PNP := FALSE;
	            #bHaltZ_PNP := FALSE;
	            #Error := FALSE;
	            #prevSafetyError := FALSE;
	            #fbAlarmManager(NewError := FALSE,
	                            NewErrorCode := 0,
	                            AcknowledgeError := TRUE);
	            #State := #STATE_STOPPED;
	        END_IF;
	        // Forward spindle commands from recipe handler.
	        // When PNP fires during STATE_RUNNING, the RUNNING(20) case is skipped, so
	        // bSpindleStart is never updated from fbRecipeHandler signals. Mirror them here.
	        // Note: fbRecipeHandler runs AFTER this CASE, so values here are from previous scan.
	        IF #fbRecipeHandler.SpindleReqStop THEN
	            #bSpindleStart := FALSE;  // Drop RunCmd level
	        END_IF;
	        IF #fbRecipeHandler.SpindleReqStart THEN
	            #bSpindleStart := TRUE;
	            "DB_Spindle".Cmd_SetSpeed := #fbRecipeHandler.SpindleReqSpeed;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_PAUSED (25) ===
	        // -----------------------------------------------------------------
	    25: // PAUSED
	        #StatusID := 88;
	        // Stop elapsed time counting while paused
	        #timerRunning := FALSE;
	        // Only Btn_Continue resumes (Pause button does NOT toggle)
	        IF #continueEdge THEN
	            #bPauseActive := FALSE;
	            #State := #STATE_RUNNING;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_TOOL_CHANGE (30) ===
	        // -----------------------------------------------------------------
	    30: // TOOL_CHANGE
	        #StatusID := 4;
	        #bToolExecute := TRUE;
	        #State := #STATE_TOOL_WAIT;
	        
	        // -----------------------------------------------------------------
	        // === STATE_TOOL_WAIT (35) ===
	        // -----------------------------------------------------------------
	    35: // TOOL_WAIT
	        IF #fbToolChanger.Done THEN
	            #bToolExecute := FALSE;
	            #CurrentTool := #fbToolChanger.CurrentTool;
	            #fbRecipeHandler.ToolChangeReq := FALSE;  // Signal RecipeHandler to continue
	            // Tool change done: re-engage lock before resuming machining
	            #State := #STATE_LOCK_EXTEND_WAIT;
	        ELSIF #fbToolChanger.Error THEN
	            #bToolExecute := FALSE;
	            #State := #STATE_ERROR;
	            #newErrorFlag := TRUE;
	            #newErrorCode := #fbToolChanger.ErrorID;
	            "DB_HMI".ErrorDetail := CONCAT(IN1 := 'Tool ', IN2 := INT_TO_STRING(#activeToolReq));
	            "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'Herramienta ', IN2 := INT_TO_STRING(#activeToolReq));
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // === STATE_ERROR (999) ===
	        // -----------------------------------------------------------------
	    999: // ERROR
	        #StatusID := 99;
	        #bStartSeq := FALSE;
	        #Error := TRUE;
	        #timerRunning := FALSE;  // Stop cycle timer
	        // Clear CMD=41 BackSupport overrides â€” valves de-energise on error
	        "DB_Cylinder_BackSupport".SolB_Cmd41 := FALSE;
	        "DB_Cylinder_BackSupport".SolAtmo_Cmd := FALSE;
	        // SheetHolder: clear extend command while in error so it does not hold on reset
	        "DB_Cylinder_SheetHolder".Cmd_Extend := FALSE;
	        
	        // Save current position for warm restart
	        IF #savedLineIndex < 0 THEN
	            #savedLineIndex := #fbRecipeHandler.CurrentLine;
	            #savedProgram := #activeProgram;
	        END_IF;
	        "DB_HMI".ResumeLine := #savedLineIndex;   // HMI shows which line will be resumed on next Start
	        
	        // Debug: populate DB_Diagnostic with error context for easier troubleshooting
	        "DB_Diagnostic".Error_ProcessState := #State;
	        "DB_Diagnostic".Error_Code := #fbAlarmManager.ActiveErrorCode; // primary error source
	        // If recipe handler provided an error line, prefer that
	        IF "DB_Diagnostic".Recipe_CurrentLine >= 0 THEN
	            "DB_Diagnostic".Error_Line := "DB_Diagnostic".Recipe_CurrentLine;
	        END_IF;
	        
	        // BUG FIX: Previous implementation transitioned ackEdge â†’ STATE_PAUSED,
	        // but the recipe handler remained in its internal STATE_ERROR (999).
	        // In PAUSED â†’ Continue â†’ STATE_RUNNING the recipe handler was not running (error state).
	        // Fix: All recovery paths go to STATE_STOPPED + recipe handler is reset.
	        // When operator presses Start, PRE_SCAN â†’ STARTING â†’ RUNNING flow starts clean.
	        // ACK, Continue and Restart are blocked while E-Stop is active.
	        // E-Stop must be physically released before any error acknowledgement is accepted.
	        IF #ackEdge AND (#EStop_OK OR "DB_HMI".Bypass_EStop) THEN
	            // Acknowledge: clear error â†’ STOPPED. savedLineIndex kept for warm restart on next Start.
	            #Error := FALSE;
	            #bPauseActive := FALSE;
	            #bResetRecipe := TRUE;   // Reset recipe handler to IDLE (cannot continue from state 999)
	            #prevSafetyError := FALSE;   // Clear safety latch -- fresh evaluation on restart
	            #bSheetWaitPhase2 := FALSE;
	            #bSheetWaitPhase3 := FALSE;
	            IF NOT "DB_MachineConfig".Bypass_MandrelLock THEN
	                #bMandrelRetractPending := TRUE;  // ITEM-32: deferred â€” spindle may still be spinning; wait SpindleStopSafeTime
	            END_IF;
	            #bSheetHolderRetractPulse := TRUE;  // Release sheet holder (may be extended from last run)
	            #fbAlarmManager(NewError := FALSE,
	                            NewErrorCode := 0,
	                            AcknowledgeError := TRUE);
	            #State := #STATE_STOPPED;
	        ELSIF #continueEdge AND (#EStop_OK OR "DB_HMI".Bypass_EStop) THEN
	            // Continue: resume from savedLineIndex on next Start (warm restart)
	            #Error := FALSE;
	            #bPauseActive := FALSE;
	            #bResetRecipe := TRUE;
	            #bSheetWaitPhase2 := FALSE;
	            #bSheetWaitPhase3 := FALSE;
	            IF NOT "DB_MachineConfig".Bypass_MandrelLock THEN
	                #bMandrelRetractPending := TRUE;  // ITEM-32: deferred â€” spindle may still be spinning; wait SpindleStopSafeTime
	            END_IF;
	            #bSheetHolderRetractPulse := TRUE;  // Release sheet holder
	            #fbAlarmManager(NewError := FALSE,
	                            NewErrorCode := 0,
	                            AcknowledgeError := TRUE);
	            #State := #STATE_STOPPED;
	        ELSIF #restartEdge AND (#EStop_OK OR "DB_HMI".Bypass_EStop) THEN
	            // Restart: explicit restart from line 0 -- clear saved position
	            #Error := FALSE;
	            #bPauseActive := FALSE;
	            #bResetRecipe := TRUE;
	            #savedLineIndex := -1;
	            #savedProgram := -1;
	            "DB_HMI".ResumeLine := -1;
	            #bSheetWaitPhase2 := FALSE;
	            #bSheetWaitPhase3 := FALSE;
	            IF NOT "DB_MachineConfig".Bypass_MandrelLock THEN
	                #bMandrelRetractPending := TRUE;  // ITEM-32: deferred â€” spindle may still be spinning; wait SpindleStopSafeTime
	            END_IF;
	            #bSheetHolderRetractPulse := TRUE;  // Release sheet holder
	            #fbAlarmManager(NewError := FALSE,
	                            NewErrorCode := 0,
	                            AcknowledgeError := TRUE);
	            #State := #STATE_STOPPED;
	        END_IF;
	END_CASE;
	
	// -----------------------------------------------------------------
	// === STATE_COMPLETE (100) ===
	// (handled as IF block outside CASE -- no new constant needed)
	// -----------------------------------------------------------------
	IF #State = 100 THEN
	    #StatusID := 100;
	    #bStartSeq := FALSE;
	    #Running := FALSE;
	    // Clear bSpindleStart: RUNNING no longer runs to clear it, so SpindleReqStart=TRUE
	    // from the last CMD_SPINDLE_ON would keep Start=TRUE through PRE_SCAN and STARTING.
	    // prevStart is reset inside FB_SpindleControl on halt Done, so the next CMD_SPINDLE_ON
	    // in the new recipe generates a clean startEdge.
	    // bSpindleStop is intentionally NOT cleared here: line 1567 sets it TRUE on Done to
	    // stop the spindle, and clearing it in the same scan (IF State=100 runs same scan as
	    // the Done handler in CASE 20) would cancel the stop command before it is consumed.
	    #bSpindleStart := FALSE;
	    IF NOT "DB_MachineConfig".Bypass_MandrelLock THEN
	        "DB_Cylinder_MandrelLock".Cmd_Extend := FALSE;
	        #bMandrelRetractPending := TRUE;    // ITEM-32: deferred â€” spindle still decelerating at program end; wait SpindleStopSafeTime
	    END_IF;
	    "DB_Cylinder_BackSupport".SolB_Cmd41 := FALSE;  // De-energise CMD=41 Sol_B override
	    "DB_Cylinder_BackSupport".SolAtmo_Cmd := FALSE;  // De-energise atmosphere valve
	    "DB_HMI".StatusMsg := 'Program Complete';
	    "DB_HMI".StatusMsg_ES := 'Programa Completado';
	    // Single-writer: ErrorText is owned by FB_AlarmManager. Completion is a status,
	    // not an error -- StatusMsg above already announces it ('Done!' write removed).
	    // ITEM-20: increment CycleCount exactly once per cycle, regardless of how many times
	    // Reset/Start is pressed from STATE_COMPLETE.
	    IF NOT #bCycleCountDone THEN
	        "DB_HMI".CycleCount := "DB_HMI".CycleCount + 1;
	        #bCycleCountDone := TRUE;
	    END_IF;
	    IF #fbInputs.Cmd_Start OR #restartEdge THEN
	        #bResetRecipe := TRUE;      // Reset FB_RecipeHandler (state 99â†’0) before re-run
	        #State := #STATE_PRE_SCAN;   // Restart/Start = immediate re-run, keeps drives on
	    ELSIF #fbInputs.Cmd_Reset THEN
	        #bResetRecipe := TRUE;      // Also reset recipe handler on manual reset
	        #State := #STATE_PRE_SCAN;   // Reset from COMPLETE goes to PRE_SCAN (drives stay on)
	    END_IF;
	END_IF;
	
	// =========================================================================
	// CYCLE TIMER - runs during RUNNING and PAUSED
	// =========================================================================
	#tonElapsed(IN := #timerRunning,
	            PT := T#24h);
	// Homing timeout: counts only while in STATE_HOMING; auto-resets when state exits
	#tonHomingTimeout(IN := (#State = #STATE_HOMING),
	                  PT := "DB_MachineConfig".Timeout_Homing);
	// ITEM-30: independent timeout for STATE_STOP_GOHOME â€” gets a full budget regardless of
	// how much time was consumed by the preceding STATE_HOMING sequence earlier in the same run
	#tonStopHomeTimeout(IN := (#State = #STATE_STOP_GOHOME),
	                    PT := "DB_MachineConfig".Timeout_Homing);
	// ToolHeadLock wait: counts in both lock wait states; auto-resets on exit
	// tonLockWait: 3s total (1s pre-delay + up to 2s for cylinder stroke). AtSetpoint exits early.
	#tonLockWait(IN := (#State = #STATE_LOCK_RETRACT_WAIT),
	             PT := "DB_MachineConfig".CylToolHeadLock_RetractTime);
	#tonLockPreDelay(IN := (#State = #STATE_LOCK_EXTEND_WAIT),
	                 PT := "DB_MachineConfig".CylToolHeadLock_PreDelay);
	// Spindle-stop wait: safety fallback for MandrelLock retract in STATE_STOPPING.
	// Duration = (capturedSpindleRPM / SpindleMaxRPM) * SpindleStopSafeTime. Fires immediately if speed was 0.
	#tonSpindleStopWait(IN := (#State = #STATE_STOPPING AND #bWaitingSpindleStop),
	                    PT := #spindleStopPT);
	// MandrelLock stroke wait: open-loop during STATE_SHEET_WAIT phase 2
	#tonMandrelWait(IN := (#State = #STATE_SHEET_WAIT AND #bSheetWaitPhase2),
	                PT := "DB_MachineConfig".CylMandrelLock_ClampTime);
	// SheetHolder retract wait: open-loop during STATE_SHEET_WAIT phase 3
	#tonSheetHolderRetract(IN := (#State = #STATE_SHEET_WAIT AND #bSheetWaitPhase3),
	                       PT := "DB_MachineConfig".CylSheetHolder_RetractTime);
	// ITEM-32: safety gate timer for deferred MandrelLock retract.
	// Six unsafe paths (Reset/Error-ack/Error-restart/Error-continue/Restart-pre-CASE/Complete) set
	// bMandrelRetractPending instead of bMandrelRetractPulse. This timer counts SpindleStopSafeTime
	// to ensure the spindle has physically stopped before the mandrel lock releases.
	// bMandrelRetractPending is NOT cleared by bDoHardReset â€” it must stay TRUE until the timer fires.
	#tonMandrelRetractWait(IN := #bMandrelRetractPending,
	                       PT := "DB_MachineConfig".SpindleStopSafeTime);
	// One-shot retract pulses:
	// ValveType=1 + Mode=0 keeps Sol_A=TRUE in State 3 even after Cmd_Extend=FALSE.
	// A one-scan Cmd_Retract=TRUE pulse forces the FB to State 2 (Sol_A=FALSE) â†’ spring retracts.
	// ITEM-32: promote deferred retract to immediate pulse once safety timer has elapsed.
	// STATE_STOPPING uses bMandrelRetractPulse directly (already waited proportional timer) â€” no change there.
	IF #tonMandrelRetractWait.Q THEN
	    #bMandrelRetractPulse := TRUE;   // Fire the retract this scan
	    #bMandrelRetractPending := FALSE;  // Clear pending; timer IN drops next scan â†’ ET resets
	END_IF;
	"DB_Cylinder_MandrelLock".Cmd_Retract := #bMandrelRetractPulse;
	#bMandrelRetractPulse := FALSE;  // Self-clearing: active for exactly one scan
	"DB_Cylinder_SheetHolder".Cmd_Retract := #bSheetHolderRetractPulse;
	#bSheetHolderRetractPulse := FALSE;  // Self-clearing: active for exactly one scan
	// Drive ready timeout: counts while in STARTING and drives not yet ready; auto-resets on exit
	#tonDriveReady(IN := (#State = #STATE_STARTING) AND NOT (#fbPowerX.Status AND #fbPowerZ.Status),
	               PT := "DB_MachineConfig".Timeout_DriveReady);
	// Spindle decel wait: blocks RunCmd from going TRUE until VFD ramp-down completes
	#tonSpindleDecel(IN := #bSpindleDecelWait,
	                 PT := "DB_MachineConfig".SpindleDecelTime);
	IF #tonSpindleDecel.Q THEN
	    #bSpindleDecelWait := FALSE;
	    IF #bSpindlePendingStart THEN
	        "DB_Spindle".Cmd_SetSpeed := #pendingSpindleSpeed;
	        #bSpindleStart := TRUE;
	        #bSpindlePendingStart := FALSE;
	    END_IF;
	END_IF;
	IF #timerRunning THEN
	    "DB_HMI".ElapsedTime := #tonElapsed.ET;
	    "DB_HMI".ElapsedSeconds := TIME_TO_DINT(#tonElapsed.ET / 1000);
	END_IF;
	// Reset timer on new program start
	IF #State = #STATE_STARTING THEN
	    #tonElapsed(IN := FALSE,
	                PT := T#24h);  // Reset
	    "DB_HMI".ElapsedTime := T#0s;
	    "DB_HMI".ElapsedSeconds := 0;
	END_IF;
	
	// =========================================================================
	// PRODUCTION LOGGING - DB_Production
	// =========================================================================
	// Edge: cycle start (enter PRE_SCAN)
	IF (#State = #STATE_PRE_SCAN) AND (#prevState <> #STATE_PRE_SCAN) THEN
	    "DB_Production".CurrentActive := TRUE;
	    "DB_Production".CurrentProgram := #activeProgram;
	    "DB_Production".TotalStarted := "DB_Production".TotalStarted + 1;
	    #prodTimeStatus := RD_SYS_T(OUT => #prodTimeNow);
	    "DB_Production".CurrentStartTime := #prodTimeNow;
	END_IF;
	
	// Edge: OK complete (enter state 100)
	IF (#State = 100) AND (#prevState <> 100) THEN
	    "DB_Production".LastResult := 1;  // OK
	    "DB_Production".LastProgram := #activeProgram;
	    "DB_Production".LastDuration_s := "DB_HMI".ElapsedSeconds;
	    "DB_Production".LastErrorCode := 0;
	    "DB_Production".LastErrorLine := -1;
	    "DB_Production".TotalOK := "DB_Production".TotalOK + 1;
	    #prodTimeStatus := RD_SYS_T(OUT => #prodTimeNow);
	    "DB_Production".LastEndTime := #prodTimeNow;
	    "DB_Production".CurrentActive := FALSE;
	    
	    // History ring buffer update
	    "DB_Production".Hist_Index := "DB_Production".Hist_Index + 1;
	    IF "DB_Production".Hist_Index > 100 THEN
	        "DB_Production".Hist_Index := 1;
	    END_IF;
	    IF "DB_Production".Hist_Count < 100 THEN
	        "DB_Production".Hist_Count := "DB_Production".Hist_Count + 1;
	    END_IF;
	    "DB_Production".Hist_Result["DB_Production".Hist_Index] := "DB_Production".LastResult;
	    "DB_Production".Hist_Program["DB_Production".Hist_Index] := "DB_Production".LastProgram;
	    "DB_Production".Hist_Duration_s["DB_Production".Hist_Index] := "DB_Production".LastDuration_s;
	    "DB_Production".Hist_ErrorCode["DB_Production".Hist_Index] := "DB_Production".LastErrorCode;
	    "DB_Production".Hist_ErrorLine["DB_Production".Hist_Index] := "DB_Production".LastErrorLine;
	    "DB_Production".Hist_Time["DB_Production".Hist_Index] := #prodTimeNow;
	END_IF;
	
	// Edge: NOK (enter STATE_ERROR with active cycle)
	IF (#State = #STATE_ERROR) AND (#prevState <> #STATE_ERROR) AND "DB_Production".CurrentActive THEN
	    "DB_Production".LastResult := 2;  // NOK
	    "DB_Production".LastProgram := #activeProgram;
	    "DB_Production".LastDuration_s := "DB_HMI".ElapsedSeconds;
	    "DB_Production".LastErrorCode := #fbAlarmManager.ActiveErrorCode;
	    "DB_Production".LastErrorLine := "DB_Diagnostic".Error_Line;
	    "DB_Production".TotalNOK := "DB_Production".TotalNOK + 1;
	    #prodTimeStatus := RD_SYS_T(OUT => #prodTimeNow);
	    "DB_Production".LastEndTime := #prodTimeNow;
	    "DB_Production".CurrentActive := FALSE;
	    
	    // History ring buffer update
	    "DB_Production".Hist_Index := "DB_Production".Hist_Index + 1;
	    IF "DB_Production".Hist_Index > 100 THEN
	        "DB_Production".Hist_Index := 1;
	    END_IF;
	    IF "DB_Production".Hist_Count < 100 THEN
	        "DB_Production".Hist_Count := "DB_Production".Hist_Count + 1;
	    END_IF;
	    "DB_Production".Hist_Result["DB_Production".Hist_Index] := "DB_Production".LastResult;
	    "DB_Production".Hist_Program["DB_Production".Hist_Index] := "DB_Production".LastProgram;
	    "DB_Production".Hist_Duration_s["DB_Production".Hist_Index] := "DB_Production".LastDuration_s;
	    "DB_Production".Hist_ErrorCode["DB_Production".Hist_Index] := "DB_Production".LastErrorCode;
	    "DB_Production".Hist_ErrorLine["DB_Production".Hist_Index] := "DB_Production".LastErrorLine;
	    "DB_Production".Hist_Time["DB_Production".Hist_Index] := #prodTimeNow;
	END_IF;
	
	// Edge: STOPPED via STOP sequence (STOPPING â†’ LOCK_RETRACT_WAIT â†’ STOPPED, or legacy paths)
	IF (#State = #STATE_STOPPED) AND
	    ((#prevState = #STATE_STOPPING) OR (#prevState = #STATE_STOP_GOHOME) OR (#prevState = #STATE_STOP_GOTOZERO)
	    OR (#prevState = #STATE_LOCK_RETRACT_WAIT)) AND
	    "DB_Production".CurrentActive THEN
	    "DB_Production".LastResult := 3;  // STOP
	    "DB_Production".LastProgram := #activeProgram;
	    "DB_Production".LastDuration_s := "DB_HMI".ElapsedSeconds;
	    "DB_Production".LastErrorCode := 0;
	    "DB_Production".LastErrorLine := -1;
	    "DB_Production".TotalStopped := "DB_Production".TotalStopped + 1;
	    #prodTimeStatus := RD_SYS_T(OUT => #prodTimeNow);
	    "DB_Production".LastEndTime := #prodTimeNow;
	    "DB_Production".CurrentActive := FALSE;
	    
	    // History ring buffer update
	    "DB_Production".Hist_Index := "DB_Production".Hist_Index + 1;
	    IF "DB_Production".Hist_Index > 100 THEN
	        "DB_Production".Hist_Index := 1;
	    END_IF;
	    IF "DB_Production".Hist_Count < 100 THEN
	        "DB_Production".Hist_Count := "DB_Production".Hist_Count + 1;
	    END_IF;
	    "DB_Production".Hist_Result["DB_Production".Hist_Index] := "DB_Production".LastResult;
	    "DB_Production".Hist_Program["DB_Production".Hist_Index] := "DB_Production".LastProgram;
	    "DB_Production".Hist_Duration_s["DB_Production".Hist_Index] := "DB_Production".LastDuration_s;
	    "DB_Production".Hist_ErrorCode["DB_Production".Hist_Index] := "DB_Production".LastErrorCode;
	    "DB_Production".Hist_ErrorLine["DB_Production".Hist_Index] := "DB_Production".LastErrorLine;
	    "DB_Production".Hist_Time["DB_Production".Hist_Index] := #prodTimeNow;
	END_IF;
	
	// Production RESET: clear counters + history
	IF #prodResetEdge THEN
	    "DB_Production".TotalStarted := 0;
	    "DB_Production".TotalOK := 0;
	    "DB_Production".TotalNOK := 0;
	    "DB_Production".TotalStopped := 0;
	    "DB_Production".Hist_Index := 0;
	    "DB_Production".Hist_Count := 0;
	    // Optionally also clear last cycle summary
	    "DB_Production".LastResult := 0;
	    "DB_Production".LastProgram := 0;
	    "DB_Production".LastDuration_s := 0;
	    "DB_Production".LastErrorCode := 0;
	    "DB_Production".LastErrorLine := -1;
	    "DB_Production".CurrentActive := FALSE;
	END_IF;
	
	// Last-cycle RESET: only clear last cycle summary (counters and history are preserved)
	IF #lastCycleResetEdge THEN
	    "DB_Production".LastResult := 0;
	    "DB_Production".LastProgram := 0;
	    "DB_Production".LastDuration_s := 0;
	    "DB_Production".LastErrorCode := 0;
	    "DB_Production".LastErrorLine := -1;
	END_IF;
	
	// Update prevState for next cycle
	#prevState := #State;
	
	// =========================================================================
	// RECIPE HANDLER + PRE-SCAN - Execute based on active program
	// =========================================================================
	// Both FBs are called EVERY scan regardless of machine state.
	// fbPreScan: Execute=bPreScanExec is TRUE only inside STATE_PRE_SCAN; all
	// other states call it with FALSE so its internal state machine returns
	// DONE(99) -> IDLE(0) and rearms its rising-edge start for the next run.
	// (BUG FIX: previously called only inside STATE_PRE_SCAN with Execute held
	// TRUE, so validation only ever ran on the first cycle after power-up.)
	CASE #activeProgram OF
	    1:
	        #fbRecipeHandler(Start := #bStartSeq,
	                         Stop := #fbInputs.Cmd_Stop,
	                         Pause := #bPauseActive,
	                         Reset := #fbInputs.Cmd_Reset OR #bResetRecipe,
	                         bStartEdge := #fbInputs.Cmd_Start,
	                         StartLine := MAX(IN1 := INT#0, IN2 := #savedLineIndex),
	                         LineCount := #activeLineCount,
	                         Lines := "DB_RecipeProgram1".Lines,
	                         Axis_X := #Axis_X,
	                         Axis_Z := #Axis_Z);
	        #fbPreScan(Execute := #bPreScanExec,
	                   LineCount := #activeLineCount,
	                   Lines := "DB_RecipeProgram1".Lines);
	    2:
	        #fbRecipeHandler(Start := #bStartSeq,
	                         Stop := #fbInputs.Cmd_Stop,
	                         Pause := #bPauseActive,
	                         Reset := #fbInputs.Cmd_Reset OR #bResetRecipe,
	                         bStartEdge := #fbInputs.Cmd_Start,
	                         StartLine := MAX(IN1 := INT#0, IN2 := #savedLineIndex),
	                         LineCount := #activeLineCount,
	                         Lines := "DB_RecipeProgram2".Lines,
	                         Axis_X := #Axis_X,
	                         Axis_Z := #Axis_Z);
	        #fbPreScan(Execute := #bPreScanExec,
	                   LineCount := #activeLineCount,
	                   Lines := "DB_RecipeProgram2".Lines);
	    3:
	        #fbRecipeHandler(Start := #bStartSeq,
	                         Stop := #fbInputs.Cmd_Stop,
	                         Pause := #bPauseActive,
	                         Reset := #fbInputs.Cmd_Reset OR #bResetRecipe,
	                         bStartEdge := #fbInputs.Cmd_Start,
	                         StartLine := MAX(IN1 := INT#0, IN2 := #savedLineIndex),
	                         LineCount := #activeLineCount,
	                         Lines := "DB_RecipeProgram3".Lines,
	                         Axis_X := #Axis_X,
	                         Axis_Z := #Axis_Z);
	        #fbPreScan(Execute := #bPreScanExec,
	                   LineCount := #activeLineCount,
	                   Lines := "DB_RecipeProgram3".Lines);
	    4:
	        #fbRecipeHandler(Start := #bStartSeq,
	                         Stop := #fbInputs.Cmd_Stop,
	                         Pause := #bPauseActive,
	                         Reset := #fbInputs.Cmd_Reset OR #bResetRecipe,
	                         bStartEdge := #fbInputs.Cmd_Start,
	                         StartLine := MAX(IN1 := INT#0, IN2 := #savedLineIndex),
	                         LineCount := #activeLineCount,
	                         Lines := "DB_RecipeProgram4".Lines,
	                         Axis_X := #Axis_X,
	                         Axis_Z := #Axis_Z);
	        #fbPreScan(Execute := #bPreScanExec,
	                   LineCount := #activeLineCount,
	                   Lines := "DB_RecipeProgram4".Lines);
	    5:
	        #fbRecipeHandler(Start := #bStartSeq,
	                         Stop := #fbInputs.Cmd_Stop,
	                         Pause := #bPauseActive,
	                         Reset := #fbInputs.Cmd_Reset OR #bResetRecipe,
	                         bStartEdge := #fbInputs.Cmd_Start,
	                         StartLine := MAX(IN1 := INT#0, IN2 := #savedLineIndex),
	                         LineCount := #activeLineCount,
	                         Lines := "DB_RecipeProgram5".Lines,
	                         Axis_X := #Axis_X,
	                         Axis_Z := #Axis_Z);
	        #fbPreScan(Execute := #bPreScanExec,
	                   LineCount := #activeLineCount,
	                   Lines := "DB_RecipeProgram5".Lines);
	END_CASE;
	
	// Homing -- sequential pattern: STATE_HOMING (startup) and STATE_STOP_GOHOME (post-stop)
	// both use homeSeqState + bHomeXExec/bHomeZExec.
	// Mode SEL: mode 3 (active+zero) is forced in STATE_HOMING; other states use DB_Manual.HomingMode.
	#fbHomeX(
	         Execute := #bHomeXExec,
	         Mode := SEL(G := (#State = #STATE_HOMING AND #bHomeXExec), IN0 := 3, IN1 := "DB_Manual".HomingMode),
	         Position := "DB_MachineConfig".HomeOffset_X,
	         Axis := #Axis_X
	);
	#fbHomeZ(
	         Execute := #bHomeZExec,
	         Mode := SEL(G := (#State = #STATE_HOMING AND #bHomeZExec), IN0 := 3, IN1 := "DB_Manual".HomingMode),
	         Position := "DB_MachineConfig".HomeOffset_Z,
	         Axis := #Axis_Z
	);
	#fbHomeTool(
	            Execute := #bHomeToolExec,
	            Mode := SEL(G := (#State = #STATE_HOMING AND #bHomeToolExec), IN0 := 3, IN1 := "DB_Manual".HomingMode),
	            Position := 0.0,
	            Axis := #Axis_Tool
	);
	// PNP halt FBs: Execute stays TRUE until bHaltX/Z_PNP is cleared (on return to STATE_STOPPED)
	#fbHaltX_PNP(Execute := #bHaltX_PNP,
	             Axis := #Axis_X);
	#fbHaltZ_PNP(Execute := #bHaltZ_PNP,
	             Axis := #Axis_Z);
	// ITEM-31: reset/startup halt â€” MC_Halt rising edge fires on the scan that bDoHardReset or
	// first-scan startup set bHaltAllAxes TRUE. Aborts any MC_Home command still active in the TO.
	// bHaltAllAxes is self-cleared here (after the calls) so the rising edge occurs for exactly one scan.
	// Must NOT be cleared earlier (e.g. in STATE_STOPPED CASE) â€” state machine runs before this section.
	#fbHaltX_Reset(Execute := #bHaltAllAxes,
	               Axis := #Axis_X);
	#fbHaltZ_Reset(Execute := #bHaltAllAxes,
	               Axis := #Axis_Z);
	#fbHaltTool_Reset(Execute := #bHaltAllAxes,
	                  Axis := #Axis_Tool);
	#bHaltAllAxes := FALSE;  // Self-clearing: active for exactly one scan
	
	// Tool changer -- only rotates the turret; axis positioning done by G-code
	#fbToolChanger(Execute := #bToolExecute,
	               ToolNumber := #activeToolReq,
	               Axis_Tool := #Axis_Tool);
	
	// Motion FBs for moving to position 0 after stop
	#fbMoveX_Stop(Execute := #bStopMoveX,
	              Position := 0.0,
	              Velocity := "DB_MachineConfig".RapidVelocity,
	              Axis := #Axis_X);
	#fbMoveZ_Stop(Execute := #bStopMoveZ,
	              Position := 0.0,
	              Velocity := "DB_MachineConfig".RapidVelocity,
	              Axis := #Axis_Z);
	// Homing clearance moves -- pre (clear PNP zone) and post (move away after homing)
	// Target: HomeOffset + PostHome_Clearance (outside PNP sensor range)
	#fbMoveX_HomeClr(Execute := #bHomeClrX,
	                 Position := "DB_MachineConfig".HomeOffset_X + "DB_MachineConfig".PostHome_Clearance,
	                 Velocity := "DB_MachineConfig".HomeVelocity,
	                 Axis := #Axis_X);
	#fbMoveZ_HomeClr(Execute := #bHomeClrZ,
	                 Position := "DB_MachineConfig".HomeOffset_Z + "DB_MachineConfig".PostHome_Clearance,
	                 Velocity := "DB_MachineConfig".HomeVelocity,
	                 Axis := #Axis_Z);
	
	// Manual mode - sync aliases first
	// Soft-limit jog gating (manual): once an axis is HOMED, jogging deeper past a
	// configured soft limit is blocked; jogging back toward the valid range always
	// passes (same escape pattern as PNP below -- never fault, never trap the operator).
	// Un-homed axes are NOT gated: position is meaningless before the reference seek,
	// so soft limits cannot apply. Tool axis (SelectedAxis=2) is never gated here.
	#bJogBlockPlus :=
	("DB_Manual".SelectedAxis = 0 AND #Axis_X.StatusBits.HomingDone
	AND #Axis_X.ActualPosition >= "DB_MachineConfig".SoftLimit_MaxX) OR
	("DB_Manual".SelectedAxis = 1 AND #Axis_Z.StatusBits.HomingDone
	AND #Axis_Z.ActualPosition >= "DB_MachineConfig".SoftLimit_MaxZ);
	#bJogBlockMinus :=
	("DB_Manual".SelectedAxis = 0 AND #Axis_X.StatusBits.HomingDone
	AND #Axis_X.ActualPosition <= "DB_MachineConfig".SoftLimit_MinX) OR
	("DB_Manual".SelectedAxis = 1 AND #Axis_Z.StatusBits.HomingDone
	AND #Axis_Z.ActualPosition <= "DB_MachineConfig".SoftLimit_MinZ);
	// In STATE_PNP_HALT: additionally block jog direction that would drive the axis
	// deeper into the PNP zone. Jog toward the active PNP zone is blocked; jog away
	// (escape direction) is passed through.
	IF #State = #STATE_PNP_HALT THEN
	    "DB_Manual".Jog_Plus := "DB_Manual".Btn_JogPlus AND NOT #bJogBlockPlus AND NOT (
	    ("DB_Manual".SelectedAxis = 0 AND #HW_PNP_X_Max) OR
	    ("DB_Manual".SelectedAxis = 1 AND #HW_PNP_Z_Max));
	    "DB_Manual".Jog_Minus := "DB_Manual".Btn_JogMinus AND NOT #bJogBlockMinus AND NOT (
	    ("DB_Manual".SelectedAxis = 0 AND #HW_PNP_X_Min) OR
	    ("DB_Manual".SelectedAxis = 1 AND #HW_PNP_Z_Min));
	ELSE
	    "DB_Manual".Jog_Plus := "DB_Manual".Btn_JogPlus AND NOT #bJogBlockPlus;
	    "DB_Manual".Jog_Minus := "DB_Manual".Btn_JogMinus AND NOT #bJogBlockMinus;
	END_IF;
	"DB_Manual".Btn_HomeAxis := "DB_Manual".Btn_Home;
	
	#fbManualMode(Enable := (#State = #STATE_MANUAL OR #State = #STATE_PNP_HALT),
	              SelectedAxis := "DB_Manual".SelectedAxis,
	              Jog_Plus := "DB_Manual".Jog_Plus,
	              Jog_Minus := "DB_Manual".Jog_Minus,
	              JogSpeed := "DB_Manual".JogSpeed,
	              MoveAbsolute := "DB_Manual".Btn_MoveAbsolute,
	              TargetPosition := "DB_Manual".MoveToPosition,
	              HomeAxis := "DB_Manual".Btn_HomeAxis,
	              HomeAll := "DB_Manual".Btn_HomeAll,
	              HomingMode := "DB_Manual".HomingMode,
	              HomePosition := 0.0,
	              GoSafe := "DB_Manual".Btn_GoSafe,
	              GoZero := "DB_Manual".Btn_GoZero,
	              SafeToJog := #fbSafetyMonitor.SafeToJog,
	              Reset := #fbInputs.Cmd_Reset,
	              PNP_X_Min := #HW_PNP_X_Min,
	              PNP_Z_Min := #HW_PNP_Z_Min,
	              ToolStepCW := "DB_Manual".Btn_ToolStepCW,
	              ToolStepCCW := "DB_Manual".Btn_ToolStepCCW,
	              ToolStepAngle := "DB_Manual".ToolStepAngle,
	              ToolStepSpeed := "DB_Manual".ToolStepSpeed,
	              Axis_X := #Axis_X,
	              Axis_Z := #Axis_Z,
	              Axis_Tool := #Axis_Tool,
	              Axis_Spindle := #Axis_Spindle);
	
	// Update manual mode status
	"DB_Manual".JogBusy := #fbManualMode.Busy;
	"DB_Manual".ManualBusy := #fbManualMode.Busy;       // Alias
	"DB_Manual".JogError := #fbManualMode.Error;
	"DB_Manual".ManualError := #fbManualMode.Error;     // Alias
	"DB_Manual".JogErrorID := #fbManualMode.ErrorID;
	"DB_Manual".ManualErrorID := #fbManualMode.ErrorID; // Alias
	"DB_Manual".SelectedAxisPos := SEL(G := "DB_Manual".SelectedAxis = 0,
	                                   IN0 := #Axis_Z.ActualPosition, IN1 := #Axis_X.ActualPosition);
	"DB_Manual".SelectedAxisName := SEL(G := "DB_Manual".SelectedAxis = 0, IN0 := 'Z', IN1 := 'X');
	"DB_Manual".ToolPosition := #Axis_Tool.ActualPosition;
	"DB_Manual".ActiveAxis := #fbManualMode.ActiveAxis;
	
	// Forward manual mode errors to alarm manager (once, on rising edge)
	IF #fbManualMode.Error AND NOT #prevManualError THEN
	    #newErrorFlag := TRUE;
	    #newErrorCode := #fbManualMode.ErrorID;
	    // Single-writer: ErrorText comes from the FB_AlarmManager CASE table for the code.
	    // DB_HMI.ErrorDetail is written directly inside FB_ManualMode at each error point.
	END_IF;
	#prevManualError := #fbManualMode.Error;
	
	// =========================================================================
	// SPINDLE CONTROL
	// Manual mode spindle control via DB_Manual buttons
	// Recipe handler spindle control via bSpindleStart/bSpindleStop flags
	// =========================================================================
	// Capture inputs BEFORE calling the FB so Diag_* reflects this scan's values.
	"DB_Spindle".Diag_bSpindleStart := #bSpindleStart;
	"DB_Spindle".Diag_bSpindleStop := #bSpindleStop;
	"DB_Spindle".Diag_EnableInput := #bDrivesEnable;
	"DB_Spindle".Diag_StartInput := "DB_Manual".Btn_SpindleStart OR #bSpindleStart;
	"DB_Spindle".Diag_StopInput := "DB_Manual".Btn_SpindleStop OR #bSpindleStop OR #fbInputs.Cmd_Stop;
	"DB_Spindle".Diag_ReqStart := #fbRecipeHandler.SpindleReqStart;
	"DB_Spindle".Diag_ReqStop := #fbRecipeHandler.SpindleReqStop;
	// -------------------------------------------------------------------------
	// Spindle history ring buffer: push snapshot on any meaningful change.
	// Trigger fields: SpindleState, PrevStart, ReqStart, StartEdge.
	// Reading tip: sort Hist_Log[0..19] by .Seq to get chronological order.
	// -------------------------------------------------------------------------
	IF "DB_Spindle".Hist_Clear THEN
	    "DB_Spindle".Hist_Head := 0;
	    "DB_Spindle".Hist_Count := 0;
	    "DB_Spindle".Hist_SeqNum := 0;
	    "DB_Spindle".Hist_Clear := FALSE;
	ELSIF ("DB_Spindle".Diag_SpindleState <> #prevSnap_State)
	    OR ("DB_Spindle".Diag_PrevStart <> #prevSnap_PrevStart)
	    OR ("DB_Spindle".Diag_ReqStart <> #prevSnap_ReqStart)
	    OR ("DB_Spindle".Diag_StartEdge <> #prevSnap_StartEdge)
	    OR ("DB_Spindle".Diag_MoveVelBusy <> #prevSnap_MoveVelBusy) THEN
	    // Push new entry at Hist_Head
	    "DB_Spindle".Hist_Log["DB_Spindle".Hist_Head].Seq := "DB_Spindle".Hist_SeqNum;
	    "DB_Spindle".Hist_Log["DB_Spindle".Hist_Head].MachineState := #State;
	    "DB_Spindle".Hist_Log["DB_Spindle".Hist_Head].State := "DB_Spindle".Diag_SpindleState;
	    "DB_Spindle".Hist_Log["DB_Spindle".Hist_Head].ReqStart := "DB_Spindle".Diag_ReqStart;
	    "DB_Spindle".Hist_Log["DB_Spindle".Hist_Head].ReqStop := "DB_Spindle".Diag_ReqStop;
	    "DB_Spindle".Hist_Log["DB_Spindle".Hist_Head].bStart := "DB_Spindle".Diag_bSpindleStart;
	    "DB_Spindle".Hist_Log["DB_Spindle".Hist_Head].bStop := "DB_Spindle".Diag_bSpindleStop;
	    "DB_Spindle".Hist_Log["DB_Spindle".Hist_Head].StartInput := "DB_Spindle".Diag_StartInput;
	    "DB_Spindle".Hist_Log["DB_Spindle".Hist_Head].StopInput := "DB_Spindle".Diag_StopInput;
	    "DB_Spindle".Hist_Log["DB_Spindle".Hist_Head].EnableIn := "DB_Spindle".Diag_EnableInput;
	    "DB_Spindle".Hist_Log["DB_Spindle".Hist_Head].PrevStart := "DB_Spindle".Diag_PrevStart;
	    "DB_Spindle".Hist_Log["DB_Spindle".Hist_Head].StartEdge := "DB_Spindle".Diag_StartEdge;
	    "DB_Spindle".Hist_Log["DB_Spindle".Hist_Head].MoveVelBusy := "DB_Spindle".Diag_MoveVelBusy;
	    "DB_Spindle".Hist_Log["DB_Spindle".Hist_Head].MoveVelInVel := "DB_Spindle".Diag_MoveVelInVel;
	    // Advance ring buffer pointer
	    "DB_Spindle".Hist_SeqNum := "DB_Spindle".Hist_SeqNum + 1;
	    "DB_Spindle".Hist_Head := ("DB_Spindle".Hist_Head + 1) MOD 20;
	    IF "DB_Spindle".Hist_Count < 20 THEN
	        "DB_Spindle".Hist_Count := "DB_Spindle".Hist_Count + 1;
	    END_IF;
	    // Latch current values for next-scan comparison
	    #prevSnap_State := "DB_Spindle".Diag_SpindleState;
	    #prevSnap_PrevStart := "DB_Spindle".Diag_PrevStart;
	    #prevSnap_ReqStart := "DB_Spindle".Diag_ReqStart;
	    #prevSnap_StartEdge := "DB_Spindle".Diag_StartEdge;
	    #prevSnap_MoveVelBusy := "DB_Spindle".Diag_MoveVelBusy;
	END_IF;
	// RunCmd is a level signal (TRUE = run).
	// The CALLER must:
	//   â€¢ Set SetSpeed before raising RunCmd
	//   â€¢ Lower RunCmd to stop (do not change SetSpeed while RunCmd is TRUE)
	//   â€¢ For a speed change: lower RunCmd â†’ update SetSpeed â†’ raise RunCmd again
	#fbSpindleControl(
	                  Enable   := #bDrivesEnable,
	                  RunCmd   := ("DB_Manual".Btn_SpindleStart OR #bSpindleStart)
	                  AND NOT ("DB_Manual".Btn_SpindleStop OR #bSpindleStop OR #fbInputs.Cmd_Stop),
	                  SetSpeed := SEL(G := (#State = #STATE_MANUAL),
	                                  IN0 := "DB_Spindle".Cmd_SetSpeed,
	                                  IN1 := "DB_Manual".Manual_SpindleSpeed),
	                  SpeedOverride := "DB_Spindle".SpeedOverride,
	                  Reset    := #fbInputs.Cmd_Reset,
	                  AckError := #ackEdge OR "DB_Manual".Btn_SpindleAckError,
	                  RunForward := "PTO_RunForward_AxisS",
	                  Axis_Spindle := #Axis_Spindle
	);
	// Write FB outputs back to DB_Spindle so HMI tags reflect actual state
	"DB_Spindle".IsRunning := #fbSpindleControl.Running;
	"DB_Spindle".AtSpeed := #fbSpindleControl.AtSpeed;
	"DB_Spindle".ActualSpeed := #fbSpindleControl.ActualSpeed;
	
	// =========================================================================
	// TOOLHEADLOCK CONTROL
	// Written every scan so FB_CylinderControl (called from OB1) sees the
	// correct command on the next scan.
	//
	// EXTEND (Sol_A ON):  STATE_RUNNING (20), STATE_PAUSED (25), STATE_LOCK_EXTEND_WAIT (17)
	// RETRACT (spring):   all other states -- cylinder retracts automatically via spring return.
	//
	// Safety: spring-return valve retracts on power loss without any PLC action.
	// State 17 checks AtSetpoint for extend confirmation only -- no fallback timer in FB_Process.
	// CylFB Timeout_Extend (T#6S in DB_Cylinder_ToolHeadLock) is the sole timer; on timeout
	// CylFB sets Error=TRUE, state 17 catches it and goes to STATE_ERROR (16#0012).
	// State 29 uses tonLockWait only (spring retract; no retract sensor).
	// =========================================================================
	"DB_Cylinder_ToolHeadLock".Cmd_Extend :=
	(#State = #STATE_RUNNING) OR
	(#State = #STATE_PAUSED) OR
	(#State = #STATE_LOCK_EXTEND_WAIT AND #tonLockPreDelay.Q);
	
	// Diagnostic output
	"DB_Diagnostic".Process_State := #State;
	"DB_Diagnostic".Process_SafeToRun := #SafeToRun;
	"DB_Diagnostic".Process_DrivesEnable := #bDrivesEnable;
	"DB_Diagnostic".Recipe_CurrentProgram := #activeProgram;
	"DB_Diagnostic".Recipe_TotalLines := #activeLineCount;
	"DB_Diagnostic".Axis_X_Pos := #Axis_X.ActualPosition;
	"DB_Diagnostic".Axis_Z_Pos := #Axis_Z.ActualPosition;
	"DB_Diagnostic".Axis_X_Enabled := #fbPowerX.Status;
	"DB_Diagnostic".Axis_Z_Enabled := #fbPowerZ.Status;
	"DB_Diagnostic".Axis_X_Homed := #Axis_X.StatusBits.HomingDone;
	"DB_Diagnostic".Axis_Z_Homed := #Axis_Z.StatusBits.HomingDone;
	
	// =========================================================================
	// CONTACTOR CONTROL -- called as the last step of FB_Process.
	// FC_ContactorControl reads DB_HMI.Btn_Contactor_* and Bypass_EStop/HasError.
	// In auto mode STATE_STARTING already sets these flags TRUE; they are reflected to I/O here.
	// Called here rather than from OB1 to ensure contactor logic runs in sync with the process.
	// =========================================================================
	"FC_ContactorControl"();
	
END_FUNCTION_BLOCK

FUNCTION_BLOCK "FB_AnalogSensor"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.0
// -----------------------------------------------------------------------------
// FB_AnalogSensor -- Analog input scaling, validity check, alarm
// -----------------------------------------------------------------------------
// USAGE:
//   For analog inputs such as linear rulers, pressure sensors, and potentiometers.
//   Calibration parameters (Raw_Min/Max, Phys_Min/Max) can be written from HMI.
//
// EXAMPLE OB1 CALL:
//   "DB_LinearRuler"(AI_Raw := "AI_LinearRuler");
//   // Calibration parameters are read from instance DB (written by HMI or FC_LoadConfig)
//
// S7-1200 AI STANDARD:
//   0 V  (or 4  mA) â†’ 0     (or 5530)
//   10 V (or 20 mA) â†’ 27648
//   Raw_Min=0,    Raw_Max=27648 â†’ correct for 0-10V
//   Raw_Min=5530, Raw_Max=27648 â†’ correct for 4-20mA
//
// SCALING FORMULA:
//   norm = (AI_Raw - Raw_Min) / (Raw_Max - Raw_Min)
//   Value = norm Ã— (Phys_Max - Phys_Min) + Phys_Min
//
// HMI CONNECTIONS (via instance DB):
//   AI_Raw   (Int,  â†’PLC) : Connected directly to physical input in OB1
//   Raw_Min      (Int,  â†’PLC) : AI raw minimum (calibration)
//   Raw_Max      (Int,  â†’PLC) : AI raw maximum (calibration)
//   Phys_Min     (Real, â†’PLC) : Physical minimum (mm, bar, etc.)
//   Phys_Max     (Real, â†’PLC) : Physical maximum
//   InvertSignal (Bool, â†’PLC) : TRUE = sensor wired reverse (low raw = high physical value)
//   Hi_Limit     (Real, â†’PLC) : High alarm level
//   Lo_Limit     (Real, â†’PLC) : Low alarm level
//   Value    (Real, PLCâ†’) : Scaled output (engineering units)
//   Valid    (Bool, PLCâ†’) : TRUE = raw value within range (sensor healthy)
//   Hi_Alarm (Bool, PLCâ†’) : Value >= Hi_Limit
//   Lo_Alarm (Bool, PLCâ†’) : Value <= Lo_Limit
// -----------------------------------------------------------------------------
   VAR_INPUT 
      AI_Raw : Int;   // Raw analog value (S7-1200: 0-27648) Calibration parameters -- declared as VAR (static) because:   â€¢ FC_LoadConfig writes to these at startup (must be writable from outside)   â€¢ HMI reads/writes directly via instance DB   â€¢ In optimized FBs, VAR_INPUT cannot be written externally (e.g. from FC)
   END_VAR

   VAR_OUTPUT 
      Value : Real;   // Scaled output (engineering units)
      Valid : Bool;   // TRUE = raw value within range
      Hi_Alarm : Bool;   // Value >= Hi_Limit (and Valid)
      Lo_Alarm : Bool;   // Value <= Lo_Limit (and Valid)
   END_VAR

   VAR 
      Raw_Min : Int := 0;   // Raw minimum (corresponds to 0V or 4mA)
      Raw_Max : Int := 27648;   // Raw maximum (corresponds to 10V or 20mA)
      Phys_Min : Real := 0.0;   // Physical minimum (mm, bar, Â°C, etc.)
      Phys_Max : Real := 100.0;   // Physical maximum
      InvertSignal : Bool := FALSE;   // TRUE = sensor wired reverse (low raw = high physical value)
      Hi_Limit : Real := 90.0;   // High alarm level (engineering units)
      Lo_Limit : Real := 10.0;   // Low alarm level
   END_VAR

   VAR_TEMP 
      rawReal : Real;
      rangeReal : Real;
      normVal : Real;
   END_VAR


BEGIN
	
	// Range check: is the raw value within the configured limits?
	IF #AI_Raw >= #Raw_Min AND #AI_Raw <= #Raw_Max AND #Raw_Max > #Raw_Min THEN
	    // Scaling calculation
	    #rawReal := INT_TO_REAL(#AI_Raw - #Raw_Min);
	    #rangeReal := INT_TO_REAL(#Raw_Max - #Raw_Min);
	    #normVal := #rawReal / #rangeReal;
	    IF #InvertSignal THEN
	        #normVal := 1.0 - #normVal;
	    END_IF;
	    #Value := #normVal * (#Phys_Max - #Phys_Min) + #Phys_Min;
	    #Valid := TRUE;
	ELSE
	    // Out of range: HMI should illuminate a sensor fault indicator
	    #Valid := FALSE;
	END_IF;
	
	// Alarm outputs -- evaluated only when measurement is valid
	#Hi_Alarm := #Valid AND (#Value >= #Hi_Limit);
	#Lo_Alarm := #Valid AND (#Value <= #Lo_Limit);
	
END_FUNCTION_BLOCK

FUNCTION_BLOCK "FB_DigitalSensor"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.0
// =============================================================================
// Version_Recipe -- 09_Sensors_Actuators.scl
// Reusable sensor and actuator function blocks
//
// FBs:
//   FB_DigitalSensor    -- Any digital input (NC/NO, debounce, edge detection)
//   FB_AnalogSensor     -- Analog input scaling + alarm
//   FB_CylinderControl  -- 5/2 and 5/3 pneumatic cylinder control
//
// USAGE CONCEPT:
//   A separate instance is opened from these FBs for each physical sensor/actuator.
//   The instance DB is used directly as the HMI interface.
//
//   Example: 1 cylinder + mid-point magnetic switch + linear ruler:
//     DB_Sen_Cyl1_Setpt  (FB_DigitalSensor) â† I/O: In_Cyl1_AtSetpoint
//     DB_Sen_Cyl1_Ret    (FB_DigitalSensor) â† I/O: In_Cyl1_Retracted  (optional)
//     DB_Cylinder1       (FB_CylinderControl)
//     DB_LinearRuler     (FB_AnalogSensor)  â† I/O: AI_LinearRuler
//
// HMI CONNECTION RULES:
//   HMI â†’ PLC : writes directly to VAR_INPUT fields
//               (inputs not connected in OB1 call are read from instance DB)
//   PLC â†’ HMI : reads VAR_OUTPUT fields
//
// MANUAL TEST USAGE:
//   HMI can always write to DB_CylinderX.Cmd_* fields.
//   Cylinder FB is called every scan from OB1 (independent of state machine).
//   While SafetyOK=TRUE, cylinder accepts commands regardless of MANUAL/AUTO/STOPPED mode.
// =============================================================================
// -----------------------------------------------------------------------------
// FB_DigitalSensor -- Digital input filter, polarity correction, edge detection
// -----------------------------------------------------------------------------
// USAGE:
//   For any digital input such as magnetic switches, proximity sensors,
//   buttons, and limit switches. NC/NO polarity and debounce time are
//   configured per instance.
//
// EXAMPLE OB1 CALL:
//   "DB_Sen_Cyl1_Ext"(RawInput := "In_Cyl1_Extended");
//   // IsNC and DebounceTime use values from the instance DB
//
// HMI CONNECTIONS (via instance DB):
//   IsNC         (Bool, â†’PLC) : TRUE = NC sensor, signal is inverted
//   DebounceTime (Time, â†’PLC) : Stability time (T#0ms = no filter)
//   State        (Bool, PLCâ†’) : Filtered + polarity-corrected signal
//   RisingEdge   (Bool, PLCâ†’) : 1 scan: State FALSEâ†’TRUE transition
//   FallingEdge  (Bool, PLCâ†’) : 1 scan: State TRUEâ†’FALSE transition
//
// NC/NO LOGIC:
//   IsNC=FALSE (NO): RawInput=TRUE â†’ sensor active â†’ State=TRUE
//   IsNC=TRUE  (NC): RawInput=FALSE â†’ sensor active â†’ State=TRUE
//   Use IsNC=TRUE for fail-safe NC components like limit switches and door sensors
//
// DEBOUNCE:
//   Cylinder magnetic switch: T#10ms recommended
//   Button (panel): T#20ms recommended
//   Fast proximity: T#5ms or T#0ms
// -----------------------------------------------------------------------------
   VAR_INPUT 
      RawInput : Bool;   // Raw physical input (polarity not yet corrected)
      IsNC : Bool := FALSE;   // TRUE = Normally Closed sensor (logic inverted)
      DebounceTime : Time := T#10MS;   // Stability time (0 = no filter)
   END_VAR

   VAR_OUTPUT 
      State : Bool;   // Filtered + polarity-corrected signal
      RisingEdge : Bool;   // 1 scan: State FALSEâ†’TRUE
      FallingEdge : Bool;   // 1 scan: State TRUEâ†’FALSE
   END_VAR

   VAR 
      rawInverted : Bool;   // Raw signal after polarity correction
      prevState : Bool;   // Previous scan State value (for edge detection)
      tonDebounce {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;   // Rising edge debounce timer
   END_VAR


BEGIN
	
	// Step 1: NC/NO polarity correction
	// XOR: IsNC=FALSE â†’ unchanged | IsNC=TRUE â†’ inverted
	#rawInverted := #RawInput XOR #IsNC;
	
	// Step 2: Debounce filter (for rising edge)
	// TON: Q=TRUE only if rawInverted stays TRUE for DebounceTime continuously
	// rawInverted=FALSE immediately sets Q=FALSE (falling edge is unfiltered)
	// Note: To also filter the falling edge, add TOF -- not implemented currently
	#tonDebounce(IN := #rawInverted,
	             PT := #DebounceTime);
	
	IF #DebounceTime > T#0ms THEN
	    #State := #tonDebounce.Q;   // Filtered signal
	ELSE
	    #State := #rawInverted;     // Unfiltered (when DebounceTime=0)
	END_IF;
	
	// Step 3: Edge detection (compare with previous scan)
	#RisingEdge := #State AND NOT #prevState;
	#FallingEdge := NOT #State AND #prevState;
	#prevState := #State;
	
END_FUNCTION_BLOCK

FUNCTION_BLOCK "FB_SpindleControl"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 3.0
// =============================================================================
// 07_SpindleControl.scl
// FB_SpindleControl -- Spindle speed control (simplified)
//
// Purpose:
//   Controls the spindle in velocity mode using MC_MoveVelocity (PTO output).
//   VFD run direction: CW only -- no direction pin.
//   RunForward signal enables VFD run.
//
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// OPERATING RULES (enforced by the CALLER, not by this FB):
//
//   1. Set SetSpeed while RunCmd = FALSE.
//   2. Set RunCmd = TRUE  â†’ MC_MoveVelocity starts + RunForward goes TRUE.
//      Keep RunCmd TRUE for the entire run.
//   3. To stop:  set RunCmd = FALSE  â†’ RunForward goes FALSE, PTO halts.
//      Do NOT touch SetSpeed during stop.
//   4. To change speed:
//        a. RunCmd = FALSE  (spindle coasts / stops on VFD ramp)
//        b. Write new SetSpeed
//        c. RunCmd = TRUE   (spindle restarts at new speed)
//
// This FB does NOT add any delays or intermediate states.
// Timing handshakes (coast-down waits, PTO stabilise, etc.) are the CALLER's
// responsibility if they are needed.
//
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Speed calculation:
//   effectiveSpeed = CLAMP(SetSpeed, MinSpeed, MaxSpeed)
//   PTO conversion: velocity (pulse/s) = effectiveRPM Ã— 500 / 60
//   MinSpeed and MaxSpeed are read from DB_Spindle.
//
// Error codes:
//   16#0502 -- MC_MoveVelocity runtime error
//
// States (Diag_SpindleState):
//   0   = IDLE     -- RunCmd FALSE, all outputs safe
//   20  = RUNNING  -- RunCmd TRUE, PTO active, RunForward TRUE
//   999 = ERROR    -- cleared by AckError or Reset
//
// Change log:
//   2026-05-09  Complete rewrite: RunCmd level input replaces Start/Stop edges.
//               Removed STARTING and STOPPING delay states and mid-run
//               velocity-change handshake.  Caller owns all sequencing.
//   2026-05-09  Previous version: 4-state machine (was 7-state before that).
// =============================================================================
   VAR_INPUT 
      Enable : Bool;   // Drive power enable -- from bDrivesEnable; stays TRUE during normal operation
      RunCmd : Bool;   // Level signal: TRUE = run, FALSE = stop/idle.   Set speed first, then raise RunCmd.   Lower RunCmd to stop; do not change speed while RunCmd is TRUE.
      SetSpeed : Real;   // Commanded speed in RPM (set while RunCmd = FALSE)
      SpeedOverride : Real;   // Speed override % (100 = normal speed)
      Reset : Bool;   // Full system reset -- clears ERROR, returns to IDLE
      AckError : Bool;   // Acknowledge spindle error only (no full system reset needed)
   END_VAR

   VAR_OUTPUT 
      Running : Bool;   // TRUE while RunCmd is TRUE and no error
      AtSpeed : Bool;   // TRUE when actual speed is within SpeedTolerance of commanded
      ActualSpeed : Real;   // Measured speed (RPM)
      CommandedSpeed : Real;   // Override-applied target speed (RPM)
      Error : Bool;   // Error active
      ErrorID : Word;   // Error code
      RunForward : Bool;   // VFD Run Forward digital output -- mirrors RunCmd (except in ERROR)
   END_VAR

   VAR_IN_OUT 
      Axis_Spindle {InstructionName := 'TO_PositioningAxis'; LibVersion := '8.0'} : TO_PositioningAxis;   // Spindle Technology Object
   END_VAR

   VAR 
      state : Int;   // 0 = IDLE, 20 = RUNNING, 999 = ERROR Speed calculation
      effectiveRPM : Real;   // RPM after override and clamping
      targetVelocity : Real;   // Velocity in pulse/s sent to MC_MoveVelocity Motion FB instances
      MC_Power_Inst {InstructionName := 'MC_Power'; LibVersion := '8.0'} : MC_Power;
      MC_MoveVelocity_Inst {InstructionName := 'MC_MoveVelocity'; LibVersion := '8.0'} : MC_MoveVelocity;   // Internal execute flag
      bMoveVelExec : Bool;   // AtSpeed helpers
      speedDiff : Real;
      speedPercent : Real;   // AckError edge detection
      prevAck : Bool;
      ackEdge : Bool;
   END_VAR


BEGIN
	
	// =========================================================================
	// 1. EDGE DETECTION
	// =========================================================================
	#ackEdge := #AckError AND NOT #prevAck;
	#prevAck := #AckError;
	
	// =========================================================================
	// 2. RESET (full system reset -- takes priority over everything)
	// =========================================================================
	IF #Reset THEN
	    #state := 0;
	    #Error := FALSE;
	    #ErrorID := 0;
	    #bMoveVelExec := FALSE;
	    #RunForward := FALSE;
	END_IF;
	
	// =========================================================================
	// 3. SPEED CALCULATION (runs every scan)
	// =========================================================================
	#effectiveRPM := #SetSpeed * (#SpeedOverride / 100.0);
	IF #effectiveRPM < "DB_Spindle".MinSpeed THEN
	    #effectiveRPM := "DB_Spindle".MinSpeed;
	END_IF;
	IF #effectiveRPM > "DB_Spindle".MaxSpeed THEN
	    #effectiveRPM := "DB_Spindle".MaxSpeed;
	END_IF;
	#CommandedSpeed := #effectiveRPM;
	#targetVelocity := #effectiveRPM * 500.0 / 60.0;  // RPM â†’ pulse/s
	
	// =========================================================================
	// 4. STATE MACHINE
	// =========================================================================
	CASE #state OF
	        
	        // -----------------------------------------------------------------
	        // STATE 0: IDLE
	        // All outputs safe.  Transition to RUNNING when RunCmd goes TRUE.
	        // -----------------------------------------------------------------
	    0:
	        #Running := FALSE;
	        #AtSpeed := FALSE;
	        #bMoveVelExec := FALSE;
	        #RunForward := FALSE;
	        
	        IF #RunCmd THEN
	            #bMoveVelExec := TRUE;  // pre-load velocity; RunForward still FALSE
	            #state := 10;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // STATE 10: PRELOAD
	        // Execute TRUE so the PTO frequency is stable before the VFD is
	        // enabled.  RunForward stays FALSE this scan; transitions to RUNNING
	        // on the very next scan.
	        // -----------------------------------------------------------------
	    10:
	        #Running := FALSE;
	        #AtSpeed := FALSE;
	        #bMoveVelExec := TRUE;
	        #RunForward := FALSE;
	        #state := 20;
	        
	        // -----------------------------------------------------------------
	        // STATE 20: RUNNING
	        // RunCmd TRUE â†’ MC_MoveVelocity active, RunForward TRUE.
	        // The CALLER is responsible for sequencing (speed-change stops,
	        // coast-down waits, PTO-stabilise delays, etc.).
	        // Transition back to IDLE when RunCmd goes FALSE.
	        // -----------------------------------------------------------------
	    20:
	        IF NOT #RunCmd THEN
	            // Caller dropped RunCmd â†’ stop immediately
	            #Running := FALSE;
	            #AtSpeed := FALSE;
	            #bMoveVelExec := FALSE;
	            #RunForward := FALSE;
	            #state := 0;
	            
	        ELSE
	            // Normal running
	            #Running := TRUE;
	            #bMoveVelExec := TRUE;
	            #RunForward := TRUE;
	            
	            // AtSpeed check
	            #speedDiff := ABS(#ActualSpeed - #effectiveRPM);
	            #speedPercent := 0.0;
	            IF #effectiveRPM > 1.0 THEN
	                #speedPercent := (#speedDiff / #effectiveRPM) * 100.0;
	            END_IF;
	            #AtSpeed := (#speedPercent <= "DB_Spindle".SpeedTolerance);
	            
	            // MC_MoveVelocity error check
	            IF #MC_MoveVelocity_Inst.Error THEN
	                #ErrorID := 16#0502;
	                #bMoveVelExec := FALSE;
	                #RunForward := FALSE;
	                "DB_Diagnostic".Spindle_TO_ErrorID := #MC_MoveVelocity_Inst.ErrorID;
	                "DB_Diagnostic".TO_ErrorText := "FC_TO_ErrorText"(Code := #MC_MoveVelocity_Inst.ErrorID);
	                "DB_Diagnostic".Error_Text := CONCAT(IN1 := 'Spindle move failed: ',
	                                                     IN2 := "DB_Diagnostic".TO_ErrorText);
	                "DB_Diagnostic".Error_Code := #ErrorID;
	                // Single-writer: report via queue -> FB_AlarmManager latches DB_Error and
	                // drives DB_HMI.ErrorText through the mirror. (The old direct ErrorText
	                // write here was overwritten by the mirror one scan later and the error
	                // never reached DB_Error/history at all.)
	                "FC_ReportError"(Code := #ErrorID,
	                                 Details := "DB_Diagnostic".Error_Text,
	                                 Source := 'Spindle');
	                "DB_HMI".ErrorDetail := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
	                "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
	                #state := 999;
	            END_IF;
	        END_IF;
	        
	        // -----------------------------------------------------------------
	        // STATE 999: ERROR
	        // AckError: clears spindle error, returns to IDLE.
	        // Reset:    handled above (takes priority, clears everything).
	        // -----------------------------------------------------------------
	    999:
	        #Error := TRUE;
	        #Running := FALSE;
	        #AtSpeed := FALSE;
	        #bMoveVelExec := FALSE;
	        #RunForward := FALSE;
	        
	        IF #ackEdge THEN
	            #Error := FALSE;
	            #ErrorID := 0;
	            #state := 0;
	            // DB_HMI error text is owned by FB_AlarmManager (mirror) â€” Ack clears it
	            // there; STATE_STOPPED clears ErrorDetail. No HMI writes from this FB.
	        END_IF;
	        
	END_CASE;
	
	// =========================================================================
	// 5. MC_ FUNCTION BLOCK CALLS (every scan)
	// =========================================================================
	#MC_Power_Inst(
	               Axis := #Axis_Spindle,
	               Enable := #Enable
	);
	#MC_MoveVelocity_Inst(
	                      Axis := #Axis_Spindle,
	                      Execute := #bMoveVelExec,
	                      Velocity := #targetVelocity,
	                      Direction := 1              // CW only -- no direction pin
	);
	
	// Actual speed: TO velocity (pulse/s) â†’ RPM
	#ActualSpeed := ABS(#Axis_Spindle.ActualVelocity) * 60.0 / 500.0;
	
	// =========================================================================
	// 6. WRITE STATUS TO DB_Spindle (read by HMI and other FBs)
	// =========================================================================
	"DB_Spindle".IsRunning := #Running;
	"DB_Spindle".AtSpeed := #AtSpeed;
	"DB_Spindle".ActualSpeed := #ActualSpeed;
	"DB_Spindle".CommandedSpeed := #CommandedSpeed;
	"DB_Spindle".Error := #Error;
	"DB_Spindle".ErrorID := #ErrorID;
	
	// Diagnostics (written every scan for watch-table tracing)
	"DB_Spindle".Diag_SpindleState := #state;    // 0=Idle, 10=Preload, 20=Running, 999=Error
	"DB_Spindle".Diag_MoveVelBusy := #MC_MoveVelocity_Inst.Busy;
	"DB_Spindle".Diag_MoveVelInVel := #MC_MoveVelocity_Inst.InVelocity;
	
	
END_FUNCTION_BLOCK

DATA_BLOCK "TO_AxisX"
{InstructionName := 'TO_PositioningAxis';
 LibVersion := '8.0';
 S7_Optimized_Access := 'TRUE' }
AUTHOR : SIMATIC
FAMILY : BasicMC
NAME : TO_PosAx
VERSION : 8.0
NON_RETAIN
TO_PositioningAxis

BEGIN
   Header.VersionMaj := 8;
   Header.VersionMin := 0;
   Actor.InverseDirection := FALSE;
   Actor.Interface.PTO := 16#88E1_0109;
   Actor.DriveParameter.PulsesPerDriveRevolution := 2048;
   Sensor[1].ActiveHoming.DigitalInputAddress.RID := 16#0200_0001;
   Sensor[1].ActiveHoming.DigitalInputAddress.AREA := 16#81;
   Sensor[1].ActiveHoming.DigitalInputAddress.OFFSET := 4;
   Sensor[1].ActiveHoming.HomePositionOffset := 10.0;
   Mechanics.LeadScrew := 1.0;
   DynamicLimits.MaxVelocity := 40.0;
   DynamicLimits.MinVelocity := 0.001;
   DynamicDefaults.Acceleration := 153.8423;
   DynamicDefaults.Deceleration := 184.6108;
   DynamicDefaults.EmergencyDeceleration := 3999.9;
   DynamicDefaults.Jerk := 512.8076;
   PositionLimits_SW.Active := FALSE;
   PositionLimits_SW.MinPosition := -50.0;
   PositionLimits_SW.MaxPosition := 350.0;
   PositionLimits_HW.Active := TRUE;
   PositionLimits_HW.MinSwitchAddress.RID := 16#0200_0001;
   PositionLimits_HW.MinSwitchAddress.AREA := 16#81;
   PositionLimits_HW.MinSwitchAddress.OFFSET := 9;
   PositionLimits_HW.MaxSwitchAddress.RID := 16#0200_0001;
   PositionLimits_HW.MaxSwitchAddress.AREA := 16#81;
   PositionLimits_HW.MaxSwitchAddress.OFFSET := 10;
   Homing.AutoReversal := TRUE;
   Homing.ApproachDirection := FALSE;
   Homing.ApproachVelocity := 30.0;
   Homing.ReferencingVelocity := 10.0;

END_DATA_BLOCK

FUNCTION "FC_CylinderDispatch" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
// =============================================================================
// FC_CylinderDispatch -- Routes manual cylinder commands to the selected cylinder
// =============================================================================
//
// Reads command fields from DB_Manual.SelectedCylinder and related fields,
// writes them to the corresponding DB_CylinderX instance, then mirrors
// status back to DB_Manual.SelCyl_* for HMI display.
//
// Called from OB1 AFTER all cylinder FB calls so status reflects the current scan.
// Commands have a one-scan delay relative to the HMI write -- imperceptible in practice.
//
// ADDING A CYLINDER:
//   1. Add DATA_BLOCK "DB_CylinderN" in 02_DataBlocks.scl
//   2. Add sensor FB calls + DB_CylinderN() call + solenoid outputs in OB1
//   3. Copy CASE 1 block below, change all DB_Cylinder1 â†’ DB_CylinderN,
//      and update SelCyl_Name string.
// =============================================================================

BEGIN
	
	// Apply cylinder config on rising edge of Btn_ApplyType (PositioningMode + Tolerance)
	IF "DB_Manual".Btn_ApplyType AND NOT "DB_Manual".prevBtn_ApplyType THEN
	    CASE "DB_Manual".SelectedCylinder OF
	        1:
	            "DB_Cylinder_BackSupport".PositioningMode := INT_TO_BYTE("DB_Manual".SelCyl_SetType);
	            "DB_Cylinder_BackSupport".Tolerance := "DB_Manual".Cyl_Tolerance;
	        2:
	            "DB_Cylinder_SheetHolder".PositioningMode := INT_TO_BYTE("DB_Manual".SelCyl_SetType);
	            "DB_Cylinder_SheetHolder".Tolerance := "DB_Manual".Cyl_Tolerance;
	        3:
	            "DB_Cylinder_ToolHeadLock".PositioningMode := INT_TO_BYTE("DB_Manual".SelCyl_SetType);
	            "DB_Cylinder_ToolHeadLock".Tolerance := "DB_Manual".Cyl_Tolerance;
	        4:
	            "DB_Cylinder_MandrelLock".PositioningMode := INT_TO_BYTE("DB_Manual".SelCyl_SetType);
	            "DB_Cylinder_MandrelLock".Tolerance := "DB_Manual".Cyl_Tolerance;
	    END_CASE;
	END_IF;
	"DB_Manual".prevBtn_ApplyType := "DB_Manual".Btn_ApplyType;
	
	CASE "DB_Manual".SelectedCylinder OF
	        
	    1: // BackSupport -- linear ruler, PositioningMode=3
	        "DB_Manual".SelCyl_Name := 'BackSupport';
	        "DB_Cylinder_BackSupport".Cmd_ExtendFull := "DB_Manual".Btn_CylExtendFull;
	        "DB_Cylinder_BackSupport".Cmd_RetractFull := "DB_Manual".Btn_CylRetractFull;
	        "DB_Cylinder_BackSupport".Cmd_GotoPos := "DB_Manual".Btn_CylGotoPos;
	        "DB_Cylinder_BackSupport".TargetPos := "DB_Manual".Cyl_TargetPos;
	        "DB_Manual".SelCyl_State := "DB_Cylinder_BackSupport".State;
	        "DB_Manual".SelCyl_StateText := "DB_Cylinder_BackSupport".StateText;
	        "DB_Manual".SelCyl_AtSetpoint := "DB_Cylinder_BackSupport".AtSetpoint;
	        "DB_Manual".SelCyl_AtRetract := "DB_Cylinder_BackSupport".AtRetract;
	        "DB_Manual".SelCyl_AtTarget := FALSE;
	        "DB_Manual".SelCyl_PosError := 0.0;
	        "DB_Manual".SelCyl_Error := "DB_Cylinder_BackSupport".Error;
	        "DB_Manual".SelCyl_ErrorID := "DB_Cylinder_BackSupport".ErrorID;
	        "DB_Manual".SelCyl_ActualPos := "DB_Cylinder_LinearRuler_BackSupport".Value;
	        "DB_Manual".SelCyl_Type := BYTE_TO_INT("DB_Cylinder_BackSupport".PositioningMode);
	        "DB_Manual".SelCyl_Toleranse := "DB_Cylinder_BackSupport".Tolerance;
	        "DB_Manual".SelCyl_MaxPos := "DB_Cylinder_BackSupport".MaxPos;
	        "DB_Manual".SelCyl_MinPos := "DB_Cylinder_BackSupport".MinPos;
	        
	    2: // SheetHolder -- no sensor, PositioningMode=0
	        "DB_Manual".SelCyl_Name := 'SheetHolder';
	        "DB_Cylinder_SheetHolder".Cmd_ExtendFull := "DB_Manual".Btn_CylExtendFull;
	        "DB_Cylinder_SheetHolder".Cmd_RetractFull := "DB_Manual".Btn_CylRetractFull;
	        "DB_Cylinder_SheetHolder".Cmd_GotoPos := "DB_Manual".Btn_CylGotoPos;
	        "DB_Cylinder_SheetHolder".TargetPos := "DB_Manual".Cyl_TargetPos;
	        "DB_Manual".SelCyl_State := "DB_Cylinder_SheetHolder".State;
	        "DB_Manual".SelCyl_StateText := "DB_Cylinder_SheetHolder".StateText;
	        "DB_Manual".SelCyl_AtSetpoint := "DB_Cylinder_SheetHolder".AtSetpoint;
	        "DB_Manual".SelCyl_AtRetract := "DB_Cylinder_SheetHolder".AtRetract;
	        "DB_Manual".SelCyl_AtTarget := FALSE;
	        "DB_Manual".SelCyl_PosError := 0.0;
	        "DB_Manual".SelCyl_Error := "DB_Cylinder_SheetHolder".Error;
	        "DB_Manual".SelCyl_ErrorID := "DB_Cylinder_SheetHolder".ErrorID;
	        "DB_Manual".SelCyl_ActualPos := 0.0;
	        "DB_Manual".SelCyl_Type := BYTE_TO_INT("DB_Cylinder_SheetHolder".PositioningMode);
	        "DB_Manual".SelCyl_Toleranse := "DB_Cylinder_SheetHolder".Tolerance;
	        "DB_Manual".SelCyl_MaxPos := "DB_Cylinder_SheetHolder".MaxPos;
	        "DB_Manual".SelCyl_MinPos := "DB_Cylinder_SheetHolder".MinPos;
	        
	    3: // ToolHeadLock -- magnetic sensor, PositioningMode=1
	        // CRITICAL: This cylinder locks the tool head. When extended (Sol_A=TRUE),
	        // tool axis movement is blocked at the process level.
	        // Manual extend/retract is allowed here for commissioning only.
	        "DB_Manual".SelCyl_Name := 'ToolHeadLock';
	        "DB_Cylinder_ToolHeadLock".Cmd_ExtendFull := "DB_Manual".Btn_CylExtendFull;
	        "DB_Cylinder_ToolHeadLock".Cmd_RetractFull := "DB_Manual".Btn_CylRetractFull;
	        "DB_Cylinder_ToolHeadLock".Cmd_GotoPos := "DB_Manual".Btn_CylGotoPos;
	        "DB_Cylinder_ToolHeadLock".TargetPos := "DB_Manual".Cyl_TargetPos;
	        "DB_Manual".SelCyl_State := "DB_Cylinder_ToolHeadLock".State;
	        "DB_Manual".SelCyl_StateText := "DB_Cylinder_ToolHeadLock".StateText;
	        "DB_Manual".SelCyl_AtSetpoint := "DB_Cylinder_ToolHeadLock".AtSetpoint;
	        "DB_Manual".SelCyl_AtRetract := "DB_Cylinder_ToolHeadLock".AtRetract;
	        "DB_Manual".SelCyl_AtTarget := FALSE;
	        "DB_Manual".SelCyl_PosError := 0.0;
	        "DB_Manual".SelCyl_Error := "DB_Cylinder_ToolHeadLock".Error;
	        "DB_Manual".SelCyl_ErrorID := "DB_Cylinder_ToolHeadLock".ErrorID;
	        "DB_Manual".SelCyl_ActualPos := 0.0;
	        "DB_Manual".SelCyl_Type := BYTE_TO_INT("DB_Cylinder_ToolHeadLock".PositioningMode);
	        "DB_Manual".SelCyl_Toleranse := "DB_Cylinder_ToolHeadLock".Tolerance;
	        "DB_Manual".SelCyl_MaxPos := "DB_Cylinder_ToolHeadLock".MaxPos;
	        "DB_Manual".SelCyl_MinPos := "DB_Cylinder_ToolHeadLock".MinPos;
	        
	    4: // MandrelLock -- no sensor, PositioningMode=0
	        "DB_Manual".SelCyl_Name := 'MandrelLock';
	        "DB_Cylinder_MandrelLock".Cmd_ExtendFull := "DB_Manual".Btn_CylExtendFull;
	        "DB_Cylinder_MandrelLock".Cmd_RetractFull := "DB_Manual".Btn_CylRetractFull;
	        "DB_Cylinder_MandrelLock".Cmd_GotoPos := "DB_Manual".Btn_CylGotoPos;
	        "DB_Cylinder_MandrelLock".TargetPos := "DB_Manual".Cyl_TargetPos;
	        "DB_Manual".SelCyl_State := "DB_Cylinder_MandrelLock".State;
	        "DB_Manual".SelCyl_StateText := "DB_Cylinder_MandrelLock".StateText;
	        "DB_Manual".SelCyl_AtSetpoint := "DB_Cylinder_MandrelLock".AtSetpoint;
	        "DB_Manual".SelCyl_AtRetract := "DB_Cylinder_MandrelLock".AtRetract;
	        "DB_Manual".SelCyl_AtTarget := FALSE;
	        "DB_Manual".SelCyl_PosError := 0.0;
	        "DB_Manual".SelCyl_Error := "DB_Cylinder_MandrelLock".Error;
	        "DB_Manual".SelCyl_ErrorID := "DB_Cylinder_MandrelLock".ErrorID;
	        "DB_Manual".SelCyl_ActualPos := 0.0;
	        "DB_Manual".SelCyl_Type := BYTE_TO_INT("DB_Cylinder_MandrelLock".PositioningMode);
	        "DB_Manual".SelCyl_Toleranse := "DB_Cylinder_MandrelLock".Tolerance;
	        "DB_Manual".SelCyl_MaxPos := "DB_Cylinder_MandrelLock".MaxPos;
	        "DB_Manual".SelCyl_MinPos := "DB_Cylinder_MandrelLock".MinPos;
	        
	    ELSE:
	        // Unknown selector -- show N/A, no commands routed
	        "DB_Manual".SelCyl_Name := '---';
	        "DB_Manual".SelCyl_State := 0;
	        "DB_Manual".SelCyl_StateText := 'N/A';
	        "DB_Manual".SelCyl_AtSetpoint := FALSE;
	        "DB_Manual".SelCyl_AtRetract := FALSE;
	        "DB_Manual".SelCyl_AtTarget := FALSE;
	        "DB_Manual".SelCyl_PosError := 0.0;
	        "DB_Manual".SelCyl_Error := FALSE;
	        "DB_Manual".SelCyl_ErrorID := 16#0000;
	        "DB_Manual".SelCyl_ActualPos := 0.0;
	        "DB_Manual".SelCyl_Type := 0;
	        "DB_Manual".SelCyl_Toleranse := 0.0;
	        "DB_Manual".SelCyl_MaxPos := 0.0;
	        "DB_Manual".SelCyl_MinPos := 0.0;
	        
	END_CASE;
	
END_FUNCTION

ORGANIZATION_BLOCK "Startup"
TITLE = "PLC Startup - Load Configuration"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.0
// -----------------------------------------------------------------------------
// OB100 -- Startup Organization Block
// Runs ONCE on PLC power-up, transition to RUN mode, or program download.
// Calls FC_LoadConfig -- do not add anything else here; keep everything inside FC.
// -----------------------------------------------------------------------------
   VAR_TEMP 
      tempRetVal : Int;
   END_VAR


BEGIN
	
	"FC_LoadConfig"();
	
END_ORGANIZATION_BLOCK

