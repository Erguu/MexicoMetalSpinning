DATA_BLOCK "DB_Cylinder_BackSupport"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.5
NON_RETAIN
// =============================================================================
// PNEUMATIC CYLINDER INSTANCE DATA BLOCKS
// =============================================================================
// Instances of FBs defined in 09_Sensors_Actuators.scl.
// HMI reads/writes these DBs directly -- no separate interface DB needed.
//
// Cylinder map:
//   CylDiag[1] = DB_BackSupport    (full stroke, PositioningMode=0; ruler HW removed on this machine)
//   CylDiag[2] = DB_SheetHolder    (no sensor, PositioningMode=0, ValveType=1)
//   CylDiag[3] = DB_ToolHeadLock   (magnetic sensor, PositioningMode=1, safety lock)
//   CylDiag[4] = DB_MandrelLock    (no sensor, PositioningMode=0)
// =============================================================================
// =============================================================================
// BACKSUPPORT CYLINDER (CylDiag[1]) -- Full stroke, PositioningMode=0
//
// Ruler hardware removed on this machine. CMD=40 triggers a full extension;
// AtSetpoint fires after Timeout_Extend. 5/3 blocked-center valve holds mechanically.
// DB_Cylinder_LinearRuler_BackSupport and OB1 ruler call are retained for future use
// if the ruler is re-fitted (switch PositioningMode back to 3 and re-enable in OB1).
// TIA tags:  Output_Cyl_Backsupport_SolA/B
// =============================================================================
// -----------------------------------------------------------------------------
// DB_BackSupport -- FB_CylinderControl instance
// PositioningMode=0 (full stroke, timed), ValveType=2 (5/3 blocked center)
//
// HMI WRITABLE:   Cmd_ExtendFull, Cmd_RetractFull
// HMI READ-ONLY:  Sol_A, Sol_B, State, StateText, AtSetpoint, Error, ErrorID
// CONNECTED IN OB1: SafetyOK, RulerValue, RulerValid (ruler inputs ignored in Mode=0)
// To re-enable ruler: change PositioningMode to 3 and restore ruler tuning fields below.
// -----------------------------------------------------------------------------
"FB_CylinderControl"

BEGIN
   ValveType := 2;
   Timeout_Extend := T#1S_500MS;
   Timeout_Retract := T#10S;
   PositioningMode := 0;

END_DATA_BLOCK

DATA_BLOCK "DB_Cylinder_Sen_BackSupport_Setpt"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
"FB_DigitalSensor"

BEGIN
   DebounceTime := T#10MS;

END_DATA_BLOCK

DATA_BLOCK "DB_Cylinder_LinearRuler_BackSupport"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
// -----------------------------------------------------------------------------
// DB_Cylinder_LinearRuler_BackSupport -- FB_AnalogSensor instance
// Analog linear ruler for BackSupport cylinder position feedback.
// Connected in OB1: AI_LinearRuler_BackSupport â†’ RulerValue/RulerValid on cylinder FB.
// Calibration is set in FC_LoadConfig Section 6; HMI can adjust at runtime.
// InvertSignal=TRUE: 0V = full extend (~300mm), ~10V = retracted (0mm).
// -----------------------------------------------------------------------------
"FB_AnalogSensor"

BEGIN
   Raw_Max := 31433;
   Phys_Max := 300.0;
   InvertSignal := TRUE;
   Hi_Limit := 295.0;
   Lo_Limit := 5.0;

END_DATA_BLOCK

DATA_BLOCK "DB_Cylinder_SheetHolder"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
// =============================================================================
// SHEETHOLDER CYLINDER (CylDiag[2]) -- No sensor, full stroke (PositioningMode=0)
//
// TIA Portal tags: Output_Cyl_SheetHolder_SolA  (Sol_B not wired -- ValveType=1)
// =============================================================================
// -----------------------------------------------------------------------------
// DB_SheetHolder -- FB_CylinderControl instance
// ValveType=1 (5/2 spring return, single solenoid):
//   Sol_A=TRUE  â†’ piston extends (sheet held).
//   Sol_A=FALSE â†’ spring retracts. Power loss = safe retract.
// PositioningMode=0: no sensor -- full stroke, timeout = done, no error.
// -----------------------------------------------------------------------------
"FB_CylinderControl"

BEGIN
   ValveType := 1;
   Timeout_Extend := T#5S;
   Timeout_Retract := T#5S;
   PositioningMode := 0;

END_DATA_BLOCK

DATA_BLOCK "DB_Cylinder_ToolHeadLock"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.3
NON_RETAIN
// =============================================================================
// TOOLHEADLOCK CYLINDER (CylDiag[3]) -- Magnetic sensor (PositioningMode=1, safety lock)
//
// LOCK BEHAVIOR (implemented in FB_Process):
//   EXTEND (Sol_A ON)  : states STATE_RUNNING (20) and STATE_PAUSED (25) only.
//   RETRACT (spring)   : all other states -- power loss also retracts (spring return).
//
// SEQUENCE GATES (FB_Process checks sensor before state transition):
//   Before entering RUNNING     : STATE_LOCK_EXTEND_WAIT (17) -- AtSetpoint OR 2s timer fallback.
//   Before TOOL_CHANGE / homing : STATE_LOCK_RETRACT_WAIT (29) -- 2s timer (no retract sensor).
//
// TIA Portal tags: In_Cyl_ToolHeadLock_AtSetpoint, Output_Cyl_ToolHeadLock_SolA
//                  (Sol_B not wired -- ValveType=1)
// =============================================================================
// -----------------------------------------------------------------------------
// DB_ToolHeadLock -- FB_CylinderControl instance
// ValveType=1 (5/2 spring return, single solenoid):
//   Sol_A=TRUE  â†’ piston extends (locked).
//   Sol_A=FALSE â†’ spring retracts (unlocked). Power loss = safe retract.
// Sen_AtSetpoint confirms lock fully engaged; Timeout_Extend=T#6S is error fallback.
// State 17 in FB_Process transitions when AtSetpoint=TRUE (sensor only; no fallback timer in FB_Process).
// Timeout_Extend in this DB is the only timer -- if sensor does not confirm within 6s, CylFB reports Error.
// -----------------------------------------------------------------------------
"FB_CylinderControl"

BEGIN
   ValveType := 1;
   Timeout_Extend := T#6S;
   Timeout_Retract := T#2S;
   PositioningMode := 1;

END_DATA_BLOCK

DATA_BLOCK "DB_Cylinder_Sen_ToolHeadLock_Setpt"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
"FB_DigitalSensor"

BEGIN
   DebounceTime := T#10MS;

END_DATA_BLOCK

DATA_BLOCK "DB_Cylinder_MandrelLock"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
// =============================================================================
// MANDRELLOCK CYLINDER (CylDiag[4]) -- No sensor, full stroke (PositioningMode=0)
//
// TIA Portal tags: Output_Cyl_MandrelLock_SolA, Output_Cyl_MandrelLock_SolB
// =============================================================================
// -----------------------------------------------------------------------------
// DB_MandrelLock -- FB_CylinderControl instance
// -----------------------------------------------------------------------------
"FB_CylinderControl"

BEGIN
   ValveType := 1;
   Timeout_Extend := T#5S;
   Timeout_Retract := T#5S;
   PositioningMode := 0;

END_DATA_BLOCK

FUNCTION "FC_ContactorControl" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
// -----------------------------------------------------------------------------
// FC_ContactorControl -- Manages physical drive contactor and enable outputs.
//
// Safety condition: no output is active without E-Stop OK (physical or bypass).
// On error (MachineError): contactors and enable signals are dropped.
// Enable interlock: Enable can only be active when the associated contactor is also on.
//
// Sequence: Contactor ON â†’ Enable ON â†’ MC_Power.Enable := TRUE â†’ drive ready
// -----------------------------------------------------------------------------
   VAR_TEMP 
      eStopOK : Bool;   // E-Stop cleared (physical or bypass)
      drivePermit : Bool;   // Only E-Stop controls contactor permission
      modePermit : Bool;   // State-based interlock: prevents contactor in STATE_STOPPED (0) only
   END_VAR


BEGIN
	
	#eStopOK := "Safety_Estop" OR "DB_HMI".Bypass_EStop;
	#drivePermit := #eStopOK;  // Only E-Stop cuts contactor power -- NC/PNP/errors do NOT cut power
	
	// Mode interlock: contactors blocked only in STATE_STOPPED (0).
	// STATE_ERROR (999) is ALLOWED so contactors stay on after a PNP/NC halt --
	// operator can jog away from limit zone without a full restart cycle.
	// In auto states (>=10), FB_Process writes Btn_Contactor_* programmatically.
	#modePermit := "DB_HMI".MachineState > 0;
	
	// Contactor outputs
	"Output_Contactor_X" := "DB_HMI".Btn_Contactor_X AND #drivePermit AND #modePermit;
	"Output_Contactor_Z" := "DB_HMI".Btn_Contactor_Z AND #drivePermit AND #modePermit;
	"Output_Contactor_Tool" := "DB_HMI".Btn_Contactor_Tool AND #drivePermit AND #modePermit;
	"Output_Contactor_Spindle" := "DB_HMI".Btn_Contactor_Spindle AND #drivePermit AND #modePermit;
	
	// Enable outputs -- associated contactor must also be on (interlock)
	"Output_Enable_X" := "DB_HMI".Btn_Enable_X AND "DB_HMI".Btn_Contactor_X AND #drivePermit AND #modePermit;
	"Output_Enable_Z" := "DB_HMI".Btn_Enable_Z AND "DB_HMI".Btn_Contactor_Z AND #drivePermit AND #modePermit;
	
	// HMI lamp feedback
	"DB_HMI".Contactor_X_On := "Output_Contactor_X";
	"DB_HMI".Contactor_Z_On := "Output_Contactor_Z";
	"DB_HMI".Contactor_Tool_On := "Output_Contactor_Tool";
	"DB_HMI".Contactor_Spindle_On := "Output_Contactor_Spindle";
	"DB_HMI".Enable_X_On := "Output_Enable_X";
	"DB_HMI".Enable_Z_On := "Output_Enable_Z";
	
END_FUNCTION

ORGANIZATION_BLOCK "Main"
TITLE = "Main Program Sweep (Cycle)"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
// -----------------------------------------------------------------------------
// OB1 -- Main cyclic loop entry point
// -----------------------------------------------------------------------------
   VAR_TEMP 
      tempRetVal : Int;
   END_VAR


BEGIN
	
	// =========================================================================
	// E-STOP DUAL CHANNEL -- Must run BEFORE all other FB calls
	// =========================================================================
	// Safety_Estop_Ch1 and Safety_Estop_Ch2: physical DI (%I) addresses in TIA Portal tag table.
	// Safety_Estop: Marker (%M) -- computed combined signal.
	"DB_fbEStop"(Ch1_NC := "Safety_Estop_Ch1",
	             Ch2_NO := "Safety_Estop_Ch2",
	             DiscrepancyTimeout := "DB_MachineConfig".Timeout_EStopDiscrep);
	
	// Combined E-Stop signal: safe when both channels are closed
	"Safety_Estop" := "DB_fbEStop".EStop_OK;
	
	// HMI status update
	"DB_HMI".EStop_Ch1_OK := "Safety_Estop_Ch1";
	"DB_HMI".EStop_Ch2_OK := "Safety_Estop_Ch2";
	"DB_HMI".EStop_Discrepancy := "DB_fbEStop".Discrepancy;
	
	// Discrepancy alarm: triggered once after timeout â†’ FB_AlarmManager generates 16#0406
	IF "DB_fbEStop".DiscrepancyAlarm THEN
	    "FC_ReportError"(Code := 16#0406,
	                     Details := 'E-Stop contact discrepancy - check wiring/contacts',
	                     Source := 'Safety');
	END_IF;
	
	// Main process state machine
	"fbProcess"(
	            Panel_Start    := "Panel_Start_A" AND "Panel_Start_B",
	            Panel_Stop     := "Panel_Stop",
	            Panel_Pause    := "Panel_Pause",
	            Panel_Reset    := "Panel_Reset",
	            Rem_Start      := FALSE,
	            Rem_Stop       := FALSE,
	            EStop_OK       := "Safety_Estop",
	            Door_Closed    := "Safety_Door",
	            AirPressure_OK := "Safety_Air",
	            HW_NC_X_Min    := "Limit_NC_X_Min",
	            HW_NC_X_Max    := "Limit_NC_X_Max",
	            HW_NC_Z_Min    := "Limit_NC_Z_Min",
	            HW_NC_Z_Max    := "Limit_NC_Z_Max",
	            HW_PNP_X_Min   := "Limit_PNP_X_Min",
	            HW_PNP_X_Max   := "Limit_PNP_X_Max",
	            HW_PNP_Z_Min   := "Limit_PNP_Z_Min",
	            HW_PNP_Z_Max   := "Limit_PNP_Z_Max",
	            Axis_X         := "TO_AxisX",
	            Axis_Z         := "TO_AxisZ",
	            Axis_Tool      := "TO_AxisTool",
	            Axis_Spindle   := "TO_AxisSpindle"
	);
	
	// =========================================================================
	// PNEUMATIC CYLINDERS
	// Sensor FBs must run BEFORE their cylinder FB (State must be updated first).
	// FC_CylinderDispatch must run AFTER all cylinder FBs (mirrors status to DB_Manual).
	//
	// Cylinder map:
	//   CylDiag[1] = DB_BackSupport  (full stroke, PositioningMode=0; ruler HW removed) -- SelectedCylinder=1
	//   CylDiag[2] = DB_SheetHolder  (no sensor, PositioningMode=0, ValveType=1) -- SelectedCylinder=2
	//   CylDiag[3] = DB_ToolHeadLock (magnetic sensor, PositioningMode=1) -- SelectedCylinder=3
	//   CylDiag[4] = DB_MandrelLock  (no sensor, PositioningMode=0) -- SelectedCylinder=4
	// =========================================================================
	
	// â”€â”€ BackSupport (CylDiag[1]) -- full stroke, PositioningMode=0 â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	// Ruler HW removed on this machine. Ruler FB call and RulerValue/RulerValid inputs
	// are retained so Mode=3 can be restored later by changing PositioningMode in
	// DB_Cylinder_BackSupport. In Mode=0 the cylinder FB ignores these inputs.
	"DB_Cylinder_LinearRuler_BackSupport"(AI_Raw := "AI_LinearRuler_Backsupport");
	"DB_Cylinder_Sen_BackSupport_Setpt"(RawInput := "In_Cyl_BackSupport_AtSetpoint");
	"DB_Cylinder_BackSupport"(
	                          SafetyOK       := "Safety_Estop" OR "DB_HMI".Bypass_EStop,
	                          Sen_AtSetpoint := "DB_Cylinder_Sen_BackSupport_Setpt".State,
	                          RulerValue     := "DB_Cylinder_LinearRuler_BackSupport".Value,
	                          RulerValid     := "DB_Cylinder_LinearRuler_BackSupport".Valid
	);
	"Output_Cyl_Backsupport_SolA" := "DB_Cylinder_BackSupport".Sol_A;
	// Sol_B: normal FB output OR CMD=41 Param=1 override (holds retract solenoid independently)
	"Output_Cyl_Backsupport_SolB" := "DB_Cylinder_BackSupport".Sol_B
	OR "DB_Cylinder_BackSupport".SolB_Cmd41;
	// Atmosphere valve: energised by CMD=41 Param=1, de-energised by Param=2 or process stop
	"Output_Cyl_Backsupport_SolAtmosphere" := "DB_Cylinder_BackSupport".SolAtmo_Cmd;
	"DB_Diagnostic".CylDiag[1].State := "DB_Cylinder_BackSupport".State;
	"DB_Diagnostic".CylDiag[1].Pos := "DB_Cylinder_LinearRuler_BackSupport".Value;
	"DB_Diagnostic".CylDiag[1].Sol_A := "DB_Cylinder_BackSupport".Sol_A;
	"DB_Diagnostic".CylDiag[1].Sol_B := "DB_Cylinder_BackSupport".Sol_B;
	"DB_Diagnostic".CylDiag[1].Error := "DB_Cylinder_BackSupport".Error;
	"DB_Diagnostic".CylDiag[1].ErrorID := "DB_Cylinder_BackSupport".ErrorID;
	
	// â”€â”€ SheetHolder (CylDiag[2]) -- no sensor, PositioningMode=0, ValveType=1 â”€â”€
	"DB_Cylinder_SheetHolder"(
	                          SafetyOK := "Safety_Estop" OR "DB_HMI".Bypass_EStop
	);
	"Output_Cyl_SheetHolder_SolA" := "DB_Cylinder_SheetHolder".Sol_A;
	"DB_Diagnostic".CylDiag[2].State := "DB_Cylinder_SheetHolder".State;
	"DB_Diagnostic".CylDiag[2].Pos := 0.0;
	"DB_Diagnostic".CylDiag[2].Sol_A := "DB_Cylinder_SheetHolder".Sol_A;
	"DB_Diagnostic".CylDiag[2].Sol_B := "DB_Cylinder_SheetHolder".Sol_B;
	"DB_Diagnostic".CylDiag[2].Error := "DB_Cylinder_SheetHolder".Error;
	"DB_Diagnostic".CylDiag[2].ErrorID := "DB_Cylinder_SheetHolder".ErrorID;
	
	// â”€â”€ ToolHeadLock (CylDiag[3]) -- magnetic sensor, PositioningMode=1, ValveType=1 â”€
	// Cmd_Extend is written every scan by FB_Process based on machine state:
	//   EXTEND  : STATE_RUNNING (20), STATE_PAUSED (25), STATE_LOCK_EXTEND_WAIT (17)
	//   RETRACT : all other states (spring return; includes ERROR, STOPPED, homing, tool change)
	// State 17 transitions when AtSetpoint confirms lock engaged, or after 2s timer fallback.
	"DB_Cylinder_Sen_ToolHeadLock_Setpt"(RawInput := "In_Cyl_ToolHeadLock_AtSetpoint");
	"DB_Cylinder_ToolHeadLock"(
	                           SafetyOK       := "Safety_Estop" OR "DB_HMI".Bypass_EStop,
	                           Sen_AtSetpoint := "DB_Cylinder_Sen_ToolHeadLock_Setpt".State
	);
	"Output_Cyl_ToolHeadLock_SolA" := "DB_Cylinder_ToolHeadLock".Sol_A;
	"DB_Diagnostic".CylDiag[3].State := "DB_Cylinder_ToolHeadLock".State;
	"DB_Diagnostic".CylDiag[3].Pos := 0.0;
	"DB_Diagnostic".CylDiag[3].Sol_A := "DB_Cylinder_ToolHeadLock".Sol_A;
	"DB_Diagnostic".CylDiag[3].Sol_B := "DB_Cylinder_ToolHeadLock".Sol_B;
	"DB_Diagnostic".CylDiag[3].Error := "DB_Cylinder_ToolHeadLock".Error;
	"DB_Diagnostic".CylDiag[3].ErrorID := "DB_Cylinder_ToolHeadLock".ErrorID;
	
	// â”€â”€ MandrelLock (CylDiag[4]) -- no sensor, PositioningMode=0 â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	// Cmd_Extend driven by FB_Process in STATE_SHEET_WAIT phase 2 (clamp during sheet loading).
	// SafetyOK override: keep MandrelLock extended (workpiece clamped) during RUNNING (20),
	// PAUSED (25), STOPPING (18), and ERROR (999) even if E-Stop fires. The workpiece must not
	// be released while the spindle is still coasting after an E-Stop -- ejecting the sheet at
	// speed is more hazardous than holding it clamped. Retract is triggered explicitly by
	// bMandrelRetractPulse when the operator acknowledges or resets from STATE_ERROR (lines
	// 2244/2256/2271/1477 in 06_MainProcess.scl), and Cmd_Extend is cleared every scan in
	// STATE_STOPPED (line 1514). All error-exit paths fire the retract pulse before reaching
	// STOPPED, so the mandrel cannot remain permanently extended.
	"DB_Cylinder_MandrelLock"(
	                          SafetyOK := "Safety_Estop" OR "DB_HMI".Bypass_EStop OR
	                          ("DB_HMI".MachineState = 20) OR  // STATE_RUNNING
	                          ("DB_HMI".MachineState = 25) OR  // STATE_PAUSED
	                          ("DB_HMI".MachineState = 18) OR  // STATE_STOPPING
	                          ("DB_HMI".MachineState = 999)    // STATE_ERROR: hold clamp until explicit Ack/Reset
	);
	"Output_Cyl_MandrelLock_SolA" := "DB_Cylinder_MandrelLock".Sol_A;
	"DB_Diagnostic".CylDiag[4].State := "DB_Cylinder_MandrelLock".State;
	"DB_Diagnostic".CylDiag[4].Pos := 0.0;
	"DB_Diagnostic".CylDiag[4].Sol_A := "DB_Cylinder_MandrelLock".Sol_A;
	"DB_Diagnostic".CylDiag[4].Error := "DB_Cylinder_MandrelLock".Error;
	"DB_Diagnostic".CylDiag[4].ErrorID := "DB_Cylinder_MandrelLock".ErrorID;
	
	// Cylinder manual command dispatch (selected cylinder â†’ DB_Manual SelCyl_* status)
	// Must run AFTER all cylinder FB calls so status reflects the current scan.
	"FC_CylinderDispatch"();
	
	// Contactor and enable outputs: FC_ContactorControl is called at the END of
	// FB_Process (in sync with the state machine) -- NOT here. ITEM-37: the
	// duplicate OB1 call was removed; nothing between fbProcess and this point
	// writes any input the FC depends on (Btn_Contactor_*, Bypass_EStop,
	// MachineState, Safety_Estop), so one call per scan is sufficient.
	
	// Automatically update tool slot angles based on slot count
	"FC_ToolAngleCalc"();
	
END_ORGANIZATION_BLOCK

