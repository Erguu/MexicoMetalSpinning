      Error_Text : String[100];   // Error_Detail removed -- not written anywhere, Error_Text is used instead Readable description for the last TO error code (FC_TO_ErrorText output)
      TO_ErrorText : String[60];   // ========================================================= CYLINDER DIAGNOSTICS -- indexed by cylinder number (1-based, max 8) No new fields needed when adding cylinders -- write to CylDiag[N] in OB1. =========================================================
      CylDiag : Array[1..8] of "UDT_CylDiag";
