// =============================================================================
// Version_Recipe - 02_DataBlocks.scl
// Memory-optimized data blocks for 5 recipe programs
// Target: CPU 1214C (100KB work memory)
// =============================================================================

// -----------------------------------------------------------------------------
// DB_RecipeProgram1 - Recipe data for Program 1 (max 1000 lines = 12KB)
// -----------------------------------------------------------------------------
DATA_BLOCK "DB_RecipeProgram1"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
    VAR
        Header : "RecipeHeader";                // Program name, LineCount, Valid, bounding box
        Lines  : Array[0..599] of "RecipeLine"; // 1000 lines × 12 byte = 12 KB
    END_VAR
BEGIN
END_DATA_BLOCK

// -----------------------------------------------------------------------------
// DB_RecipeProgram2 - Recipe data for Program 2
// -----------------------------------------------------------------------------
DATA_BLOCK "DB_RecipeProgram2"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
    VAR
        Header : "RecipeHeader";
        Lines  : Array[0..599] of "RecipeLine";
    END_VAR
BEGIN
END_DATA_BLOCK

