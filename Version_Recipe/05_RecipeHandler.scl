// =============================================================================
// Version_Recipe - 05_RecipeHandler.scl
// Recipe-based motion handler with pre-scan validation
// No string parsing - direct array access for maximum efficiency
// =============================================================================

// -----------------------------------------------------------------------------
// FB_RecipePreScan - Pre-scan recipe for limit validation
// DOC:
//  purpose: Scan recipe lines before execution to compute bounding box and detect
//           any soft-limit violations. Runs in batches to avoid long PLC scan times.
//  inputs: Execute (rising edge), LineCount
//  outputs: Done, Valid, ErrorLine (first offending line), MinX/MaxX, MinZ/MaxZ
//  notes: Designed for non-blocking operation - processes N lines per PLC cycle.
// -----------------------------------------------------------------------------
FUNCTION_BLOCK "FB_RecipePreScan"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
    VAR_INPUT
        Execute : Bool;             // Rising edge starts pre-scan (level input)
        LineCount : Int;            // Number of lines to scan
    END_VAR
    VAR_OUTPUT
        Done : Bool;                // TRUE when pre-scan finished
        Valid : Bool;               // TRUE if no limit violations found
        ErrorLine : Int := -1;      // Line with first error (-1 = none)
        MinX : Real;                // Computed bounding box minimum X
        MaxX : Real;                // Computed bounding box maximum X
        MinZ : Real;                // Computed bounding box minimum Z
        MaxZ : Real;                // Computed bounding box maximum Z
    END_VAR
    VAR_IN_OUT
        Lines : Array[0..999] of "RecipeLine"; // Recipe lines storage (in/out DB reference)
    END_VAR
    VAR
        state : Int;                // Local state machine
        scanIndex : Int;            // Current scan index (next line to process)
        scanEndIndex : Int;         // End index for current batch
        rtExecute : Bool;           // Rising-edge start detection
        prevExecute : Bool;         // Previous execute level (for edge)
    END_VAR
BEGIN
    // Rising edge detection
    #rtExecute := #Execute AND NOT #prevExecute;
    #prevExecute := #Execute;
    
    // NOTE: PreScan is designed to operate across multiple PLC cycles to avoid long scan blocks.
    // It batches lines (10 lines/cycle) so the CPU remains responsive. ErrorLine stores the first
    // offending line found to help operators quickly locate the problematic G-code.

    CASE #state OF
        0: // IDLE
            #Done := FALSE;
            IF #rtExecute THEN
                #scanIndex := 0;
                #MinX := 999999.0;
                #MaxX := -999999.0;
                #MinZ := 999999.0;
                #MaxZ := -999999.0;
                #ErrorLine := -1;
                #Valid := TRUE;
                #state := 10;
            END_IF;
            
        10: // SCANNING
            // Scan multiple lines per cycle for speed (10 lines/cycle)
            #scanEndIndex := #scanIndex + 9;
            IF #scanEndIndex > #LineCount - 1 THEN
                #scanEndIndex := #LineCount - 1;
            END_IF;
            
            FOR #scanIndex := #scanIndex TO #scanEndIndex DO
                // Only check motion commands (G0=0, G1=1) for bounding box and limits
                IF #Lines[#scanIndex].CMD <= 1 THEN
                    // Update bounding box
                    IF #Lines[#scanIndex].X < #MinX THEN #MinX := #Lines[#scanIndex].X; END_IF;
                    IF #Lines[#scanIndex].X > #MaxX THEN #MaxX := #Lines[#scanIndex].X; END_IF;
                    IF #Lines[#scanIndex].Z < #MinZ THEN #MinZ := #Lines[#scanIndex].Z; END_IF;
                    IF #Lines[#scanIndex].Z > #MaxZ THEN #MaxZ := #Lines[#scanIndex].Z; END_IF;
                    
                    // Check limits
                    IF #Lines[#scanIndex].X < "DB_MachineConfig".SoftLimit_MinX OR
                       #Lines[#scanIndex].X > "DB_MachineConfig".SoftLimit_MaxX OR
                       #Lines[#scanIndex].Z < "DB_MachineConfig".SoftLimit_MinZ OR
                       #Lines[#scanIndex].Z > "DB_MachineConfig".SoftLimit_MaxZ THEN
                        IF #ErrorLine < 0 THEN #ErrorLine := #scanIndex; END_IF;
                        #Valid := FALSE;
                    END_IF;
                END_IF;
            END_FOR;
            
            // NOT: FOR döngüsü #scanIndex'i otomatik artırır, ek +1 kaldırıldı
            
            IF #scanIndex >= #LineCount THEN
                #state := 99;
            END_IF;
            
        99: // DONE
            #Done := TRUE;
            IF NOT #Execute THEN #state := 0; END_IF;
    END_CASE;
END_FUNCTION_BLOCK

// -----------------------------------------------------------------------------
// FB_RecipeHandler - Execute recipe program line by line
// DOC:
//  purpose: Main recipe execution engine. Reads Lines[] and issues axis/spindle/tool requests.
//  inputs: Start/Stop/Pause/Reset control signals, LineCount
//  outputs: Busy/Done/Error, CurrentLine, Tool/Spindle requests, ActiveFeedrate, Progress
//  notes: No string parsing; recipe lines are pre-parsed into RecipeLine UDTs stored in DBs.
//         Designed to be deterministic and yield frequently to PLC scan cycle.
// -----------------------------------------------------------------------------
FUNCTION_BLOCK "FB_RecipeHandler"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
    VAR_INPUT
        Start : Bool;               // Rising-edge or level to start/continue execution
        Stop : Bool;                // Stop execution (controlled stop)
        Pause : Bool;               // Pause execution (retain position)
        Reset : Bool;               // Reset to beginning (clear internal state)
        LineCount : Int;            // Total lines in program
    END_VAR
    VAR_OUTPUT
        Busy : Bool;                // Execution in progress
        Done : Bool;                // Program complete
        Paused : Bool;              // Execution paused (SingleStep or Pause)
        Error : Bool;               // Error occurred
        ErrorID : Word;             // Error code (DB_ErrorCodes)
        CurrentLine : Int;          // Current line index being executed
        ToolChangeReq : Bool;       // Tool change requested by recipe
        ToolReqNumber : Int;        // Requested tool number (from recipe Param)
        SpindleReqStart : Bool;     // Spindle start request flag
        SpindleReqStop : Bool;      // Spindle stop request flag
        SpindleReqSpeed : Real;     // Spindle speed request (RPM)
        ActiveFeedrate : Real;      // Current feedrate (mm/min) for HMI display
        Progress : Real;            // Progress percentage 0-100
    END_VAR
    VAR_IN_OUT
        Lines : Array[0..999] of "RecipeLine"; // Reference to recipe lines in DB
        Axis_X : TO_PositioningAxis;           // Axis TO IN_OUT
        Axis_Z : TO_PositioningAxis;
    END_VAR
    VAR
        state : Int;                // Internal state machine
        lineIndex : Int;           // Current executing line index
        
        // Current motion targets and feedback
        targX : Real;               // Target X for current line
        targZ : Real;               // Target Z for current line
        currX : Real;               // Current X tracked by handler
        currZ : Real;               // Current Z tracked by handler
        velX : Real;                // Velocity command for X (mm/s)
        velZ : Real;                // Velocity command for Z (mm/s)
        
        // Temporary calculation variables
        deltaX : Real;
        deltaZ : Real;
        totalDist : Real;
        feedrate : Real;            // Calculated feedrate (mm/s)
        // Tool mapping helpers
        tmpToolCode : Int;          // Raw tool code from recipe Param (e.g. 101)
        mapIndex : Int;             // Loop index for mapping lookup
        mapFound : Bool;            // TRUE if mapping found
        
        // Move control flags
        bTrigMove : Bool;           // Trigger movement this cycle
        bMoveX : Bool;              // X axis needs to move
        bMoveZ : Bool;              // Z axis needs to move
        bHaltTrig : Bool;           // Trigger halt (Stop)
        
        // Motion FB instances used by handler
        fbMoveX : "FB_Axis_AbsPos";
        fbMoveZ : "FB_Axis_AbsPos";
        fbHaltX : "FB_Axis_Halt";
        fbHaltZ : "FB_Axis_Halt";
        
        // Timers for move timeout and dwell
        tonMoveTimeout : TON;
        tonDwell : TON;             // Dwell timer for CMD_DWELL
        dwellTime : Time;           // Calculated dwell duration
        
        // Edge detection for Start/StepNext
        prevStart : Bool;           // previous Start level
        rtStart : Bool;             // rising edge Start
        prevStepNext : Bool;        // previous StepNext level
        rtStepNext : Bool;          // rising edge StepNext
        
        // Override temporary
        overridePercent : Real;     // Feedrate override percent (50..200)
    END_VAR
    
    CONST
        STATE_IDLE : Int := 0;
        STATE_READ : Int := 10;
        STATE_EXEC : Int := 20;
        STATE_WAIT : Int := 30;
        STATE_TOOL_REQ : Int := 40;
        STATE_TOOL_WAIT : Int := 50;
        STATE_SPINDLE : Int := 55;   // Spindle command processing
        STATE_DWELL : Int := 57;     // Dwell/wait timer
        STATE_NEXT : Int := 60;
        STATE_STEP_WAIT : Int := 65;  // Wait for StepNext in SingleStepMode
        STATE_DONE : Int := 99;
        STATE_PAUSED : Int := 800;
        STATE_ERROR : Int := 999;
        
        CMD_RAPID : Byte := 0;
        CMD_LINEAR : Byte := 1;
        CMD_TOOL_CHANGE : Byte := 10;
        CMD_SPINDLE_ON : Byte := 20;
        CMD_SPINDLE_OFF : Byte := 21;
        CMD_DWELL : Byte := 30;
        CMD_END : Byte := 99;
    END_CONST
BEGIN
    // Edge detection
    #rtStart := #Start AND NOT #prevStart;
    #prevStart := #Start;
    
    // Debug note: rtStart is the rising-edge start trigger. We keep prevStart cleared on Reset
    // so consecutive starts are detected reliably.

    // SingleStep edge detection
    #rtStepNext := "DB_HMI".StepNext AND NOT #prevStepNext;
    #prevStepNext := "DB_HMI".StepNext;
    
    // Reset handling
    IF #Reset THEN
        #lineIndex := 0;
        #state := STATE_IDLE;
        #Error := FALSE;
        #ErrorID := 0;
        #Busy := FALSE;
        #Done := FALSE;
        #Paused := FALSE;
        #ToolChangeReq := FALSE;
        // BUG FIX: Clear internal flags so rising-edge detection works on next Start
        #prevStart := FALSE;
        #bTrigMove := FALSE;
        #bMoveX := FALSE;
        #bMoveZ := FALSE;
        #bHaltTrig := FALSE;
        #SpindleReqStart := FALSE;
        #SpindleReqStop := FALSE;
    END_IF;
    
    // Stop handling
    IF #Stop AND #state <> STATE_IDLE AND #state <> STATE_ERROR THEN
        // User Stop = kontrollü, hatasız duruş
        // Hareketleri FB_Axis_Halt ile güvenli şekilde kes,
        // ardından programı temiz şekilde DONE durumuna al.
        #bHaltTrig := TRUE;
        #Busy := FALSE;
        #Done := TRUE;
        #Paused := FALSE;
        // Hata üretilmez; Error/ErrorID dokunma
        #state := STATE_DONE;
    END_IF;
    
    // Move timeout timer
    #tonMoveTimeout(IN := #state = STATE_WAIT, PT := T#30S);
    
    // State machine
    CASE #state OF
        0: // IDLE
            #Busy := FALSE;
            #Done := FALSE;
            #Paused := FALSE;
            #bTrigMove := FALSE;
            #bHaltTrig := FALSE;
            
            IF #rtStart AND #LineCount > 0 THEN
                #lineIndex := 0;
                #currX := #Axis_X.ActualPosition;
                #currZ := #Axis_Z.ActualPosition;
                #Busy := TRUE;
                #state := STATE_READ;
            END_IF;
            
        10: // READ - Read current line
            IF #lineIndex >= #LineCount THEN
                #state := STATE_DONE;
            ELSE
                // Read line data
                #targX := #Lines[#lineIndex].X;
                #targZ := #Lines[#lineIndex].Z;
                
                // Check command type
                CASE #Lines[#lineIndex].CMD OF
                    CMD_END:
                        #state := STATE_DONE;
                        
                    CMD_TOOL_CHANGE:
                        // Read raw tool code (supports post-processed codes like 101)
                        #tmpToolCode := BYTE_TO_INT(#Lines[#lineIndex].Param);
                        #mapFound := FALSE;
                        // Try explicit mapping in DB_ToolConfig.ToolCode_List
                        FOR #mapIndex := 1 TO "DB_MachineConfig".ToolCount DO
                            IF "DB_ToolConfig".ToolCode_List[#mapIndex] = #tmpToolCode THEN
                                #ToolReqNumber := #mapIndex;
                                #mapFound := TRUE;
                            END_IF;
                        END_FOR;
                        // If mapping not found -> report recipe tool number error (operator must map codes via HMI)
                        IF NOT #mapFound THEN
                            #ErrorID := 16#0308; // Recipe: Invalid tool number
                            "DB_Diagnostic".Error_Text := CONCAT(IN1 := 'Tool code ', IN2 := INT_TO_STRING(#tmpToolCode));
                            "DB_Diagnostic".Error_Line := #lineIndex;
                            "DB_Diagnostic".Error_Code := #ErrorID;
                            // Provide clear HMI guidance for operator: which code is missing and what to do
                            "DB_HMI".ErrorText := CONCAT(IN1 := 'Tool code ', IN2 := INT_TO_STRING(#tmpToolCode));
                            "DB_HMI".ErrorDetail := 'Not mapped. Open Tool Setup, enter the numeric code for a slot and press Apply.';
                            #state := STATE_ERROR;
                        ELSE
                            // Mapping found -> request tool change for mapped slot
                            #state := STATE_TOOL_REQ;
                        END_IF;
                    
                    CMD_SPINDLE_ON, CMD_SPINDLE_OFF:
                        IF "DB_MachineConfig".Bypass_Spindle THEN
                            #state := STATE_NEXT;
                        ELSE
                            #state := STATE_SPINDLE;
                        END_IF;
                    
                    CMD_DWELL:
                        // Dwell = wait for Param * 100ms
                        #dwellTime := INT_TO_TIME(BYTE_TO_INT(#Lines[#lineIndex].Param) * 100);
                        #tonDwell(IN := FALSE, PT := #dwellTime); // Reset timer
                        #state := STATE_DWELL;
                        
                    CMD_RAPID, CMD_LINEAR:
                        #state := STATE_EXEC;
                        
                    ELSE
                        // Unknown command - skip
                        #state := STATE_NEXT;
                END_CASE;
            END_IF;
            
        20: // EXEC - Execute motion
            // Calculate deltas
            #deltaX := ABS(#targX - #currX);
            #deltaZ := ABS(#targZ - #currZ);
            #totalDist := SQRT(#deltaX * #deltaX + #deltaZ * #deltaZ);
            
            // Determine which axes need to move
            #bMoveX := #deltaX > 0.01;  // 0.01mm threshold
            #bMoveZ := #deltaZ > 0.01;
            
            // Calculate velocity
            IF #Lines[#lineIndex].CMD = CMD_RAPID OR #Lines[#lineIndex].F = 0 THEN
                // Rapid move - use max velocity with RapidOverride
                #feedrate := "DB_MachineConfig".RapidVelocity;
                #overridePercent := "DB_HMI".RapidOverride;
            ELSE
                // Linear move - convert mm/min to mm/s with FeedrateOverride
                #feedrate := INT_TO_REAL(#Lines[#lineIndex].F) / 60.0;
                #overridePercent := "DB_HMI".FeedrateOverride;
            END_IF;
            
            // Apply override (clamp to 50-200%)
            IF #overridePercent < 50.0 THEN #overridePercent := 50.0; END_IF;
            IF #overridePercent > 200.0 THEN #overridePercent := 200.0; END_IF;
            #feedrate := #feedrate * (#overridePercent / 100.0);
            
            // Clamp velocity to limits
            IF #feedrate > "DB_MachineConfig".MaxVelocity THEN
                #feedrate := "DB_MachineConfig".MaxVelocity;
            ELSIF #feedrate < "DB_MachineConfig".MinVelocity THEN
                #feedrate := "DB_MachineConfig".MinVelocity;
            END_IF;
            
            // Calculate axis velocities for linear interpolation
            IF #totalDist > 0.01 THEN
                #velX := #feedrate * #deltaX / #totalDist;
                #velZ := #feedrate * #deltaZ / #totalDist;
            ELSE
                #velX := #feedrate;
                #velZ := #feedrate;
            END_IF;
            
            // Ensure minimum velocity
            IF #bMoveX AND #velX < "DB_MachineConfig".MinVelocity THEN 
                #velX := "DB_MachineConfig".MinVelocity; 
            END_IF;
            IF #bMoveZ AND #velZ < "DB_MachineConfig".MinVelocity THEN 
                #velZ := "DB_MachineConfig".MinVelocity; 
            END_IF;
            
            // Skip if no movement needed
            IF NOT #bMoveX AND NOT #bMoveZ THEN
                #state := STATE_NEXT;
            ELSE
                // Trigger movement
                #bTrigMove := TRUE;
                #tonMoveTimeout(IN := FALSE, PT := T#30S);
                #state := STATE_WAIT;
            END_IF;
            
        30: // WAIT - Wait for motion complete
            #bTrigMove := FALSE;
            
            // Pause handling
            IF #Pause THEN
                #bHaltTrig := TRUE;
                #state := STATE_PAUSED;
            ELSE
                // Check completion based on which axes are moving
                IF (#bMoveX AND #bMoveZ) THEN
                    IF #fbMoveX.Done AND #fbMoveZ.Done THEN
                        #currX := #targX;
                        #currZ := #targZ;
                        #state := STATE_NEXT;
                    END_IF;
                ELSIF #bMoveX THEN
                    IF #fbMoveX.Done THEN
                        #currX := #targX;
                        #state := STATE_NEXT;
                    END_IF;
                ELSIF #bMoveZ THEN
                    IF #fbMoveZ.Done THEN
                        #currZ := #targZ;
                        #state := STATE_NEXT;
                    END_IF;
                ELSE
                    #state := STATE_NEXT;
                END_IF;
                
                // Error checking
                IF (#bMoveX AND #fbMoveX.Error) OR (#bMoveZ AND #fbMoveZ.Error) THEN
                    IF #bMoveX AND #fbMoveX.Error THEN
                        #ErrorID := 16#0001;
                        "DB_Diagnostic".Error_Text := 'X Axis Move Failed';
                        "DB_Diagnostic".MoveX_ErrorID := #fbMoveX.ErrorID;
                    ELSE
                        #ErrorID := 16#0002;
                        "DB_Diagnostic".Error_Text := 'Z Axis Move Failed';
                        "DB_Diagnostic".MoveZ_ErrorID := #fbMoveZ.ErrorID;
                    END_IF;
                    "DB_Diagnostic".Error_Line := #lineIndex;
                    "DB_Diagnostic".Error_Code := #ErrorID;
                    // Propagate error and record diagnostic context to help debugging.
                    #state := STATE_ERROR;
                ELSIF #tonMoveTimeout.Q THEN
                    #ErrorID := 16#0008;
                    "DB_Diagnostic".Error_Text := 'Motion Timeout';
                    "DB_Diagnostic".Error_Line := #lineIndex;
                    "DB_Diagnostic".Error_Code := #ErrorID;
                    #state := STATE_ERROR;
                END_IF;
            END_IF;
            
        40: // TOOL_REQ
            #ToolChangeReq := TRUE;
            #state := STATE_TOOL_WAIT;
            
        50: // TOOL_WAIT
            // Wait for external tool change completion from FB_Process
            // FB_Process sets ToolChangeReq := FALSE when done
            // Stay here until FB_Process clears our request
            IF NOT #ToolChangeReq THEN
                #state := STATE_NEXT;
            END_IF;
            
        55: // SPINDLE - Process spindle command
            IF #Lines[#lineIndex].CMD = CMD_SPINDLE_ON THEN
                #SpindleReqStart := TRUE;
                #SpindleReqStop := FALSE;
                #SpindleReqSpeed := INT_TO_REAL(BYTE_TO_INT(#Lines[#lineIndex].Param)) * 10.0;
            ELSE
                #SpindleReqStart := FALSE;
                #SpindleReqStop := TRUE;
                #SpindleReqSpeed := 0.0;
            END_IF;
            #state := STATE_NEXT;
            
        57: // DWELL - Wait for timer
            #tonDwell(IN := TRUE, PT := #dwellTime);
            IF #tonDwell.Q THEN
                #tonDwell(IN := FALSE, PT := #dwellTime); // Reset
                #state := STATE_NEXT;
            END_IF;
            
        60: // NEXT
            #lineIndex := #lineIndex + 1;
            // SingleStepMode: wait for user to press StepNext before continuing
            IF "DB_HMI".SingleStepMode THEN
                #state := STATE_STEP_WAIT;
            ELSE
                #state := STATE_READ;
            END_IF;
            
        65: // STEP_WAIT - Wait for StepNext pulse in SingleStep mode
            #Paused := TRUE;  // Show as paused in HMI
            IF #rtStepNext THEN
                // User pressed StepNext, continue to next line
                #Paused := FALSE;
                #state := STATE_READ;
            ELSIF NOT "DB_HMI".SingleStepMode THEN
                // SingleStepMode turned off, continue normally
                #Paused := FALSE;
                #state := STATE_READ;
            END_IF;
            
        99: // DONE
            #Busy := FALSE;
            #Done := TRUE;
            #ToolChangeReq := FALSE;
            
        800: // PAUSED
            #Paused := TRUE;
            #bHaltTrig := FALSE;
            IF NOT #Pause THEN
                #Paused := FALSE;
                #currX := #Axis_X.ActualPosition;
                #currZ := #Axis_Z.ActualPosition;
                #state := STATE_EXEC;
            END_IF;
            
        999: // ERROR
            #Error := TRUE;
            #Busy := FALSE;
            #ToolChangeReq := FALSE;
            #bHaltTrig := FALSE;
            // Ensure diagnostic block contains the latest recipe error context
            "DB_Diagnostic".Error_ProcessState := #state;
            "DB_Diagnostic".Error_Code := #ErrorID;
            "DB_Diagnostic".Error_Line := #lineIndex;
    END_CASE;
    
    // Call motion function blocks
    #fbMoveX(Execute := #bTrigMove AND #bMoveX, Position := #targX, Velocity := #velX, Axis := #Axis_X);
    #fbMoveZ(Execute := #bTrigMove AND #bMoveZ, Position := #targZ, Velocity := #velZ, Axis := #Axis_Z);
    #fbHaltX(Execute := #bHaltTrig, Axis := #Axis_X);
    #fbHaltZ(Execute := #bHaltTrig, Axis := #Axis_Z);
    
    // Calculate progress
    IF #LineCount > 0 THEN
        #Progress := INT_TO_REAL(#lineIndex) / INT_TO_REAL(#LineCount) * 100.0;
    ELSE
        #Progress := 0.0;
    END_IF;
    
    // Update active feedrate for HMI (convert mm/s back to mm/min)
    #ActiveFeedrate := #feedrate * 60.0;
    
    // Outputs
    #CurrentLine := #lineIndex;
    
    // Diagnostics
    "DB_Diagnostic".Recipe_CurrentLine := #lineIndex;
    "DB_Diagnostic".Recipe_TargetX := #targX;
    "DB_Diagnostic".Recipe_TargetZ := #targZ;
    "DB_Diagnostic".Recipe_Velocity := #velX;
    "DB_Diagnostic".bMoveX := #bMoveX;
    "DB_Diagnostic".bMoveZ := #bMoveZ;
    "DB_Diagnostic".MoveX_Busy := #fbMoveX.Busy;
    "DB_Diagnostic".MoveX_Done := #fbMoveX.Done;
    "DB_Diagnostic".MoveX_Error := #fbMoveX.Error;
    "DB_Diagnostic".MoveZ_Busy := #fbMoveZ.Busy;
    "DB_Diagnostic".MoveZ_Done := #fbMoveZ.Done;
    "DB_Diagnostic".MoveZ_Error := #fbMoveZ.Error;
END_FUNCTION_BLOCK
