// 04_ToolChanger.scl - GCODE Version

FUNCTION_BLOCK "FB_ToolChanger"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.1
    VAR_INPUT Execute : Bool; ToolNumber : Int; END_VAR
    VAR_OUTPUT Done : Bool; Busy : Bool; Error : Bool; ErrorID : Word; CurrentTool : Int; END_VAR
    VAR_IN_OUT Axis_X : TO_PositioningAxis; Axis_Z : TO_PositioningAxis; Axis_Tool : TO_PositioningAxis; END_VAR
    VAR 
        state : Int;
        targetToolPos : Real;
        fbMoveX : "FB_Axis_AbsPos";
        fbMoveZ : "FB_Axis_AbsPos";
        fbMoveTool : "FB_Axis_AbsPos";
        bExecMoveX : Bool;
        bExecMoveZ : Bool;
        bExecMoveTool : Bool;
    END_VAR
BEGIN
    IF NOT #Execute THEN
        #state := 0; #Done := FALSE; #Busy := FALSE; #Error := FALSE; #ErrorID := 0;
        #bExecMoveX := FALSE; #bExecMoveZ := FALSE; #bExecMoveTool := FALSE;
        RETURN;
    END_IF;
    #Busy := TRUE;
    CASE #state OF
        0: // Validate tool number
            IF #ToolNumber < 1 OR #ToolNumber > 4 THEN 
                #ErrorID := 16#0202;  // Invalid tool number
                #state := 999;
            ELSE
               CASE #ToolNumber OF
                   1: #targetToolPos := "DB_ToolConfig".Tool1_Position;
                   2: #targetToolPos := "DB_ToolConfig".Tool2_Position;
                   3: #targetToolPos := "DB_ToolConfig".Tool3_Position;
                   4: #targetToolPos := "DB_ToolConfig".Tool4_Position;
               END_CASE;
               #state := 10;
           END_IF;
        10: // Start retract to tool change position
            #bExecMoveX := TRUE; #bExecMoveZ := TRUE; #state := 20;
        20: // Wait for retract
            IF #fbMoveX.Done THEN #bExecMoveX := FALSE; END_IF;
            IF #fbMoveZ.Done THEN #bExecMoveZ := FALSE; END_IF;
            IF #fbMoveX.Done AND #fbMoveZ.Done THEN #state := 30;
            ELSIF #fbMoveX.Error OR #fbMoveZ.Error THEN 
                #ErrorID := 16#0204;  // Retract to tool pos failed
                #state := 999; 
            END_IF;
        30: // Start tool rotation
            #bExecMoveTool := TRUE; #state := 40;
        40: // Wait for tool rotation
            IF #fbMoveTool.Done THEN 
                #bExecMoveTool := FALSE; #CurrentTool := #ToolNumber; #state := 99;
            ELSIF #fbMoveTool.Error THEN 
                #ErrorID := 16#0205;  // Tool rotation failed
                #state := 999; 
            END_IF;
        99: // Done
            #Done := TRUE; #Busy := FALSE;
        999: // Error
            #Error := TRUE; #Busy := FALSE;
    END_CASE;
    #fbMoveX(Execute := #bExecMoveX, Position := "DB_ToolConfig".ToolChangePos_X,
             Velocity := "DB_MachineConfig".RapidVelocity, Axis := #Axis_X);
    #fbMoveZ(Execute := #bExecMoveZ, Position := "DB_ToolConfig".ToolChangePos_Z,
             Velocity := "DB_MachineConfig".RapidVelocity, Axis := #Axis_Z);
    #fbMoveTool(Execute := #bExecMoveTool, Position := #targetToolPos, Velocity := 50.0, Axis := #Axis_Tool);
END_FUNCTION_BLOCK
