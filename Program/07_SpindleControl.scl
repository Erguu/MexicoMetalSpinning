// =============================================================================
// 07_SpindleControl.scl
// FB_SpindleControl -- Spindle speed control (simplified)
//
// Purpose:
//   Controls the spindle in velocity mode using MC_MoveVelocity (PTO output).
//   VFD run direction: CW only -- no direction pin.
//   RunForward signal enables VFD run.
//
// ─────────────────────────────────────────────────────────────────────────────
// OPERATING RULES (enforced by the CALLER, not by this FB):
//
//   1. Set SetSpeed while RunCmd = FALSE.
//   2. Set RunCmd = TRUE  → MC_MoveVelocity starts + RunForward goes TRUE.
//      Keep RunCmd TRUE for the entire run.
//   3. To stop:  set RunCmd = FALSE  → RunForward goes FALSE, PTO halts.
//      Do NOT touch SetSpeed during stop.
//   4. To change speed WHILE RUNNING (in-place / on-the-fly):
//        Just write a new SetSpeed with RunCmd left TRUE. This FB detects the
//        change and regenerates the MC_MoveVelocity trigger edge internally
//        (Execute held LOW for SpindleSpeedChange_ExecLowTime, then raised) so
//        the drive ramps to the new speed. RunForward (VFD run) stays TRUE the
//        whole time -- the PTO is NOT halted (no MC_Halt, no lost run signal).
//        A full RunCmd FALSE->TRUE cycle is NOT required to change speed.
//
// This FB adds no long delays. The only intermediate action is the brief
// Execute-low pulse used to re-trigger MC_MoveVelocity on a speed change.
// Other timing handshakes (coast-down waits, etc.) are the CALLER's
// responsibility if they are needed.
//
// ─────────────────────────────────────────────────────────────────────────────
// Speed calculation:
//   effectiveSpeed = CLAMP(SetSpeed, MinSpeed, MaxSpeed)
//   PTO conversion: velocity (pulse/s) = effectiveRPM × 500 / 60
//   MinSpeed and MaxSpeed are read from DB_Spindle.
//
// Error codes:
//   16#0502 -- MC_MoveVelocity runtime error
//
// States (Diag_SpindleState):
//   0   = IDLE     -- RunCmd FALSE, all outputs safe
//   20  = RUNNING  -- RunCmd TRUE, PTO active, RunForward TRUE
//   999 = ERROR    -- cleared by AckError or Reset
//
// Change log:
//   2026-07-08  In-place speed change: state 20 now detects a SetSpeed change
//               while running and regenerates the MC_MoveVelocity Execute edge
//               (LOW for SpindleSpeedChange_ExecLowTime) without dropping
//               RunForward. Also makes live SpeedOverride changes take effect.
//   2026-05-09  Complete rewrite: RunCmd level input replaces Start/Stop edges.
//               Removed STARTING and STOPPING delay states and mid-run
//               velocity-change handshake.  Caller owns all sequencing.
//   2026-05-09  Previous version: 4-state machine (was 7-state before that).
// =============================================================================

FUNCTION_BLOCK "FB_SpindleControl"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 3.0
    VAR_INPUT
        Enable        : Bool;  // Drive power enable -- from bDrivesEnable; stays TRUE during normal operation
        RunCmd        : Bool;  // Level signal: TRUE = run, FALSE = stop/idle.
                               //   Set speed first, then raise RunCmd.
                               //   Lower RunCmd to stop; do not change speed while RunCmd is TRUE.
        SetSpeed      : Real;  // Commanded speed in RPM (set while RunCmd = FALSE)
        SpeedOverride : Real;  // Speed override % (100 = normal speed)
        Reset         : Bool;  // Full system reset -- clears ERROR, returns to IDLE
        AckError      : Bool;  // Acknowledge spindle error only (no full system reset needed)
    END_VAR
    VAR_OUTPUT
        Running        : Bool;  // TRUE while RunCmd is TRUE and no error
        AtSpeed        : Bool;  // TRUE when actual speed is within SpeedTolerance of commanded
        ActualSpeed    : Real;  // Measured speed (RPM)
        CommandedSpeed : Real;  // Override-applied target speed (RPM)
        Error          : Bool;  // Error active
        ErrorID        : Word;  // Error code
        RunForward     : Bool;  // VFD Run Forward digital output -- mirrors RunCmd (except in ERROR)
    END_VAR
    VAR_IN_OUT
        Axis_Spindle : TO_PositioningAxis;  // Spindle Technology Object
    END_VAR
    VAR
        state            : Int;   // 0 = IDLE, 20 = RUNNING, 999 = ERROR

        // Speed calculation
        effectiveRPM     : Real;  // RPM after override and clamping
        targetVelocity   : Real;  // Velocity in pulse/s sent to MC_MoveVelocity

        // Motion FB instances
        MC_Power_Inst        : MC_Power;
        MC_MoveVelocity_Inst : MC_MoveVelocity;

        // Internal execute flag
        bMoveVelExec : Bool;

        // AtSpeed helpers
        speedDiff    : Real;
        speedPercent : Real;

        // AckError edge detection
        prevAck  : Bool;
        ackEdge  : Bool;

        // In-place speed change (regenerate MC_MoveVelocity edge without halting PTO)
        prevEffectiveRPM : Real;   // last-applied speed, for change detection
        reExecActive     : Bool;   // TRUE while holding Execute LOW to re-trigger
        tonReExec        : TON;    // Execute-low hold timer (PT = SpindleSpeedChange_ExecLowTime)
    END_VAR

    CONST
        // Deadband for detecting a commanded-speed change (RPM). Prevents an HMI
        // override slider or measurement jitter from re-triggering every scan.
        SPEED_CHANGE_THRESHOLD : Real := 5.0;
    END_CONST

BEGIN
    // =========================================================================
    // 1. EDGE DETECTION
    // =========================================================================
    #ackEdge := #AckError AND NOT #prevAck;
    #prevAck := #AckError;

    // =========================================================================
    // 2. RESET (full system reset -- takes priority over everything)
    // =========================================================================
    IF #Reset THEN
        #state           := 0;
        #Error           := FALSE;
        #ErrorID         := 0;
        #bMoveVelExec    := FALSE;
        #RunForward      := FALSE;
        #reExecActive    := FALSE;
        #prevEffectiveRPM := 0.0;
        #tonReExec(IN := FALSE, PT := T#0S);
    END_IF;

    // =========================================================================
    // 3. SPEED CALCULATION (runs every scan)
    // =========================================================================
    #effectiveRPM := #SetSpeed * (#SpeedOverride / 100.0);
    IF #effectiveRPM < "DB_Spindle".MinSpeed THEN
        #effectiveRPM := "DB_Spindle".MinSpeed;
    END_IF;
    IF #effectiveRPM > "DB_Spindle".MaxSpeed THEN
        #effectiveRPM := "DB_Spindle".MaxSpeed;
    END_IF;
    #CommandedSpeed  := #effectiveRPM;
    #targetVelocity  := #effectiveRPM * 500.0 / 60.0;  // RPM → pulse/s

    // =========================================================================
    // 4. STATE MACHINE
    // =========================================================================
    CASE #state OF

        // -----------------------------------------------------------------
        // STATE 0: IDLE
        // All outputs safe.  Transition to RUNNING when RunCmd goes TRUE.
        // -----------------------------------------------------------------
        0:
            #Running      := FALSE;
            #AtSpeed      := FALSE;
            #bMoveVelExec := FALSE;
            #RunForward   := FALSE;
            #reExecActive := FALSE;
            #tonReExec(IN := FALSE, PT := T#0S);

            IF #RunCmd THEN
                #bMoveVelExec     := TRUE;  // pre-load velocity; RunForward still FALSE
                #prevEffectiveRPM := #effectiveRPM;  // baseline so first RUNNING scan doesn't false-trigger
                #state            := 10;
            END_IF;

        // -----------------------------------------------------------------
        // STATE 10: PRELOAD
        // Execute TRUE so the PTO frequency is stable before the VFD is
        // enabled.  RunForward stays FALSE this scan; transitions to RUNNING
        // on the very next scan.
        // -----------------------------------------------------------------
        10:
            #Running      := FALSE;
            #AtSpeed      := FALSE;
            #bMoveVelExec := TRUE;
            #RunForward   := FALSE;
            #state        := 20;

        // -----------------------------------------------------------------
        // STATE 20: RUNNING
        // RunCmd TRUE → MC_MoveVelocity active, RunForward TRUE.
        // The CALLER is responsible for sequencing (speed-change stops,
        // coast-down waits, PTO-stabilise delays, etc.).
        // Transition back to IDLE when RunCmd goes FALSE.
        // -----------------------------------------------------------------
        20:
            IF NOT #RunCmd THEN
                // Caller dropped RunCmd → stop immediately
                #Running      := FALSE;
                #AtSpeed      := FALSE;
                #bMoveVelExec := FALSE;
                #RunForward   := FALSE;
                #state        := 0;

            ELSE
                // Normal running
                #Running      := TRUE;
                #RunForward   := TRUE;   // VFD run stays TRUE across a speed change

                // --- In-place speed change --------------------------------------
                // MC_MoveVelocity latches Velocity only on a rising edge of Execute.
                // Detect a commanded-speed change and regenerate that edge by holding
                // Execute LOW for SpindleSpeedChange_ExecLowTime, then raising it again.
                // Execute=LOW does NOT abort the move (no MC_Halt): the axis holds its
                // velocity and the PTO keeps pulsing, so the VFD sees no run interruption.
                //
                // ┌─ BENCH TEST GUIDE (2026-07-08, pending hardware confirmation) ───────────┐
                // │ Goal: change spindle RPM mid-run (2nd CMD=20, no SPINDLE_OFF/tool change).│
                // │                                                                          │
                // │ TWO TUNING VALUES (live in DB_MachineConfig, no download; note that      │
                // │ FC_LoadConfig resets both to default on every restart/download):         │
                // │   • SpindleSpeedChange_DropRunForward (Bool)  = Mode A / Mode B selector │
                // │   • SpindleSpeedChange_ExecLowTime    (Time)  = length of change window  │
                // │                                                                          │
                // │ STEP 1 — Mode A (default): DropRunForward = FALSE, ExecLowTime = T#0S.   │
                // │   RunForward stays TRUE; only the PTO pulse frequency changes. This is   │
                // │   the documented wiring intent (VFD tracks pulse freq live).             │
                // │   → run recipe, trigger a 2nd CMD=20 at a new RPM. If spindle ramps to   │
                // │     the new speed, DONE — Mode A is correct.                             │
                // │                                                                          │
                // │ STEP 2 — only if Mode A does NOT ramp: set DropRunForward = TRUE and     │
                // │   ExecLowTime = T#200MS..T#500MS (so the VFD clearly sees RunForward     │
                // │   drop, then come back). Use this if the VFD latches its frequency at    │
                // │   the RunForward rising edge. PTO-safe: pulse train keeps running.       │
                // │                                                                          │
                // │ WATCH (DB_Spindle):                                                      │
                // │   ActualSpeed      → should ramp to the new RPM                          │
                // │   CommandedSpeed   → jumps to the new target immediately                 │
                // │   AtSpeed          → FALSE during ramp, TRUE once reached                │
                // │   Diag_MoveVelInVel/Diag_MoveVelBusy → brief blip at the change          │
                // │   Diag_SpindleState → stays 20 (RUNNING) throughout; 999 = fault         │
                // │ Confirm the VFD does NOT fault during the change window.                 │
                // │ Report which mode works → it becomes the committed default.              │
                // └──────────────────────────────────────────────────────────────────────────┘
                IF NOT #reExecActive
                   AND ABS(#effectiveRPM - #prevEffectiveRPM) > #SPEED_CHANGE_THRESHOLD THEN
                    #reExecActive := TRUE;
                    #tonReExec(IN := FALSE, PT := "DB_MachineConfig".SpindleSpeedChange_ExecLowTime);
                END_IF;

                IF #reExecActive THEN
                    #bMoveVelExec := FALSE;   // hold Execute low for the configured time
                    // Optional VFD-dependent behaviour: also drop RunForward during the
                    // change if the drive latches frequency at the run-enable edge.
                    // Pulse train keeps running (no MC_Halt) -- RunForward is the stop signal.
                    IF "DB_MachineConfig".SpindleSpeedChange_DropRunForward THEN
                        #RunForward := FALSE;
                    END_IF;
                    #tonReExec(IN := TRUE, PT := "DB_MachineConfig".SpindleSpeedChange_ExecLowTime);
                    IF #tonReExec.Q THEN
                        #reExecActive     := FALSE;
                        #prevEffectiveRPM := #effectiveRPM;  // new baseline; Execute rises next scan
                        #tonReExec(IN := FALSE, PT := "DB_MachineConfig".SpindleSpeedChange_ExecLowTime);
                    END_IF;
                ELSE
                    #bMoveVelExec     := TRUE;               // rising edge applies new targetVelocity
                    #prevEffectiveRPM := #effectiveRPM;
                END_IF;
                // ----------------------------------------------------------------

                // AtSpeed check
                #speedDiff    := ABS(#ActualSpeed - #effectiveRPM);
                #speedPercent := 0.0;
                IF #effectiveRPM > 1.0 THEN
                    #speedPercent := (#speedDiff / #effectiveRPM) * 100.0;
                END_IF;
                #AtSpeed := (#speedPercent <= "DB_Spindle".SpeedTolerance);

                // MC_MoveVelocity error check
                IF #MC_MoveVelocity_Inst.Error THEN
                    #ErrorID      := 16#0502;
                    #bMoveVelExec := FALSE;
                    #RunForward   := FALSE;
                    #reExecActive := FALSE;
                    #tonReExec(IN := FALSE, PT := T#0S);
                    "DB_Diagnostic".Spindle_TO_ErrorID := #MC_MoveVelocity_Inst.ErrorID;
                    "DB_Diagnostic".TO_ErrorText := "FC_TO_ErrorText"(Code := #MC_MoveVelocity_Inst.ErrorID);
                    "DB_Diagnostic".Error_Text := CONCAT(IN1 := 'Spindle move failed: ',
                                                          IN2 := "DB_Diagnostic".TO_ErrorText);
                    "DB_Diagnostic".Error_Code := #ErrorID;
                    // Single-writer: report via queue -> FB_AlarmManager latches DB_Error and
                    // drives DB_HMI.ErrorText through the mirror. (The old direct ErrorText
                    // write here was overwritten by the mirror one scan later and the error
                    // never reached DB_Error/history at all.)
                    "FC_ReportError"(Code := #ErrorID,
                                     Details := "DB_Diagnostic".Error_Text,
                                     Source := 'Spindle');
                    "DB_HMI".ErrorDetail    := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
                    #state := 999;
                END_IF;
            END_IF;

        // -----------------------------------------------------------------
        // STATE 999: ERROR
        // AckError: clears spindle error, returns to IDLE.
        // Reset:    handled above (takes priority, clears everything).
        // -----------------------------------------------------------------
        999:
            #Error        := TRUE;
            #Running      := FALSE;
            #AtSpeed      := FALSE;
            #bMoveVelExec := FALSE;
            #RunForward   := FALSE;
            #reExecActive := FALSE;

            IF #ackEdge THEN
                #Error   := FALSE;
                #ErrorID := 0;
                #state   := 0;
                // DB_HMI error text is owned by FB_AlarmManager (mirror) — Ack clears it
                // there; STATE_STOPPED clears ErrorDetail. No HMI writes from this FB.
            END_IF;

    END_CASE;

    // =========================================================================
    // 5. MC_ FUNCTION BLOCK CALLS (every scan)
    // =========================================================================
    #MC_Power_Inst(
        Axis   := #Axis_Spindle,
        Enable := #Enable
    );
    #MC_MoveVelocity_Inst(
        Axis      := #Axis_Spindle,
        Execute   := #bMoveVelExec,
        Velocity  := #targetVelocity,
        Direction := 1              // CW only -- no direction pin
    );

    // Actual speed: TO velocity (pulse/s) → RPM
    #ActualSpeed := ABS(#Axis_Spindle.ActualVelocity) * 60.0 / 500.0;

    // =========================================================================
    // 6. WRITE STATUS TO DB_Spindle (read by HMI and other FBs)
    // =========================================================================
    "DB_Spindle".IsRunning      := #Running;
    "DB_Spindle".AtSpeed        := #AtSpeed;
    "DB_Spindle".ActualSpeed    := #ActualSpeed;
    "DB_Spindle".CommandedSpeed := #CommandedSpeed;
    "DB_Spindle".Error          := #Error;
    "DB_Spindle".ErrorID        := #ErrorID;

    // Diagnostics (written every scan for watch-table tracing)
    "DB_Spindle".Diag_SpindleState  := #state;    // 0=Idle, 10=Preload, 20=Running, 999=Error
    "DB_Spindle".Diag_MoveVelBusy   := #MC_MoveVelocity_Inst.Busy;
    "DB_Spindle".Diag_MoveVelInVel  := #MC_MoveVelocity_Inst.InVelocity;

END_FUNCTION_BLOCK
