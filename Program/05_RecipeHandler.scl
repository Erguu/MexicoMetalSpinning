// =============================================================================
// Version_Recipe - 05_RecipeHandler.scl
// Recipe-based motion handler with pre-scan validation
// No string parsing - direct array access for maximum efficiency
// =============================================================================

// -----------------------------------------------------------------------------
// FB_RecipeLoader - Copy the selected recipe from LOAD memory into work memory
// DOC:
//  purpose: DB_RecipeProgram1..PROGRAM_COUNT live in load memory (UNLINKED) and cannot be
//           read by the program directly. This FB copies the selected one into
//           "DB_SelectedRecipe" using TWO sequential READ_DBL sub-reference
//           transfers -- .Header first, then .Lines. Never the whole-DB form;
//           see "TWO TRANSFERS, NOT ONE" below for what that cost on the machine.
//           Runs once per cycle start, in STATE_RECIPE_LOAD(11), before the
//           pre-scan -- the machine is stationary and nothing else is pending.
//  inputs:  Execute (rising edge), ProgramNo (1..PROGRAM_COUNT), Reset (level)
//  outputs: Done, Busy, Error + ErrorCode, LoadedProgram
//  design:  Program/docs/LOADMEM_COPY_ON_SELECT.md  (gate-tested 2026-08-04)
//
//  READ_DBL call form -- both of these cost a build if you get them wrong:
//    * READ_DBL is an INSTANCE-LESS system function (SFC 83 heritage). Declaring
//      it as a multi-instance gives "Data type READ_DBL is unknown".
//    * RET_VAL is the FUNCTION RETURN VALUE, not an output parameter. Passing
//      it as RET_VAL => x gives "The formal parameter 'RET_VAL' is invalid".
//
//  TWO TRANSFERS, NOT ONE (changed 2026-08-06 after a field failure).
//  The first version copied the WHOLE DB in one call (SRCBLK := "DB_RecipeProgramN").
//  On the machine that delivered the Header correctly and left Lines completely
//  zero, with no error anywhere -- a structured copy that matched the first
//  member and gave up on the second. Re-reading the gate-test results
//  (loadmem_gatetest/result.md) shows why it was never caught: whole-DB mode was
//  only ever proven at 350 lines / 4.3 KB, while the 12 KB / 1000-line case was
//  proven with the SUB-REFERENCE form (SRCBLK := "...".Lines). Production ran the
//  one combination -- whole DB at 12 KB -- that no test covered.
//  So: Header and Lines are now copied in two sequential calls, each in the exact
//  form the gate test passed. A length or type mismatch on Lines surfaces as a
//  non-zero RET_VAL instead of a silently empty buffer.
//
//  THE SPLIT WAS NOT ENOUGH (2026-08-13, second field failure, same signature).
//  The claim that a sub-reference copy "cannot half-succeed" was wrong. On the
//  machine the .Lines call again returned RET_VAL = 0 with BUSY = FALSE while the
//  array stayed zero -- pre-scan caught it as 16#0313. RET_VAL/BUSY report that the
//  instruction accepted and closed the job, not that 12 KB of flash arrived, and
//  the moment this FB left ST_WAIT_LINES it dropped REQ and abandoned whatever was
//  still in flight. PLCSIM never reproduced it (host RAM, copy done in one call).
//  ST_WAIT_LINES therefore no longer trusts BUSY alone: it VERIFIES the copy and
//  re-issues the transfer up to LINES_RETRY_MAX times before failing. Do not
//  "simplify" that check away -- it is the only thing standing between a silent
//  partial copy and a machined part.
//
//  WHY THE VERIFY PROBES THE WHOLE ARRAY AND NOT JUST THE END MARKER.
//  Same day, with a 999-line recipe: the operator found DB_SelectedRecipe zero up
//  to roughly line 900 and CORRECT after it. The copy is not all-or-nothing, it is
//  PARTIAL -- and the part that landed is where the END marker lives, so a
//  marker-only test would have passed that buffer and the machine would have run
//  ~900 zero lines (X=0, Z=0) with the HMI counting up. That is exactly what
//  happened before this check existed. Hence five poison probes across the array,
//  all of which must come back overwritten, AND the END marker. The 38-line case
//  is the same fault seen from the other end: there the marker sits at index 37,
//  in the region that did NOT land, so pre-scan caught it as 16#0313.
//  ErrorPhase says what failed: 1 = Header, 2 = Lines, 3 = Lines verify.
//
//  THE SELECTION LATCH -- the one genuinely dangerous thing in this block.
//  READ_DBL is asynchronous and spans several scans with REQ held. SRCBLK is a
//  VARIANT and the S7-1200 cannot index a DB dynamically, so the source is
//  chosen by a CASE. If that CASE branch changed mid-transfer, the buffer would
//  receive the front of one recipe and the tail of another -- with RET_VAL = 0
//  and no error anywhere. The operator would machine a part that exists in no
//  recipe. Hence #selLatched: the branch is frozen at ST_LATCH and the live
//  ProgramNo input is ignored until the transfer completes.
//
//  Reset path: REQ is derived from the state EVERY scan and is never latched
//  independently, so there is no way for a transfer to stay in flight across a
//  reset, an E-Stop or an error acknowledge.
// -----------------------------------------------------------------------------
FUNCTION_BLOCK "FB_RecipeLoader"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.3
    VAR_INPUT
        Execute   : Bool;           // Rising edge starts the copy
        ProgramNo : Int;            // 1..PROGRAM_COUNT -- which recipe to load
        Reset     : Bool;           // Level: abort, clear error, invalidate buffer
    END_VAR
    VAR_OUTPUT
        Done          : Bool;       // Copy complete AND verified, DB_SelectedRecipe is valid
        Busy          : Bool;       // Transfer in flight
        Error         : Bool;       // Copy failed -- FB_Process raises 16#0312 or 16#0314
        ErrorCode     : Word;       // READ_DBL RET_VAL, latched. Two sentinels that are
                                    // NOT RET_VAL values: 16#FFFF = watchdog timeout,
                                    // 16#0314 = a chunk never arrived intact
        ErrorPhase    : Int;        // 1 = Header transfer, 2 = chunk transfer (RET_VAL),
                                    // 3 = chunk verify (RET_VAL said OK, data did not arrive)
        ErrorChunk    : Int;        // Which chunk failed (1..CHUNK_COUNT), 0 = Header or
                                    // the assembled-buffer end-marker check
        LoadedProgram : Int;        // Which recipe is in the buffer (0 = none/invalid)
    END_VAR
    VAR
        // READ_DBL is NOT declared here -- see the note above.
        tonWatch    : TON;          // Hang watchdog (RecipeLoadTimeout), per transfer
        state       : Int;          // see the ST_* constants below
        selLatched  : Int := 1;     // Frozen program number for the whole load.
                                    // Never cleared: keeps the instruction being
                                    // called with REQ=FALSE so it resets cleanly.
        chunkPhase  : Int;          // 0 = Header is the live call, 1..CHUNK_COUNT = that
                                    // chunk. Latched like selLatched: only ever changed
                                    // where REQ is already low, never mid-transfer.
        chunkRetry  : Int;          // Attempts already re-issued for the CURRENT chunk
        reqActive   : Bool;         // REQ level, derived from state every scan
        busyRaw     : Bool;         // READ_DBL BUSY
        retValRaw   : Int;          // READ_DBL return value (raw, every scan)
        chunkOK     : Bool;         // every line of the staging buffer came back written
        hdrLines    : Int;          // Header.LineCount, for the END-marker check
        dstBase     : Int;          // first DB_SelectedRecipe index of the current chunk
        prevExecute : Bool;
        rtExecute   : Bool;
    END_VAR
    VAR_TEMP
        i           : Int;          // loop index (poison / verify / copy)
    END_VAR
    CONST
        ST_IDLE        : Int := 0;
        ST_LATCH       : Int := 10;
        ST_REQ_HDR     : Int := 20;  // Header transfer
        ST_WAIT_HDR    : Int := 30;
        ST_HDR_SETTLE  : Int := 35;  // One scan with REQ low so the Header call sees
                                     // its job closed before the CASE switches
        ST_CHUNK_PREP  : Int := 38;  // REQ low: poison the staging buffer, then request.
                                     // Also the settle scan BETWEEN chunks and the
                                     // re-poison step before a retry.
        ST_REQ_CHUNK   : Int := 40;
        ST_WAIT_CHUNK  : Int := 50;
        ST_CHUNK_COPY  : Int := 57;  // staging -> DB_SelectedRecipe (work memory, sync)
        ST_DONE        : Int := 60;
        ST_ERROR       : Int := 90;
        CHUNK_RETRY_MAX : Int := 3;  // re-issues per chunk before 16#0314. Each attempt
                                     // is bounded by RecipeLoadTimeout.
        CMD_PROGRAM_END : Int := 99; // Mandatory last-line marker (PLC_Recipe_Format_Spec.md)
        POISON_CMD     : Int := 255; // 16#FF -- no recipe CMD can be this value
        // Chunk geometry. COUPLED to tools/gen_recipe_slots.py (CHUNK_LINES /
        // CHUNK_COUNT) and to the DB_RecipeProgram*.Lines1..N declarations it
        // emits. Change them together or the transfers go out of step.
        CHUNK_LINES    : Int := 100;
        CHUNK_COUNT    : Int := 10;
        LINES_MAX      : Int := 1000; // = CHUNK_LINES * CHUNK_COUNT, and the bound of
                                      // DB_SelectedRecipe.Lines + the pre-scan guard
        // <<< GENERATED:PROGRAM_COUNT -- do not hand-edit; run tools/gen_recipe_slots.py >>>
        PROGRAM_COUNT : Int := 5;  // Slot count. Generated -- must match the DB_RecipeProgram* count.
        // <<< END GENERATED:PROGRAM_COUNT >>>
    END_CONST
BEGIN
    // -------------------------------------------------------------------------
    // Rising edge on Execute
    // -------------------------------------------------------------------------
    #rtExecute := #Execute AND NOT #prevExecute;
    #prevExecute := #Execute;

    // -------------------------------------------------------------------------
    // Reset -- always honoured. Drives REQ low via the state on the next line.
    // -------------------------------------------------------------------------
    IF #Reset THEN
        #state := ST_IDLE;
        #Done := FALSE;
        #Error := FALSE;
        #ErrorCode := 16#0000;
        #ErrorPhase := 0;
        #ErrorChunk := 0;
        #chunkPhase := 0;           // idle on the Header branch, REQ low
        #chunkRetry := 0;
        #LoadedProgram := 0;        // Buffer is no longer trusted -> forces a re-load
    END_IF;

    // -------------------------------------------------------------------------
    // REQ is derived from state EVERY SCAN -- never latched on its own.
    // ST_CHUNK_PREP is deliberately excluded: that is the scan where the previous
    // job is closed, the staging buffer is poisoned and the watchdog resets.
    // -------------------------------------------------------------------------
    #reqActive := (#state = ST_REQ_HDR) OR (#state = ST_WAIT_HDR)
                  OR (#state = ST_REQ_CHUNK) OR (#state = ST_WAIT_CHUNK);

    // -------------------------------------------------------------------------
    // THE READ_DBL CALL BLOCK
    // Outer CASE = which recipe (#selLatched), inner CASE = which transfer
    // (#chunkPhase: 0 = Header, 1..CHUNK_COUNT = Lines chunks). Exactly ONE call
    // executes per scan. Both selectors are latched, never the live inputs.
    // -------------------------------------------------------------------------
    // <<< GENERATED:LOADER_CASE -- do not hand-edit; run tools/gen_recipe_slots.py >>>
    CASE #selLatched OF
        1:  CASE #chunkPhase OF
                0: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram1".Header,
                                           BUSY => #busyRaw, DSTBLK := "DB_SelectedRecipe".Header);
                1: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram1".Lines1,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                2: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram1".Lines2,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                3: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram1".Lines3,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                4: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram1".Lines4,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                5: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram1".Lines5,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                6: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram1".Lines6,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                7: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram1".Lines7,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                8: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram1".Lines8,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                9: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram1".Lines9,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                10:#retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram1".Lines10,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
            END_CASE;
        2:  CASE #chunkPhase OF
                0: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram2".Header,
                                           BUSY => #busyRaw, DSTBLK := "DB_SelectedRecipe".Header);
                1: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram2".Lines1,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                2: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram2".Lines2,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                3: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram2".Lines3,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                4: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram2".Lines4,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                5: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram2".Lines5,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                6: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram2".Lines6,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                7: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram2".Lines7,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                8: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram2".Lines8,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                9: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram2".Lines9,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                10:#retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram2".Lines10,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
            END_CASE;
        3:  CASE #chunkPhase OF
                0: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram3".Header,
                                           BUSY => #busyRaw, DSTBLK := "DB_SelectedRecipe".Header);
                1: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram3".Lines1,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                2: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram3".Lines2,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                3: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram3".Lines3,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                4: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram3".Lines4,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                5: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram3".Lines5,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                6: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram3".Lines6,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                7: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram3".Lines7,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                8: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram3".Lines8,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                9: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram3".Lines9,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                10:#retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram3".Lines10,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
            END_CASE;
        4:  CASE #chunkPhase OF
                0: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram4".Header,
                                           BUSY => #busyRaw, DSTBLK := "DB_SelectedRecipe".Header);
                1: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram4".Lines1,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                2: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram4".Lines2,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                3: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram4".Lines3,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                4: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram4".Lines4,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                5: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram4".Lines5,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                6: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram4".Lines6,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                7: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram4".Lines7,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                8: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram4".Lines8,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                9: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram4".Lines9,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                10:#retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram4".Lines10,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
            END_CASE;
        5:  CASE #chunkPhase OF
                0: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram5".Header,
                                           BUSY => #busyRaw, DSTBLK := "DB_SelectedRecipe".Header);
                1: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram5".Lines1,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                2: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram5".Lines2,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                3: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram5".Lines3,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                4: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram5".Lines4,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                5: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram5".Lines5,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                6: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram5".Lines6,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                7: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram5".Lines7,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                8: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram5".Lines8,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                9: #retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram5".Lines9,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
                10:#retValRaw := READ_DBL(REQ := #reqActive, SRCBLK := "DB_RecipeProgram5".Lines10,
                                           BUSY => #busyRaw, DSTBLK := "DB_RecipeChunk".Lines);
            END_CASE;
    END_CASE;
    // <<< END GENERATED:LOADER_CASE >>>

    // -------------------------------------------------------------------------
    // Hang watchdog -- only runs while a transfer is in flight
    // -------------------------------------------------------------------------
    #tonWatch(IN := #reqActive, PT := "DB_MachineConfig".RecipeLoadTimeout);

    // -------------------------------------------------------------------------
    // State machine
    // -------------------------------------------------------------------------
    CASE #state OF

        // === ST_IDLE (0) ===
        ST_IDLE:
            IF #rtExecute AND #ProgramNo >= 1 AND #ProgramNo <= PROGRAM_COUNT THEN
                #state := ST_LATCH;
            END_IF;

        // === ST_LATCH (10) -- freeze the selection, poison the header ===
        ST_LATCH:
            #selLatched := #ProgramNo;      // the latch. Everything downstream uses this.
            #chunkPhase := 0;               // always start with the Header transfer
            #chunkRetry := 0;
            #Done := FALSE;
            #Error := FALSE;
            #ErrorCode := 16#0000;
            #ErrorPhase := 0;
            #ErrorChunk := 0;
            #LoadedProgram := 0;            // buffer invalid until the copy lands
            // POISON (2026-08-06): a failed load must leave a buffer that CANNOT
            // pass pre-scan. DB_SelectedRecipe survives delta downloads and failed
            // transfers, so header data from an OLD copy would otherwise sit there
            // looking like evidence that "the copy worked". The Lines array needs
            // no poison of its own any more -- every chunk is verified in the
            // staging buffer BEFORE it is allowed into DB_SelectedRecipe.
            "DB_SelectedRecipe".Header.LineCount := 0;
            "DB_SelectedRecipe".Header.sName := '';
            "DB_SelectedRecipe".Header.Valid := FALSE;
            #state := ST_REQ_HDR;

        // === ST_REQ_HDR (20) -- first scan with REQ high, Header branch ===
        ST_REQ_HDR:
            #state := ST_WAIT_HDR;

        // === ST_WAIT_HDR (30) -- hold REQ on the SAME branch until BUSY drops ===
        // ErrorCode is LATCHED here, not mirrored every scan: once REQ falls the
        // next call returns its idle value and would wipe the real result.
        ST_WAIT_HDR:
            IF #tonWatch.Q THEN
                #ErrorCode := 16#FFFF;      // watchdog: BUSY never cleared
                #ErrorPhase := 1;
                #state := ST_ERROR;
            ELSIF NOT #busyRaw THEN
                IF #retValRaw = 0 THEN
                    #state := ST_HDR_SETTLE;
                ELSE
                    #ErrorCode := INT_TO_WORD(#retValRaw);
                    #ErrorPhase := 1;
                    #state := ST_ERROR;
                END_IF;
            END_IF;

        // === ST_HDR_SETTLE (35) -- one scan with REQ low, then start chunk 1 ===
        ST_HDR_SETTLE:
            #chunkPhase := 1;
            #chunkRetry := 0;
            #state := ST_CHUNK_PREP;

        // === ST_CHUNK_PREP (38) -- REQ low: poison the staging buffer ===
        // Every line gets 16#FF in its CMD byte. After the transfer, ANY line
        // still holding 16#FF proves that line was never written. At CHUNK_LINES
        // = 100 this is complete coverage, not a sample: the scattered holes seen
        // on the machine (data around line 200 on one attempt, past 850 on
        // another) cannot slip through it.
        ST_CHUNK_PREP:
            FOR #i := 0 TO CHUNK_LINES - 1 DO
                "DB_RecipeChunk".Lines[#i].CMD := 16#FF;
            END_FOR;
            #state := ST_REQ_CHUNK;

        // === ST_REQ_CHUNK (40) -- first scan with REQ high on this chunk ===
        ST_REQ_CHUNK:
            #state := ST_WAIT_CHUNK;

        // === ST_WAIT_CHUNK (50) -- wait, then VERIFY before believing it ===
        // BUSY = FALSE with RET_VAL = 0 reports that the instruction closed the
        // job, NOT that the bytes arrived. That distinction is the entire bug.
        ST_WAIT_CHUNK:
            IF #tonWatch.Q THEN
                #ErrorCode := 16#FFFF;
                #ErrorPhase := 2;
                #ErrorChunk := #chunkPhase;
                #state := ST_ERROR;
            ELSIF NOT #busyRaw THEN
                IF #retValRaw <> 0 THEN
                    #ErrorCode := INT_TO_WORD(#retValRaw);
                    #ErrorPhase := 2;
                    #ErrorChunk := #chunkPhase;
                    #state := ST_ERROR;
                ELSE
                    #chunkOK := TRUE;
                    FOR #i := 0 TO CHUNK_LINES - 1 DO
                        IF BYTE_TO_INT("DB_RecipeChunk".Lines[#i].CMD) = POISON_CMD THEN
                            #chunkOK := FALSE;
                        END_IF;
                    END_FOR;

                    IF #chunkOK THEN
                        #state := ST_CHUNK_COPY;
                    ELSIF #chunkRetry < CHUNK_RETRY_MAX THEN
                        #chunkRetry := #chunkRetry + 1;
                        #state := ST_CHUNK_PREP;    // re-poison and re-issue THIS chunk
                    ELSE
                        // Out of attempts on this chunk. Not a READ_DBL failure --
                        // it claimed success every time -- so it gets its own code.
                        #ErrorCode := 16#0314;
                        #ErrorPhase := 3;
                        #ErrorChunk := #chunkPhase;
                        #state := ST_ERROR;
                    END_IF;
                END_IF;
            END_IF;

        // === ST_CHUNK_COPY (57) -- staging -> DB_SelectedRecipe ===
        // Work memory to work memory, synchronous, one scan. Variable indices are
        // legal here; it is only the READ_DBL VARIANT that must be constant.
        ST_CHUNK_COPY:
            #dstBase := (#chunkPhase - 1) * CHUNK_LINES;
            FOR #i := 0 TO CHUNK_LINES - 1 DO
                "DB_SelectedRecipe".Lines[#dstBase + #i] := "DB_RecipeChunk".Lines[#i];
            END_FOR;

            IF #chunkPhase < CHUNK_COUNT THEN
                #chunkPhase := #chunkPhase + 1;
                #chunkRetry := 0;               // fresh budget for the next chunk
                #state := ST_CHUNK_PREP;
            ELSE
                // Last chunk in. Final cross-check: the recipe format guarantees
                // the last line is CMD = 99, so the assembled buffer must end
                // where the Header says it does. Catches a Header and a Lines set
                // that came from different states of the source DB.
                #hdrLines := "DB_SelectedRecipe".Header.LineCount;
                IF #hdrLines >= 1 AND #hdrLines <= LINES_MAX
                   AND BYTE_TO_INT("DB_SelectedRecipe".Lines[#hdrLines - 1].CMD) <> CMD_PROGRAM_END THEN
                    #ErrorCode := 16#0314;
                    #ErrorPhase := 3;
                    #ErrorChunk := 0;           // 0 = assembled buffer, not one chunk
                    #state := ST_ERROR;
                ELSE
                    #LoadedProgram := #selLatched;
                    #Done := TRUE;
                    #state := ST_DONE;
                END_IF;
            END_IF;

        // === ST_DONE (60) ===
        // Done stays TRUE so FB_Process can move on. A new rising edge re-loads,
        // which is what a program change or a restart must do.
        ST_DONE:
            #Done := TRUE;
            IF #rtExecute AND #ProgramNo >= 1 AND #ProgramNo <= PROGRAM_COUNT THEN
                #state := ST_LATCH;
            END_IF;

        // === ST_ERROR (90) -- cleared only by Reset ===
        ST_ERROR:
            #Error := TRUE;
            #Done := FALSE;
            #LoadedProgram := 0;
    END_CASE;

    #Busy := #reqActive AND #busyRaw;
END_FUNCTION_BLOCK

// -----------------------------------------------------------------------------
// FB_RecipePreScan - Pre-scan recipe for limit validation
// DOC:
//  purpose: Scan recipe lines before execution to compute bounding box and detect
//           any soft-limit violations. Runs in batches to avoid long PLC scan times.
//  inputs: Execute (rising edge), LineCount
//  outputs: Done, Valid, ErrorLine (first offending line), MinX/MaxX, MinZ/MaxZ
//  notes: Designed for non-blocking operation - processes N lines per PLC cycle.
// -----------------------------------------------------------------------------
FUNCTION_BLOCK "FB_RecipePreScan"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
    VAR_INPUT
        Execute : Bool;             // Rising edge starts pre-scan (level input)
        LineCount : Int;            // Number of lines to scan
    END_VAR
    VAR_OUTPUT
        Done : Bool;                // TRUE when pre-scan finished
        Valid : Bool;               // TRUE if no limit violations found
        ErrorLine : Int := -1;      // Line with first error (-1 = none)
        ErrorDesc : String[60];     // Human-readable description of first violation
        MinX : Real;                // Computed bounding box minimum X
        MaxX : Real;                // Computed bounding box maximum X
        MinZ : Real;                // Computed bounding box minimum Z
        MaxZ : Real;                // Computed bounding box maximum Z
        Progress : Real;            // Pre-scan progress 0-100% for HMI display
    END_VAR
    VAR_IN_OUT
        // Bound to "DB_SelectedRecipe".Lines -- the work-memory buffer, never a
        // DB_RecipeProgram* (those are load-memory only). Must match that DB.
        Lines : Array[0..999] of "RecipeLine"; // Recipe lines storage (in/out DB reference)
    END_VAR
    VAR
        state : Int;                // Local state machine
        scanIndex : Int;            // Current scan index (next line to process)
        scanEndIndex : Int;         // End index for current batch
        rtExecute : Bool;           // Rising-edge start detection
        prevExecute : Bool;         // Previous execute level (for edge)
        // Temp vars for pre-scan checks (#4 feedrate/spindle, #5 tool mapping)
        spindleRPM : Real;          // Decoded spindle RPM from Param byte
        tmpToolCode : Int;          // Tool code from recipe Param
        mapIndex : Int;             // Tool mapping loop index
        mapFound : Bool;            // Tool mapping search result
        cylTarget : Real;           // reserved (ITEM-38 ruler range check removed -- BackSupport is full-stroke on this machine)
    END_VAR
    CONST
        // Recipe format: RecipeLine.Param encodes spindle speed as RPM ÷ 10.
        // Range: 0–255 byte → 0–2550 RPM. Clamp to DB_Spindle.MaxSpeed at runtime.
        // See PLC_Recipe_Format_Spec.md CMD_SPINDLE_ON.
        SPINDLE_PARAM_TO_RPM : Real := 10.0;
    END_CONST
BEGIN
    // -------------------------------------------------------------------------
    // Rising edge detection -- start once when Execute level rises
    // -------------------------------------------------------------------------
    #rtExecute := #Execute AND NOT #prevExecute;
    #prevExecute := #Execute;

    // NOTE: PreScan processes 10 lines per PLC scan cycle to avoid long scan blocks.
    // This preserves CPU responsiveness.
    // ErrorLine: the first line with a limit violation -- helps operator locate the issue.

    CASE #state OF

        // -----------------------------------------------------------------
        // === STATE_IDLE (0) ===
        // -----------------------------------------------------------------
        0: // IDLE -- waiting for Execute rising edge
            #Done := FALSE;
            #Progress := 0.0;
            IF #rtExecute THEN
                #scanIndex := 0;
                #MinX := "DB_MachineConfig".SoftLimit_MaxX;
                #MaxX := "DB_MachineConfig".SoftLimit_MinX;
                #MinZ := "DB_MachineConfig".SoftLimit_MaxZ;
                #MaxZ := "DB_MachineConfig".SoftLimit_MinZ;
                #ErrorLine := -1;
                #Valid := TRUE;
                #state := 10;
            END_IF;
            
        // -----------------------------------------------------------------
        // === STATE_SCANNING (10) ===
        // -----------------------------------------------------------------
        10: // SCANNING -- 10 lines scanned per cycle (batch processing)
            // Bounding box updated and soft limit checked for each G0/G1 line.
            // Other commands (SpindleOn, ToolChange, Dwell, End) skipped -- contain no position.
            #scanEndIndex := #scanIndex + 9;
            IF #scanEndIndex > #LineCount - 1 THEN
                #scanEndIndex := #LineCount - 1;
            END_IF;
            
            FOR #scanIndex := #scanIndex TO #scanEndIndex DO
                // Only check motion commands (G0=0, G1=1) for bounding box and limits
                IF #Lines[#scanIndex].CMD <= 1 THEN
                    // Update bounding box
                    IF #Lines[#scanIndex].X < #MinX THEN #MinX := #Lines[#scanIndex].X; END_IF;
                    IF #Lines[#scanIndex].X > #MaxX THEN #MaxX := #Lines[#scanIndex].X; END_IF;
                    IF #Lines[#scanIndex].Z < #MinZ THEN #MinZ := #Lines[#scanIndex].Z; END_IF;
                    IF #Lines[#scanIndex].Z > #MaxZ THEN #MaxZ := #Lines[#scanIndex].Z; END_IF;
                    
                    // Check limits -- records which axis/direction was violated
                    IF #Lines[#scanIndex].X < "DB_MachineConfig".SoftLimit_MinX THEN
                        IF #ErrorLine < 0 THEN
                            #ErrorLine := #scanIndex;
                            #ErrorDesc := CONCAT(IN1 := 'X below min (',
                                          IN2 := CONCAT(IN1 := REAL_TO_STRING("DB_MachineConfig".SoftLimit_MinX),
                                          IN2 := ')'));
                        END_IF;
                        #Valid := FALSE;
                    ELSIF #Lines[#scanIndex].X > "DB_MachineConfig".SoftLimit_MaxX THEN
                        IF #ErrorLine < 0 THEN
                            #ErrorLine := #scanIndex;
                            #ErrorDesc := CONCAT(IN1 := 'X above max (',
                                          IN2 := CONCAT(IN1 := REAL_TO_STRING("DB_MachineConfig".SoftLimit_MaxX),
                                          IN2 := ')'));
                        END_IF;
                        #Valid := FALSE;
                    ELSIF #Lines[#scanIndex].Z < "DB_MachineConfig".SoftLimit_MinZ THEN
                        IF #ErrorLine < 0 THEN
                            #ErrorLine := #scanIndex;
                            #ErrorDesc := CONCAT(IN1 := 'Z below min (',
                                          IN2 := CONCAT(IN1 := REAL_TO_STRING("DB_MachineConfig".SoftLimit_MinZ),
                                          IN2 := ')'));
                        END_IF;
                        #Valid := FALSE;
                    ELSIF #Lines[#scanIndex].Z > "DB_MachineConfig".SoftLimit_MaxZ THEN
                        IF #ErrorLine < 0 THEN
                            #ErrorLine := #scanIndex;
                            #ErrorDesc := CONCAT(IN1 := 'Z above max (',
                                          IN2 := CONCAT(IN1 := REAL_TO_STRING("DB_MachineConfig".SoftLimit_MaxZ),
                                          IN2 := ')'));
                        END_IF;
                        #Valid := FALSE;
                    END_IF;
                END_IF;

                // #4 -- Feedrate check: G1 F-value above MaxVelocity (mm/min → mm/s for comparison)
                IF #Lines[#scanIndex].CMD = 1 AND #Lines[#scanIndex].F > 0 THEN
                    IF INT_TO_REAL(#Lines[#scanIndex].F) / "DB_MachineConfig".FeedrateConvFactor > "DB_MachineConfig".MaxVelocity THEN
                        IF #ErrorLine < 0 THEN
                            #ErrorLine := #scanIndex;
                            #ErrorDesc := CONCAT(IN1 := 'F exceeds MaxVelocity (',
                                          IN2 := CONCAT(IN1 := REAL_TO_STRING("DB_MachineConfig".MaxVelocity * "DB_MachineConfig".FeedrateConvFactor),
                                          IN2 := ' mm/min)'));
                        END_IF;
                        #Valid := FALSE;
                    END_IF;
                END_IF;

                // #4 -- Spindle speed check: CMD_SPINDLE_ON Param*10 RPM vs DB_Spindle.MaxSpeed
                IF #Lines[#scanIndex].CMD = 20 THEN   // CMD_SPINDLE_ON
                    #spindleRPM := INT_TO_REAL(BYTE_TO_INT(#Lines[#scanIndex].Param)) * SPINDLE_PARAM_TO_RPM;
                    IF #spindleRPM > "DB_Spindle".MaxSpeed THEN
                        IF #ErrorLine < 0 THEN
                            #ErrorLine := #scanIndex;
                            #ErrorDesc := CONCAT(IN1 := 'Spindle RPM exceeds max (',
                                          IN2 := CONCAT(IN1 := REAL_TO_STRING("DB_Spindle".MaxSpeed),
                                          IN2 := ' RPM)'));
                        END_IF;
                        #Valid := FALSE;
                    END_IF;
                END_IF;

                // #5 -- Tool mapping check: CMD_TOOL_CHANGE Param must exist in ToolCode_List
                // Skip if Bypass_ToolAxis=TRUE -- runtime also skips tool changes on bypass machines
                IF #Lines[#scanIndex].CMD = 10 AND NOT "DB_MachineConfig".Bypass_ToolAxis THEN
                    #tmpToolCode := BYTE_TO_INT(#Lines[#scanIndex].Param);
                    #mapFound := FALSE;
                    FOR #mapIndex := 1 TO "DB_MachineConfig".ToolCount DO
                        IF "DB_ToolConfig".ToolCode_List[#mapIndex] = #tmpToolCode THEN
                            #mapFound := TRUE;
                        END_IF;
                    END_FOR;
                    IF NOT #mapFound THEN
                        IF #ErrorLine < 0 THEN
                            #ErrorLine := #scanIndex;
                            #ErrorDesc := CONCAT(IN1 := 'Tool code not mapped: T',
                                          IN2 := INT_TO_STRING(#tmpToolCode));
                        END_IF;
                        #Valid := FALSE;
                    END_IF;
                END_IF;


            END_FOR;

            // #13 -- Progress: updated each batch so HMI shows scanning progress
            IF #LineCount > 0 THEN
                #Progress := INT_TO_REAL(#scanIndex) / INT_TO_REAL(#LineCount) * 100.0;
            END_IF;

            // NOTE: FOR loop auto-increments #scanIndex, extra +1 removed

            IF #scanIndex >= #LineCount THEN
                #state := 99;
            END_IF;
            
        // -----------------------------------------------------------------
        // === STATE_DONE (99) ===
        // -----------------------------------------------------------------
        99: // DONE
            #Done := TRUE;
            #Progress := 100.0;
            IF NOT #Execute THEN
                #Done  := FALSE;  // Drop Done on the release scan so a stale TRUE
                                  // cannot be misread as a fresh result by the caller
                #state := 0;
            END_IF;
    END_CASE;
END_FUNCTION_BLOCK

// -----------------------------------------------------------------------------
// FB_RecipeHandler - Execute recipe program line by line
// DOC:
//  purpose: Main recipe execution engine. Reads Lines[] and issues axis/spindle/tool requests.
//  inputs: Start/Stop/Pause/Reset control signals, LineCount
//  outputs: Busy/Done/Error, CurrentLine, Tool/Spindle requests, ActiveFeedrate, Progress
//  notes: No string parsing; recipe lines are pre-parsed into RecipeLine UDTs stored in DBs.
//         Designed to be deterministic and yield frequently to PLC scan cycle.
// -----------------------------------------------------------------------------
FUNCTION_BLOCK "FB_RecipeHandler"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
    VAR_INPUT
        Start : Bool;               // Rising-edge or level to start/continue execution
        Stop : Bool;                // Stop execution (controlled stop)
        bStartEdge : Bool;          // Rising edge from Panel_Start_A AND Panel_Start_B (for sheet load confirm)
        Pause : Bool;               // Pause execution (retain position)
        Reset : Bool;               // Reset to beginning (clear internal state)
        StartLine : Int := 0;       // First line to execute on next run (0 = beginning; use savedLineIndex for warm restart)
        LineCount : Int;            // Total lines in program
    END_VAR
    VAR_OUTPUT
        Busy : Bool;                // Execution in progress
        Done : Bool;                // Program complete
        Paused : Bool;              // Execution paused (SingleStep or Pause)
        Error : Bool;               // Error occurred
        ErrorID : Word;             // Error code (DB_ErrorCodes)
        CurrentLine : Int;          // Current line index being executed
        ToolChangeReq : Bool;       // Tool change requested by recipe
        ToolReqNumber : Int;        // Requested tool number (from recipe Param)
        SpindleReqStart : Bool;     // Spindle start request flag
        SpindleReqStop : Bool;      // Spindle stop request flag
        SpindleReqSpeed : Real;     // Spindle speed request (RPM)
        ActiveFeedrate : Real;      // Current feedrate (mm/min) for HMI display
        Progress : Real;            // Progress percentage 0-100
    END_VAR
    VAR_IN_OUT
        // Bound to "DB_SelectedRecipe".Lines -- the work-memory buffer, never a
        // DB_RecipeProgram* (those are load-memory only). Must match that DB.
        Lines : Array[0..999] of "RecipeLine"; // Reference to recipe lines in DB
        Axis_X : TO_PositioningAxis;           // Axis TO IN_OUT
        Axis_Z : TO_PositioningAxis;
    END_VAR
    VAR
        state : Int;                // Internal state machine
        lineIndex : Int;           // Current executing line index
        
        // Current motion targets and feedback
        targX : Real;               // Target X for current line
        targZ : Real;               // Target Z for current line
        currX : Real;               // Current X tracked by handler
        currZ : Real;               // Current Z tracked by handler
        velX : Real;                // Velocity command for X (mm/s)
        velZ : Real;                // Velocity command for Z (mm/s)
        
        // Temporary calculation variables
        deltaX : Real;
        deltaZ : Real;
        totalDist : Real;
        feedrate : Real;            // Calculated feedrate (mm/s)
        // Tool mapping helpers
        tmpToolCode : Int;          // Raw tool code from recipe Param (e.g. 101)
        mapIndex : Int;             // Loop index for mapping lookup
        mapFound : Bool;            // TRUE if mapping found
        
        // Move control flags
        bTrigMove : Bool;           // Trigger movement this cycle
        bMoveX : Bool;              // X axis needs to move
        bMoveZ : Bool;              // Z axis needs to move
        bHaltTrig : Bool;           // Trigger halt (Stop)
        // BUG FIX: resume target after PAUSED. Pause from STATE_WAIT resumes via
        // STATE_EXEC (recalculate move from actual position). Pause from the
        // non-motion states (SPINDLE_WAIT/DWELL/SPINDLE_STOP_WAIT) must return to
        // that same state -- resuming via STATE_EXEC executed a move to the
        // non-motion line's X/Z placeholders (0,0) and drove both axes to home.
        pauseReturnState : Int := 20;  // 20 = STATE_EXEC (safe default)
        // Pause-retract: interruption point captured on pause, returned to on resume.
        resumeX : Real;             // Interruption-point X (return target after retract)
        resumeZ : Real;             // Interruption-point Z

        // Motion FB instances used by handler
        fbMoveX : "FB_Axis_AbsPos";
        fbMoveZ : "FB_Axis_AbsPos";
        fbHaltX : "FB_Axis_Halt";
        fbHaltZ : "FB_Axis_Halt";
        
        // Timers for move timeout and dwell
        tonMoveTimeout : TON;
        tonPauseMove : TON;         // Timeout guard for pause retract/return moves
        tonDwell : TON;             // Dwell timer for CMD_DWELL
        tonAtSpeed : TON;           // Timeout timer for spindle at-speed wait (STATE_SPINDLE_WAIT)
        dwellTime : Time;           // Calculated dwell duration
        
        // Edge detection for Start/StepNext
        prevStart : Bool;           // previous Start level
        rtStart : Bool;             // rising edge Start
        prevStepNext : Bool;        // previous StepNext level
        rtStepNext : Bool;          // rising edge StepNext
        
        // Override temporary
        overridePercent : Real;     // Feedrate override percent (50..200)
    END_VAR
    
    CONST
        STATE_IDLE : Int := 0;
        STATE_READ : Int := 10;
        STATE_EXEC : Int := 20;
        STATE_WAIT : Int := 30;
        STATE_TOOL_REQ : Int := 40;
        STATE_TOOL_WAIT : Int := 50;
        STATE_SPINDLE : Int := 55;   // Spindle command processing
        STATE_SPINDLE_WAIT : Int := 56;  // Wait for spindle AtSpeed after start command
        STATE_DWELL : Int := 57;     // Dwell/wait timer
        STATE_SPINDLE_STOP_WAIT : Int := 58;  // Wait for spindle to fully stop before proceeding
        STATE_NEXT : Int := 60;
        STATE_STEP_WAIT : Int := 65;  // Wait for StepNext in SingleStepMode
        STATE_CYL_GOTO      : Int := 70;   // CMD=40: set BackSupport TargetPos and trigger extend
        STATE_CYL_GOTO_WAIT : Int := 71;   // CMD=40: wait for BackSupport AtSetpoint or error
        STATE_DONE : Int := 99;
        STATE_PAUSED : Int := 800;         // Pause entry: halt axes, then retract
        STATE_PAUSE_RETRACT : Int := 801;  // Moving to retracted (tool-clear) position
        STATE_PAUSE_HOLD    : Int := 802;  // Held at retracted position, waiting for Continue
        STATE_PAUSE_RETURN  : Int := 803;  // Moving back to interruption point before resume
        STATE_STOPPING : Int := 850;  // Halt triggered, waiting for axes to stop
        STATE_ERROR : Int := 999;
        
        CMD_RAPID : Byte := 0;
        CMD_LINEAR : Byte := 1;
        CMD_TOOL_CHANGE : Byte := 10;
        CMD_SPINDLE_ON : Byte := 20;
        CMD_SPINDLE_OFF : Byte := 21;
        CMD_DWELL : Byte := 30;
        CMD_CYLINDER_GOTO : Byte := 40;     // BackSupport full extend (PositioningMode=0 on this machine; Param ignored)
        CMD_ATMO          : Byte := 41;     // BackSupport atmosphere. Param=1 → SolAtmo ON, Sol_A stays ON;
                                            // Param=2 → SolAtmo OFF + Cmd_Retract (Sol_A off, Sol_B on);
                                            // Param=3 → release retract, all coils off.
                                            // (The old "Sol_B+SolAtmo ON" at P1 was the SolB_Cmd41
                                            //  override, deleted 2026-08-07 -- see ITEM-41.)
        CMD_END : Byte := 99;

        // Recipe format: RecipeLine.Param encodes spindle speed as RPM ÷ 10.
        // Range: 0–255 byte → 0–2550 RPM. Clamp to DB_Spindle.MaxSpeed at runtime.
        // See PLC_Recipe_Format_Spec.md CMD_SPINDLE_ON.
        SPINDLE_PARAM_TO_RPM : Real := 10.0;
    END_CONST
BEGIN
    // =========================================================================
    // FB_RecipeHandler -- Execution logic summary
    // =========================================================================
    // Called every PLC scan cycle.
    // State machine:
    //   IDLE(0) → READ(10) → EXEC(20) → WAIT(30) → NEXT(60) → READ(10) → ...
    //   Special branches: TOOL_REQ(40)→TOOL_WAIT(50), SPINDLE(55), DWELL(57),
    //                     STEP_WAIT(65), PAUSED(800), STOPPING(850), DONE(99), ERROR(999)
    // All axis moves are performed via fbMoveX / fbMoveZ.
    // Spindle and tool change requests are passed to FB_Process via flags (no direct drive access).
    // =========================================================================

    // Rising edge detection -- Start button
    #rtStart := #Start AND NOT #prevStart;
    #prevStart := #Start;

    // NOTE: prevStart is cleared on Reset -- consecutive starts are reliably detected.

    // SingleStep edge detection
    #rtStepNext := "DB_HMI".StepNext AND NOT #prevStepNext;
    #prevStepNext := "DB_HMI".StepNext;
    
    // -------------------------------------------------------------------------
    // RESET -- Rewind program to beginning, clear all flags
    // Can be applied while running; caller must stop axes first.
    // -------------------------------------------------------------------------
    IF #Reset THEN
        #lineIndex := #StartLine;   // 0 = normal start; >0 = warm restart from saved line
        #state := STATE_IDLE;
        #Error := FALSE;
        #ErrorID := 0;
        #Busy := FALSE;
        #Done := FALSE;
        #Paused := FALSE;
        #ToolChangeReq := FALSE;
        // BUG FIX: Clear internal flags so rising-edge detection works on next Start
        #prevStart := FALSE;
        #bTrigMove := FALSE;
        #bMoveX := FALSE;
        #bMoveZ := FALSE;
        #bHaltTrig := FALSE;
        #pauseReturnState := STATE_EXEC;  // Clear stale resume target from a previous pause
        #SpindleReqStart := FALSE;
        #SpindleReqStop := FALSE;
        // Reset timers -- no stale ET remains on next run
        #tonMoveTimeout(IN := FALSE, PT := "DB_MachineConfig".Timeout_Motion);
        #tonPauseMove(IN := FALSE, PT := "DB_MachineConfig".Timeout_Motion);
        #tonDwell(IN := FALSE, PT := T#0S);
        // Clear CMD=40/41 BackSupport commands so next run starts clean.
        // Cmd_Retract is cleared here too: it is latched by CMD=41 P2 and by the
        // end-of-recipe retract in FB_Process, and a recipe must never start with a
        // stale retract command still held. FB_Process drops its end-retract latch on
        // leaving STOPPED/ERROR/COMPLETE, so this cannot cut that sequence short.
        "DB_Cylinder_BackSupport".Cmd_Extend  := FALSE;
        "DB_Cylinder_BackSupport".Cmd_Retract := FALSE;
        "DB_Cylinder_BackSupport".SolAtmo_Cmd := FALSE;
    END_IF;
    
    // -------------------------------------------------------------------------
    // STOP -- Controlled, error-free stop sequence
    // Halt triggered → waits in STATE_STOPPING until both axes fully stop
    // → STATE_DONE. Error/ErrorID untouched (operator stop is not an error).
    // -------------------------------------------------------------------------
    IF #Stop AND #state <> STATE_IDLE AND #state <> STATE_ERROR
              AND #state <> STATE_STOPPING AND #state <> STATE_DONE THEN
        // User Stop = controlled, error-free stop
        // Safely interrupt moves using FB_Axis_Halt.
        // Waits in STATE_STOPPING until halt completes, then STATE_DONE.
        #bHaltTrig := TRUE;
        // Drop any active move trigger so the pending halt has sole control of the axes.
        // Required because the pause-retract states (801/803) leave bTrigMove TRUE;
        // without this, MC_MoveAbsolute and MC_Halt would fight on the same axis.
        #bTrigMove := FALSE;
        #Paused := FALSE;
        // Clear BackSupport Cmd_Extend -- if stop fires during CMD=40 (STATE_CYL_GOTO_WAIT),
        // without this the cylinder keeps extending through the entire stop/home sequence.
        "DB_Cylinder_BackSupport".Cmd_Extend := FALSE;
        #state := STATE_STOPPING;
    END_IF;

    // Move timeout timer -- only counts during STATE_WAIT (30 seconds)
    // If axis does not return Done within 30s, error 16#0008 (Motion Timeout) is generated.
    #tonMoveTimeout(IN := #state = STATE_WAIT, PT := "DB_MachineConfig".Timeout_Motion);

    // Pause retract/return move timeout -- counts only while a pause move is in progress.
    // Guards against a stuck axis hanging the machine in the retract or return phase.
    #tonPauseMove(IN := (#state = STATE_PAUSE_RETRACT OR #state = STATE_PAUSE_RETURN),
                  PT := "DB_MachineConfig".Timeout_Motion);
    
    // State machine
    CASE #state OF

        // -----------------------------------------------------------------
        // === STATE_IDLE (0) ===
        // -----------------------------------------------------------------
        0: // IDLE
            #Busy := FALSE;
            #Done := FALSE;
            #Paused := FALSE;
            #bTrigMove := FALSE;
            #bHaltTrig := FALSE;
            
            IF #rtStart AND #LineCount > 0 THEN
                #lineIndex := #StartLine;   // 0 = normal start; >0 = warm restart
                #currX := #Axis_X.ActualPosition;
                #currZ := #Axis_Z.ActualPosition;
                #Busy := TRUE;
                #state := STATE_READ;
            END_IF;
            
        // -----------------------------------------------------------------
        // === STATE_READ (10) ===
        // -----------------------------------------------------------------
        10: // READ - Read current line
            IF #lineIndex >= #LineCount THEN
                #state := STATE_DONE;
            ELSE
                // Read line data
                #targX := #Lines[#lineIndex].X;
                #targZ := #Lines[#lineIndex].Z;
                
                // Check command type
                CASE #Lines[#lineIndex].CMD OF
                    CMD_END:
                        #state := STATE_DONE;
                        
                    CMD_TOOL_CHANGE:
                        // Read raw tool code (supports post-processed codes like 101)
                        #tmpToolCode := BYTE_TO_INT(#Lines[#lineIndex].Param);
                        #mapFound := FALSE;
                        // Try explicit mapping in DB_ToolConfig.ToolCode_List
                        FOR #mapIndex := 1 TO "DB_MachineConfig".ToolCount DO
                            IF "DB_ToolConfig".ToolCode_List[#mapIndex] = #tmpToolCode THEN
                                #ToolReqNumber := #mapIndex;
                                #mapFound := TRUE;
                            END_IF;
                        END_FOR;
                        // If mapping not found -> report recipe tool number error (operator must map codes via HMI)
                        IF NOT #mapFound THEN
                            #ErrorID := 16#0308; // Recipe: Invalid tool number
                            "DB_Diagnostic".Error_Text := CONCAT(IN1 := 'Tool code ', IN2 := INT_TO_STRING(#tmpToolCode));
                            "DB_Diagnostic".Error_Line := #lineIndex;
                            "DB_Diagnostic".Error_Code := #ErrorID;
                            // Single-writer: ErrorText comes from FB_AlarmManager (FB_Process forwards
                            // #ErrorID from STATE_RUNNING). The missing code number goes into ErrorDetail.
                            "DB_HMI".ErrorDetail    := CONCAT(IN1 := 'Tool code ', IN2 := CONCAT(
                                                       IN1 := INT_TO_STRING(#tmpToolCode),
                                                       IN2 := ' not mapped. Open Tool Setup, enter slot code & Apply.'));
                            #state := STATE_ERROR;
                        ELSE
                            // Mapping found -> request tool change for mapped slot
                            #state := STATE_TOOL_REQ;
                        END_IF;
                    
                    CMD_SPINDLE_ON, CMD_SPINDLE_OFF:
                        IF "DB_HMI".Bypass_Spindle THEN
                            #state := STATE_NEXT;
                        ELSE
                            #state := STATE_SPINDLE;
                        END_IF;
                    
                    CMD_DWELL:
                        // Dwell = wait for Param * 100ms
                        #dwellTime := INT_TO_TIME(BYTE_TO_INT(#Lines[#lineIndex].Param) * 100);
                        #tonDwell(IN := FALSE, PT := #dwellTime); // Reset timer
                        #state := STATE_DWELL;

                    CMD_CYLINDER_GOTO:
                        // BackSupport full extend -- waits AtSetpoint (Mode=0: after Timeout_Extend)
                        #state := STATE_CYL_GOTO;

                    CMD_ATMO:
                        // BackSupport atmosphere / retract control — fire-and-go (no axis wait).
                        // Operator spec 2026-08-07 (see DB_Cylinder_BackSupport header):
                        //   P1 -> atmosphere ON, Sol_A stays ON  (cylinder slack, still commanded out)
                        //   P2 -> atmosphere OFF, retract        (Sol_A off, Sol_B on)
                        //   P3 -> release retract                (all coils off, blocked centre holds)
                        //
                        // Sol_B is driven by the cylinder FB's own State 2, NOT by an output override.
                        // Cmd_Retract is a level input and nothing else writes it for this cylinder
                        // (FC_CylinderDispatch wires only the two *Full buttons), so a single write
                        // latches until we clear it at P3 or at end of recipe.
                        IF #Lines[#lineIndex].Param = 1 THEN
                            "DB_Cylinder_BackSupport".SolAtmo_Cmd := TRUE;   // energise atmosphere valve
                            // Sol_A deliberately left ON here (FB stays in State 3).
                        ELSIF #Lines[#lineIndex].Param = 2 THEN
                            "DB_Cylinder_BackSupport".SolAtmo_Cmd := FALSE;  // de-energise atmosphere valve
                            "DB_Cylinder_BackSupport".Cmd_Retract  := TRUE;  // FB State 3 -> 2: Sol_A off, Sol_B on
                        ELSIF #Lines[#lineIndex].Param = 3 THEN
                            "DB_Cylinder_BackSupport".SolAtmo_Cmd := FALSE;
                            "DB_Cylinder_BackSupport".Cmd_Retract  := FALSE; // FB State 2 -> 0: both coils off
                        END_IF;
                        #state := STATE_NEXT;

                    CMD_RAPID, CMD_LINEAR:
                        #state := STATE_EXEC;
                        
                    ELSE
                        // Unknown command - skip
                        #state := STATE_NEXT;
                END_CASE;
            END_IF;
            
        // -----------------------------------------------------------------
        // === STATE_EXEC (20) ===
        // -----------------------------------------------------------------
        20: // EXEC -- Calculate motion parameters and start move
            // Linear interpolation: both axes start and finish simultaneously.
            // velX/velZ split proportionally over total distance.
            // This ensures X and Z reach target in the same time (true linear path).
            #deltaX := ABS(#targX - #currX);
            #deltaZ := ABS(#targZ - #currZ);
            #totalDist := SQRT(#deltaX * #deltaX + #deltaZ * #deltaZ);
            
            // Determine which axes need to move
            #bMoveX := #deltaX > 0.01;  // 0.01mm threshold
            #bMoveZ := #deltaZ > 0.01;
            
            // Calculate velocity
            IF #Lines[#lineIndex].CMD = CMD_RAPID OR #Lines[#lineIndex].F = 0 THEN
                // Rapid move - use max velocity with RapidOverride
                #feedrate := "DB_MachineConfig".RapidVelocity;
                #overridePercent := "DB_HMI".RapidOverride;
            ELSE
                // Linear move - convert mm/min to mm/s with FeedrateOverride
                #feedrate := INT_TO_REAL(#Lines[#lineIndex].F) / "DB_MachineConfig".FeedrateConvFactor;
                #overridePercent := "DB_HMI".FeedrateOverride;
            END_IF;
            
            // Apply override (clamp to 50-200%)
            IF #overridePercent < 50.0 THEN #overridePercent := 50.0; END_IF;
            IF #overridePercent > 200.0 THEN #overridePercent := 200.0; END_IF;
            #feedrate := #feedrate * (#overridePercent / 100.0);
            
            // Clamp velocity to limits
            IF #feedrate > "DB_MachineConfig".MaxVelocity THEN
                #feedrate := "DB_MachineConfig".MaxVelocity;
            ELSIF #feedrate < "DB_MachineConfig".MinVelocity THEN
                #feedrate := "DB_MachineConfig".MinVelocity;
            END_IF;
            
            // Calculate axis velocities for linear interpolation
            IF #totalDist > 0.01 THEN
                #velX := #feedrate * #deltaX / #totalDist;
                #velZ := #feedrate * #deltaZ / #totalDist;
            ELSE
                #velX := #feedrate;
                #velZ := #feedrate;
            END_IF;
            
            // Ensure minimum velocity
            IF #bMoveX AND #velX < "DB_MachineConfig".MinVelocity THEN 
                #velX := "DB_MachineConfig".MinVelocity; 
            END_IF;
            IF #bMoveZ AND #velZ < "DB_MachineConfig".MinVelocity THEN 
                #velZ := "DB_MachineConfig".MinVelocity; 
            END_IF;
            
            // Skip if no movement needed
            IF NOT #bMoveX AND NOT #bMoveZ THEN
                #state := STATE_NEXT;
            ELSE
                // Trigger movement
                #bTrigMove := TRUE;
                #tonMoveTimeout(IN := FALSE, PT := "DB_MachineConfig".Timeout_Motion);
                #state := STATE_WAIT;
            END_IF;
            
        // -----------------------------------------------------------------
        // === STATE_WAIT (30) ===
        // -----------------------------------------------------------------
        30: // WAIT - Wait for motion complete
            #bTrigMove := FALSE;
            
            // Pause handling
            IF #Pause THEN
                #bHaltTrig := TRUE;
                // Resume via STATE_READ, not STATE_EXEC: the pause-retract states (800/802)
                // overwrite #targX/#targZ with retract/return geometry, destroying this line's
                // endpoint. STATE_READ re-reads the endpoint from #Lines[#lineIndex] before EXEC
                // recomputes the remaining move from currX/currZ (= interruption point after 803).
                // Going straight to EXEC computed deltaX = ABS(resumeX - resumeX) = 0 and silently
                // skipped the rest of the interrupted cut, jumping to the next line.
                #pauseReturnState := STATE_READ;  // motion pause: re-read endpoint, then recalc move
                #state := STATE_PAUSED;
            ELSE
                // Check completion based on which axes are moving
                IF (#bMoveX AND #bMoveZ) THEN
                    IF #fbMoveX.Done AND #fbMoveZ.Done THEN
                        #currX := #targX;
                        #currZ := #targZ;
                        #state := STATE_NEXT;
                    END_IF;
                ELSIF #bMoveX THEN
                    IF #fbMoveX.Done THEN
                        #currX := #targX;
                        #state := STATE_NEXT;
                    END_IF;
                ELSIF #bMoveZ THEN
                    IF #fbMoveZ.Done THEN
                        #currZ := #targZ;
                        #state := STATE_NEXT;
                    END_IF;
                ELSE
                    #state := STATE_NEXT;
                END_IF;
                
                // Error check -- TO/drive error or mechanical blockage
                // TO ErrorID: Siemens TO diagnostics code -- converted to readable text via FC_TO_ErrorText.
                // DB_Diagnostic.MoveX/Z_ErrorID: readable directly on HMI diagnostic page.
                IF (#bMoveX AND #fbMoveX.Error) OR (#bMoveZ AND #fbMoveZ.Error) THEN
                    IF #bMoveX AND #fbMoveX.Error THEN
                        #ErrorID := 16#0001;
                        "DB_Diagnostic".MoveX_ErrorID := #fbMoveX.ErrorID;
                        "DB_Diagnostic".TO_ErrorText  := "FC_TO_ErrorText"(Code := #fbMoveX.ErrorID);
                        "DB_Diagnostic".Error_Text := CONCAT(IN1 := 'X Move Failed: ', IN2 := "DB_Diagnostic".TO_ErrorText);
                        // Single-writer: ErrorText from FB_AlarmManager (FB_Process forwards #ErrorID)
                        "DB_HMI".ErrorDetail    := CONCAT(IN1 := 'Ln:', IN2 := CONCAT(
                                                   IN1 := INT_TO_STRING(#lineIndex), IN2 := CONCAT(
                                                   IN1 := ' TO:', IN2 := "DB_Diagnostic".TO_ErrorText)));
                    ELSE
                        #ErrorID := 16#0002;
                        "DB_Diagnostic".MoveZ_ErrorID := #fbMoveZ.ErrorID;
                        "DB_Diagnostic".TO_ErrorText  := "FC_TO_ErrorText"(Code := #fbMoveZ.ErrorID);
                        "DB_Diagnostic".Error_Text := CONCAT(IN1 := 'Z Move Failed: ', IN2 := "DB_Diagnostic".TO_ErrorText);
                        // Single-writer: ErrorText from FB_AlarmManager (FB_Process forwards #ErrorID)
                        "DB_HMI".ErrorDetail    := CONCAT(IN1 := 'Ln:', IN2 := CONCAT(
                                                   IN1 := INT_TO_STRING(#lineIndex), IN2 := CONCAT(
                                                   IN1 := ' TO:', IN2 := "DB_Diagnostic".TO_ErrorText)));
                    END_IF;
                    "DB_Diagnostic".Error_Line := #lineIndex;
                    "DB_Diagnostic".Error_Code := #ErrorID;
                    #state := STATE_ERROR;
                ELSIF #tonMoveTimeout.Q THEN
                    // Axis did not return Done within 30s -- mechanical blockage, drive fault or TO issue
                    #ErrorID := 16#0008;
                    "DB_Diagnostic".Error_Line := #lineIndex;
                    "DB_Diagnostic".Error_Code := #ErrorID;
                    // Determine which axis is stuck (based on bMoveX/Z state).
                    // Single-writer: ErrorText from FB_AlarmManager; axis goes into ErrorDetail.
                    IF #bMoveX AND #bMoveZ THEN
                        "DB_Diagnostic".Error_Text := 'Motion Timeout: X+Z axes';
                        "DB_HMI".ErrorDetail    := CONCAT(IN1 := 'X+Z Ln:', IN2 := CONCAT(
                                                  IN1 := INT_TO_STRING(#lineIndex), IN2 := ' (30s limit)'));
                    ELSIF #bMoveX THEN
                        "DB_Diagnostic".Error_Text := 'Motion Timeout: X axis';
                        "DB_HMI".ErrorDetail    := CONCAT(IN1 := 'X axis Ln:', IN2 := CONCAT(
                                                  IN1 := INT_TO_STRING(#lineIndex), IN2 := ' (30s limit)'));
                    ELSE
                        "DB_Diagnostic".Error_Text := 'Motion Timeout: Z axis';
                        "DB_HMI".ErrorDetail    := CONCAT(IN1 := 'Z axis Ln:', IN2 := CONCAT(
                                                  IN1 := INT_TO_STRING(#lineIndex), IN2 := ' (30s limit)'));
                    END_IF;
                    #state := STATE_ERROR;
                END_IF;
            END_IF;
            
        // -----------------------------------------------------------------
        // === STATE_TOOL_REQ (40) ===
        // -----------------------------------------------------------------
        40: // TOOL_REQ
            #ToolChangeReq := TRUE;
            #state := STATE_TOOL_WAIT;
            
        // -----------------------------------------------------------------
        // === STATE_TOOL_WAIT (50) ===
        // -----------------------------------------------------------------
        50: // TOOL_WAIT
            // Wait for external tool change completion from FB_Process
            // FB_Process sets ToolChangeReq := FALSE when done
            // BUG FIX: also wait for Start (bStartSeq) to be TRUE before advancing.
            // Without this, the recipe races ahead through READ→SPINDLE while the machine
            // is still in STATE_LOCK_EXTEND_WAIT (17) where bStartSeq=FALSE.
            // The spindle-start latch is only checked in CASE 20 (RUNNING), so any
            // SpindleReqStart pulse that fires in state 17 is silently missed.
            IF NOT #ToolChangeReq AND #Start THEN
                #state := STATE_NEXT;
            END_IF;
            
        // -----------------------------------------------------------------
        // === STATE_SPINDLE (55) ===
        // -----------------------------------------------------------------
        55: // SPINDLE -- Forward spindle command to FB_Process (via flag)
            IF #Lines[#lineIndex].CMD = CMD_SPINDLE_ON THEN
                #SpindleReqStart := TRUE;
                #SpindleReqStop := FALSE;
                #SpindleReqSpeed := INT_TO_REAL(BYTE_TO_INT(#Lines[#lineIndex].Param)) * SPINDLE_PARAM_TO_RPM;
                #tonAtSpeed(IN := FALSE, PT := "DB_MachineConfig".Timeout_SpindleAtSpeed);  // reset timer before waiting
                #state := STATE_SPINDLE_WAIT;           // wait for AtSpeed before next motion
            ELSE
                #SpindleReqStart := FALSE;
                #SpindleReqStop := TRUE;
                #SpindleReqSpeed := 0.0;
                #tonAtSpeed(IN := FALSE, PT := "DB_MachineConfig".Timeout_SpindleStop);  // reset timer for stop wait
                #state := STATE_SPINDLE_STOP_WAIT;      // wait for full stop before tool change / next motion
            END_IF;

        // -----------------------------------------------------------------
        // === STATE_SPINDLE_WAIT (56) ===
        // -----------------------------------------------------------------
        56: // SPINDLE_WAIT -- Wait for spindle to reach commanded speed (AtSpeed)
            // DB_Spindle.AtSpeed = TRUE when actual speed is within SpeedTolerance % of commanded.
            // Timeout 10s: error 16#030A. Adjust DB_Spindle.SpeedTolerance if triggering too early.
            // BUG FIX: Clear SpindleReqStart here (one scan after state 55 set it) so it is a
            // true one-shot flag. Without this, FB_Process re-sets bSpindleStart=TRUE every scan
            // because SpindleReqStart was never cleared, preventing FB_SpindleControl from ever
            // seeing a FALSE on its Start input and therefore never generating a rising startEdge.
            #SpindleReqStart := FALSE;
            #tonAtSpeed(IN := TRUE, PT := "DB_MachineConfig".Timeout_SpindleAtSpeed);
            IF "DB_Spindle".AtSpeed OR "DB_Spindle".Bypass_AtSpeed THEN
                #tonAtSpeed(IN := FALSE, PT := "DB_MachineConfig".Timeout_SpindleAtSpeed);  // reset for next use
                #state := STATE_NEXT;
            ELSIF #tonAtSpeed.Q THEN
                #tonAtSpeed(IN := FALSE, PT := "DB_MachineConfig".Timeout_SpindleAtSpeed);  // reset
                #ErrorID := 16#030A;
                "DB_Diagnostic".Error_Text := 'Spindle did not reach target speed (timeout)';
                "DB_Diagnostic".Error_Line := #lineIndex;
                "DB_Diagnostic".Error_Code := #ErrorID;
                // Single-writer: ErrorText from FB_AlarmManager (FB_Process forwards #ErrorID)
                "DB_HMI".ErrorDetail    := CONCAT(IN1 := 'Ln:', IN2 := CONCAT(
                                          IN1 := INT_TO_STRING(#lineIndex), IN2 := ' (10s limit)'));
                #state := STATE_ERROR;
            ELSIF #Pause THEN
                #tonAtSpeed(IN := FALSE, PT := "DB_MachineConfig".Timeout_SpindleAtSpeed);
                #bHaltTrig := TRUE;
                #pauseReturnState := STATE_SPINDLE_WAIT;  // resume re-waits AtSpeed, NOT a move
                #state := STATE_PAUSED;
            END_IF;

        // -----------------------------------------------------------------
        // === STATE_DWELL (57) ===
        // -----------------------------------------------------------------
        57: // DWELL -- Wait Param*100ms (equivalent to G4 command)
            // Example: Param=10 → 1000ms (1 second) wait.
            // No axis movement during dwell; spindle continues running.
            IF #Pause THEN
                // Pause pressed -- stop timer and go to PAUSED state
                #tonDwell(IN := FALSE, PT := #dwellTime);
                #bHaltTrig := TRUE;
                #pauseReturnState := STATE_DWELL;  // resume restarts the full dwell, NOT a move
                #state := STATE_PAUSED;
            ELSE
                #tonDwell(IN := TRUE, PT := #dwellTime);
                IF #tonDwell.Q THEN
                    #tonDwell(IN := FALSE, PT := #dwellTime); // Reset timer
                    #state := STATE_NEXT;
                END_IF;
            END_IF;
            
        // -----------------------------------------------------------------
        // === STATE_SPINDLE_STOP_WAIT (58) ===
        // -----------------------------------------------------------------
        58: // SPINDLE_STOP_WAIT -- Wait for spindle to fully stop before continuing.
            // Prevents a tool change (or next motion line) while spindle is still coasting.
            // DB_Spindle.IsRunning goes FALSE when FB_SpindleControl reaches idle state.
            // Timeout 15s → error 16#030B.
            // BUG FIX: Clear SpindleReqStop here (one scan after state 55 set it) so it is a
            // true one-shot flag. Mirrors the SpindleReqStart fix in state 56.
            #SpindleReqStop := FALSE;
            #tonAtSpeed(IN := TRUE, PT := "DB_MachineConfig".Timeout_SpindleStop);
            IF NOT "DB_Spindle".IsRunning THEN
                #tonAtSpeed(IN := FALSE, PT := "DB_MachineConfig".Timeout_SpindleStop);
                #state := STATE_NEXT;
            ELSIF #tonAtSpeed.Q THEN
                #tonAtSpeed(IN := FALSE, PT := "DB_MachineConfig".Timeout_SpindleStop);
                #ErrorID := 16#030B;
                "DB_Diagnostic".Error_Text := 'Spindle did not stop (timeout)';
                "DB_Diagnostic".Error_Line := #lineIndex;
                "DB_Diagnostic".Error_Code := #ErrorID;
                // Single-writer: ErrorText from FB_AlarmManager (FB_Process forwards #ErrorID)
                "DB_HMI".ErrorDetail    := CONCAT(IN1 := 'Ln:', IN2 := CONCAT(
                                          IN1 := INT_TO_STRING(#lineIndex), IN2 := ' (15s limit)'));
                #state := STATE_ERROR;
            ELSIF #Pause THEN
                #tonAtSpeed(IN := FALSE, PT := "DB_MachineConfig".Timeout_SpindleStop);
                #bHaltTrig := TRUE;
                #pauseReturnState := STATE_SPINDLE_STOP_WAIT;  // resume re-waits spindle stop, NOT a move
                #state := STATE_PAUSED;
            END_IF;

        // -----------------------------------------------------------------
        // === STATE_CYL_GOTO (70) ===
        // CMD=40: Trigger BackSupport full extension (PositioningMode=0, no ruler).
        // AtSetpoint fires after Timeout_Extend. Param value is ignored.
        // -----------------------------------------------------------------
        70: // STATE_CYL_GOTO
            "DB_Cylinder_BackSupport".Cmd_Extend := TRUE;
            #state := STATE_CYL_GOTO_WAIT;

        // -----------------------------------------------------------------
        // === STATE_CYL_GOTO_WAIT (71) ===
        // CMD=40: Wait for BackSupport AtSetpoint (Mode=0: after Timeout_Extend elapses).
        // Cmd_Extend re-written every scan to hold the extend command.
        // On done: clear Cmd_Extend. NOTE this does NOT de-energise the cylinder -- the FB
        // stays in State 3 and holds Sol_A ON (09:833-835). That is the operator's spec:
        // Sol_A stays energised until CMD=41 P2 latches Cmd_Retract. (The old comment here
        // claimed "5/3 blocked-center holds position", which was wrong for Mode 0: the hold
        // is live pressure, not the blocked centre.)
        // On error: report and go to STATE_ERROR.
        // -----------------------------------------------------------------
        71: // STATE_CYL_GOTO_WAIT
            "DB_Cylinder_BackSupport".Cmd_Extend := TRUE;
            IF #Pause THEN
                // ITEM-39: Pause during BackSupport extension. Clear Cmd_Extend --
                // the 5/3 blocked-centre valve holds position mechanically.
                // Resume re-enters STATE_CYL_GOTO and re-triggers Cmd_Extend.
                "DB_Cylinder_BackSupport".Cmd_Extend := FALSE;
                #bHaltTrig := TRUE;
                #pauseReturnState := STATE_CYL_GOTO;
                #state := STATE_PAUSED;
            ELSIF "DB_Cylinder_BackSupport".AtSetpoint THEN
                "DB_Cylinder_BackSupport".Cmd_Extend := FALSE;  // FB stays in State 3, Sol_A held ON
                #state := STATE_NEXT;
            ELSIF "DB_Cylinder_BackSupport".Error THEN
                "DB_Cylinder_BackSupport".Cmd_Extend := FALSE;
                #ErrorID := 16#0309;
                "DB_Diagnostic".Error_Text := CONCAT(IN1 := 'CMD40 BackSupport cyl error, Param=',
                                              IN2 := INT_TO_STRING(BYTE_TO_INT(#Lines[#lineIndex].Param)));
                "DB_Diagnostic".Error_Line := #lineIndex;
                "DB_Diagnostic".Error_Code := #ErrorID;
                // Single-writer: ErrorText from FB_AlarmManager (FB_Process forwards #ErrorID)
                "DB_HMI".ErrorDetail    := CONCAT(IN1 := 'Ln:', IN2 := CONCAT(
                                          IN1 := INT_TO_STRING(#lineIndex), IN2 := ' target not reached'));
                #state := STATE_ERROR;
            END_IF;

        // -----------------------------------------------------------------
        // === STATE_NEXT (60) ===
        // -----------------------------------------------------------------
        60: // NEXT
            #lineIndex := #lineIndex + 1;
            // SingleStepMode: wait for user to press StepNext before continuing
            IF "DB_HMI".SingleStepMode THEN
                #state := STATE_STEP_WAIT;
            ELSE
                #state := STATE_READ;
            END_IF;
            
        // -----------------------------------------------------------------
        // === STATE_STEP_WAIT (65) ===
        // -----------------------------------------------------------------
        65: // STEP_WAIT - Wait for StepNext pulse in SingleStep mode
            #Paused := TRUE;  // Show as paused in HMI
            IF #rtStepNext THEN
                // User pressed StepNext, continue to next line
                #Paused := FALSE;
                #state := STATE_READ;
            ELSIF NOT "DB_HMI".SingleStepMode THEN
                // SingleStepMode turned off, continue normally
                #Paused := FALSE;
                #prevStepNext := FALSE;  // Clear stale edge -- prevents false trigger when mode re-enabled
                #state := STATE_READ;
            END_IF;
            
        // -----------------------------------------------------------------
        // === STATE_DONE (99) ===
        // -----------------------------------------------------------------
        99: // DONE
            #Busy := FALSE;
            #Done := TRUE;
            #ToolChangeReq := FALSE;
            
        // -----------------------------------------------------------------
        // === STATE_PAUSED (800) ===
        // -----------------------------------------------------------------
        // Pause sequence (return-before-resume): 800 halt/capture -> 801 retract ->
        // 802 hold -> 803 return -> pauseReturnState. This FB does not touch the spindle;
        // FB_Process stops it while paused (State=PAUSED) and spins it back up before it
        // releases Pause (drops bPauseActive) here, so 802 -> 803 return only starts once
        // the spindle is back up to speed. See docs/FB_Process_States.md (STATE_PAUSED).
        // Offset/velocity from DB_MachineConfig.
        // -----------------------------------------------------------------
        800: // PAUSED -- fully stop axes, capture interruption point, then retract
            #Paused := TRUE;
            IF NOT (#fbHaltX.Done OR NOT #bMoveX) OR NOT (#fbHaltZ.Done OR NOT #bMoveZ) THEN
                // Axes not yet stopped -- hold halt command
                #bHaltTrig := TRUE;
            ELSE
                // Axes stopped -- release halt, capture return point, arm retract move.
                #bHaltTrig := FALSE;
                #resumeX := #Axis_X.ActualPosition;   // exact interruption point
                #resumeZ := #Axis_Z.ActualPosition;
                // Retract targets = interruption point + operator offset, clamped to soft limits
                // so a pause near home cannot drive an axis past its limit and fault.
                #targX := LIMIT(MN := "DB_MachineConfig".SoftLimit_MinX,
                                IN := #resumeX + "DB_MachineConfig".PauseRetract_X,
                                MX := "DB_MachineConfig".SoftLimit_MaxX);
                #targZ := LIMIT(MN := "DB_MachineConfig".SoftLimit_MinZ,
                                IN := #resumeZ + "DB_MachineConfig".PauseRetract_Z,
                                MX := "DB_MachineConfig".SoftLimit_MaxZ);
                // Both axes are launched on the same bTrigMove edge (same scan) so they
                // START together. Each runs at PauseRetract_Vel independently and finishes
                // when it reaches its own target (they need not arrive together).
                #velX := "DB_MachineConfig".PauseRetract_Vel;
                #velZ := "DB_MachineConfig".PauseRetract_Vel;
                #bMoveX := ABS(#targX - #resumeX) > 0.01;   // skip axis if no net offset
                #bMoveZ := ABS(#targZ - #resumeZ) > 0.01;
                #bTrigMove := FALSE;   // ensure clean FALSE->TRUE edge for fbMove next scan
                #tonPauseMove(IN := FALSE, PT := "DB_MachineConfig".Timeout_Motion);
                #state := STATE_PAUSE_RETRACT;
            END_IF;

        // -----------------------------------------------------------------
        // === STATE_PAUSE_RETRACT (801) ===
        // -----------------------------------------------------------------
        801: // Move to retracted (tool-clear) position. bHaltTrig stays FALSE (no conflict).
            #Paused := TRUE;
            #bTrigMove := TRUE;   // FALSE->TRUE rising edge triggers fbMoveX/fbMoveZ
            IF (#bMoveX AND #fbMoveX.Error) OR (#bMoveZ AND #fbMoveZ.Error) THEN
                "DB_Diagnostic".Error_Line := #lineIndex;
                IF #bMoveX AND #fbMoveX.Error THEN #ErrorID := 16#0001;
                ELSE #ErrorID := 16#0002; END_IF;
                "DB_Diagnostic".Error_Code := #ErrorID;
                "DB_Diagnostic".Error_Text := 'Pause retract move failed';
                #bTrigMove := FALSE;
                #state := STATE_ERROR;
            ELSIF #tonPauseMove.Q THEN
                #ErrorID := 16#0008;
                "DB_Diagnostic".Error_Line := #lineIndex;
                "DB_Diagnostic".Error_Code := #ErrorID;
                "DB_Diagnostic".Error_Text := 'Pause retract timeout';
                #bTrigMove := FALSE;
                #state := STATE_ERROR;
            ELSIF (NOT #bMoveX OR #fbMoveX.Done) AND (NOT #bMoveZ OR #fbMoveZ.Done) THEN
                #bTrigMove := FALSE;   // drop so a fresh edge can start the return move
                #currX := #targX;      // handler now tracks the retracted position
                #currZ := #targZ;
                #state := STATE_PAUSE_HOLD;
            END_IF;

        // -----------------------------------------------------------------
        // === STATE_PAUSE_HOLD (802) ===
        // -----------------------------------------------------------------
        802: // Held at retracted position. Wait for Continue (Pause released).
            #Paused := TRUE;
            #bTrigMove := FALSE;
            IF NOT #Pause THEN
                // Arm the return move back to the exact interruption point.
                // Both axes launched on the same bTrigMove edge (start together).
                #targX := #resumeX;
                #targZ := #resumeZ;
                #velX := "DB_MachineConfig".PauseRetract_Vel;
                #velZ := "DB_MachineConfig".PauseRetract_Vel;
                #bMoveX := ABS(#targX - #Axis_X.ActualPosition) > 0.01;
                #bMoveZ := ABS(#targZ - #Axis_Z.ActualPosition) > 0.01;
                #bTrigMove := FALSE;   // clean edge next scan
                #tonPauseMove(IN := FALSE, PT := "DB_MachineConfig".Timeout_Motion);
                #state := STATE_PAUSE_RETURN;
            END_IF;

        // -----------------------------------------------------------------
        // === STATE_PAUSE_RETURN (803) ===
        // -----------------------------------------------------------------
        803: // Move back to the interruption point, then resume the original toolpath.
            #Paused := TRUE;
            #bTrigMove := TRUE;
            IF (#bMoveX AND #fbMoveX.Error) OR (#bMoveZ AND #fbMoveZ.Error) THEN
                "DB_Diagnostic".Error_Line := #lineIndex;
                IF #bMoveX AND #fbMoveX.Error THEN #ErrorID := 16#0001;
                ELSE #ErrorID := 16#0002; END_IF;
                "DB_Diagnostic".Error_Code := #ErrorID;
                "DB_Diagnostic".Error_Text := 'Pause return move failed';
                #bTrigMove := FALSE;
                #state := STATE_ERROR;
            ELSIF #tonPauseMove.Q THEN
                #ErrorID := 16#0008;
                "DB_Diagnostic".Error_Line := #lineIndex;
                "DB_Diagnostic".Error_Code := #ErrorID;
                "DB_Diagnostic".Error_Text := 'Pause return timeout';
                #bTrigMove := FALSE;
                #state := STATE_ERROR;
            ELSIF (NOT #bMoveX OR #fbMoveX.Done) AND (NOT #bMoveZ OR #fbMoveZ.Done) THEN
                #bTrigMove := FALSE;
                #Paused := FALSE;
                #currX := #resumeX;    // back on the original path
                #currZ := #resumeZ;
                // Resume the state the pause was taken from. Motion pauses resume via
                // STATE_READ (re-read line endpoint, then EXEC recalculates the remaining
                // move from currX/currZ); dwell/spindle-wait continue in place.
                #state := #pauseReturnState;
            END_IF;

        // -----------------------------------------------------------------
        // === STATE_STOPPING (850) ===
        // -----------------------------------------------------------------
        850: // STOPPING -- Halt active, waiting for both axes to fully stop
            // fbHaltX and fbHaltZ continue to be called with Execute=TRUE.
            // When both return Done, bHaltTrig=FALSE and STATE_DONE is entered.
            // This allows STATE_STOPPING (18) in FB_Process to safely see Busy=FALSE.
            #bHaltTrig := TRUE;
            IF #fbHaltX.Done AND #fbHaltZ.Done THEN
                #bHaltTrig := FALSE;
                #Busy  := FALSE;
                #Done  := TRUE;
                #Paused := FALSE;
                #state := STATE_DONE;
            END_IF;

        // -----------------------------------------------------------------
        // === STATE_ERROR (999) ===
        // -----------------------------------------------------------------
        999: // ERROR
            #Error := TRUE;
            #Busy := FALSE;
            #ToolChangeReq := FALSE;
            #bTrigMove := FALSE;  // Stop move commands -- prevent other axis from running free
            #bMoveX := FALSE;
            #bMoveZ := FALSE;
            #bHaltTrig := TRUE;   // Safely stop both axes (was FALSE -- BUG FIX)
            // Ensure diagnostic block contains the latest recipe error context
            "DB_Diagnostic".Error_ProcessState := #state;
            "DB_Diagnostic".Error_Code := #ErrorID;
            "DB_Diagnostic".Error_Line := #lineIndex;
    END_CASE;
    
    // -------------------------------------------------------------------------
    // Motion FB calls -- run at end of every scan (after state machine)
    // bTrigMove AND bMoveX/Z: active only in EXEC state and when axis is needed
    // bHaltTrig: TRUE in STOPPING and PAUSED states -- decelerates axis to stop
    // -------------------------------------------------------------------------
    #fbMoveX(Execute := #bTrigMove AND #bMoveX, Position := #targX, Velocity := #velX, Axis := #Axis_X);
    #fbMoveZ(Execute := #bTrigMove AND #bMoveZ, Position := #targZ, Velocity := #velZ, Axis := #Axis_Z);
    #fbHaltX(Execute := #bHaltTrig, Axis := #Axis_X);
    #fbHaltZ(Execute := #bHaltTrig, Axis := #Axis_Z);
    
    // Calculate progress
    IF #LineCount > 0 THEN
        #Progress := INT_TO_REAL(#lineIndex) / INT_TO_REAL(#LineCount) * 100.0;
    ELSE
        #Progress := 0.0;
    END_IF;
    
    // Update active feedrate for HMI (convert mm/s back to mm/min using same factor as forward conversion)
    #ActiveFeedrate := #feedrate * "DB_MachineConfig".FeedrateConvFactor;
    
    // Outputs
    #CurrentLine := #lineIndex;
    
    // Diagnostics
    "DB_Diagnostic".Recipe_CurrentLine := #lineIndex;
    "DB_Diagnostic".Recipe_TargetX := #targX;
    "DB_Diagnostic".Recipe_TargetZ := #targZ;
    "DB_Diagnostic".Recipe_Velocity := #velX;
    "DB_Diagnostic".bMoveX := #bMoveX;
    "DB_Diagnostic".bMoveZ := #bMoveZ;
    "DB_Diagnostic".MoveX_Busy := #fbMoveX.Busy;
    "DB_Diagnostic".MoveX_Done := #fbMoveX.Done;
    "DB_Diagnostic".MoveX_Error := #fbMoveX.Error;
    "DB_Diagnostic".MoveZ_Busy := #fbMoveZ.Busy;
    "DB_Diagnostic".MoveZ_Done := #fbMoveZ.Done;
    "DB_Diagnostic".MoveZ_Error := #fbMoveZ.Error;
END_FUNCTION_BLOCK
