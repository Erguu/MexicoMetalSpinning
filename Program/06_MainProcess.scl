// =============================================================================
// Version_Recipe - 06_MainProcess.scl
// Main process with recipe-based G-code and pre-scan validation
// =============================================================================

// -----------------------------------------------------------------------------
// FB_InputManager - OR-combine inputs from HMI, Panel, Remote
// DOC:
//  purpose: Create single rising-edge command outputs (Cmd_*) from multiple input sources.
//  inputs: HMI_*, Panel_*, Rem_* (Bool) - raw button states (level)
//  outputs: Cmd_* (Bool) - one-shot rising-edge commands for the system
//  notes: Uses prev* latches to detect rising edges; keeps logic simple for deterministic behavior.
// -----------------------------------------------------------------------------
FUNCTION_BLOCK "FB_InputManager"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.0
    VAR_INPUT
        // Raw level inputs from various sources (HMI, physical panel, remote)
        HMI_Start : Bool;    // HMI Start button (level)
        HMI_Stop : Bool;     // HMI Stop button (level)
        HMI_Pause : Bool;    // HMI Pause button (level)
        HMI_Reset : Bool;    // HMI Reset button (level)
        Panel_Start : Bool;  // Physical panel Start
        Panel_Stop : Bool;   // Physical panel Stop
        Panel_Pause : Bool;  // Physical panel Pause
        Panel_Reset : Bool;  // Physical panel Reset
        Rem_Start : Bool;    // Remote Start (e.g. PLC network)
        Rem_Stop : Bool;     // Remote Stop
    END_VAR
    VAR_OUTPUT
        // One-shot command outputs (rising edge true for one cycle)
        Cmd_Start : Bool; 
        Cmd_Stop : Bool; 
        Cmd_Pause : Bool; 
        Cmd_Reset : Bool; 
    END_VAR
    VAR 
        // Previous sampled raw values for edge detection
        prevStart : Bool; 
        prevStop : Bool; 
        prevPause : Bool; 
        prevReset : Bool;
        // Combined raw inputs for current cycle
        rawStart : Bool; 
        rawStop : Bool; 
        rawPause : Bool; 
        rawReset : Bool; 
    END_VAR
BEGIN
    #rawStart := #HMI_Start OR #Panel_Start OR #Rem_Start;
    #rawStop := #HMI_Stop OR #Panel_Stop OR #Rem_Stop;
    #rawPause := #HMI_Pause OR #Panel_Pause;
    #rawReset := #HMI_Reset OR #Panel_Reset;
    #Cmd_Start := #rawStart AND NOT #prevStart;
    #Cmd_Stop := #rawStop AND NOT #prevStop;
    #Cmd_Pause := #rawPause AND NOT #prevPause;
    #Cmd_Reset := #rawReset AND NOT #prevReset;
    #prevStart := #rawStart; #prevStop := #rawStop; #prevPause := #rawPause; #prevReset := #rawReset;
END_FUNCTION_BLOCK

// -----------------------------------------------------------------------------
// FB_SafetyMonitor - Check E-Stop, Door, Air Pressure, Drives
// DOC:
//  purpose: Evaluate hardware safety inputs and bypass flags, produce SafeToRun/SafeToJog.
//  inputs: EStop_OK, Door_Closed, AirPressure_OK, DrivesReady and bypass flags.
//  outputs: SafeToRun (machine may start), SafeToJog (manual jog allowed), ErrorCode (if unsafe).
//  notes: Returns immediately on first fatal safety failure to minimize decision latency.
// -----------------------------------------------------------------------------
FUNCTION_BLOCK "FB_SafetyMonitor"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.0
    VAR_INPUT 
        EStop_OK : Bool;            // TRUE if E-stop circuit is OK (no emergency)
        Door_Closed : Bool;         // TRUE if safety door closed
        AirPressure_OK : Bool;      // TRUE if air pressure sufficient
        DrivesReady : Bool;         // TRUE if drives report ready
        // Bypass flags (from HMI) used only for testing; production should disable
        Bypass_EStop : Bool;
        Bypass_Door : Bool;
        Bypass_AirPressure : Bool;
        Bypass_Drives : Bool;
    END_VAR
    VAR_OUTPUT 
        SafeToRun : Bool;           // TRUE => allowed to start program execution
        SafeToJog : Bool;           // TRUE => manual jogging permitted
        ErrorCode : Word;           // Non-zero if unsafe (map to DB_ErrorCodes)
    END_VAR
BEGIN
    // Runs every scan. RETURNs on first failing condition -- priority order matters.
    // EStop and Drive fault disable both SafeToRun and SafeToJog (jogging also forbidden).
    // Door and air pressure only disable SafeToRun (manual jog still permitted).
    #ErrorCode := 0;
    IF NOT #EStop_OK AND NOT #Bypass_EStop THEN
        // EMERGENCY STOP active -- all motion forbidden
        #SafeToRun := FALSE; #SafeToJog := FALSE; #ErrorCode := 16#0401;
        "DB_Diagnostic".Error_Text := 'Safety: EMERGENCY STOP active';
        RETURN;
    END_IF;
    // Drive readiness is NOT checked here.
    // In STATE_STOPPED, contactors are physically blocked (modePermit=0), so drives can never
    // report ready before starting. Blocking SafeToRun/SafeToJog here creates a deadlock.
    // Drive enable is handled automatically in STATE_STARTING (tonDriveReady timeout).
    // Drive faults while running are caught by prevDriveFaultX/Z detection → STATE_ERROR.
    #SafeToJog := TRUE;
    IF NOT #Door_Closed AND NOT #Bypass_Door THEN
        // Safety door open -- auto run forbidden, manual jog allowed
        #SafeToRun := FALSE; #ErrorCode := 16#0402;
        "DB_Diagnostic".Error_Text := 'Safety: Safety door is open';
        RETURN;
    END_IF;
    IF NOT #AirPressure_OK AND NOT #Bypass_AirPressure THEN
        // Air pressure insufficient -- pneumatic system will not operate
        #SafeToRun := FALSE; #ErrorCode := 16#0404;
        "DB_Diagnostic".Error_Text := 'Safety: Air pressure too low';
        RETURN;
    END_IF;
    #SafeToRun := TRUE;
END_FUNCTION_BLOCK

// -----------------------------------------------------------------------------
// FB_LimitMonitor - Check soft and hard limits
// DOC:
//  purpose: Validate current axis positions against configured soft limits and hardware limit switches.
//  inputs: ActualPos_X/Z, Homed_X/Z, HW limit switches.
//  outputs: LimitError (TRUE if any violation), ErrorCode (first matching error code).
//  notes: Soft limits from DB_MachineConfig are used; hardware limit switches take precedence.
//         Soft limits are only checked for a HOMED axis (Homed_X/Z = StatusBits.HomingDone):
//         before homing the TO position is meaningless (0 after restart, stale after a run),
//         so comparing it against limits would produce false trips.
// -----------------------------------------------------------------------------
FUNCTION_BLOCK "FB_LimitMonitor"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.0
    VAR_INPUT
        ActualPos_X : Real;         // Current X position (mm)
        ActualPos_Z : Real;         // Current Z position (mm)
        Homed_X : Bool;             // X axis homed (StatusBits.HomingDone) -- soft limits checked only when TRUE
        Homed_Z : Bool;             // Z axis homed (StatusBits.HomingDone) -- soft limits checked only when TRUE
        // NC limit switches: TRUE=closed=OK, FALSE=open=limit triggered
        // Cable break also reads FALSE → fail-safe behavior
        HW_NC_X_Min : Bool;         // NC switch: X min (FALSE = limit hit)
        HW_NC_X_Max : Bool;         // NC switch: X max (FALSE = limit hit)
        HW_NC_Z_Min : Bool;         // NC switch: Z min (FALSE = limit hit)
        HW_NC_Z_Max : Bool;         // NC switch: Z max (FALSE = limit hit)
        // PNP NO proximity sensors: TRUE=target detected=entered limit zone
        // Triggered BEFORE NC switch → early warning + second safety layer
        HW_PNP_X_Min : Bool;        // PNP NO sensor: X min (TRUE = limit zone)
        HW_PNP_X_Max : Bool;        // PNP NO sensor: X max (TRUE = limit zone)
        HW_PNP_Z_Min : Bool;        // PNP NO sensor: Z min (TRUE = limit zone)
        HW_PNP_Z_Max : Bool;        // PNP NO sensor: Z max (TRUE = limit zone)
    END_VAR
    VAR_OUTPUT
        LimitError : Bool;          // TRUE if any soft/hard limit violated
        ErrorCode : Word;           // Specific error code for HMI/alarm
    END_VAR
BEGIN
    // Runs every scan. Soft limits are read from DB_MachineConfig.
    // Hardware limit switches take priority over soft limits (physical end stop).
    // ErrorCode shows the last triggered fault -- multiple can be active simultaneously.
    #LimitError := FALSE; #ErrorCode := 0;
    // --- Software (Soft) Limits ---
    // Only checked while the axis is homed: an un-homed axis has no valid position
    // reference, so soft limits cannot mean anything before the reference seek completes.
    IF #Homed_X THEN
        IF #ActualPos_X < "DB_MachineConfig".SoftLimit_MinX THEN
            #LimitError := TRUE; #ErrorCode := 16#0101;
            "DB_Diagnostic".Error_Text := 'Limit: X axis below minimum soft limit';
        END_IF;
        IF #ActualPos_X > "DB_MachineConfig".SoftLimit_MaxX THEN
            #LimitError := TRUE; #ErrorCode := 16#0102;
            "DB_Diagnostic".Error_Text := 'Limit: X axis above maximum soft limit';
        END_IF;
    END_IF;
    IF #Homed_Z THEN
        IF #ActualPos_Z < "DB_MachineConfig".SoftLimit_MinZ THEN
            #LimitError := TRUE; #ErrorCode := 16#0103;
            "DB_Diagnostic".Error_Text := 'Limit: Z axis below minimum soft limit';
        END_IF;
        IF #ActualPos_Z > "DB_MachineConfig".SoftLimit_MaxZ THEN
            #LimitError := TRUE; #ErrorCode := 16#0104;
            "DB_Diagnostic".Error_Text := 'Limit: Z axis above maximum soft limit';
        END_IF;
    END_IF;
    // --- Hardware Limit Switches ---
    // NC switches: the TO (Technology Object) is configured with these as HW limits.
    // The TO handles deceleration and stop directly -- no PLC action required.
    // Only E-Stop cuts contactor power; PLC does NOT raise LimitError on NC hits.
    //
    // PNP proximity sensors: handled separately in FB_Process (inline halt block).
    // In auto mode: PNP → MC_Halt on triggered axis + STATE_ERROR (codes 16#0121-0124).
    // In homing and manual mode: PNP is bypassed (expected zone during reference seek / manual op).
END_FUNCTION_BLOCK

// -----------------------------------------------------------------------------
// FB_AlarmManager - Unified error management and monitoring
// DOC:
//  purpose: Single place to translate error codes to text, maintain active error state,
//           append to centralized DB_Error history, and provide outputs for monitoring.
//  inputs: NewError (rising edge), NewErrorCode, AcknowledgeError (edge)
//  outputs: HasActiveError, ActiveErrorCode, ActiveErrorText, ActiveSeverity, ActiveSource, ActiveTime
//  notes: Updates legacy DB_AlarmHistory for backward compatibility but centralizes storage in DB_Error.
// -----------------------------------------------------------------------------
FUNCTION_BLOCK "FB_AlarmManager"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 2.0
    VAR_INPUT
        NewError         : Bool;   // Rising edge triggers new active error
        NewErrorCode     : Word;   // Numeric code describing error
        AcknowledgeError : Bool;   // Operator ack (edge)
        ActiveProgram    : Int;    // ITEM-26: current recipe program (0=none); stored in alarm history
        ActiveLine       : Int;    // ITEM-26: current recipe line (-1=outside recipe); stored in alarm history
    END_VAR
    VAR_OUTPUT
        HasActiveError : Bool;       // TRUE while an error is active (until ack)
        ActiveErrorCode : Word;      // Current active error code
        ActiveErrorText : String[80];    // Human readable text for HMI (English)
        ActiveErrorText_ES : String[80]; // Texto de error para HMI (Español)
        ActiveSeverity : Byte;       // Priority tier: 1=warning, 2=project, 3=motion/TO, 4=safety (higher preempts lower on HMI display)
        ActiveSource : String[20];   // Source category string
        ActiveTime : DTL;            // Timestamp of active error
    END_VAR
    VAR
        prevNewError : Bool;       // previous NewError for edge detection
        currentTime : DTL;         // timestamp captured at NewError
        SystemTimeStatus : Int;    // RD_SYS_T return status
        i : Int;                   // temporary loop index for history shift
        internalNewError : Bool;
        internalErrorCode : Word;
        fromQueue : Bool;           // TRUE when error came from DB_SystemEvents queue
        newHistCode   : Word;       // new error code for history push (independent of first-error latch)
        newHistText   : String[80]; // new error text for history push (independent of first-error latch)
        newHistSource : String[20]; // new error source for history push (independent of first-error latch)
        latchedText_ES : String[80]; // ES text of the DISPLAYED (latched) error -- DB_Error has no
                                     // Details_ES field, so the Spanish counterpart is kept here for
                                     // the secondary-error restore path (EN/ES must describe the same error)
    END_VAR
BEGIN
    #internalNewError := #NewError;
    #internalErrorCode := #NewErrorCode;
    #fromQueue := FALSE;

    // Dequeue one item per scan from DB_SystemEvents error ring buffer (written by FC_ReportError).
    // Processing one per scan is intentional: avoids two errors overwriting each other in the same
    // AlarmManager call. Any remaining items are consumed on subsequent scans.
    IF "DB_SystemEvents".EQ_Count > 0 THEN
        #internalNewError := TRUE;
        #internalErrorCode := "DB_SystemEvents".EQ_Code["DB_SystemEvents".EQ_Head];
        "DB_Diagnostic".Error_Text := "DB_SystemEvents".EQ_Details["DB_SystemEvents".EQ_Head];
        "DB_Diagnostic".Error_Code := "DB_SystemEvents".EQ_Code["DB_SystemEvents".EQ_Head];
        "DB_SystemEvents".EQ_Head  := ("DB_SystemEvents".EQ_Head + 1) MOD 4;
        "DB_SystemEvents".EQ_Count := "DB_SystemEvents".EQ_Count - 1;
        #fromQueue := TRUE;
    END_IF;

    // Handle new error
    // Queue path (fromQueue): always process — queue already guarantees one item per scan,
    //   so edge detection would drop consecutive errors when prevNewError stays TRUE.
    // Direct path (NewError input from FB_Process): edge-triggered to prevent repeated firing.
    IF #internalErrorCode <> 0 AND (#fromQueue OR (#internalNewError AND NOT #prevNewError)) THEN
        #ActiveErrorCode := #internalErrorCode;
        #SystemTimeStatus := RD_SYS_T(OUT => #currentTime);

        // Translate code -> text
        // CASE always runs for both paths to guarantee a Spanish translation.
        // Queue path: EN is overridden after the CASE with the richer diagnostic text
        //   from DB_Diagnostic.Error_Text (contains TO codes, line numbers).
        //   ES remains from the CASE table -- proper Spanish, not English diagnostic text.
        // Direct path: both EN and ES come from the CASE table only.
        CASE #internalErrorCode OF
                // Axis Movement Errors
                16#0001: #ActiveErrorText := 'X Axis: Move command failed';
                         #ActiveErrorText_ES := 'Eje X: fallo en comando de movimiento';
                16#0002: #ActiveErrorText := 'Z Axis: Move command failed';
                         #ActiveErrorText_ES := 'Eje Z: fallo en comando de movimiento';
                16#0003: #ActiveErrorText := 'X Axis: Homing failed';
                         #ActiveErrorText_ES := 'Eje X: fallo en referenciado';
                16#0004: #ActiveErrorText := 'Z Axis: Homing failed';
                         #ActiveErrorText_ES := 'Eje Z: fallo en referenciado';
                16#0005: #ActiveErrorText := 'Drive fault - check servo';
                         #ActiveErrorText_ES := 'Fallo en variador - revisar servo';
                16#0006: #ActiveErrorText := 'Tool Axis: Move failed';
                         #ActiveErrorText_ES := 'Eje herramienta: fallo de movimiento';
                16#0007: #ActiveErrorText := 'Tool Axis: Homing failed';
                         #ActiveErrorText_ES := 'Eje herramienta: fallo de referenciado';
                16#0008: #ActiveErrorText := 'Motion timeout - axis stuck';
                         #ActiveErrorText_ES := 'Tiempo de movimiento excedido - eje bloqueado';
                16#0009: #ActiveErrorText := 'X drive power failed';
                         #ActiveErrorText_ES := 'Fallo de potencia variador X';
                16#000A: #ActiveErrorText := 'Z drive power failed';
                         #ActiveErrorText_ES := 'Fallo de potencia variador Z';
                16#000B: #ActiveErrorText := 'Homing timeout - check ref switch';
                         #ActiveErrorText_ES := 'Tiempo de referenciado excedido - revisar sensor';
                16#000C: #ActiveErrorText := 'Drive ready timeout - check contactor/enable wiring';
                         #ActiveErrorText_ES := 'Tiempo de espera variador - revisar contactor/cableado';
                16#000D: #ActiveErrorText := 'Tool drive power failed';           // ITEM-29
                         #ActiveErrorText_ES := 'Fallo de potencia variador herramienta';
                16#0012: #ActiveErrorText := 'ToolHeadLock: extend timeout - check cylinder/sensor';
                         #ActiveErrorText_ES := 'Bloqueo cabezal: tiempo de extension excedido - revisar cilindro/sensor';
                16#0010: #ActiveErrorText := 'User pressed STOP';
                         #ActiveErrorText_ES := 'Operador presiono PARO';
                // TO (Technology Object) fault poller (FB_Process, StatusBits.Error rising edge)
                16#0021: #ActiveErrorText := 'X axis TO fault - check TO diagnostics';
                         #ActiveErrorText_ES := 'Fallo TO eje X - revisar diagnostico TO';
                16#0022: #ActiveErrorText := 'Z axis TO fault - check TO diagnostics';
                         #ActiveErrorText_ES := 'Fallo TO eje Z - revisar diagnostico TO';
                16#0023: #ActiveErrorText := 'Tool axis TO fault - check TO diagnostics';
                         #ActiveErrorText_ES := 'Fallo TO eje herramienta - revisar diagnostico TO';
                16#0024: #ActiveErrorText := 'Spindle TO fault - check TO diagnostics';
                         #ActiveErrorText_ES := 'Fallo TO husillo - revisar diagnostico TO';
                // Soft Limits
                16#0101: #ActiveErrorText := 'X beyond MIN soft limit';
                         #ActiveErrorText_ES := 'X fuera de limite minimo';
                16#0102: #ActiveErrorText := 'X beyond MAX soft limit';
                         #ActiveErrorText_ES := 'X fuera de limite maximo';
                16#0103: #ActiveErrorText := 'Z beyond MIN soft limit';
                         #ActiveErrorText_ES := 'Z fuera de limite minimo';
                16#0104: #ActiveErrorText := 'Z beyond MAX soft limit';
                         #ActiveErrorText_ES := 'Z fuera de limite maximo';
                // PNP Proximity Zone Errors (auto mode only; homing and manual bypass these)
                16#0121: #ActiveErrorText := 'PNP zone: X axis MIN proximity';
                         #ActiveErrorText_ES := 'Zona PNP: proximidad MIN Eje X';
                16#0122: #ActiveErrorText := 'PNP zone: X axis MAX proximity';
                         #ActiveErrorText_ES := 'Zona PNP: proximidad MAX Eje X';
                16#0123: #ActiveErrorText := 'PNP zone: Z axis MIN proximity';
                         #ActiveErrorText_ES := 'Zona PNP: proximidad MIN Eje Z';
                16#0124: #ActiveErrorText := 'PNP zone: Z axis MAX proximity';
                         #ActiveErrorText_ES := 'Zona PNP: proximidad MAX Eje Z';
                // Tool Errors
                16#0201: #ActiveErrorText := 'Invalid tool number';
                         #ActiveErrorText_ES := 'Numero de herramienta invalido';
                16#0202: #ActiveErrorText := 'Tool number out of range';
                         #ActiveErrorText_ES := 'Numero de herramienta fuera de rango';
                16#0203: #ActiveErrorText := 'Tool rotation timeout';
                         #ActiveErrorText_ES := 'Tiempo de rotacion herramienta excedido';
                16#0204: #ActiveErrorText := 'Retract to tool pos failed';
                         #ActiveErrorText_ES := 'Fallo al retraer a posicion de herramienta';
                16#0205: #ActiveErrorText := 'Tool rotation failed';
                         #ActiveErrorText_ES := 'Fallo en rotacion de herramienta';
                16#0206: #ActiveErrorText := 'Tool change timeout - check turret drive';
                         #ActiveErrorText_ES := 'Tiempo de cambio herramienta excedido - revisar variador';
                // Recipe/G-code Errors
                16#0301: #ActiveErrorText := 'Recipe: Invalid command';
                         #ActiveErrorText_ES := 'Receta: Comando invalido';
                16#0302: #ActiveErrorText := 'Recipe: Parse error';
                         #ActiveErrorText_ES := 'Receta: Error de analisis';
                16#0303: #ActiveErrorText := 'Recipe: Empty program';
                         #ActiveErrorText_ES := 'Receta: Programa vacio';
                16#0304: #ActiveErrorText := 'Recipe: Line count zero';
                         #ActiveErrorText_ES := 'Receta: Conteo de lineas cero';
                16#0305: #ActiveErrorText := 'PreScan: Path exceeds limits';
                         #ActiveErrorText_ES := 'PreVerificacion: Trayectoria fuera de limites';
                16#0306: #ActiveErrorText := 'Recipe: Invalid feedrate';
                         #ActiveErrorText_ES := 'Receta: Avance invalido';
                16#0307: #ActiveErrorText := 'Recipe: Motion timeout';
                         #ActiveErrorText_ES := 'Receta: Tiempo de movimiento excedido';
                16#0308: #ActiveErrorText := 'Recipe: Invalid tool number';
                         #ActiveErrorText_ES := 'Receta: Numero de herramienta invalido';
                16#0309: #ActiveErrorText := 'BackSupport cylinder error - target not reached';
                         #ActiveErrorText_ES := 'Error cilindro BackSupport - posicion no alcanzada';
                16#030A: #ActiveErrorText := 'Spindle at-speed timeout (10s)';
                         #ActiveErrorText_ES := 'Husillo: tiempo de velocidad excedido (10s)';
                16#030B: #ActiveErrorText := 'Spindle stop timeout (15s)';
                         #ActiveErrorText_ES := 'Husillo: tiempo de paro excedido (15s)';
                16#0310: #ActiveErrorText := 'Recipe not loaded - check TotalLines';
                         #ActiveErrorText_ES := 'Receta no cargada - revisar TotalLines';
                16#0311: #ActiveErrorText := 'Recipe has no tool table - regenerate in CAM';
                         #ActiveErrorText_ES := 'Receta sin tabla de herramientas - regenerar en CAM';
                16#0312: #ActiveErrorText := 'Recipe load from load memory failed';
                         #ActiveErrorText_ES := 'Fallo al cargar la receta desde memoria de carga';
                16#0313: #ActiveErrorText := 'Recipe data empty/corrupt - no END marker';
                         #ActiveErrorText_ES := 'Datos de receta vacios/corruptos - falta marca de fin';
                // Safety Errors
                16#0401: #ActiveErrorText := 'EMERGENCY STOP ACTIVE!';
                         #ActiveErrorText_ES := 'PARO DE EMERGENCIA ACTIVO!';
                16#0402: #ActiveErrorText := 'Safety door is open';
                         #ActiveErrorText_ES := 'Puerta de seguridad abierta';
                16#0403: #ActiveErrorText := 'Drives not ready';
                         #ActiveErrorText_ES := 'Variadores no listos';
                16#0404: #ActiveErrorText := 'Air pressure too low';
                         #ActiveErrorText_ES := 'Presion de aire baja';
                16#0405: #ActiveErrorText := 'Safety interlock active';
                         #ActiveErrorText_ES := 'Interlock de seguridad activo';
                16#0406: #ActiveErrorText := 'E-Stop contact discrepancy!';
                         #ActiveErrorText_ES := 'Discrepancia en contacto Paro de Emergencia!';
                // Spindle Errors
                16#0501: #ActiveErrorText := 'Spindle: Power-on failed';
                         #ActiveErrorText_ES := 'Husillo: fallo al encender';
                16#0502: #ActiveErrorText := 'Spindle: Run command failed';
                         #ActiveErrorText_ES := 'Husillo: fallo al ejecutar comando';
                16#0503: #ActiveErrorText := 'Spindle: Halt failed';
                         #ActiveErrorText_ES := 'Husillo: fallo al detener';
                16#0504: #ActiveErrorText := 'Spindle: Speed not reached';
                         #ActiveErrorText_ES := 'Husillo: velocidad no alcanzada';
                16#0505: #ActiveErrorText := 'Spindle: Drive enable timeout';
                         #ActiveErrorText_ES := 'Husillo: tiempo de habilitacion excedido';
                // NOTE: Siemens TO (Technology Object) error codes (16#8xxx) are NOT passed here
                // directly. They are decoded via FC_TO_ErrorText and written to
                // DB_Diagnostic.TO_ErrorText + DB_HMI.ErrorDetail at the point of failure.
                // This CASE only handles project-level error codes (16#0001-16#05FF).
                ELSE
                    #ActiveErrorText    := 'Unknown error code';
                    #ActiveErrorText_ES := 'Codigo de error desconocido';
            END_CASE;
        // Queue path: override EN with the detailed diagnostic text (TO codes, line numbers);
        // ES stays from CASE table above (proper Spanish translation).
        IF #fromQueue THEN
            #ActiveErrorText := "DB_Diagnostic".Error_Text;
        END_IF;

        // Severity & source mapping (explicit ranges)
        // Priority tiers (higher tier preempts lower on the HMI display, see latch below):
        //   4 = safety interlock (E-Stop, door, air, drives, HW limit)
        //   3 = motion / TO fault (axis, homing, drive power, soft limit, PNP zone, tool motion, spindle)
        //   2 = project error (recipe validation, tool configuration)
        //   1 = warning / info (user stop, unknown codes)
        IF #ActiveErrorCode >= 16#0400 AND #ActiveErrorCode < 16#0500 THEN
            #ActiveSeverity := 4; #ActiveSource := 'Safety';
        ELSIF #ActiveErrorCode >= 16#0111 AND #ActiveErrorCode < 16#0120 THEN
            #ActiveSeverity := 4; #ActiveSource := 'HW Limit';
        ELSIF #ActiveErrorCode >= 16#0121 AND #ActiveErrorCode < 16#0130 THEN
            #ActiveSeverity := 3; #ActiveSource := 'PNP Zone';  // PNP proximity zone errors (auto mode)
        ELSIF #ActiveErrorCode = 16#0010 THEN
            #ActiveSeverity := 1; #ActiveSource := 'Operator';  // user STOP must never preempt a real fault
        ELSIF #ActiveErrorCode >= 16#0001 AND #ActiveErrorCode <= 16#002F THEN
            #ActiveSeverity := 3; #ActiveSource := 'Axis';      // axis/homing/power, 16#0012 ToolHeadLock, 16#0021-0024 TO poller
        ELSIF #ActiveErrorCode >= 16#0101 AND #ActiveErrorCode < 16#0110 THEN
            #ActiveSeverity := 3; #ActiveSource := 'Soft Limit';
        ELSIF #ActiveErrorCode >= 16#0203 AND #ActiveErrorCode <= 16#0206 THEN
            #ActiveSeverity := 3; #ActiveSource := 'Tool';      // tool motion faults (rotation fail/timeout)
        ELSIF #ActiveErrorCode >= 16#0200 AND #ActiveErrorCode < 16#0210 THEN
            #ActiveSeverity := 2; #ActiveSource := 'Tool';      // tool configuration (invalid/out of range)
        ELSIF #ActiveErrorCode >= 16#0300 AND #ActiveErrorCode <= 16#0313 THEN
            #ActiveSeverity := 2; #ActiveSource := 'Recipe';    // <= includes 16#0310..16#0313
        ELSIF #ActiveErrorCode >= 16#0500 AND #ActiveErrorCode < 16#0510 THEN
            #ActiveSeverity := 3; #ActiveSource := 'Spindle';   // spindle motion faults
        ELSE
            #ActiveSeverity := 1; #ActiveSource := 'Unknown';
        END_IF;

        // Save new error info for history before the latch guard may restore output vars
        #newHistCode   := #ActiveErrorCode;
        #newHistText   := #ActiveErrorText;
        #newHistSource := #ActiveSource;

        // Severity-priority latch: the display (DB_Error.Code, HMI text) shows the
        // highest-severity error of the fault sequence. A new error replaces the displayed
        // one only if its priority tier is STRICTLY higher (safety 4 > motion/TO 3 >
        // project 2 > warning 1). Same or lower tier goes to history only, so the first
        // error of a tier is never pushed aside by follow-up faults of the same tier
        // (e.g. soft limit firing after the axis fault that caused it), while a TO/safety
        // fault always wins the display over a project-level error that fired first.
        // All errors always go to history. Cleared by AcknowledgeError.
        IF NOT "DB_Error".Active OR (#ActiveSeverity > "DB_Error".Severity) THEN
            #HasActiveError      := TRUE;
            #ActiveTime          := #currentTime;
            "DB_Error".Active    := TRUE;
            "DB_Error".Code      := #ActiveErrorCode;
            "DB_Error".Severity  := #ActiveSeverity;
            "DB_Error".Source    := #ActiveSource;
            IF "DB_Diagnostic".Recipe_CurrentLine >= 0 AND (#ActiveSource = 'Recipe') THEN
                "DB_Error".Line := "DB_Diagnostic".Recipe_CurrentLine;
            ELSE
                "DB_Error".Line := -1;
            END_IF;
            "DB_Error".TimeStamp := #currentTime;
            "DB_Error".Details   := #ActiveErrorText;
            #latchedText_ES      := #ActiveErrorText_ES;  // keep ES of the displayed error (no Details_ES in DB_Error)
        ELSE
            // Same/lower-tier secondary error: restore output vars to the displayed error
            // so DB_HMI.ErrorText and callers still see the highest-priority root cause.
            // ES is restored from latchedText_ES so both languages describe the SAME error
            // (the CASE above already overwrote ActiveErrorText_ES with the new error's text).
            #ActiveErrorCode := "DB_Error".Code;
            #ActiveErrorText := "DB_Error".Details;
            #ActiveErrorText_ES := #latchedText_ES;
            #ActiveSeverity  := "DB_Error".Severity;
            #ActiveSource    := "DB_Error".Source;
            #ActiveTime      := "DB_Error".TimeStamp;
            #HasActiveError  := TRUE;
        END_IF;
        "DB_Error".TotalErrorCount := "DB_Error".TotalErrorCount + 1;
        // History: always push the new error (not the latched first-error values)
        FOR #i := 10 TO 2 BY -1 DO
            "DB_Error".History_Code[#i]    := "DB_Error".History_Code[#i - 1];
            "DB_Error".History_Time[#i]    := "DB_Error".History_Time[#i - 1];
            "DB_Error".History_Source[#i]  := "DB_Error".History_Source[#i - 1];
            "DB_Error".History_Details[#i] := "DB_Error".History_Details[#i - 1];
        END_FOR;
        "DB_Error".History_Code[1]    := #newHistCode;
        "DB_Error".History_Time[1]    := #currentTime;
        "DB_Error".History_Source[1]  := #newHistSource;
        // LEFT(..., 40): History_Details is String[40] while #newHistText is String[80].
        // Truncate explicitly rather than relying on implicit assignment truncation.
        "DB_Error".History_Details[1] := LEFT(IN := #newHistText, L := 40);
        "DB_Error".History_Index := "DB_Error".History_Index + 1;
        IF "DB_Error".History_Index > 10 THEN "DB_Error".History_Index := 1; END_IF;
        IF "DB_Error".History_Count < 10 THEN "DB_Error".History_Count := "DB_Error".History_Count + 1; END_IF;

        // ITEM-26: write to DB_AlarmHistory 20-entry ring buffer (always push new error)
        // Use #currentTime already captured above (same scan, consistent timestamp)
        IF "DB_AlarmHistory".Hist_Clear THEN
            "DB_AlarmHistory".Hist_Head   := 0;
            "DB_AlarmHistory".Hist_Count  := 0;
            "DB_AlarmHistory".Hist_SeqNum := 0;
            "DB_AlarmHistory".Hist_Clear  := FALSE;
        END_IF;
        "DB_AlarmHistory".Hist_Log["DB_AlarmHistory".Hist_Head].Timestamp  := #currentTime;
        "DB_AlarmHistory".Hist_Log["DB_AlarmHistory".Hist_Head].ErrorCode  := #newHistCode;
        "DB_AlarmHistory".Hist_Log["DB_AlarmHistory".Hist_Head].ProgramNum := #ActiveProgram;
        "DB_AlarmHistory".Hist_Log["DB_AlarmHistory".Hist_Head].LineNum    := #ActiveLine;
        "DB_AlarmHistory".Hist_Log["DB_AlarmHistory".Hist_Head].ErrorText  := LEFT(IN := #newHistText, L := 40);
        "DB_AlarmHistory".Hist_Head   := ("DB_AlarmHistory".Hist_Head + 1) MOD 20;
        "DB_AlarmHistory".Hist_SeqNum := "DB_AlarmHistory".Hist_SeqNum + 1;
        IF "DB_AlarmHistory".Hist_Count < 20 THEN
            "DB_AlarmHistory".Hist_Count := "DB_AlarmHistory".Hist_Count + 1;
        END_IF;
    END_IF;

    // Latch previous new error for edge detection
    #prevNewError := #internalNewError;

    // Acknowledge handling: clear active state but retain history snapshot
    IF #AcknowledgeError THEN
        #ActiveErrorCode := 0;
        #HasActiveError := FALSE;
        #ActiveErrorText := '';
        #ActiveErrorText_ES := '';  // BUG FIX (2026-07-02): was never cleared -- stale Spanish
                                    // error text kept mirroring to DB_HMI.ErrorText_ES after Ack
        #latchedText_ES := '';
        #ActiveSeverity := 0;
        #ActiveSource := '';
        #ActiveTime := DTL#1970-01-01-00:00:00;
        // legacy DB_AlarmHistory removed; history retained in DB_Error
        "DB_Error".Active := FALSE;
        "DB_Error".Code := 0;  // BUG FIX: clear code so DB_HMI_Errors bits go FALSE
        "DB_Error".Details := CONCAT(IN1 := "DB_Error".Details, IN2 := ' [ACK]');
    END_IF;

    // =========================================================================
    // DB_HMI_Errors - Pack error bits into Words for HMI Discrete Alarms
    // Word.Bit = one alarm line in HMI Alarm View
    // =========================================================================

    // AlarmWord_Axis: Bits 0-7
    "DB_HMI_Errors".AlarmWord_Axis :=
    BOOL_TO_WORD("DB_Error".Code = 16#0001) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0002), N := 1) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0003), N := 2) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0004), N := 3) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0005), N := 4) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0006), N := 5) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0007), N := 6) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0008), N := 7) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#000D), N := 8);  // ITEM-29: tool drive power fault

    // AlarmWord_Limits: Bits 0-3 soft, 4-7 hardware
    "DB_HMI_Errors".AlarmWord_Limits :=
    BOOL_TO_WORD("DB_Error".Code = 16#0101) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0102), N := 1) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0103), N := 2) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0104), N := 3) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0111), N := 4) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0112), N := 5) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0113), N := 6) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0114), N := 7);

    // AlarmWord_Tool: Bits 0-4
    "DB_HMI_Errors".AlarmWord_Tool :=
    BOOL_TO_WORD("DB_Error".Code = 16#0201) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0202), N := 1) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0203), N := 2) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0204), N := 3) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0205), N := 4);

    // AlarmWord_Recipe: Bits 0-7
    "DB_HMI_Errors".AlarmWord_Recipe :=
    BOOL_TO_WORD("DB_Error".Code = 16#0301) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0302), N := 1) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0303), N := 2) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0304), N := 3) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0305), N := 4) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0306), N := 5) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0307), N := 6) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0308), N := 7);

    // AlarmWord_Safety: Bits 0-5
    "DB_HMI_Errors".AlarmWord_Safety :=
    BOOL_TO_WORD("DB_Error".Code = 16#0401) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0402), N := 1) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0403), N := 2) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0404), N := 3) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0405), N := 4) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0406), N := 5);

    // AlarmWord_Spindle: Bits 0-3
    "DB_HMI_Errors".AlarmWord_Spindle :=
    BOOL_TO_WORD("DB_Error".Code = 16#0501) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0502), N := 1) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0503), N := 2) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#0504), N := 3);

    // AlarmWord_TO: Bits 0-4
    "DB_HMI_Errors".AlarmWord_TO :=
    BOOL_TO_WORD("DB_Error".Code = 16#8401) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#8402), N := 1) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#8403), N := 2) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#8404), N := 3) OR
    SHL(IN := BOOL_TO_WORD("DB_Error".Code = 16#8405), N := 4);

    // Individual Bool flags (derived from DB_Error.Code)
    "DB_HMI_Errors".Err_X_MoveFailed       := ("DB_Error".Code = 16#0001);
    "DB_HMI_Errors".Err_Z_MoveFailed       := ("DB_Error".Code = 16#0002);
    "DB_HMI_Errors".Err_X_HomingFailed     := ("DB_Error".Code = 16#0003);
    "DB_HMI_Errors".Err_Z_HomingFailed     := ("DB_Error".Code = 16#0004);
    "DB_HMI_Errors".Err_DriveFault         := ("DB_Error".Code = 16#0005);
    "DB_HMI_Errors".Err_ToolDrivePower     := ("DB_Error".Code = 16#000D);  // ITEM-29
    "DB_HMI_Errors".Err_ToolMoveFailed     := ("DB_Error".Code = 16#0006);
    "DB_HMI_Errors".Err_ToolHomingFailed   := ("DB_Error".Code = 16#0007);
    "DB_HMI_Errors".Err_MotionTimeout      := ("DB_Error".Code = 16#0008);
    "DB_HMI_Errors".Err_LockExtendTimeout  := ("DB_Error".Code = 16#0012);
    "DB_HMI_Errors".Err_SoftLimit_X_Min    := ("DB_Error".Code = 16#0101);
    "DB_HMI_Errors".Err_SoftLimit_X_Max    := ("DB_Error".Code = 16#0102);
    "DB_HMI_Errors".Err_SoftLimit_Z_Min    := ("DB_Error".Code = 16#0103);
    "DB_HMI_Errors".Err_SoftLimit_Z_Max    := ("DB_Error".Code = 16#0104);
    "DB_HMI_Errors".Err_HWLimit_X_Min      := ("DB_Error".Code = 16#0111);
    "DB_HMI_Errors".Err_HWLimit_X_Max      := ("DB_Error".Code = 16#0112);
    "DB_HMI_Errors".Err_HWLimit_Z_Min      := ("DB_Error".Code = 16#0113);
    "DB_HMI_Errors".Err_HWLimit_Z_Max      := ("DB_Error".Code = 16#0114);
    "DB_HMI_Errors".Err_InvalidToolNum     := ("DB_Error".Code = 16#0201);
    "DB_HMI_Errors".Err_ToolOutOfRange     := ("DB_Error".Code = 16#0202);
    "DB_HMI_Errors".Err_ToolRotTimeout     := ("DB_Error".Code = 16#0203);
    "DB_HMI_Errors".Err_ToolRetractFail    := ("DB_Error".Code = 16#0204);
    "DB_HMI_Errors".Err_ToolRotFailed      := ("DB_Error".Code = 16#0205);
    "DB_HMI_Errors".Err_Recipe_InvalidCmd  := ("DB_Error".Code = 16#0301);
    "DB_HMI_Errors".Err_Recipe_ParseErr    := ("DB_Error".Code = 16#0302);
    "DB_HMI_Errors".Err_Recipe_Empty       := ("DB_Error".Code = 16#0303);
    "DB_HMI_Errors".Err_Recipe_NoLines     := ("DB_Error".Code = 16#0304);
    "DB_HMI_Errors".Err_PreScan_Limits     := ("DB_Error".Code = 16#0305);
    "DB_HMI_Errors".Err_Recipe_Feedrate    := ("DB_Error".Code = 16#0306);
    "DB_HMI_Errors".Err_Recipe_Timeout     := ("DB_Error".Code = 16#0307);
    "DB_HMI_Errors".Err_Recipe_ToolNum     := ("DB_Error".Code = 16#0308);
    "DB_HMI_Errors".Err_EStop              := ("DB_Error".Code = 16#0401);
    "DB_HMI_Errors".Err_EStop_Discrepancy  := ("DB_Error".Code = 16#0406);
    "DB_HMI_Errors".Err_DoorOpen           := ("DB_Error".Code = 16#0402);
    "DB_HMI_Errors".Err_DrivesNotReady     := ("DB_Error".Code = 16#0403);
    "DB_HMI_Errors".Err_AirPressure        := ("DB_Error".Code = 16#0404);
    "DB_HMI_Errors".Err_SafetyInterlock    := ("DB_Error".Code = 16#0405);
    "DB_HMI_Errors".Err_Spindle_Power      := ("DB_Error".Code = 16#0501);
    "DB_HMI_Errors".Err_Spindle_Run        := ("DB_Error".Code = 16#0502);
    "DB_HMI_Errors".Err_Spindle_Halt       := ("DB_Error".Code = 16#0503);
    "DB_HMI_Errors".Err_Spindle_Speed      := ("DB_Error".Code = 16#0504);
    "DB_HMI_Errors".Err_TO_Position        := ("DB_Error".Code = 16#8401);
    "DB_HMI_Errors".Err_TO_Velocity        := ("DB_Error".Code = 16#8402);
    "DB_HMI_Errors".Err_TO_NotReady        := ("DB_Error".Code = 16#8403);
    "DB_HMI_Errors".Err_TO_NotEnabled      := ("DB_Error".Code = 16#8404);
    "DB_HMI_Errors".Err_TO_LimitExceeded   := ("DB_Error".Code = 16#8405);

    // Summary flags (non-zero Word = category has error)
    "DB_HMI_Errors".AnyAxisError    := ("DB_HMI_Errors".AlarmWord_Axis <> 0);
    "DB_HMI_Errors".AnyLimitError   := ("DB_HMI_Errors".AlarmWord_Limits <> 0);
    "DB_HMI_Errors".AnyToolError    := ("DB_HMI_Errors".AlarmWord_Tool <> 0);
    "DB_HMI_Errors".AnyRecipeError  := ("DB_HMI_Errors".AlarmWord_Recipe <> 0);
    "DB_HMI_Errors".AnySafetyError  := ("DB_HMI_Errors".AlarmWord_Safety <> 0);
    "DB_HMI_Errors".AnySpindleError := ("DB_HMI_Errors".AlarmWord_Spindle <> 0);
    "DB_HMI_Errors".AnyError        := "DB_Error".Active;

END_FUNCTION_BLOCK

// -----------------------------------------------------------------------------
// FB_ManualMode - Manual jog, home, move operations
// DOC:
//  purpose: Provide manual control and single-axis operations for operator (jog, absolute move, homing).
//  inputs: Enable (activation), SelectedAxis, Jog buttons, MoveAbsolute, Home commands, SafeToJog
//  outputs: Busy/Done/Error flags, AxisName/Position, ToolPosition
//  notes: Designed to be used in Manual mode only; delegates axis operations to axis FBs.
// -----------------------------------------------------------------------------
FUNCTION_BLOCK "FB_ManualMode"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.2
    VAR_INPUT 
        Enable : Bool;              // Enable manual mode (true = active)
        SelectedAxis : Int;         // 0=X,1=Z,2=Tool,3=Spindle
        Jog_Plus : Bool;            // Jog positive direction (level)
        Jog_Minus : Bool;           // Jog negative direction (level)
        JogSpeed : Real;            // Jog velocity (mm/s)
        MoveAbsolute : Bool;        // Trigger absolute move
        TargetPosition : Real;      // Absolute target position (mm)
        HomeAxis : Bool;            // Home selected axis
        HomeAll : Bool;             // Home all axes
        HomingMode : Int;           // Homing mode selection
        HomePosition : Real;        // Home position parameter (if used)
        GoSafe : Bool;              // Move to safe position
        GoZero : Bool;              // Move to zero position
        SafeToJog : Bool;           // From safety monitor
        Reset : Bool;               // Reset manual FB state
        PNP_X_Min : Bool;           // X min PNP sensor -- TRUE = in limit zone (for pre-homing clearance)
        PNP_Z_Min : Bool;           // Z min PNP sensor -- TRUE = in limit zone
        ToolStepCW : Bool;          // Tool step clockwise
        ToolStepCCW : Bool;         // Tool step counter-clockwise
        ToolStepAngle : Real;       // Angle per tool step (deg)
        ToolStepSpeed : Real;       // Velocity for tool step (deg/s)
    END_VAR
    VAR_OUTPUT
        Busy : Bool;
        Done : Bool;
        Error : Bool;
        ErrorID : Word;
        AxisName : String[10];      // Display name for selected axis
        AxisPosition : Real;        // Current axis position reported
        AxisHomed : Bool;
        AxisReady : Bool;
        ToolPosition : Real;
        ActiveAxis : Int;           // Axis currently controlled (-1 = none)
        HomingActive : Bool;        // TRUE = homing motion in progress (for limit bypass)
    END_VAR
    VAR_IN_OUT
        Axis_X : TO_PositioningAxis; // Axis technology objects (in/out interface)
        Axis_Z : TO_PositioningAxis;
        Axis_Tool : TO_PositioningAxis;
        Axis_Spindle : TO_PositioningAxis;
    END_VAR
    VAR 
        state : Int;                // Local state for manual FB
        // Motion FB instances used by manual mode
        fbJogX, fbJogZ, fbJogTool : "FB_Axis_Jog";
        fbMoveX, fbMoveZ : "FB_Axis_AbsPos";
        fbMoveToolAbs : "FB_Axis_AbsPos";  // Manual > MOVE ABSOLUTE (requires homing)
        fbMoveTool : "FB_Axis_RelPos";     // Manual > TOOL STEP (does not require homing)
        fbHomeX, fbHomeZ, fbHomeTool : "FB_Axis_Home";
        // Previous input state for edge detection and one-shot triggers
        prevMoveAbs : Bool; 
        prevHomeAxis : Bool; 
        prevHomeAll : Bool; 
        prevGoSafe : Bool; 
        prevGoZero : Bool;
        prevToolStepCW : Bool; 
        prevToolStepCCW : Bool;
        // Internal control flags
        bMoveX : Bool;
        bMoveZ : Bool;
        bMoveTool : Bool;
        bMoveToolAbs : Bool;
        bHomeX : Bool;
        bHomeZ : Bool;
        bHomeTool : Bool;
        bHomeAllExec : Bool;             // TRUE while HomeAll sequence is active
        homeAllStep : Int;               // HomeAll step: 1=X, 2=Z, 3=Tool
        // Homing clearance -- escape from PNP zone / move away after homing
        fbClearX : "FB_Axis_AbsPos";   // X clearance move
        fbClearZ : "FB_Axis_AbsPos";   // Z clearance hareketi
        bClearX  : Bool;               // X clearance execute flag
        bClearZ  : Bool;               // Z clearance execute flag
        bToolStepExec : Bool;
        jogAxis : Int;             // Axis selected for jogging during a jog session
        stepTarget : Real; 
        moveVelocity : Real; 
    END_VAR
BEGIN
    IF NOT #Enable THEN
        #state := 0; #Busy := FALSE; #Done := FALSE;
        #bMoveX := FALSE; #bMoveZ := FALSE; #bMoveTool := FALSE;
        #bHomeX := FALSE; #bHomeZ := FALSE; #bHomeTool := FALSE;
        #bHomeAllExec := FALSE; #homeAllStep := 0;
        RETURN;
    END_IF;
    
    IF NOT #SafeToJog THEN
        #Error := TRUE; #ErrorID := 16#0005; #state := 999;
        "DB_HMI".ErrorDetail    := 'Manual: drives not ready or E-Stop active';
        "DB_HMI".ErrorDetail_ES := 'Manual: variadores no listos o Paro de Emergencia activo';
    END_IF;
    IF #Reset THEN #state := 0; #Error := FALSE; #ErrorID := 0; #Done := FALSE; END_IF;
    
    #ToolPosition := #Axis_Tool.ActualPosition;
    
    CASE #SelectedAxis OF
        0: #AxisName := 'X'; #AxisPosition := #Axis_X.ActualPosition; #AxisHomed := #Axis_X.StatusBits.HomingDone; #AxisReady := #Axis_X.StatusBits.DriveReady;
        1: #AxisName := 'Z'; #AxisPosition := #Axis_Z.ActualPosition; #AxisHomed := #Axis_Z.StatusBits.HomingDone; #AxisReady := #Axis_Z.StatusBits.DriveReady;
        2: #AxisName := 'Tool'; #AxisPosition := #Axis_Tool.ActualPosition; #AxisHomed := #Axis_Tool.StatusBits.HomingDone; #AxisReady := #Axis_Tool.StatusBits.DriveReady;
        3: #AxisName := 'Spindle'; #AxisPosition := #Axis_Spindle.ActualVelocity; #AxisHomed := TRUE; #AxisReady := #Axis_Spindle.StatusBits.DriveReady;
    END_CASE;
    
    CASE #state OF
        0: // IDLE
            #Busy := FALSE; #Done := FALSE; #ActiveAxis := -1; #HomingActive := FALSE;
            IF (#Jog_Plus OR #Jog_Minus) AND #SafeToJog THEN #jogAxis := #SelectedAxis; #state := 10; END_IF;
            IF #MoveAbsolute AND NOT #prevMoveAbs THEN #state := 30; END_IF;
            IF #HomeAxis AND NOT #prevHomeAxis THEN #state := 40; END_IF;
            IF #HomeAll AND NOT #prevHomeAll THEN #state := 50; END_IF;
            IF #GoSafe AND NOT #prevGoSafe THEN #state := 60; END_IF;
            IF #GoZero AND NOT #prevGoZero THEN #state := 70; END_IF;
            // moveVelocity must be set here -- FB call comes at the end of the same scan;
            // if set in state 20 it arrives one scan late and MC_MoveRelative starts at 0 speed.
            IF #ToolStepCW  AND NOT #prevToolStepCW  THEN
                #stepTarget    :=  #ToolStepAngle;
                #moveVelocity  := #ToolStepSpeed;
                #bMoveTool     := TRUE;
                #state         := 20;
            END_IF;
            IF #ToolStepCCW AND NOT #prevToolStepCCW THEN
                #stepTarget    := -#ToolStepAngle;
                #moveVelocity  := #ToolStepSpeed;
                #bMoveTool     := TRUE;
                #state         := 20;
            END_IF;

        10: // JOGGING
            #Busy := TRUE; #ActiveAxis := #jogAxis;
            IF NOT #Jog_Plus AND NOT #Jog_Minus THEN #state := 99; END_IF;
        
        20: // TOOL STEP
            #Busy := TRUE; #ActiveAxis := 2;
            #moveVelocity := #ToolStepSpeed;
            #state := 80;

        30: // MOVE ABSOLUTE
            #Busy := TRUE;
            // Soft-limit guard: once the axis is homed, reject targets outside the
            // configured soft limits (no motion started, hint shown, back to IDLE).
            // Un-homed axes are not checked -- position is meaningless before homing
            // (AbsPos on an un-homed axis is rejected by the TO itself anyway).
            IF (#SelectedAxis = 0 AND #Axis_X.StatusBits.HomingDone
                AND (#TargetPosition < "DB_MachineConfig".SoftLimit_MinX
                     OR #TargetPosition > "DB_MachineConfig".SoftLimit_MaxX))
            OR (#SelectedAxis = 1 AND #Axis_Z.StatusBits.HomingDone
                AND (#TargetPosition < "DB_MachineConfig".SoftLimit_MinZ
                     OR #TargetPosition > "DB_MachineConfig".SoftLimit_MaxZ)) THEN
                "DB_HMI".ErrorDetail    := 'Manual: target outside soft limits - move rejected';
                "DB_HMI".ErrorDetail_ES := 'Manual: objetivo fuera de limites - movimiento rechazado';
                #state := 0;
            ELSE
                #stepTarget := #TargetPosition; #moveVelocity := #JogSpeed;
                CASE #SelectedAxis OF
                    0: #bMoveX    := TRUE; #ActiveAxis := 0;
                    1: #bMoveZ    := TRUE; #ActiveAxis := 1;
                    2: #bMoveToolAbs := TRUE; #ActiveAxis := 2;  // AbsPos -- requires prior homing
                END_CASE;
                #state := 80;
            END_IF;
            
        40: // HOME AXIS INIT -- if in PNP zone, clear it first, then home
            #Busy := TRUE; #HomingActive := TRUE;
            CASE #SelectedAxis OF
                0: // X axis
                    #ActiveAxis := 0;
                    IF #PNP_X_Min THEN
                        // In X min PNP zone → clearance move first
                        #bClearX := TRUE;
                        #state := 41;
                    ELSE
                        #bHomeX := TRUE;
                        #state := 80;
                    END_IF;
                1: // Z axis
                    #ActiveAxis := 1;
                    IF #PNP_Z_Min THEN
                        #bClearZ := TRUE;
                        #state := 41;
                    ELSE
                        #bHomeZ := TRUE;
                        #state := 80;
                    END_IF;
                2: // Tool axis -- no PNP zone
                    #bHomeTool := TRUE; #ActiveAxis := 2;
                    #state := 80;
            END_CASE;

        41: // PRE-HOME CLEARANCE WAIT -- wait for clearance move out of PNP zone to finish
            #Busy := TRUE; #HomingActive := TRUE;
            IF #bClearX AND #fbClearX.Done THEN
                #bClearX := FALSE; #bHomeX := TRUE; #state := 80;
            ELSIF #bClearZ AND #fbClearZ.Done THEN
                #bClearZ := FALSE; #bHomeZ := TRUE; #state := 80;
            ELSIF (#bClearX AND #fbClearX.Error) OR (#bClearZ AND #fbClearZ.Error) THEN
                #bClearX := FALSE; #bClearZ := FALSE;
                #state := 999; #ErrorID := 16#0001;
                "DB_HMI".ErrorDetail    := 'Manual: pre-home clearance move failed';
                "DB_HMI".ErrorDetail_ES := 'Manual: fallo al liberar zona PNP antes de referenciar';
            END_IF;

        50: // HOME ALL INIT -- clear required axes from PNP zone, then home X → Z → Tool
            #Busy := TRUE; #HomingActive := TRUE; #ActiveAxis := -1;
            #bClearX := #PNP_X_Min;   // Clearance only needed if inside PNP zone
            #bClearZ := #PNP_Z_Min;
            IF #bClearX OR #bClearZ THEN
                #state := 51;          // Clearance first
            ELSE
                #homeAllStep := 1; #bHomeX := TRUE; #bHomeAllExec := TRUE; #state := 80;
            END_IF;

        51: // HOME ALL PRE-CLEARANCE WAIT -- wait until both axes have cleared PNP zone
            #Busy := TRUE; #HomingActive := TRUE;
            IF (NOT #bClearX OR #fbClearX.Done) AND (NOT #bClearZ OR #fbClearZ.Done) THEN
                #bClearX := FALSE; #bClearZ := FALSE;
                #homeAllStep := 1; #bHomeX := TRUE; #bHomeAllExec := TRUE; #state := 80;
            ELSIF (#bClearX AND #fbClearX.Error) OR (#bClearZ AND #fbClearZ.Error) THEN
                #bClearX := FALSE; #bClearZ := FALSE;
                #state := 999; #ErrorID := 16#0001;
                "DB_HMI".ErrorDetail    := 'Manual: pre-home clearance move failed (Home All)';
                "DB_HMI".ErrorDetail_ES := 'Manual: fallo al liberar zona PNP antes de referenciar (Ref. Todo)';
            END_IF;

        60: // GO SAFE
            #Busy := TRUE; #moveVelocity := "DB_MachineConfig".RapidVelocity;
            CASE #SelectedAxis OF
                0: #bMoveX := TRUE; #stepTarget := "DB_MachineConfig".SafePos_X; #ActiveAxis := 0;
                1: #bMoveZ := TRUE; #stepTarget := "DB_MachineConfig".SafePos_Z; #ActiveAxis := 1;
            END_CASE;
            #state := 80;
        
        70: // GO ZERO
            #Busy := TRUE; #stepTarget := 0.0; #moveVelocity := "DB_MachineConfig".RapidVelocity;
            CASE #SelectedAxis OF
                0: #bMoveX := TRUE; #ActiveAxis := 0;
                1: #bMoveZ := TRUE; #ActiveAxis := 1;
            END_CASE;
            #state := 80;
            
        80: // WAIT FOR COMPLETE
            #Busy := TRUE;
            // HomingActive: set while any homing flag is still active
            #HomingActive := #bHomeX OR #bHomeZ OR #bHomeTool OR #bHomeAllExec;
            // Normal moves -- go directly to 99 on completion
            IF #bMoveX AND #fbMoveX.Done THEN #state := 99; END_IF;
            IF #bMoveX AND #fbMoveX.Error THEN
                #state := 999; #ErrorID := 16#0001;
                "DB_HMI".ErrorDetail    := CONCAT(IN1 := 'Manual X move: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbMoveX.ErrorID));
                "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'Manual mov. X: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbMoveX.ErrorID));
            END_IF;
            IF #bMoveZ AND #fbMoveZ.Done THEN #state := 99; END_IF;
            IF #bMoveZ AND #fbMoveZ.Error THEN
                #state := 999; #ErrorID := 16#0002;
                "DB_HMI".ErrorDetail    := CONCAT(IN1 := 'Manual Z move: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbMoveZ.ErrorID));
                "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'Manual mov. Z: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbMoveZ.ErrorID));
            END_IF;
            IF #bMoveTool    AND #fbMoveTool.Done    THEN #state := 99; END_IF;
            IF #bMoveTool    AND #fbMoveTool.Error   THEN
                #state := 999; #ErrorID := 16#0006;
                "DB_HMI".ErrorDetail    := CONCAT(IN1 := 'Manual tool step: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbMoveTool.ErrorID));
                "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'Manual paso herr: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbMoveTool.ErrorID));
            END_IF;
            IF #bMoveToolAbs AND #fbMoveToolAbs.Done  THEN #state := 99; END_IF;
            IF #bMoveToolAbs AND #fbMoveToolAbs.Error THEN
                #state := 999; #ErrorID := 16#0006;
                "DB_HMI".ErrorDetail    := CONCAT(IN1 := 'Manual tool abs: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbMoveToolAbs.ErrorID));
                "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'Manual herr abs: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbMoveToolAbs.ErrorID));
            END_IF;
            // Single-axis homing -- on completion go to post-clearance (guarded: not during HomeAll)
            IF #bHomeX AND NOT #bHomeAllExec AND #fbHomeX.Done THEN
                #bHomeX := FALSE; #bClearX := TRUE; #state := 82;
            END_IF;
            IF #bHomeZ AND NOT #bHomeAllExec AND #fbHomeZ.Done THEN
                #bHomeZ := FALSE; #bClearZ := TRUE; #state := 82;
            END_IF;
            IF #bHomeTool AND NOT #bHomeAllExec AND #fbHomeTool.Done THEN #state := 99; END_IF;  // Tool axis has no PNP zone (individual home)
            IF #bHomeTool AND NOT #bHomeAllExec AND #fbHomeTool.Error THEN
                #state := 999; #ErrorID := 16#0007;
                "DB_HMI".ErrorDetail    := CONCAT(IN1 := 'Manual tool home: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbHomeTool.ErrorID));
                "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'Manual ref herr: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbHomeTool.ErrorID));
            END_IF;
            // HomeAll: sequential X → Z → Tool
            IF #bHomeAllExec THEN
                IF #homeAllStep = 1 THEN
                    // Step 1: home X
                    IF #fbHomeX.Done THEN
                        #bHomeX := FALSE; #homeAllStep := 2; #bHomeZ := TRUE;
                    ELSIF #fbHomeX.Error THEN
                        #bHomeX := FALSE; #bHomeAllExec := FALSE; #homeAllStep := 0;
                        #state := 999; #ErrorID := 16#0003;
                        "DB_HMI".ErrorDetail    := CONCAT(IN1 := 'Manual home all X: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbHomeX.ErrorID));
                        "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'Manual ref. todo X: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbHomeX.ErrorID));
                    END_IF;
                ELSIF #homeAllStep = 2 THEN
                    // Step 2: home Z
                    IF #fbHomeZ.Done THEN
                        #bHomeZ := FALSE;
                        IF NOT "DB_MachineConfig".Bypass_ToolAxis THEN
                            #homeAllStep := 3; #bHomeTool := TRUE;
                        ELSE
                            #bHomeAllExec := FALSE; #homeAllStep := 0;
                            #bClearX := TRUE; #bClearZ := TRUE; #state := 82;
                        END_IF;
                    ELSIF #fbHomeZ.Error THEN
                        #bHomeZ := FALSE; #bHomeAllExec := FALSE; #homeAllStep := 0;
                        #state := 999; #ErrorID := 16#0004;
                        "DB_HMI".ErrorDetail    := CONCAT(IN1 := 'Manual home all Z: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbHomeZ.ErrorID));
                        "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'Manual ref. todo Z: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbHomeZ.ErrorID));
                    END_IF;
                ELSIF #homeAllStep = 3 THEN
                    // Step 3: home Tool
                    IF #fbHomeTool.Done THEN
                        #bHomeTool := FALSE; #bHomeAllExec := FALSE; #homeAllStep := 0;
                        #bClearX := TRUE; #bClearZ := TRUE; #state := 82;
                    ELSIF #fbHomeTool.Error THEN
                        #bHomeTool := FALSE; #bHomeAllExec := FALSE; #homeAllStep := 0;
                        #state := 999; #ErrorID := 16#0007;
                        "DB_HMI".ErrorDetail    := CONCAT(IN1 := 'Manual home all Tool: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbHomeTool.ErrorID));
                        "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'Manual ref. todo herr: TO:', IN2 := "FC_TO_ErrorText"(Code := #fbHomeTool.ErrorID));
                    END_IF;
                END_IF;
            END_IF;

        82: // POST-HOME CLEARANCE WAIT -- move away from PNP zone after homing
            #Busy := TRUE; #HomingActive := FALSE;  // Homing done, clearance move in progress
            IF (NOT #bClearX OR #fbClearX.Done) AND (NOT #bClearZ OR #fbClearZ.Done) THEN
                #bClearX := FALSE; #bClearZ := FALSE; #state := 99;
            ELSIF (#bClearX AND #fbClearX.Error) OR (#bClearZ AND #fbClearZ.Error) THEN
                #bClearX := FALSE; #bClearZ := FALSE;
                #state := 999; #ErrorID := 16#0001;
                "DB_HMI".ErrorDetail    := 'Manual: post-home clearance move failed';
                "DB_HMI".ErrorDetail_ES := 'Manual: fallo al liberar zona PNP despues de referenciar';
            END_IF;

        99: // COMPLETE
            #Busy := FALSE; #Done := TRUE; #HomingActive := FALSE;
            #bMoveX := FALSE; #bMoveZ := FALSE; #bMoveTool := FALSE; #bMoveToolAbs := FALSE;
            #bHomeX := FALSE; #bHomeZ := FALSE; #bHomeTool := FALSE;
            #bHomeAllExec := FALSE; #homeAllStep := 0;
            #bClearX := FALSE; #bClearZ := FALSE;
            #ActiveAxis := -1;
            #state := 0;

        999: // ERROR
            #Error := TRUE; #Busy := FALSE; #HomingActive := FALSE;
            #bMoveX := FALSE; #bMoveZ := FALSE; #bMoveTool := FALSE; #bMoveToolAbs := FALSE;
            #bHomeAllExec := FALSE; #homeAllStep := 0;
            #bClearX := FALSE; #bClearZ := FALSE;
    END_CASE;
    
    IF #state = 0 THEN
        #prevMoveAbs := #MoveAbsolute; #prevHomeAxis := #HomeAxis; #prevHomeAll := #HomeAll; 
        #prevGoSafe := #GoSafe; #prevGoZero := #GoZero;
    END_IF;
    
    // FB Calls
    #fbJogX(JogForward := (#Jog_Plus AND #jogAxis = 0 AND #state = 10), 
            JogBackward := (#Jog_Minus AND #jogAxis = 0 AND #state = 10), 
            Velocity := #JogSpeed, Axis := #Axis_X);
    #fbJogZ(JogForward := (#Jog_Plus AND #jogAxis = 1 AND #state = 10),
            JogBackward := (#Jog_Minus AND #jogAxis = 1 AND #state = 10),
            Velocity := #JogSpeed, Axis := #Axis_Z);
    #fbJogTool(JogForward  := (#Jog_Plus  AND #jogAxis = 2 AND #state = 10),
               JogBackward := (#Jog_Minus AND #jogAxis = 2 AND #state = 10),
               Velocity    := #JogSpeed, Axis := #Axis_Tool);
    #fbMoveX(Execute := #bMoveX, Position := #stepTarget, Velocity := #moveVelocity, Axis := #Axis_X);
    #fbMoveZ(Execute := #bMoveZ, Position := #stepTarget, Velocity := #moveVelocity, Axis := #Axis_Z);
    #fbMoveTool(Execute := #bMoveTool, Distance := #stepTarget, Velocity := #moveVelocity, Axis := #Axis_Tool);
    #fbMoveToolAbs(Execute := #bMoveToolAbs, Position := #stepTarget, Velocity := #moveVelocity, Axis := #Axis_Tool);
    #fbHomeX(Execute := #bHomeX, Mode := #HomingMode, Position := #HomePosition, Axis := #Axis_X);
    #fbHomeZ(Execute := #bHomeZ, Mode := #HomingMode, Position := #HomePosition, Axis := #Axis_Z);
    #fbHomeTool(Execute := #bHomeTool, Mode := #HomingMode, Position := #HomePosition, Axis := #Axis_Tool);
    // Homing clearance moves:
    //   Pre-home:  when in PNP zone, move to safe position before starting homing
    //   Post-home: move away from PNP zone after homing completes
    //   Target: HomeOffset + PostHome_Clearance (same position in both cases)
    #fbClearX(Execute  := #bClearX,
              Position := "DB_MachineConfig".HomeOffset_X + "DB_MachineConfig".PostHome_Clearance,
              Velocity := "DB_MachineConfig".HomeVelocity,
              Axis     := #Axis_X);
    #fbClearZ(Execute  := #bClearZ,
              Position := "DB_MachineConfig".HomeOffset_Z + "DB_MachineConfig".PostHome_Clearance,
              Velocity := "DB_MachineConfig".HomeVelocity,
              Axis     := #Axis_Z);
    #prevToolStepCW  := #ToolStepCW;
    #prevToolStepCCW := #ToolStepCCW;
END_FUNCTION_BLOCK

// -----------------------------------------------------------------------------
// FB_Process - Main supervisory state machine with PRE-SCAN
// -----------------------------------------------------------------------------
FUNCTION_BLOCK "FB_Process"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 4.0
    VAR_INPUT Panel_Start : Bool; Panel_Stop : Bool; Panel_Pause : Bool; Panel_Reset : Bool;
              Rem_Start : Bool; Rem_Stop : Bool;
              EStop_OK : Bool := TRUE; Door_Closed : Bool := TRUE; AirPressure_OK : Bool := TRUE;
              // NC limit switches (FALSE = limit hit, fail-safe)
              HW_NC_X_Min : Bool; HW_NC_X_Max : Bool; HW_NC_Z_Min : Bool; HW_NC_Z_Max : Bool;
              // PNP NO proximity sensors (TRUE = limit zone, pre-warning before NC)
              HW_PNP_X_Min : Bool; HW_PNP_X_Max : Bool; HW_PNP_Z_Min : Bool; HW_PNP_Z_Max : Bool; END_VAR
    VAR_OUTPUT Running : Bool; IsPaused : Bool; Error : Bool; StatusID : Int; CurrentTool : Int; SafeToRun : Bool; END_VAR
    VAR_IN_OUT Axis_X : TO_PositioningAxis; Axis_Z : TO_PositioningAxis;
               Axis_Tool : TO_PositioningAxis; Axis_Spindle : TO_PositioningAxis; END_VAR
    VAR State : Int;
        
        // Recipe handlers -- all bound to "DB_SelectedRecipe", never to a
        // DB_RecipeProgram* (those live in load memory; see fbRecipeLoader)
        fbRecipeHandler : "FB_RecipeHandler";
        fbPreScan : "FB_RecipePreScan";
        // Load-memory recipe copy (2026-08-04): copies the selected
        // DB_RecipeProgram* into DB_SelectedRecipe in STATE_RECIPE_LOAD(11)
        fbRecipeLoader : "FB_RecipeLoader";
        
        // Support FBs
        fbToolChanger : "FB_ToolChanger";
        fbHomeX, fbHomeZ, fbHomeTool : "FB_Axis_Home";
        fbSpindleControl : "FB_SpindleControl";
        fbManualMode : "FB_ManualMode";
        fbPowerX, fbPowerZ, fbPowerTool : "FB_Axis_Power";
        fbResetX, fbResetZ, fbResetTool, fbResetSpindle : "FB_Axis_Reset";
        fbInputs : "FB_InputManager";
        fbLimitMonitor : "FB_LimitMonitor";
        fbSafetyMonitor : "FB_SafetyMonitor";
        fbAlarmManager : "FB_AlarmManager";
        // Additional motion FBs for moving to position 0 after stop
        fbMoveX_Stop, fbMoveZ_Stop : "FB_Axis_AbsPos";
        // Homing clearance moves (pre + post homing)
        fbMoveX_HomeClr, fbMoveZ_HomeClr : "FB_Axis_AbsPos";
        bHomeClrX, bHomeClrZ : Bool;
        // PNP proximity sensor halt: controlled stop when PNP zone entered in auto mode
        fbHaltX_PNP, fbHaltZ_PNP : "FB_Axis_Halt";
        bHaltX_PNP, bHaltZ_PNP : Bool;  // Halt execute flags (cleared when state returns to STOPPED)
        // ITEM-31: reset/startup halt — aborts any MC_Home the TO may resume after drive power-cycle or warm restart
        fbHaltX_Reset, fbHaltZ_Reset, fbHaltTool_Reset : "FB_Axis_Halt";
        bHaltAllAxes : Bool;   // Pulse: TRUE for one scan; set by bDoHardReset + first-scan startup; cleared after FB calls
        
        // Control flags
        bPreScanExec : Bool;
        bRecipeLoadExec : Bool; // Level: TRUE only inside STATE_RECIPE_LOAD(11).
                                // Drives fbRecipeLoader.Execute; the FB takes the
                                // rising edge, so this must go FALSE between loads.
        bResetRecipe : Bool;    // One-shot flag to reset FB_RecipeHandler
        bStartSeq, bToolExecute, bPauseActive : Bool;
        // Pause resume spin-up: on Continue from PAUSED, spindle restarts and we wait
        // SpindleResumeSpeedupTime for it to reach speed before releasing the axes to
        // return and resume. bPauseActive stays TRUE during this window so FB_RecipeHandler
        // holds at the pause-retract point (state 802).
        bResumeSpeedup   : Bool;   // TRUE while waiting for spindle to spin back up after Continue
        tonResumeSpeedup : TON;    // Spin-up wait timer (PT = DB_MachineConfig.SpindleResumeSpeedupTime)
        bStopMoveX, bStopMoveZ : Bool;       // Flags for moving to position 0 after stop
        // Sequential homing (startup): home X then Z then Tool in active mode (mode 3)
        bHomeXExec : Bool;
        bHomeZExec : Bool;
        bHomeToolExec : Bool;
        homeSeqState : Int;   // 0=idle, 1=homing X, 2=homing Z, 3=homing Tool
        activeToolReq : Int; activeToolDone : Bool;
        newErrorFlag : Bool; newErrorCode : Word;
        bSpindleStart, bSpindleStop, bDrivesEnable : Bool;
        prevAckError, prevRestart, prevContinue, ackEdge, restartEdge, continueEdge : Bool;
        prevApplyToolConfig : Bool;   // previous ApplyToolConfig button state
        applyToolEdge : Bool;         // rising edge for apply tool mapping
        prevProdReset, prevLastCycleReset, prodResetEdge, lastCycleResetEdge : Bool;
        prevSafetyError : Bool;
        prevDriveFaultX    : Bool;  // Edge detection: X drive power failure
        prevDriveFaultZ    : Bool;  // Edge detection: Z drive power failure
        prevDriveFaultTool : Bool;  // ITEM-29: edge detection: tool axis drive power failure
        prevTOFaultX       : Bool;  // Edge detection: X axis TO fault (StatusBits.Error poller)
        prevTOFaultZ       : Bool;  // Edge detection: Z axis TO fault
        prevTOFaultTool    : Bool;  // Edge detection: Tool axis TO fault
        prevTOFaultSpindle : Bool;  // Edge detection: Spindle TO fault
        // --- Sheet-load park / fast cycle mode ---
        bRequireHoming : Bool := TRUE;  // Axis reference is suspect -> next auto start MUST home.
                                        // Latched TRUE by E-Stop, STATE_ERROR and hard reset;
                                        // cleared ONLY where a homing sequence completes.
                                        // Start value TRUE so a fresh download/power-up homes.
        bRefTrusted    : Bool;  // Recomputed in STATE_STARTING: all axes homed AND NOT bRequireHoming
        clrTargetX     : Real;  // Target for fbMoveX_HomeClr -- PNP escape (state 13) or SheetLoadPos (state 16)
        clrTargetZ     : Real;  // Target for fbMoveZ_HomeClr -- PNP escape (state 13) or SheetLoadPos (state 16)
        clrVelocity    : Real;  // Velocity for the above. HomeVelocity for the slow PNP escape (13),
                                // RapidVelocity for the park move (16) -- the park can be a long
                                // travel and must not crawl at the 5 mm/s homing clearance speed.
        parkTargetX    : Real;  // Clamped SheetLoadPos_X used by the stop/park move (fbMoveX_Stop)
        parkTargetZ    : Real;  // Clamped SheetLoadPos_Z used by the stop/park move (fbMoveZ_Stop)
        bJogBlockPlus      : Bool;  // Manual soft-limit jog gate: block jog+ (recomputed every scan)
        bJogBlockMinus     : Bool;  // Manual soft-limit jog gate: block jog- (recomputed every scan)
        prevManualError : Bool;  // Edge detection: manual mode error
        prevMDIExec : Bool;      // Edge detection: manual MDI execute button (STATE_MANUAL)
        bMDI_Cmd40Extend : Bool; // Latch: MDI CMD=40 Param=1 holds BackSupport extended (Param=0 releases)
        // Edge detection: manual CMD=41 buttons (STATE_MANUAL). Seeded with the live
        // button state whenever the machine is outside manual, so a button left
        // latched (or an HMI that powers up with the bit set) cannot fire on entry.
        prevBtnCmd41Release : Bool;
        prevBtnCmd41AtmoOff : Bool;
        prevBtnCmd41AtmoOn  : Bool;
        // End-of-recipe BackSupport retract (operator spec 2026-08-07). On ENTRY to a
        // terminal state (STOPPED / ERROR / COMPLETE) drive Sol_B for
        // DB_MachineConfig.CylBackSupport_EndRetractTime, then drop every coil, so the
        // next recipe always starts from a known clean state regardless of how the
        // previous one ended. bBSTerminalPrev is the edge memory; it is SEEDED TRUE on
        // hard reset so power-up (which starts in STOPPED) does not fire a retract.
        bBSEndRetract   : Bool;
        bBSTerminalNow  : Bool;   // recomputed every scan (this FB has no VAR_TEMP section)
        bBSTerminalPrev : Bool;
        tonBSEndRetract : TON;
        bInitDone    : Bool;   // TRUE after first PLC scan; prevents re-triggering startup reset
        bDoHardReset : Bool;   // Pulse: set TRUE to trigger hard-reset block this scan (startup + Cmd_Reset)

        applyIndex : Int;  // Loop index for tool config apply

        // Active recipe reference
        activeProgram : Int;
        activeLineCount : Int;

        // Recipe-carried tool table (read from active recipe Header in STATE_PRE_SCAN,
        // then applied to DB_ToolConfig / DB_MachineConfig before the pre-scan runs)
        hdrProvidesToolCfg : Bool;
        hdrToolCount       : Int;
        hdrAutoCalc        : Bool;
        hdrToolCodes       : Array[1..4] of Int;
        hdrToolAngles      : Array[1..4] of Real;

        // ToolHeadLock timers
        tonLockWait : TON;      // Fallback timeout for states 17 and 29 (T#3S)
        tonLockPreDelay : TON;  // Pre-delay before commanding extend in state 17 (T#1S)
        // TRUE = LOCK_RETRACT_WAIT exits to STATE_STOPPED (axes already parked at SheetLoadPos by STOPPING)
        // FALSE = exits to STATE_TOOL_CHANGE
        bLockAfterHoming : Bool;
        // Sheet wait (STATE_SHEET_WAIT = 14)
        bSheetWaitPhase2          : Bool;   // Phase 2: MandrelLock extending (T#5S)
        bSheetWaitPhase3          : Bool;   // Phase 3: SheetHolder retracting (T#5S)
        tonMandrelWait            : TON;    // T#5S open-loop stroke wait for MandrelLock (phase 2)
        tonSheetHolderRetract     : TON;    // T#5S open-loop wait for SheetHolder retract (phase 3)
        bMandrelRetractPulse      : Bool;   // One-shot: pulse Cmd_Retract for one scan to release MandrelLock FB from State 3
        bMandrelRetractPending    : Bool;   // ITEM-32: deferred retract — unsafe paths (Reset/Error/Complete) set this; SpindleStopSafeTime timer promotes to pulse
        tonMandrelRetractWait     : TON;    // ITEM-32: safety gate timer for deferred retract (PT = DB_MachineConfig.SpindleStopSafeTime)
        // SheetHolder is a 5/3 blocked centre (ValveType=2) -- no spring. Cmd_Retract must be
        // HELD for the whole stroke, not pulsed: a one-scan pulse energises Sol_B for one scan
        // and the blocked centre then locks the piston mid-stroke. Held for exactly
        // CylSheetHolder_RetractTime (tonSheetHolderHold below), then dropped so BOTH coils
        // de-energise and the blocked centre holds the piston -- ITEM-46. Also cleared on
        // STATE_SHEET_WAIT Ph1 so an extend always wins.
        bSheetHolderRetractHold   : Bool;   // Held: drives Cmd_Retract for the retract window only
        // ITEM-46: bounds the retract coil. Runs whenever the latch is held AND the coils can
        // actually move the piston (E-Stop OK) -- an E-Stop during the stroke pauses the window
        // instead of burning it, so the retract finishes when the E-Stop is released.
        tonSheetHolderHold        : TON;    // PT = DB_MachineConfig.CylSheetHolder_RetractTime
        bWaitingSpindleStop       : Bool;   // TRUE while STATE_STOPPING waits for spindle decel before retracting MandrelLock
        tonSpindleStopWait        : TON;    // Proportional wait before MandrelLock retract (see SpindleStopSafeTime). Fires immediately if speed was 0.
        capturedSpindleRPM        : Real;   // Speed captured when bWaitingSpindleStop is set (ITEM-28)
        spindleStopPT             : Time;   // Proportional PT for tonSpindleStopWait (ITEM-28)
        bCycleCountDone           : Bool;   // One-shot: prevents multiple CycleCount increments per cycle (ITEM-20)

        // Cycle timer
        tonElapsed : TON;
        // Homing timeout: fires if STATE_HOMING sequence takes longer than 120s
        tonHomingTimeout : TON;
        // ITEM-30: independent timeout for STATE_STOP_GOHOME (was sharing tonHomingTimeout — risky if
        // a normal homing cycle consumed most of the budget, leaving too little time for post-stop homing)
        tonStopHomeTimeout : TON;
        // Drive ready timeout: fires if drives do not become ready within 3s of STATE_STARTING
        tonDriveReady : TON;
        // Spindle deceleration wait
        tonSpindleDecel      : TON;   // Decel wait timer
        bSpindleDecelWait    : Bool;  // TRUE while waiting for decel to complete
        bSpindlePendingStart : Bool;  // Deferred start captured during decel wait
        pendingSpindleSpeed  : Real;  // Speed to apply when timer expires
        elapsedAccum : Time;         // Accumulated elapsed time
        timerRunning : Bool;         // Timer active flag
        elapsedSeconds : DInt;       // Seconds counter
        
        // Warm restart
        savedLineIndex : Int := -1;  // Saved line for restart (-1 = none)
        savedProgram : Int := -1;    // Saved program for restart

        // Production logging
        prevState : Int;             // For state edge detection
        prodTimeNow : DTL;
        prodTimeStatus : Int;

        // Spindle history ring buffer: previous values for change detection
        // A new snapshot is pushed only when one of these changes.
        prevSnap_State       : Int;
        prevSnap_PrevStart   : Bool;
        prevSnap_ReqStart    : Bool;
        prevSnap_StartEdge   : Bool;
        prevSnap_MoveVelBusy : Bool;  // MC_MoveVelocity.Busy -- triggers snapshot when TO accepts/drops command

    END_VAR
    
    CONST
        STATE_STOPPED : Int := 0;
        STATE_MANUAL : Int := 5;
        STATE_STARTING : Int := 10;
        // Copies the selected recipe out of load memory into DB_SelectedRecipe.
        // Runs BEFORE the pre-scan -- the pre-scan is what reads the lines and
        // applies the header tool table, so the buffer must be filled first.
        STATE_RECIPE_LOAD : Int := 11;
        STATE_PRE_SCAN : Int := 12;
        STATE_PRE_HOME_CLR : Int := 13;      // Pre-homing clearance move out of PNP zone
        STATE_SHEET_WAIT   : Int := 14;      // Sheet insertion: Ph1=SheetHolder extends+prompt, Ph2=MandrelLock T#5S, Ph3=SheetHolder retract T#5S → LOCK_EXTEND_WAIT
        STATE_HOMING : Int := 15;
        STATE_POST_HOME_CLR : Int := 16;     // Post-homing clearance move away from PNP zone
        STATE_STOPPING : Int := 18;
        STATE_STOP_GOHOME : Int := 19;
        STATE_STOP_GOTOZERO : Int := 21;
        STATE_PNP_HALT : Int := 22;          // PNP limit zone -- halt active, reverse jog allowed
        STATE_RUNNING : Int := 20;
        STATE_PAUSED : Int := 25;
        STATE_TOOL_CHANGE : Int := 30;
        STATE_TOOL_WAIT : Int := 35;
        STATE_LOCK_EXTEND_WAIT : Int := 17;   // ToolHeadLock engaging before RUNNING
        STATE_LOCK_RETRACT_WAIT : Int := 29;  // ToolHeadLock releasing before tool change or homing
        STATE_ERROR : Int := 999;
    END_CONST
BEGIN
    // Update HMI displays
    "DB_HMI".ActualX := #Axis_X.ActualPosition;
    "DB_HMI".ActualZ := #Axis_Z.ActualPosition;
    "DB_HMI".MachineState := #State;

    // =========================================================================
    // FIRST-SCAN STARTUP INIT
    // =========================================================================
    // On the very first PLC scan after power-up or warm restart, trigger a hard
    // reset. This forces a known-clean machine state explicitly rather than
    // relying solely on NON_RETAIN default values. Covers any case where the
    // state machine variable did not reset cleanly (e.g. mid-homing on restart).
    IF NOT #bInitDone THEN
        #bDoHardReset := TRUE;
        #bHaltAllAxes := TRUE;   // ITEM-31: abort any MC_Home the TO may auto-resume on power-up
        // Power-up ALWAYS requires homing. Set explicitly here rather than relying on the
        // hard-reset block: that block now decides from the pre-reset #State, which is 0
        // (STOPPED) on the first scan and would therefore skip the latch. The VAR default is
        // also TRUE, but only because the instance DB is NON_RETAIN -- do not depend on that.
        #bRequireHoming := TRUE;
        // BackSupport end-of-recipe retract (ITEM-41): seed the terminal-state edge memory TRUE
        // so power-up does NOT fire a retract nobody asked for. This scan ends in STOPPED (a
        // terminal state) and an unseeded edge memory would read that as a fresh entry.
        //
        // This seeding belongs HERE and nowhere else. In the general hard-reset block it would
        // also suppress the retract on an operator Reset pressed from RUNNING -- that reset sets
        // State := STOPPED, so a pre-seeded edge memory sees terminal->terminal and the cylinder
        // is left frozen mid-recipe, which is the ITEM-48 failure all over again.
        #bBSTerminalPrev := TRUE;
        #bBSEndRetract   := FALSE;
        #tonBSEndRetract(IN := FALSE, PT := "DB_MachineConfig".CylBackSupport_EndRetractTime);
        "DB_Cylinder_BackSupport".Cmd_Retract := FALSE;
        #bInitDone    := TRUE;
    END_IF;

    // Edge detection for buttons
    #ackEdge := "DB_HMI".Btn_AckError AND NOT #prevAckError;
    #prevAckError := "DB_HMI".Btn_AckError;
    #restartEdge := "DB_HMI".Btn_Restart AND NOT #prevRestart;
    #prevRestart := "DB_HMI".Btn_Restart;
    #continueEdge := "DB_HMI".Btn_Continue AND NOT #prevContinue;
    #prevContinue := "DB_HMI".Btn_Continue;
    // Apply Tool Config edge
    #applyToolEdge := "DB_HMI".Btn_ApplyToolConfig AND NOT #prevApplyToolConfig;
    #prevApplyToolConfig := "DB_HMI".Btn_ApplyToolConfig;
    #prodResetEdge := "DB_HMI".Btn_ProdReset AND NOT #prevProdReset;
    #prevProdReset := "DB_HMI".Btn_ProdReset;
    #lastCycleResetEdge := "DB_HMI".Btn_LastCycleReset AND NOT #prevLastCycleReset;
    #prevLastCycleReset := "DB_HMI".Btn_LastCycleReset;
    
    // Get active program from HMI (lock during RUNNING to prevent mid-program switch)
    IF #State < STATE_STARTING OR #State >= STATE_ERROR THEN
        #activeProgram := "DB_HMI".ProductSelect;
        IF #activeProgram < 1 THEN #activeProgram := 1; END_IF;
        IF #activeProgram > 10 THEN #activeProgram := 10; END_IF;  // 10 recipes since 2026-08-04
    END_IF;

    // Tool-slot mapping is now CAM-authored: the active recipe Header supplies the
    // tool table and it is applied on Start (STATE_PRE_SCAN). "Recipe always wins" --
    // the HMI Apply path is intentionally disabled and DB_HMI.ToolSlotCode is a
    // read-only mirror of the active mapping for display only. #applyToolEdge is still
    // computed above (harmless) but no longer copies into DB_ToolConfig.
    // (See CAM_TOOL_TABLE_HANDOVER.md.)
    FOR #applyIndex := 1 TO 4 DO
        "DB_HMI".ToolSlotCode[#applyIndex] := "DB_ToolConfig".ToolCode_List[#applyIndex];
    END_FOR;
    
    // Safety monitor
    #fbSafetyMonitor(EStop_OK := #EStop_OK, Door_Closed := #Door_Closed, AirPressure_OK := #AirPressure_OK,
                     DrivesReady := #fbPowerX.Status AND #fbPowerZ.Status,
                     Bypass_EStop := "DB_HMI".Bypass_EStop,
                     Bypass_Door := "DB_HMI".Bypass_Door,
                     Bypass_AirPressure := "DB_HMI".Bypass_AirPressure,
                     Bypass_Drives := "DB_HMI".Bypass_Drives);
    
    // Power control
    #bDrivesEnable := (#EStop_OK OR "DB_HMI".Bypass_EStop) AND (#State <> STATE_ERROR);
    #fbPowerX(Enable := #bDrivesEnable, Axis := #Axis_X);
    #fbPowerZ(Enable := #bDrivesEnable, Axis := #Axis_Z);
    #fbPowerTool(Enable := #bDrivesEnable AND NOT "DB_MachineConfig".Bypass_ToolAxis, Axis := #Axis_Tool);

    // Drive power failure detection -- capture TO ErrorID and write to diagnostic
    // Checked every scan; alarm is raised only when a new error occurs (rising edge).
    // STATE_RECIPE_LOAD(11) and STATE_PRE_SCAN(12) are treated like STATE_STOPPED(0):
    // contactors are still open during the recipe copy and
    // pre-scan (closed only in STATE_STARTING), so a drive fault here is typically a latched
    // fault from a previous run or a transient after TO reset -- not a new startup failure.
    // The drive ready check (tonDriveReady) and MC_Home.Error in STATE_STARTING handle genuine
    // startup faults. Firing STATE_ERROR in PRE_SCAN would abort the recipe validation for no reason.
    IF #fbPowerX.Error THEN
        "DB_Diagnostic".Power_X_ErrorID := #fbPowerX.ErrorID;
        "DB_Diagnostic".TO_ErrorText := "FC_TO_ErrorText"(Code := #fbPowerX.ErrorID);
        IF NOT #prevDriveFaultX THEN
            #newErrorFlag := TRUE;
            #newErrorCode := 16#0009;
            "DB_HMI".ErrorDetail    := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
            "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
            IF #State <> STATE_ERROR AND #State <> 0 AND #State <> STATE_PRE_SCAN
               AND #State <> STATE_RECIPE_LOAD THEN
                #State := STATE_ERROR;
            END_IF;
        END_IF;
        #prevDriveFaultX := TRUE;
    ELSE
        #prevDriveFaultX := FALSE;
    END_IF;

    IF #fbPowerZ.Error THEN
        "DB_Diagnostic".Power_Z_ErrorID := #fbPowerZ.ErrorID;
        "DB_Diagnostic".TO_ErrorText := "FC_TO_ErrorText"(Code := #fbPowerZ.ErrorID);
        IF NOT #prevDriveFaultZ THEN
            #newErrorFlag := TRUE;
            #newErrorCode := 16#000A;
            "DB_HMI".ErrorDetail    := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
            "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
            IF #State <> STATE_ERROR AND #State <> 0 AND #State <> STATE_PRE_SCAN
               AND #State <> STATE_RECIPE_LOAD THEN
                #State := STATE_ERROR;
            END_IF;
        END_IF;
        #prevDriveFaultZ := TRUE;
    ELSE
        #prevDriveFaultZ := FALSE;
    END_IF;

    // ITEM-29: tool axis drive power fault monitoring (mirrors X/Z pattern above)
    IF #fbPowerTool.Error THEN
        "DB_Diagnostic".TO_ErrorText := "FC_TO_ErrorText"(Code := #fbPowerTool.ErrorID);
        IF NOT #prevDriveFaultTool THEN
            #newErrorFlag := TRUE;
            #newErrorCode := 16#000D;
            "DB_HMI".ErrorDetail    := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
            "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
            IF #State <> STATE_ERROR AND #State <> 0 AND #State <> STATE_PRE_SCAN
               AND #State <> STATE_RECIPE_LOAD THEN
                #State := STATE_ERROR;
            END_IF;
        END_IF;
        #prevDriveFaultTool := TRUE;
    ELSE
        #prevDriveFaultTool := FALSE;
    END_IF;

    // =========================================================================
    // TO (Technology Object) FAULT POLLER
    // =========================================================================
    // Guarantees axis TO errors ALWAYS reach the HMI. The MC_ wrapper FBs only report
    // an ErrorID while their own command is active; a TO fault outside an active command
    // (following error, TO-internal soft-limit trip, encoder/drive fault at rest) was
    // previously visible only on the TIA Portal TO diagnostics page.
    // Polls <axis>.StatusBits.Error every scan, raises a motion-tier alarm on the rising
    // edge. Skipped while the matching MC_Power FB reports a fault (the drive-power blocks
    // above already raise the more specific 16#0009/16#000A/16#000D) and while E-Stop is
    // active (the safety tier owns that case; power removal marks every axis in error).
    // TO errors are cleared by the MC_Reset calls on AckError/Reset (fbResetX/Z/Tool/Spindle).
    IF #Axis_X.StatusBits.Error AND NOT #fbPowerX.Error AND #EStop_OK THEN
        IF NOT #prevTOFaultX THEN
            #newErrorFlag := TRUE; #newErrorCode := 16#0021;
            "DB_Diagnostic".Error_Text := 'TO fault: X axis (StatusBits.Error) - check TO diagnostics';
            "DB_HMI".ErrorDetail    := 'X axis technology object fault - press Ack/Reset to clear';
            "DB_HMI".ErrorDetail_ES := 'Fallo de objeto tecnologico eje X - presionar Ack/Reset para borrar';
            IF #State <> STATE_ERROR AND #State <> 0 AND #State <> STATE_PRE_SCAN
               AND #State <> STATE_RECIPE_LOAD THEN
                #State := STATE_ERROR;
            END_IF;
        END_IF;
        #prevTOFaultX := TRUE;
    ELSE
        #prevTOFaultX := FALSE;
    END_IF;

    IF #Axis_Z.StatusBits.Error AND NOT #fbPowerZ.Error AND #EStop_OK THEN
        IF NOT #prevTOFaultZ THEN
            #newErrorFlag := TRUE; #newErrorCode := 16#0022;
            "DB_Diagnostic".Error_Text := 'TO fault: Z axis (StatusBits.Error) - check TO diagnostics';
            "DB_HMI".ErrorDetail    := 'Z axis technology object fault - press Ack/Reset to clear';
            "DB_HMI".ErrorDetail_ES := 'Fallo de objeto tecnologico eje Z - presionar Ack/Reset para borrar';
            IF #State <> STATE_ERROR AND #State <> 0 AND #State <> STATE_PRE_SCAN
               AND #State <> STATE_RECIPE_LOAD THEN
                #State := STATE_ERROR;
            END_IF;
        END_IF;
        #prevTOFaultZ := TRUE;
    ELSE
        #prevTOFaultZ := FALSE;
    END_IF;

    IF #Axis_Tool.StatusBits.Error AND NOT #fbPowerTool.Error AND #EStop_OK
       AND NOT "DB_MachineConfig".Bypass_ToolAxis THEN
        IF NOT #prevTOFaultTool THEN
            #newErrorFlag := TRUE; #newErrorCode := 16#0023;
            "DB_Diagnostic".Error_Text := 'TO fault: Tool axis (StatusBits.Error) - check TO diagnostics';
            "DB_HMI".ErrorDetail    := 'Tool axis technology object fault - press Ack/Reset to clear';
            "DB_HMI".ErrorDetail_ES := 'Fallo de objeto tecnologico eje herramienta - presionar Ack/Reset para borrar';
            IF #State <> STATE_ERROR AND #State <> 0 AND #State <> STATE_PRE_SCAN
               AND #State <> STATE_RECIPE_LOAD THEN
                #State := STATE_ERROR;
            END_IF;
        END_IF;
        #prevTOFaultTool := TRUE;
    ELSE
        #prevTOFaultTool := FALSE;
    END_IF;

    // Spindle: MC_Power lives inside fbSpindleControl (no fbPowerSpindle guard here).
    // A same-scan specific spindle error (16#05xx) from FB_SpindleControl wins the display
    // anyway (same tier, first-in latch); this poller is the safety net for faults at rest.
    IF #Axis_Spindle.StatusBits.Error AND #EStop_OK THEN
        IF NOT #prevTOFaultSpindle THEN
            #newErrorFlag := TRUE; #newErrorCode := 16#0024;
            "DB_Diagnostic".Error_Text := 'TO fault: Spindle (StatusBits.Error) - check TO diagnostics';
            "DB_HMI".ErrorDetail    := 'Spindle technology object fault - press Ack/Reset to clear';
            "DB_HMI".ErrorDetail_ES := 'Fallo de objeto tecnologico husillo - presionar Ack/Reset para borrar';
            IF #State <> STATE_ERROR AND #State <> 0 AND #State <> STATE_PRE_SCAN
               AND #State <> STATE_RECIPE_LOAD THEN
                #State := STATE_ERROR;
            END_IF;
        END_IF;
        #prevTOFaultSpindle := TRUE;
    ELSE
        #prevTOFaultSpindle := FALSE;
    END_IF;

    // Limit monitor
    #fbLimitMonitor(ActualPos_X := #Axis_X.ActualPosition, ActualPos_Z := #Axis_Z.ActualPosition,
                    Homed_X := #Axis_X.StatusBits.HomingDone, Homed_Z := #Axis_Z.StatusBits.HomingDone,
                    HW_NC_X_Min := #HW_NC_X_Min, HW_NC_X_Max := #HW_NC_X_Max,
                    HW_NC_Z_Min := #HW_NC_Z_Min, HW_NC_Z_Max := #HW_NC_Z_Max,
                    HW_PNP_X_Min := #HW_PNP_X_Min, HW_PNP_X_Max := #HW_PNP_X_Max,
                    HW_PNP_Z_Min := #HW_PNP_Z_Min, HW_PNP_Z_Max := #HW_PNP_Z_Max);
    // NOTE: FB_LimitMonitor itself now checks soft limits only for HOMED axes
    // (Homed_X/Z inputs = StatusBits.HomingDone) -- an un-homed axis can never trip a
    // soft limit. The state bypasses below remain as defense in depth:
    // During homing the axis may move outside soft limits (moving toward home switch).
    // All four homing-related states are bypassed: PRE_HOME_CLR, HOMING, POST_HOME_CLR,
    // and STOP_GOHOME. Without bypassing PRE/POST_HOME_CLR the clearance moves could
    // trip a spurious soft-limit fault before homing even begins (TO position = 0 after restart).
    // STATE_MANUAL and STATE_PNP_HALT are also bypassed: manual mode enforces soft limits
    // via directional jog gating + MoveAbsolute target rejection (never faults, so the
    // operator can always jog back into range).
    // STATE_PRE_SCAN(12) and STATE_STARTING(10) are bypassed because:
    //   RECIPE_LOAD: pure data copy out of load memory, no motion at all.
    //   PRE_SCAN: pure software validation, no motion -- TO position may be stale from last run.
    //   STARTING: contactors just closing, drives not yet ready -- homing will establish real position.
    // HW limit switch faults are caught by TO → MC_Home.Error → handled in state machine.
    IF #State = STATE_HOMING OR #State = STATE_STOP_GOHOME
       OR #State = STATE_PRE_HOME_CLR OR #State = STATE_POST_HOME_CLR
       OR #State = STATE_MANUAL OR #State = STATE_PNP_HALT
       OR #State = STATE_PRE_SCAN OR #State = STATE_STARTING
       OR #State = STATE_RECIPE_LOAD THEN
        #SafeToRun := #fbSafetyMonitor.SafeToRun;   // Soft limit bypass
    ELSE
        #SafeToRun := #fbSafetyMonitor.SafeToRun AND NOT #fbLimitMonitor.LimitError;
    END_IF;
    
    // Safety error handling
    // NOTE: Alarm is only raised from active states such as RUNNING/MANUAL.
    // No new alarm is raised in STOPPED (0) or ERROR (999) state;
    // this prevents drive enable delay after ACK/Reset from creating spurious alarms.
    IF NOT #fbSafetyMonitor.SafeToRun AND #fbSafetyMonitor.ErrorCode <> 0 THEN
        IF NOT #prevSafetyError AND #State <> 0 AND #State <> STATE_ERROR THEN
            #newErrorFlag := TRUE; #newErrorCode := #fbSafetyMonitor.ErrorCode;
        END_IF;
        IF #State <> 0 AND #State <> STATE_ERROR THEN #State := STATE_ERROR; END_IF;
        #prevSafetyError := TRUE;
    ELSE
        #prevSafetyError := FALSE;
    END_IF;

    // Soft limit error handling -- triggers STATE_ERROR when axis exceeds configured soft limits.
    // Un-homed axes never trip (FB_LimitMonitor Homed_X/Z gating -- position is meaningless
    // before the reference seek completes).
    // NC hardware limit switches are removed from LimitMonitor; TO handles them natively.
    // Bypassed in all four homing-related states: during homing the axis may legitimately
    // travel outside the configured limits while seeking the reference switch.
    // STATE_MANUAL and STATE_PNP_HALT also bypassed: manual mode enforces soft limits via
    // directional jog gating + MoveAbsolute target rejection instead of faulting.
    // STATE_RECIPE_LOAD(11), STATE_PRE_SCAN(12) and STATE_STARTING(10) bypassed: TO position may be stale
    // from the previous run; firing here would abort startup for a position that was valid last run.
    IF #fbLimitMonitor.LimitError AND #fbLimitMonitor.ErrorCode <> 0
       AND #State <> STATE_HOMING AND #State <> STATE_STOP_GOHOME
       AND #State <> STATE_PRE_HOME_CLR AND #State <> STATE_POST_HOME_CLR
       AND #State <> STATE_MANUAL AND #State <> STATE_PNP_HALT
       AND #State <> STATE_PRE_SCAN AND #State <> STATE_STARTING
       AND #State <> STATE_RECIPE_LOAD
       AND #State <> STATE_STOPPED AND #State <> STATE_ERROR THEN
        #newErrorFlag := TRUE;
        #newErrorCode := #fbLimitMonitor.ErrorCode;
        #State := STATE_ERROR;
    END_IF;

    // PNP proximity sensor halt -- auto mode only.
    // Bypassed in: homing states (PNP zone expected during reference seek),
    //              manual mode (operator in direct control, TO handles HW limits),
    //              STOPPED, PNP_HALT, and ERROR (no active motion to halt).
    // Triggers: MC_Halt on affected axis + STATE_PNP_HALT.
    // In STATE_PNP_HALT: drives stay ON, FB_ManualMode active, reverse jog allowed to escape zone.
    IF #State <> STATE_HOMING AND #State <> STATE_STOP_GOHOME
       AND #State <> STATE_PRE_HOME_CLR AND #State <> STATE_POST_HOME_CLR
       AND #State <> STATE_MANUAL AND #State <> STATE_STOPPED
       AND #State <> STATE_PNP_HALT AND #State <> STATE_ERROR THEN
        IF #HW_PNP_X_Min AND NOT #bHaltX_PNP THEN
            #bHaltX_PNP := TRUE;
            #newErrorFlag := TRUE; #newErrorCode := 16#0121;
            "DB_HMI".ErrorDetail    := 'X axis MIN proximity triggered - select X, jog + to escape';
            "DB_HMI".ErrorDetail_ES := 'Proximidad MIN Eje X activa - seleccionar X, joguear + para salir';
            #State := STATE_PNP_HALT;
        END_IF;
        IF #HW_PNP_X_Max AND NOT #bHaltX_PNP THEN
            #bHaltX_PNP := TRUE;
            #newErrorFlag := TRUE; #newErrorCode := 16#0122;
            "DB_HMI".ErrorDetail    := 'X axis MAX proximity triggered - select X, jog - to escape';
            "DB_HMI".ErrorDetail_ES := 'Proximidad MAX Eje X activa - seleccionar X, joguear - para salir';
            #State := STATE_PNP_HALT;
        END_IF;
        IF #HW_PNP_Z_Min AND NOT #bHaltZ_PNP THEN
            #bHaltZ_PNP := TRUE;
            #newErrorFlag := TRUE; #newErrorCode := 16#0123;
            "DB_HMI".ErrorDetail    := 'Z axis MIN proximity triggered - select Z, jog + to escape';
            "DB_HMI".ErrorDetail_ES := 'Proximidad MIN Eje Z activa - seleccionar Z, joguear + para salir';
            #State := STATE_PNP_HALT;
        END_IF;
        IF #HW_PNP_Z_Max AND NOT #bHaltZ_PNP THEN
            #bHaltZ_PNP := TRUE;
            #newErrorFlag := TRUE; #newErrorCode := 16#0124;
            "DB_HMI".ErrorDetail    := 'Z axis MAX proximity triggered - select Z, jog - to escape';
            "DB_HMI".ErrorDetail_ES := 'Proximidad MAX Eje Z activa - seleccionar Z, joguear - para salir';
            #State := STATE_PNP_HALT;
        END_IF;
    END_IF;
    // Safety clear: halt flags released when we return to idle
    IF #State = STATE_STOPPED THEN
        #bHaltX_PNP := FALSE;
        #bHaltZ_PNP := FALSE;
    END_IF;

    // Input manager
    #fbInputs(HMI_Start := "DB_HMI".Btn_Start, HMI_Stop := "DB_HMI".Btn_Stop,
              HMI_Pause := "DB_HMI".Btn_Pause, HMI_Reset := "DB_HMI".Btn_Reset,
              Panel_Start := #Panel_Start, Panel_Stop := #Panel_Stop,
              Panel_Pause := #Panel_Pause, Panel_Reset := #Panel_Reset,
              Rem_Start := #Rem_Start, Rem_Stop := #Rem_Stop);
    
    // Command processing
    IF #fbInputs.Cmd_Stop THEN
        // STOP: controlled stop without generating an error + return to safe position
        #bPauseActive := FALSE;
        #bStartSeq := FALSE;
        // Drop every other axis-motion trigger before handing the axes to the STOPPING
        // park move. Without this, a Stop pressed during a clearance/park move (13/16) or
        // during the homing sequence (15) leaves fbMoveX/Z_HomeClr or fbHomeX/Z/Tool
        // executing while fbMoveX/Z_Stop is also commanded -- two MC_ function blocks
        // fighting for the same axis. Latent before the sheet-load park change; state 16
        // is now on the normal cycle path (every reposition), so it is reachable in
        // routine operation rather than only mid-homing.
        #bHomeClrX := FALSE; #bHomeClrZ := FALSE;
        #bHomeXExec := FALSE; #bHomeZExec := FALSE; #bHomeToolExec := FALSE;
        #homeSeqState := 0;
        // If running, go to special STOP sequence; otherwise go directly to STOPPED
        IF (#State >= STATE_STARTING AND #State < STATE_ERROR AND #State <> 100) OR (#State = STATE_PAUSED) THEN
            #State := STATE_STOPPING;
        ELSE
            #State := STATE_STOPPED;
        END_IF;
    END_IF;
    // Reset and Restart are blocked while E-Stop is active.
    // Operator must physically release E-Stop before clearing any error state.
    IF #fbInputs.Cmd_Reset AND (#EStop_OK OR "DB_HMI".Bypass_EStop) THEN
        #bDoHardReset := TRUE;
    END_IF;

    // Btn_Restart - restart program from beginning (from ERROR or PAUSED).
    // This block fires BEFORE the CASE state machine, so CASE 999/25 restart handlers
    // are bypassed. All required cleanup must be done here.
    IF #restartEdge AND (#State = STATE_ERROR OR #State = STATE_PAUSED)
       AND (#EStop_OK OR "DB_HMI".Bypass_EStop) THEN
        #State := STATE_STOPPED;
        #bPauseActive := FALSE;
        #Error := FALSE;
        #bResetRecipe := TRUE;      // Reset recipe handler to IDLE (was missing -- bug fix)
        #prevSafetyError := FALSE;  // Fresh safety evaluation on restart
        #savedLineIndex := -1;
        #savedProgram := -1;
        "DB_HMI".ResumeLine := -1;
        IF NOT "DB_MachineConfig".Bypass_MandrelLock THEN
            #bMandrelRetractPending := TRUE;  // ITEM-32: deferred — spindle may still be spinning; wait SpindleStopSafeTime
        END_IF;
        #fbAlarmManager(NewError := FALSE, NewErrorCode := 0,
                        AcknowledgeError := TRUE);  // Clear active alarm (was missing -- bug fix)
    END_IF;
    
    // Pause - one-shot SET only (no toggle). Only Btn_Continue resumes.
    IF #fbInputs.Cmd_Pause AND #Running AND NOT #bPauseActive THEN #bPauseActive := TRUE; END_IF;
    
    #Running := (#State >= 10) AND (#State < STATE_ERROR);
    #IsPaused := (#State = STATE_PAUSED);
    
    // Update HMI status lamps
    "DB_HMI".IsRunning := #Running;
    "DB_HMI".IsPaused := #IsPaused;
    "DB_HMI".HasError := (#State = STATE_ERROR);

    // Warning: only E-Stop bypass is shown on HMI (Door/Air/Drive bypasses silently permitted for setup)
    "DB_HMI".HasWarning := "DB_HMI".Bypass_EStop;
    IF "DB_HMI".Bypass_EStop THEN
        "DB_HMI".WarningText    := 'E-Stop bypass ON - auto start blocked';
        "DB_HMI".WarningText_ES := 'Paro de emergencia desactivado - inicio automatico bloqueado';
    ELSE
        "DB_HMI".WarningText    := '';
        "DB_HMI".WarningText_ES := '';
    END_IF;
    
    // Update HMI status message based on state (English + Spanish)
    CASE #State OF
        0:   "DB_HMI".StatusMsg := 'Stopped';                            "DB_HMI".StatusMsg_ES := 'Detenido';
        5:   "DB_HMI".StatusMsg := 'Manual Mode';                        "DB_HMI".StatusMsg_ES := 'Modo Manual';
        10:  "DB_HMI".StatusMsg := 'Starting...';                        "DB_HMI".StatusMsg_ES := 'Iniciando...';
        11:  "DB_HMI".StatusMsg := 'Loading recipe...';                   "DB_HMI".StatusMsg_ES := 'Cargando receta...';
        12:  "DB_HMI".StatusMsg := 'Pre-scanning...';                    "DB_HMI".StatusMsg_ES := 'Verificando receta...';
        13:  "DB_HMI".StatusMsg := 'Clearing PNP zone...';               "DB_HMI".StatusMsg_ES := 'Liberando zona PNP...';
        14:  "DB_HMI".StatusMsg := 'Waiting for sheet...';               "DB_HMI".StatusMsg_ES := 'Esperando lamina...';
        15:  "DB_HMI".StatusMsg := 'Homing...';                          "DB_HMI".StatusMsg_ES := 'Referenciando...';
        16:  "DB_HMI".StatusMsg := 'Sheet-load park move...';            "DB_HMI".StatusMsg_ES := 'Moviendo a posicion de carga...';
        17:  "DB_HMI".StatusMsg := 'Lock engaging...';                   "DB_HMI".StatusMsg_ES := 'Bloqueando cabezal...';
        18:  "DB_HMI".StatusMsg := 'Stopping...';                        "DB_HMI".StatusMsg_ES := 'Deteniendo...';
        29:  "DB_HMI".StatusMsg := 'Lock releasing...';                  "DB_HMI".StatusMsg_ES := 'Liberando bloqueo...';
        19:  "DB_HMI".StatusMsg := 'Homing (post-stop)...';              "DB_HMI".StatusMsg_ES := 'Referenciando (post-paro)...';
        20:  "DB_HMI".StatusMsg := 'Running';                            "DB_HMI".StatusMsg_ES := 'Ejecutando';
        21:  "DB_HMI".StatusMsg := 'Returning to zero...';               "DB_HMI".StatusMsg_ES := 'Retornando a cero...';
        22:  "DB_HMI".StatusMsg := 'PNP Halt - jog to escape limit zone';"DB_HMI".StatusMsg_ES := 'Zona PNP - joguear para salir';
        25:  "DB_HMI".StatusMsg := 'Paused';                             "DB_HMI".StatusMsg_ES := 'Pausado';
        30:  "DB_HMI".StatusMsg := 'Tool Change';                        "DB_HMI".StatusMsg_ES := 'Cambio de Herramienta';
        35:  "DB_HMI".StatusMsg := 'Tool Change Wait';                   "DB_HMI".StatusMsg_ES := 'Esperando cambio...';
        100: "DB_HMI".StatusMsg := 'Program Complete';                   "DB_HMI".StatusMsg_ES := 'Programa Completado';
        999: "DB_HMI".StatusMsg := 'ERROR';                              "DB_HMI".StatusMsg_ES := 'ERROR';
    END_CASE;
    
    // =========================================================================
    // ALARM MANAGER - call FIRST so outputs are ready for DB_HMI
    // =========================================================================
    // NOTE: Acknowledge is done only on edge (ackEdge), not level.
    // This keeps ActiveError/HMI bools visible until the operator actually presses Ack.
    #fbAlarmManager(NewError         := #newErrorFlag,
                    NewErrorCode     := #newErrorCode,
                    AcknowledgeError := #ackEdge OR #fbInputs.Cmd_Reset,
                    ActiveProgram    := #activeProgram,
                    ActiveLine       := #fbRecipeHandler.CurrentLine);  // ITEM-26
    #newErrorFlag := FALSE;
    
    // Debug helpers: copy alarm/diagnostic info into DB_Diagnostic for easy tracing
    // This ensures a snapshot of the latest active error code is always visible for debugging.
    "DB_Diagnostic".Error_ProcessState := #State;
    "DB_Diagnostic".Error_Code := #fbAlarmManager.ActiveErrorCode;
    // If recipe reported a line error, keep that; otherwise -1
    IF "DB_Diagnostic".Error_Line < 0 THEN
        "DB_Diagnostic".Error_Line := -1;
    END_IF;

    // Copy alarm outputs to HMI (now reads CURRENT scan values)
    "DB_HMI".ErrorID       := #fbAlarmManager.ActiveErrorCode;
    "DB_HMI".ErrorText     := #fbAlarmManager.ActiveErrorText;
    "DB_HMI".ErrorText_ES  := #fbAlarmManager.ActiveErrorText_ES;
    // ITEM-08: If no active alarm text but a safety condition is blocking, show it.
    // This covers the case where the operator is in STOPPED state with door open / E-Stop active
    // after a previous error was acknowledged — AlarmManager cleared its text but the safety
    // condition is still live and writing to DB_Diagnostic.Error_Text.
    // Use compact customer-facing text here; DB_Diagnostic keeps the developer detail.
    // ITEM-16: ErrorDetail is also written here so the operator does not need DB_Diagnostic.
    IF "DB_HMI".ErrorText = '' AND NOT #fbSafetyMonitor.SafeToRun THEN
        CASE #fbSafetyMonitor.ErrorCode OF
            16#0401: "DB_HMI".ErrorText      := 'EMERGENCY STOP active';
                     "DB_HMI".ErrorText_ES   := 'PARO DE EMERGENCIA activo';
                     "DB_HMI".ErrorDetail    := 'Check E-Stop pushbutton and wiring';
                     "DB_HMI".ErrorDetail_ES := 'Revisar boton de emergencia y cableado';
            16#0402: "DB_HMI".ErrorText      := 'Safety door open';
                     "DB_HMI".ErrorText_ES   := 'Puerta de seguridad abierta';
                     "DB_HMI".ErrorDetail    := 'Close the safety door to continue';
                     "DB_HMI".ErrorDetail_ES := 'Cerrar la puerta de seguridad para continuar';
            16#0403: "DB_HMI".ErrorText      := 'Drives not ready';
                     "DB_HMI".ErrorText_ES   := 'Variadores no listos';
                     "DB_HMI".ErrorDetail    := 'Check contactor, enable wiring and drive status';
                     "DB_HMI".ErrorDetail_ES := 'Revisar contactor, cableado de habilitacion y estado del variador';
            16#0404: "DB_HMI".ErrorText      := 'Air pressure low';
                     "DB_HMI".ErrorText_ES   := 'Presion de aire baja';
                     "DB_HMI".ErrorDetail    := 'Check air compressor and pressure switch';
                     "DB_HMI".ErrorDetail_ES := 'Revisar compresor y sensor de presion de aire';
            ELSE:    "DB_HMI".ErrorText      := 'Safety interlock active';
                     "DB_HMI".ErrorText_ES   := 'Interlock de seguridad activo';
                     "DB_HMI".ErrorDetail    := '';
                     "DB_HMI".ErrorDetail_ES := '';
        END_CASE;
    END_IF;
    "DB_HMI".CurrentTool := #CurrentTool;
    
    // Reset TO errors (only on AckError or full reset)
    // BUG FIX: MC_Reset is triggered only by edge signals. Btn_AckError level signal
    // is not used -- when the button is held, Execute stays HIGH continuously, which
    // adversely affects TO error management (new errors may be masked).
    #fbResetX(Execute := #ackEdge OR #fbInputs.Cmd_Reset, Axis := #Axis_X);
    #fbResetZ(Execute := #ackEdge OR #fbInputs.Cmd_Reset, Axis := #Axis_Z);
    #fbResetTool(Execute := #ackEdge OR #fbInputs.Cmd_Reset, Axis := #Axis_Tool);
    #fbResetSpindle(Execute := #ackEdge OR #fbInputs.Cmd_Reset, Axis := #Axis_Spindle);

    // =========================================================================
    // HARD RESET
    // =========================================================================
    // Single place that defines what a full reset clears.
    // Triggered from exactly two places:
    //   1. bInitDone block (first PLC scan after power-up / warm restart)
    //   2. Cmd_Reset handler (operator presses Reset button)
    // Motion-FB execute flags (bHomeXExec, bStopMoveX, etc.) are cleared by the
    // STATE_STOPPED CASE block which runs on this same scan right after this block.
    IF #bDoHardReset THEN
        // Reference validity -- evaluated FIRST, while #State still holds the state the
        // operator pressed Reset in (the assignment below overwrites it).
        //
        // This used to be an unconditional #bRequireHoming := TRUE at the bottom of the block,
        // which made every Reset cost a full homing cycle on the next auto start. Operators
        // press Reset out of habit, often several times, from an idle machine — where nothing
        // has happened that could invalidate the reference. Now only a reset pressed from a
        // state where an axis could have been moving arms the latch, because #bHaltAllAxes
        // above aborts whatever was in progress.
        //
        // WHITELIST, not blacklist: anything not listed counts as "could have been moving", so
        // a state added later fails safe. The three listed states are motionless by definition:
        //   STOPPED (0)  — idle
        //   MANUAL  (5)  — jogging is tracked by the TO, and STATE_STARTING already handles
        //                  "trusted but parked elsewhere" with a park move. An MC_Home aborted
        //                  mid-seek in manual clears StatusBits.HomingDone by itself, and
        //                  bRefTrusted checks that separately
        //   COMPLETE(100)— program finished, axes parked
        // This NEVER clears the latch — only ever sets it — so a homing requirement raised
        // earlier by an E-Stop, a fault or loss of drive power survives any number of resets.
        IF NOT (#State = STATE_STOPPED OR #State = STATE_MANUAL OR #State = 100) THEN
            #bRequireHoming := TRUE;
        END_IF;
        #bHaltAllAxes    := TRUE;   // ITEM-31: abort any in-progress MC_Home before clearing state
        #State           := STATE_STOPPED;
        #Error           := FALSE;
        #bPauseActive    := FALSE;
        #bResumeSpeedup  := FALSE;   // Cancel any pending pause spin-up wait
        #savedLineIndex  := -1;
        #savedProgram    := -1;
        "DB_HMI".ResumeLine := -1;
        #prevSafetyError := FALSE;
        #bResetRecipe                := TRUE;
        #bRecipeLoadExec             := FALSE;  // drop READ_DBL REQ. fbRecipeLoader.Reset is driven
                                                // by bResetRecipe (set TRUE just above) at its call
                                                // site -- NOT by bDoHardReset, which is cleared at
                                                // the end of this block and would never be seen
                                                // there. That Reset also clears LoadedProgram ->
                                                // forces a fresh copy before the next cycle
        #bSheetWaitPhase2            := FALSE;
        #bSheetWaitPhase3            := FALSE;
        IF NOT "DB_MachineConfig".Bypass_MandrelLock THEN
            #bMandrelRetractPending  := TRUE;   // ITEM-32: deferred — machine may have been RUNNING; wait SpindleStopSafeTime
        END_IF;
        #bSheetHolderRetractHold     := TRUE;   // Release sheet holder regardless of which state was active.
                                                // TRUE (not FALSE) is the safe hard-reset default: this latch
                                                // commands the retract, and the blocked centre will otherwise
                                                // hold the piston wherever the fault left it.
                                                // tonSheetHolderHold needs no explicit reset: its IN is this
                                                // latch, so setting it TRUE here restarts the window cleanly.
        // BackSupport end-of-recipe retract (ITEM-41): deliberately NOT reset here, and the edge
        // memory is deliberately NOT seeded here. Same class of exception as
        // #bMandrelRetractPending above -- an in-flight safety motion outlives the reset.
        //
        // Seeding bBSTerminalPrev := TRUE in this block would suppress the retract exactly when
        // it is most needed: a Reset pressed while RUNNING sets State := STOPPED three lines
        // above, so a seeded edge memory sees terminal->terminal, no rising edge fires, and the
        // BackSupport is left frozen wherever the recipe put it. Power-up needs the seed and
        // gets it in the bInitDone first-scan block instead -- that is the only case where
        // State is already STOPPED before this block runs.
        //
        // Clearing bBSEndRetract here would abandon a retract mid-stroke (Reset pressed inside
        // the 2 s window). Letting it run costs nothing: the block at the bottom of this FB
        // drops every coil when its timer expires, and Cmd_Extend is already FALSE by then.
        //
        // Cmd_Retract still has to be dropped if NO window is running -- otherwise a CMD=41 P2
        // latch survives the reset and holds the cylinder retracting.
        IF NOT #bBSEndRetract THEN
            "DB_Cylinder_BackSupport".Cmd_Retract := FALSE;
        END_IF;
        #bWaitingSpindleStop         := FALSE;  // Cancel any pending spindle-stop wait
        #capturedSpindleRPM          := 0.0;
        #spindleStopPT               := T#0MS;
        #bCycleCountDone             := FALSE;  // Allow CycleCount to increment on next completion
        #prevMDIExec                 := FALSE;  // Clear stale MDI edge (button may be held at reset)
        #bMDI_Cmd40Extend            := FALSE;  // Release MDI CMD=40 BackSupport extend latch
        // CMD=41 edge memory: SEED with the live button state, do not clear. Clearing
        // would let a button still held/latched at reset fire a one-shot immediately.
        #prevBtnCmd41Release         := "DB_Manual".Btn_Cmd41_Release;
        #prevBtnCmd41AtmoOff         := "DB_Manual".Btn_Cmd41_AtmoOff;
        #prevBtnCmd41AtmoOn          := "DB_Manual".Btn_Cmd41_AtmoOn;
        // Reference validity is decided at the TOP of this block (it needs the pre-reset
        // #State). Do not re-add an unconditional #bRequireHoming := TRUE here.
        #bDoHardReset                := FALSE;
    END_IF;

    // =========================================================================
    // SHEET-LOAD PARK TARGET -- soft-limit clamped, single source of truth
    // =========================================================================
    // SheetLoadPos_X/Z are commissioning values typed on the HMI, so clamp them to the
    // configured soft limits before they can reach an MC_MoveAbsolute -- a mistyped value
    // must not be able to drive an axis into a limit.
    //
    // Computed BEFORE the state machine so the "am I already parked?" comparison in
    // STATE_STARTING and the move target it hands to STATE_POST_HOME_CLR / STATE_STOPPING
    // are the same number in the same scan. Comparing against the raw config value while
    // moving to the clamped one would make an out-of-range SheetLoadPos re-issue a
    // pointless park move on every cycle.
    // =========================================================================
    #parkTargetX := MIN(IN1 := MAX(IN1 := "DB_MachineConfig".SheetLoadPos_X,
                                   IN2 := "DB_MachineConfig".SoftLimit_MinX),
                        IN2 := "DB_MachineConfig".SoftLimit_MaxX);
    #parkTargetZ := MIN(IN1 := MAX(IN1 := "DB_MachineConfig".SheetLoadPos_Z,
                                   IN2 := "DB_MachineConfig".SoftLimit_MinZ),
                        IN2 := "DB_MachineConfig".SoftLimit_MaxZ);

    // =========================================================================
    // MAIN STATE MACHINE
    // =========================================================================
    CASE #State OF

        // -----------------------------------------------------------------
        // === STATE_STOPPED (0) ===
        // -----------------------------------------------------------------
        0: // STOPPED
            #StatusID := 0; #bStartSeq := FALSE; #bPreScanExec := FALSE;
            #bRecipeLoadExec := FALSE;   // no recipe copy may stay in flight while idle
            // ITEM-34 FIX: clear only when no safety condition is blocking a start.
            // The ITEM-08 fallback (runs BEFORE this CASE) writes the door-open /
            // E-Stop / air-pressure hint into ErrorText when SafeToRun is FALSE;
            // clearing unconditionally here erased that hint every scan, so the
            // operator saw a machine that refused to start with no explanation.
            IF #fbSafetyMonitor.SafeToRun THEN
                "DB_HMI".ErrorText      := '';
                "DB_HMI".ErrorText_ES   := '';
                "DB_HMI".ErrorDetail    := '';
                "DB_HMI".ErrorDetail_ES := '';
            END_IF;
            // Clear ALL motion-FB execute flags every scan while stopped.
            // Every path that reaches STATE_STOPPED (Cmd_Reset, Ack, Continue,
            // Restart, normal stop sequence) therefore clears these automatically.
            // Without this, a flag stuck TRUE (e.g. bHomeXExec after a homing error)
            // keeps its MC_ FB running → error re-triggers immediately after reset.
            #bHomeXExec    := FALSE; #bHomeZExec    := FALSE; #bHomeToolExec := FALSE;
            #homeSeqState  := 0;
            #bToolExecute  := FALSE;
            #bStopMoveX    := FALSE; #bStopMoveZ    := FALSE;
            #bHomeClrX     := FALSE; #bHomeClrZ     := FALSE;
            #bLockAfterHoming := FALSE;
            // Spindle
            #bSpindleStart       := FALSE;
            #bSpindleStop        := FALSE;
            #bSpindleDecelWait   := FALSE;
            #bSpindlePendingStart := FALSE;
            #bResumeSpeedup      := FALSE;  // Cancel any pending pause spin-up wait
            // MandrelLock: clear Cmd_Extend (spring retracts on EStop/power-loss).
            // Cmd_Retract is pulsed by bMandrelRetractPulse (set in STATE_STOPPING only — safe path) to
            // force FB out of State 3 — Mode=0 does not auto-retract on Cmd_Extend=FALSE alone.
            // All other paths (Reset/Error/Complete) use bMandrelRetractPending + tonMandrelRetractWait (ITEM-32).
            "DB_Cylinder_MandrelLock".Cmd_Extend  := FALSE;
            // SheetHolder Cmd_Extend is NOT written here any more: it has a single writer at the
            // bottom of this FB (State = SHEET_WAIT AND NOT Ph3), which drives it FALSE in every
            // other state including this one. Writing it here as well was harmless; writing it
            // NOWHERE on the stop path was the bug -- see the single-writer block for detail.
            // BackSupport: de-energise the atmosphere valve at rest.
            "DB_Cylinder_BackSupport".SolAtmo_Cmd := FALSE;
            // BackSupport extend: clear here too. Previously cleared only by
            // FB_RecipeHandler (RESET / STOP handlers), which left no clear path for
            // the manual CMD=40 button -- it would stay asserted after leaving manual.
            "DB_Cylinder_BackSupport".Cmd_Extend  := FALSE;
            // BackSupport retract: latched by CMD=41 P2 and by the end-of-recipe retract, so it
            // must be dropped while idle -- but ONLY once the end-retract window has finished.
            // Entering STOPPED is exactly what starts that window (bBSEndRetract, block at the
            // bottom of this FB), and this CASE runs every scan, so an unconditional clear here
            // cancelled the retract on the scan it was requested. Gate it on the latch.
            // The end-retract block itself drops Cmd_Retract when its timer expires.
            IF NOT #bBSEndRetract THEN
                "DB_Cylinder_BackSupport".Cmd_Retract := FALSE;
            END_IF;
            // bBSEndRetract / tonBSEndRetract / bBSTerminalPrev are NOT reset here -- see the
            // hard-reset block. Resetting them every idle scan is what kept the end-of-recipe
            // retract from ever firing on a normal stop.
            #bMDI_Cmd40Extend                     := FALSE;  // Drop MDI CMD=40 latch while idle
            // CMD=41 edge memory: track the live button state every scan while idle.
            // STATE_MANUAL is entered only from here (see below), so a button left
            // latched cannot fire a one-shot on the first scan of manual mode.
            #prevBtnCmd41Release := "DB_Manual".Btn_Cmd41_Release;
            #prevBtnCmd41AtmoOff := "DB_Manual".Btn_Cmd41_AtmoOff;
            #prevBtnCmd41AtmoOn  := "DB_Manual".Btn_Cmd41_AtmoOn;

            IF "DB_Manual".ManualModeActive AND #fbSafetyMonitor.SafeToJog THEN
                #State := STATE_MANUAL;
            ELSIF #fbInputs.Cmd_Start AND #SafeToRun AND NOT "DB_HMI".Bypass_EStop THEN
                // Start pre-scan before running.
                // Always reset fbRecipeHandler here: after any stop or error the handler
                // ends up in STATE_DONE (Done=TRUE). Without this reset, the first scan
                // of RUNNING sees Done=TRUE and immediately reports "recipe complete".
                // (STATE_COMPLETE already does this correctly before its own PRE_SCAN.)
                #bResetRecipe := TRUE;
                #State := STATE_RECIPE_LOAD;   // load recipe out of load memory, then PRE_SCAN
            END_IF;
        
        // -----------------------------------------------------------------
        // === STATE_MANUAL (5) ===
        // -----------------------------------------------------------------
        5: // MANUAL
            #StatusID := 50;

            // -----------------------------------------------------------------
            // Manual CMD=40 / CMD=41 equivalents (HMI manual page)
            // Each button writes exactly what the matching recipe line writes,
            // so manual and automatic behave identically.
            // Written only here (STATE_MANUAL); STATE_STOPPED and STATE_ERROR
            // drive all three flags FALSE every scan, so nothing can persist
            // after manual mode is left.
            // -----------------------------------------------------------------
            // CMD=40 -- BackSupport extend. Level command: held while the button
            // is held. Releasing mid-stroke returns the FB to idle (blocked
            // centre, cylinder holds position).
            // bMDI_Cmd40Extend is the MDI equivalent: the MDI block below cannot
            // write Cmd_Extend directly, because this line re-evaluates it every
            // scan and would wipe the MDI value one scan later (the cylinder FB
            // then saw a 1-scan pulse and the valve never moved). The MDI sets the
            // latch instead; Param=0 clears it.
            //
            // MDI CMD=40 auto-release -- mirrors FB_RecipeHandler STATE_CYL_GOTO(70) /
            // STATE_CYL_GOTO_WAIT(71): hold Cmd_Extend every scan, then drop it the scan
            // AtSetpoint reports done, or on a cylinder Error. Runs before the assignment
            // below so the release takes effect in the same scan, exactly as state 71 does.
            //
            // Dropping Cmd_Extend does NOT release the cylinder: FB State 3 with
            // PositioningMode=0 holds Sol_A energised (09:833-835) and is left only by
            // Cmd_Retract / Cmd_RetractFull / Cmd_ExtendFull. That is intentional and is
            // the operator's spec -- Sol_A stays ON from CMD=40 through CMD=41 P1, and is
            // released by P2 (Cmd_Retract -> State 2). See the DB_Cylinder_BackSupport
            // header in 02_DataBlocks.scl for the full coil table.
            IF #bMDI_Cmd40Extend THEN
                IF "DB_Cylinder_BackSupport".AtSetpoint THEN
                    #bMDI_Cmd40Extend             := FALSE;
                    "DB_Manual".MDI_Status        := 1;
                    "DB_Manual".MDI_StatusText    := 'CMD40 done';
                    "DB_Manual".MDI_StatusText_ES := 'CMD40 completado';
                ELSIF "DB_Cylinder_BackSupport".Error THEN
                    #bMDI_Cmd40Extend             := FALSE;
                    "DB_Manual".MDI_Status        := 4;
                    "DB_Manual".MDI_StatusText    := 'CMD40 cylinder error';
                    "DB_Manual".MDI_StatusText_ES := 'CMD40 error cilindro';
                END_IF;
            END_IF;

            "DB_Cylinder_BackSupport".Cmd_Extend := "DB_Manual".Btn_Cmd40_Extend
                                                    OR #bMDI_Cmd40Extend;

            // CMD=41 -- atmosphere overrides. ONE-SHOT (rising edge), exactly like
            // the recipe: FB_RecipeHandler STATE_READ writes these flags on the
            // single scan the line is read and never re-asserts them.
            //
            // Why edge and not level (2026-08-01): these were previously evaluated
            // every scan from latching HMI buttons. A latched button therefore
            // re-wrote its own value continuously and overwrote any later MDI
            // CMD=41 one scan after it was issued -- the operator saw a ~20 ms
            // click on the valve, no state change, and MDI_Status = 'Executed'.
            // With edge detection the button and the MDI write identically: once,
            // per press. AtmoOn -> AtmoOff -> AtmoOn now reproduces P1 -> P2 -> P1,
            // which a latched state cannot express.
            //
            // HMI REQUIREMENT: these three buttons must be MOMENTARY (SetBit on
            // press / ResetBit on release). A latching button fires once per latch
            // cycle and must be un-latched before it can be used again.
            //
            // The safest-first ELSIF order is kept: on a simultaneous press only
            // the safest branch runs, and the other button's edge is consumed by
            // the prev* update below rather than firing on the following scan.
            // Note this no longer forces Sol_B off for as long as Release is held
            // -- with one-shot writes each press acts exactly once.
            IF "DB_Manual".Btn_Cmd41_Release AND NOT #prevBtnCmd41Release THEN      // = CMD=41 Param=3
                "DB_Cylinder_BackSupport".SolAtmo_Cmd := FALSE;
                "DB_Cylinder_BackSupport".Cmd_Retract := FALSE;  // State 2 -> 0: all coils off
            ELSIF "DB_Manual".Btn_Cmd41_AtmoOff AND NOT #prevBtnCmd41AtmoOff THEN   // = CMD=41 Param=2
                "DB_Cylinder_BackSupport".SolAtmo_Cmd := FALSE;
                "DB_Cylinder_BackSupport".Cmd_Retract := TRUE;   // State 3 -> 2: Sol_A off, Sol_B on
            ELSIF "DB_Manual".Btn_Cmd41_AtmoOn AND NOT #prevBtnCmd41AtmoOn THEN     // = CMD=41 Param=1
                "DB_Cylinder_BackSupport".SolAtmo_Cmd := TRUE;   // Sol_A deliberately stays ON
            END_IF;

            // -----------------------------------------------------------------
            // MANUAL MDI -- execute a typed CMD number + Param, once per press.
            //
            // Generic entry point for auxiliary recipe commands. To support a new
            // CMD later, add a branch to the CASE below -- no new DB field and no
            // HMI screen change required.
            //
            // Only auxiliary (non-motion) commands are accepted. Motion commands
            // (CMD=0 / CMD=1) are deliberately rejected: they need feedrate
            // handling and the full soft-limit/motion path. Use Btn_MoveAbsolute
            // for manual positioning instead.
            // -----------------------------------------------------------------
            IF "DB_Manual".Btn_MDI_Execute AND NOT #prevMDIExec THEN
                "DB_Manual".MDI_Status        := 1;              // assume accepted
                "DB_Manual".MDI_StatusText    := 'Executed';
                "DB_Manual".MDI_StatusText_ES := 'Ejecutado';
                CASE "DB_Manual".MDI_Cmd OF
                    40: // BackSupport extend -- same sequence as the recipe: assert
                        // Cmd_Extend, hold it, auto-release at AtSetpoint (handled by
                        // the sequencer above).
                        //   Param=1 -> start the extend
                        //   Param=0 -> abort/release early (MDI-only; the recipe ignores
                        //              Param and relies on AtSetpoint alone)
                        IF "DB_Manual".MDI_Param = 1 THEN
                            #bMDI_Cmd40Extend := TRUE;
                        ELSIF "DB_Manual".MDI_Param = 0 THEN
                            #bMDI_Cmd40Extend := FALSE;
                        ELSE
                            "DB_Manual".MDI_Status        := 3;
                            "DB_Manual".MDI_StatusText    := 'CMD40: use Param 0 or 1';
                            "DB_Manual".MDI_StatusText_ES := 'CMD40: use Param 0 o 1';
                        END_IF;

                    41: // BackSupport atmosphere / retract -- identical to the recipe CMD=41
                        IF "DB_Manual".MDI_Param = 1 THEN
                            "DB_Cylinder_BackSupport".SolAtmo_Cmd := TRUE;   // Sol_A stays ON
                        ELSIF "DB_Manual".MDI_Param = 2 THEN
                            "DB_Cylinder_BackSupport".SolAtmo_Cmd := FALSE;
                            "DB_Cylinder_BackSupport".Cmd_Retract := TRUE;   // State 3 -> 2
                        ELSIF "DB_Manual".MDI_Param = 3 THEN
                            "DB_Cylinder_BackSupport".SolAtmo_Cmd := FALSE;
                            "DB_Cylinder_BackSupport".Cmd_Retract := FALSE;  // State 2 -> 0
                        ELSE
                            "DB_Manual".MDI_Status        := 3;
                            "DB_Manual".MDI_StatusText    := 'CMD41: use Param 1,2,3';
                            "DB_Manual".MDI_StatusText_ES := 'CMD41: use Param 1,2,3';
                        END_IF;

                    ELSE: // Not an MDI-supported command -- nothing written
                        "DB_Manual".MDI_Status        := 2;
                        "DB_Manual".MDI_StatusText    := 'Unknown/blocked CMD';
                        "DB_Manual".MDI_StatusText_ES := 'CMD desconocido/no permitido';
                END_CASE;
            END_IF;
            #prevMDIExec := "DB_Manual".Btn_MDI_Execute;
            // CMD=41 button edge memory -- updated after BOTH the button block and
            // the MDI block, so one press is consumed exactly once and the MDI
            // write made this scan survives into the next one.
            #prevBtnCmd41Release := "DB_Manual".Btn_Cmd41_Release;
            #prevBtnCmd41AtmoOff := "DB_Manual".Btn_Cmd41_AtmoOff;
            #prevBtnCmd41AtmoOn  := "DB_Manual".Btn_Cmd41_AtmoOn;

            IF NOT "DB_Manual".ManualModeActive THEN
                // Contactor / enable flags are NOT cleared here any more (2026-08-09).
                //
                // They used to be, "so stale HMI button states cannot activate outputs in
                // STATE_STOPPED" — which only made sense while FC_ContactorControl blocked every
                // output in STOPPED anyway (modePermit, retired with ITEM-49). With that gone,
                // clearing them here physically de-energised the drives on every exit from manual
                // mode, so the axes lost holding torque and their reference every time the
                // operator looked at the manual page. That is one of the "sometimes it homes"
                // paths, and it defeats fast cycle mode after any manual visit.
                //
                // Leaving them as the operator set them is the point: the drives stay powered if
                // they were powered, and if the operator deliberately switched drive power OFF to
                // move an axis by hand, the flags stay FALSE and the reference-validity latch at
                // the bottom of this FB sees it and demands a homing cycle. Either way the
                // behaviour is deterministic. STATE_STARTING forces all of them TRUE on the next
                // auto start regardless.
                //
                // Safety is unchanged: E-Stop (drivePermit in FC_ContactorControl) still drops
                // every contactor and enable output, and nothing here can command motion.
                // Clear MDI result so a stale message does not greet the operator
                // the next time the manual page is opened.
                "DB_Manual".MDI_Status         := 0;
                "DB_Manual".MDI_StatusText     := '';
                "DB_Manual".MDI_StatusText_ES  := '';
                #prevMDIExec                   := FALSE;
                #bMDI_Cmd40Extend              := FALSE;  // Do not carry the extend latch out of manual
                // CMD=41 edge memory: seed (not clear) so a button still latched on
                // the way out cannot fire when manual mode is next entered.
                #prevBtnCmd41Release           := "DB_Manual".Btn_Cmd41_Release;
                #prevBtnCmd41AtmoOff           := "DB_Manual".Btn_Cmd41_AtmoOff;
                #prevBtnCmd41AtmoOn            := "DB_Manual".Btn_Cmd41_AtmoOn;
                #State := 0;
            ELSIF #fbInputs.Cmd_Start AND #SafeToRun AND NOT "DB_HMI".Bypass_EStop THEN
                // Bypass_EStop blocks transition to auto: must be cleared before running
                "DB_Manual".ManualModeActive := FALSE;
                #bResetRecipe := TRUE;  // Same as STATE_STOPPED Cmd_Start handler (see comment there)
                #State := STATE_RECIPE_LOAD;   // load recipe out of load memory, then PRE_SCAN
            END_IF;
        
        // -----------------------------------------------------------------
        // === STATE_RECIPE_LOAD (11) ===
        // -----------------------------------------------------------------
        // Copy the selected recipe out of LOAD memory into DB_SelectedRecipe
        // before anything reads it. Entered from every path that used to go
        // straight to PRE_SCAN: STOPPED Start, MANUAL Start, COMPLETE
        // restart/Start, COMPLETE Reset.
        //
        // Why this must run EVERY cycle start and not be skipped when the same
        // program is selected again: a recipe re-downloaded from CAM changes the
        // load-memory contents while DB_SelectedRecipe still holds the old data.
        // Skipping the copy would machine the previous geometry with no warning.
        // The copy costs a fraction of a second, once, with the machine standing
        // still -- do not "optimise" it away.
        //
        // The machine is stationary here (same as PRE_SCAN: contactors open,
        // drives not yet enabled), so a few extra scans cost nothing.
        // -----------------------------------------------------------------
        11: // RECIPE LOAD - copy selected recipe from load memory
            #StatusID := 11;
            #bRecipeLoadExec := TRUE;   // level; FB takes the rising edge

            IF #fbRecipeLoader.Error THEN
                // READ_DBL refused the transfer, or it never completed.
                #bRecipeLoadExec := FALSE;
                #newErrorFlag := TRUE;
                #newErrorCode := 16#0312;   // Recipe load from load memory failed
                // Same pattern as the 16#0310 / 16#0311 sites next door: context goes
                // to DB_Diagnostic.Error_Text, never to DB_HMI.ErrorText (single-writer
                // rule). 16#FFFF here means the watchdog fired, not a READ_DBL code.
                // ErrorPhase (1 = Header, 2 = Lines) says WHICH of the two
                // transfers failed -- the 2026-08-06 field fault was a silent
                // Lines failure, so this must stay visible.
                "DB_Diagnostic".Error_Text := CONCAT(
                    IN1 := CONCAT(IN1 := 'Recipe load failed, phase ',
                                  IN2 := INT_TO_STRING(#fbRecipeLoader.ErrorPhase)),
                    IN2 := CONCAT(IN1 := ' (1=Header 2=Lines), RET_VAL=',
                                  IN2 := INT_TO_STRING(WORD_TO_INT(#fbRecipeLoader.ErrorCode))));
                #State := STATE_ERROR;

            ELSIF #fbRecipeLoader.Done THEN
                #bRecipeLoadExec := FALSE;
                "DB_Diagnostic".Recipe_LoadedProgram := #fbRecipeLoader.LoadedProgram;
                #State := STATE_PRE_SCAN;
            END_IF;

        // -----------------------------------------------------------------
        // === STATE_PRE_SCAN (12) ===
        // -----------------------------------------------------------------
        12: // PRE-SCAN - Validate recipe before running
            #StatusID := 12;
            #bPreScanExec := TRUE;
            // Redundant since 2026-07-31 (the flag is now self-cleared after the
            // fbRecipeHandler call each scan); kept as a belt-and-braces clear.
            #bResetRecipe := FALSE;
            
            // Line count + tool table read from the recipe buffer's Header
            // (both written by the CAM post-processor -- see CAM_TOOL_TABLE_HANDOVER.md).
            // 2026-08-04: was a five-way CASE over DB_RecipeProgram1..5. Those now
            // live in load memory and cannot be read directly; STATE_RECIPE_LOAD(11)
            // has already copied the selected one into DB_SelectedRecipe.
            #activeLineCount    := "DB_SelectedRecipe".Header.LineCount;
            #hdrProvidesToolCfg := "DB_SelectedRecipe".Header.ProvidesToolConfig;
            #hdrToolCount       := "DB_SelectedRecipe".Header.ToolCount;
            #hdrAutoCalc        := "DB_SelectedRecipe".Header.AutoCalcAngles;
            #hdrToolCodes       := "DB_SelectedRecipe".Header.ToolCode_List;
            #hdrToolAngles      := "DB_SelectedRecipe".Header.ToolAngle_List;

            // Validate: 0 = recipe not loaded (Header not written yet).
            // Upper bound is now the ACTUAL array size -- this used to accept up to
            // 999 against an Array[0..349], so a header claiming 400+ lines read past
            // the end of the array. Closed by construction: the guard and the array
            // are both 1000 now. Keep them in step if the array size ever changes.
            IF #activeLineCount <= 0 OR #activeLineCount > 1000 THEN
                #newErrorFlag := TRUE;     // BUG FIX: was missing -- alarm manager never latched 16#0310,
                                           // so HMI showed ERROR state with empty text and no history entry
                #newErrorCode := 16#0310;  // Recipe: invalid line count (not loaded?)
                #bPreScanExec := FALSE;    // Do not start a scan on garbage LineCount
                "DB_Diagnostic".Error_Text := 'Recipe not loaded: Header.LineCount invalid';
                // Single-writer: HMI text comes from FB_AlarmManager (CASE 16#0310)
                #State := STATE_ERROR;

            // END-MARKER GUARD (2026-08-06, added after the field fault where the
            // Lines array arrived all zero while the Header was plausible). The
            // recipe format REQUIRES the last line to be CMD=99 (PROGRAM_END --
            // PLC_Recipe_Format_Spec.md, CMD table + template line N-1), and the
            // CAM post-processor always emits it. A buffer whose header claims N
            // lines but whose line N-1 is not 99 is empty or corrupt -- catching
            // it here stops the machine from "running" a program of zero-moves.
            ELSIF "DB_SelectedRecipe".Lines[#activeLineCount - 1].CMD <> 99 THEN
                #newErrorFlag := TRUE;
                #newErrorCode := 16#0313;  // Recipe buffer corrupt: no END marker
                #bPreScanExec := FALSE;
                "DB_Diagnostic".Error_Text := CONCAT(
                    IN1 := 'Recipe buffer corrupt: Lines empty or truncated, last CMD=',
                    IN2 := INT_TO_STRING(BYTE_TO_INT(
                        "DB_SelectedRecipe".Lines[#activeLineCount - 1].CMD)));
                // Single-writer: HMI text comes from FB_AlarmManager (CASE 16#0313)
                #State := STATE_ERROR;
            END_IF;

            // Apply the CAM-authored tool table BEFORE the pre-scan validates tool codes.
            // "Recipe always wins": every recipe must carry its own tool table, else it is
            // rejected here (16#0311). Skipped if the LineCount check already bailed
            // (#bPreScanExec cleared) so we do not overwrite the 16#0310 error.
            IF #bPreScanExec THEN
                IF NOT #hdrProvidesToolCfg THEN
                    #newErrorFlag := TRUE;
                    #newErrorCode := 16#0311;  // Recipe has no tool table (ProvidesToolConfig=FALSE)
                    #bPreScanExec := FALSE;
                    "DB_Diagnostic".Error_Text := 'Recipe missing tool table (ProvidesToolConfig=FALSE)';
                    // Single-writer: HMI text comes from FB_AlarmManager (CASE 16#0311)
                    #State := STATE_ERROR;
                ELSE
                    // Defensive clamp: ToolCode_List / ToolAngle_List are Array[1..4].
                    // A ToolCount > 4 would index out of bounds in the recipe lookup
                    // loops (05_RecipeHandler) -> CPU STOP. Clamp to 1..4 here.
                    IF #hdrToolCount < 1 THEN #hdrToolCount := 1; END_IF;
                    IF #hdrToolCount > 4 THEN #hdrToolCount := 4; END_IF;
                    "DB_MachineConfig".ToolCount   := #hdrToolCount;
                    "DB_ToolConfig".AutoCalcAngles := #hdrAutoCalc;
                    FOR #applyIndex := 1 TO 4 DO
                        "DB_ToolConfig".ToolCode_List[#applyIndex] := #hdrToolCodes[#applyIndex];
                        "DB_HMI".ToolSlotCode[#applyIndex]         := #hdrToolCodes[#applyIndex];  // HMI display mirror
                    END_FOR;
                    // When AutoCalcAngles=FALSE the recipe supplies explicit slot angles.
                    // When TRUE, FC_ToolAngleCalc recomputes them every scan from ToolCount.
                    IF NOT #hdrAutoCalc THEN
                        "DB_ToolConfig".Tool1_Position := #hdrToolAngles[1];
                        "DB_ToolConfig".Tool2_Position := #hdrToolAngles[2];
                        "DB_ToolConfig".Tool3_Position := #hdrToolAngles[3];
                        "DB_ToolConfig".Tool4_Position := #hdrToolAngles[4];
                    END_IF;
                END_IF;
            END_IF;

            // NOTE: fbPreScan is called unconditionally at the bottom of this FB
            // (next to fbRecipeHandler), NOT here. BUG FIX: when it was called only
            // inside this CASE branch, Execute never went FALSE between runs, so the
            // FB stayed latched in its DONE state and every start after the first
            // returned the PREVIOUS run's Valid/bounding-box instantly -- recipe
            // validation was silently skipped from the second cycle onward.

            // Update progress every scan during pre-scan (HMI bar)
            "DB_HMI".PreScanProgress := #fbPreScan.Progress;

            IF #fbPreScan.Done THEN
                #bPreScanExec := FALSE;

                // Update HMI with bounding box
                "DB_HMI".BoundingBox_MinX := #fbPreScan.MinX;
                "DB_HMI".BoundingBox_MaxX := #fbPreScan.MaxX;
                "DB_HMI".BoundingBox_MinZ := #fbPreScan.MinZ;
                "DB_HMI".BoundingBox_MaxZ := #fbPreScan.MaxZ;
                "DB_HMI".BoundingBox_Valid := #fbPreScan.Valid;
                
                // Update diagnostic
                "DB_Diagnostic".PreScan_Complete := TRUE;
                "DB_Diagnostic".PreScan_Valid := #fbPreScan.Valid;
                "DB_Diagnostic".PreScan_ErrorLine := #fbPreScan.ErrorLine;
                
                IF #fbPreScan.Valid THEN
                    #State := STATE_STARTING;
                ELSE
                    // Pre-scan failed - limits exceeded.
                    // Single-writer: report via queue so the failing line number reaches the
                    // displayed text (queue path shows Details as the EN ErrorText; ES comes
                    // from the FB_AlarmManager CASE table for 16#0305).
                    "FC_ReportError"(Code := 16#0305,
                                     Details := CONCAT(IN1 := 'PreScan Ln', IN2 := CONCAT(
                                                IN1 := INT_TO_STRING(#fbPreScan.ErrorLine), IN2 := CONCAT(
                                                IN1 := ': ', IN2 := #fbPreScan.ErrorDesc))),
                                     Source := 'Recipe');
                    "DB_HMI".ErrorDetail    := CONCAT(IN1 := 'Check line ', IN2 := INT_TO_STRING(#fbPreScan.ErrorLine));
                    "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'Revisar linea ', IN2 := INT_TO_STRING(#fbPreScan.ErrorLine));
                    "DB_Diagnostic".Error_Text := CONCAT(IN1 := 'PreScan failed Ln',
                                                  IN2 := CONCAT(IN1 := INT_TO_STRING(#fbPreScan.ErrorLine),
                                                  IN2 := CONCAT(IN1 := ': ', IN2 := #fbPreScan.ErrorDesc)));
                    #State := STATE_ERROR;
                END_IF;
            END_IF;
        
        // -----------------------------------------------------------------
        // === STATE_STARTING (10) ===
        // -----------------------------------------------------------------
        10: // STARTING
            #StatusID := 1;
            // Auto-enable drives for auto mode -- contactors and enable signals are set automatically.
            // In manual mode (STATE_MANUAL) they are under HMI control; PLC takes over when switching to auto.
            "DB_HMI".Btn_Contactor_X       := TRUE;
            "DB_HMI".Btn_Contactor_Z       := TRUE;
            "DB_HMI".Btn_Contactor_Tool    := NOT "DB_MachineConfig".Bypass_ToolAxis;
            "DB_HMI".Btn_Contactor_Spindle := NOT "DB_HMI".Bypass_Spindle;
            "DB_HMI".Btn_Enable_X          := TRUE;
            "DB_HMI".Btn_Enable_Z          := TRUE;
            // Wait for both drives to report ready before issuing any motion command.
            // Physical contactor close + drive boot can take up to several hundred ms.
            // tonDriveReady is called unconditionally near the timer section (auto-resets on exit).
            IF #fbPowerX.Status AND #fbPowerZ.Status THEN
                // Drives ready -- three-way decision: home, reposition, or load the sheet.
                //
                // The axis reference is TRUSTED only when every required axis reports
                // HomingDone AND nothing has invalidated it since the last completed
                // homing cycle (bRequireHoming: E-Stop, STATE_ERROR, hard reset, power-up).
                // StatusBits.HomingDone alone is not enough -- whether the TO clears it
                // when MC_Power drops is encoder-type dependent, and an open-loop axis can
                // lose steps during an E-Stop while still reporting HomingDone=TRUE.
                #bRefTrusted := #Axis_X.StatusBits.HomingDone
                                AND #Axis_Z.StatusBits.HomingDone
                                AND (#Axis_Tool.StatusBits.HomingDone
                                     OR "DB_MachineConfig".Bypass_ToolAxis)
                                AND NOT #bRequireHoming;

                IF NOT #bRefTrusted OR "DB_MachineConfig".AlwaysHomeOnAutoStart THEN
                    // (1) Reference suspect, or the operator forced homing on every cycle.
                    // Full reference seek. NEVER command an absolute move here -- the
                    // coordinate system cannot be trusted until MC_Home completes.
                    // If in PNP zone, clear it first (target = legacy PNP escape position).
                    #bHomeClrX := #HW_PNP_X_Min AND NOT #Axis_X.StatusBits.HomingDone;
                    #bHomeClrZ := #HW_PNP_Z_Min AND NOT #Axis_Z.StatusBits.HomingDone;
                    IF #bHomeClrX OR #bHomeClrZ THEN
                        #clrTargetX  := "DB_MachineConfig".HomeOffset_X + "DB_MachineConfig".PostHome_Clearance;
                        #clrTargetZ  := "DB_MachineConfig".HomeOffset_Z + "DB_MachineConfig".PostHome_Clearance;
                        #clrVelocity := "DB_MachineConfig".HomeVelocity;  // slow: escaping a PNP sensor un-homed
                        #State := STATE_PRE_HOME_CLR;
                    ELSE
                        #homeSeqState := 1;
                        #bHomeXExec := TRUE; #bHomeZExec := FALSE;
                        #State := STATE_HOMING;
                    END_IF;
                ELSIF ABS(#Axis_X.ActualPosition - #parkTargetX) > "DB_MachineConfig".SheetLoadTol
                   OR ABS(#Axis_Z.ActualPosition - #parkTargetZ) > "DB_MachineConfig".SheetLoadTol THEN
                    // (2) Reference trusted but the axes are parked somewhere else -- e.g.
                    // the operator jogged in MANUAL between parts, or the last run was
                    // aborted. Reposition to the sheet-load park instead of paying for a
                    // full homing cycle. Safe: the reference is valid, the move is a normal
                    // absolute move, and the target is clamped to the soft limits.
                    // STATE_POST_HOME_CLR already does "move X+Z to target, then SHEET_WAIT".
                    #bHomeClrX   := TRUE; #bHomeClrZ := TRUE;
                    #clrTargetX  := #parkTargetX;
                    #clrTargetZ  := #parkTargetZ;
                    #clrVelocity := "DB_MachineConfig".RapidVelocity;  // can be a long travel -- not the 5 mm/s clearance speed
                    #State       := STATE_POST_HOME_CLR;
                ELSE
                    // (3) Reference trusted AND already parked at the sheet-load position:
                    // no motion needed -- straight to sheet insertion. This is the fast
                    // path that removes the homing seek from every cycle after the first.
                    // NOTE: goes to SHEET_WAIT, never straight to LOCK_EXTEND_WAIT -- the
                    // operator must still load a sheet and the MandrelLock must still clamp
                    // (both were released at the end of the previous cycle).
                    #bSheetWaitPhase2 := FALSE;
                    #bSheetWaitPhase3 := FALSE;
                    #State := STATE_SHEET_WAIT;
                END_IF;
            ELSIF #tonDriveReady.Q THEN
                // Timeout: drives did not become ready within 3s
                #newErrorFlag := TRUE;
                #newErrorCode := 16#000C;
                "DB_HMI".ErrorDetail    := 'Contactor closed but drive not enabled - check wiring';
                "DB_HMI".ErrorDetail_ES := 'Contactor cerrado pero variador no habilitado - revisar cableado';
                #State := STATE_ERROR;
            END_IF;
        
        // -----------------------------------------------------------------
        // === STATE_HOMING (15) ===
        // -----------------------------------------------------------------
        15: // HOMING (sequential: X then Z in active homing mode 3)
            #StatusID := 2;
            // Ensure other stop/homing triggers are not interfering
            IF #homeSeqState = 1 THEN
                // Homing X
                #bHomeXExec := TRUE;
                #bHomeZExec := FALSE;
                IF #fbHomeX.Done THEN
                    #bHomeXExec := FALSE;
                    #homeSeqState := 2;    // proceed to homing Z
                    #bHomeZExec := TRUE;
                ELSIF #fbHomeX.Error THEN
                    #bHomeXExec := FALSE;
                    #bHomeZExec := FALSE;
                    #State := STATE_ERROR;
                    #newErrorFlag := TRUE;
                    #newErrorCode := 16#0003;
                    "DB_Diagnostic".HomeX_ErrorID := #fbHomeX.ErrorID;
                    "DB_Diagnostic".TO_ErrorText  := "FC_TO_ErrorText"(Code := #fbHomeX.ErrorID);
                    "DB_HMI".ErrorDetail    := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
                    "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
                END_IF;
            ELSIF #homeSeqState = 2 THEN
                // Homing Z
                #bHomeXExec := FALSE;
                #bHomeZExec := TRUE;
                IF #fbHomeZ.Done THEN
                    #bHomeZExec := FALSE;
                    IF NOT "DB_MachineConfig".Bypass_ToolAxis THEN
                        // Proceed to tool axis homing (step 3)
                        #homeSeqState := 3;
                        #bHomeToolExec := TRUE;
                    ELSE
                        // Tool axis bypassed -- go to post-homing park move.
                        // Target is the sheet-load park, not HomeOffset + PostHome_Clearance:
                        // the machine parks at ONE position for sheet loading on every path.
                        #homeSeqState := 0;
                        #bHomeClrX := TRUE; #bHomeClrZ := TRUE;
                        #clrTargetX  := #parkTargetX;
                        #clrTargetZ  := #parkTargetZ;
                        #clrVelocity := "DB_MachineConfig".RapidVelocity;
                        #CurrentTool := 1;  // Tool axis homed to slot 1 position
                        #bRequireHoming := FALSE;  // Reference re-established -- trust it again
                        #State := STATE_POST_HOME_CLR;
                    END_IF;
                ELSIF #fbHomeZ.Error THEN
                    #bHomeZExec := FALSE;
                    #State := STATE_ERROR;
                    #newErrorFlag := TRUE;
                    #newErrorCode := 16#0004;
                    "DB_Diagnostic".HomeZ_ErrorID := #fbHomeZ.ErrorID;
                    "DB_Diagnostic".TO_ErrorText  := "FC_TO_ErrorText"(Code := #fbHomeZ.ErrorID);
                    "DB_HMI".ErrorDetail    := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
                    "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
                END_IF;
            ELSIF #homeSeqState = 3 THEN
                // Homing Tool axis
                #bHomeToolExec := TRUE;
                IF #fbHomeTool.Done THEN
                    #bHomeToolExec := FALSE;
                    #homeSeqState := 0;
                    // Tool done -- proceed to the post-homing park move for X and Z.
                    // Target is the sheet-load park, not HomeOffset + PostHome_Clearance:
                    // the machine parks at ONE position for sheet loading on every path.
                    #bHomeClrX := TRUE; #bHomeClrZ := TRUE;
                    #clrTargetX  := #parkTargetX;
                    #clrTargetZ  := #parkTargetZ;
                    #clrVelocity := "DB_MachineConfig".RapidVelocity;
                    #CurrentTool := 1;  // Tool axis homed to slot 1 position
                    #bRequireHoming := FALSE;  // Reference re-established -- trust it again
                    #State := STATE_POST_HOME_CLR;
                ELSIF #fbHomeTool.Error THEN
                    #bHomeToolExec := FALSE;
                    #State := STATE_ERROR;
                    #newErrorFlag := TRUE;
                    #newErrorCode := 16#0007;
                    "DB_Diagnostic".HomeTool_ErrorID := #fbHomeTool.ErrorID;
                    "DB_Diagnostic".TO_ErrorText     := "FC_TO_ErrorText"(Code := #fbHomeTool.ErrorID);
                    "DB_HMI".ErrorDetail    := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
                    "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
                END_IF;
            ELSE
                // Fallback: if homeSeqState not set, go to STARTING check
                #homeSeqState := 0;
                #State := STATE_STARTING;
            END_IF;
            // Homing timeout: X+Z+Tool combined must complete within 120s
            IF #tonHomingTimeout.Q THEN
                #bHomeXExec := FALSE;
                #bHomeZExec := FALSE;
                #bHomeToolExec := FALSE;
                #homeSeqState := 0;
                #State := STATE_ERROR;
                #newErrorFlag := TRUE;
                #newErrorCode := 16#000B;
                "DB_HMI".ErrorDetail    := 'Homing did not complete - check reference switch/drive';
                "DB_HMI".ErrorDetail_ES := 'Referenciado no completado - revisar sensor/variador';
            END_IF;

        // -----------------------------------------------------------------
        // === STATE_PRE_HOME_CLR (13) ===
        // -----------------------------------------------------------------
        13: // PRE_HOME_CLR -- Clear PNP zone before homing
            #StatusID := 2;
            // Transition to homing as soon as clearance move finishes
            IF (NOT #bHomeClrX OR #fbMoveX_HomeClr.Done) AND (NOT #bHomeClrZ OR #fbMoveZ_HomeClr.Done) THEN
                #bHomeClrX := FALSE; #bHomeClrZ := FALSE;
                #homeSeqState := 1; #bHomeXExec := TRUE; #bHomeZExec := FALSE;
                #State := STATE_HOMING;
            ELSIF (#bHomeClrX AND #fbMoveX_HomeClr.Error) OR (#bHomeClrZ AND #fbMoveZ_HomeClr.Error) THEN
                #bHomeClrX := FALSE; #bHomeClrZ := FALSE;
                // Single-writer: queue path keeps the clearance-move context in the displayed text
                "FC_ReportError"(Code := 16#0001,
                                 Details := 'Pre-home clearance move failed - axis could not clear PNP zone',
                                 Source := 'Process');
                "DB_HMI".ErrorDetail    := 'Axis could not clear PNP zone before homing - check drive';
                "DB_HMI".ErrorDetail_ES := 'Eje no pudo liberar zona PNP antes del referenciado - revisar variador';
                #State := STATE_ERROR;
            END_IF;

        // -----------------------------------------------------------------
        // === STATE_POST_HOME_CLR (16) ===
        // Move X and Z to #clrTargetX/Z, then hand over to SHEET_WAIT.
        // Two entry paths, same behaviour -- both target the sheet-load park:
        //   • from STATE_HOMING       -- after a completed reference seek
        //   • from STATE_STARTING (2) -- reference trusted but axes parked elsewhere
        // -----------------------------------------------------------------
        16: // POST_HOME_CLR -- Move X and Z to the sheet-load park position
            #StatusID := 2;
            IF (NOT #bHomeClrX OR #fbMoveX_HomeClr.Done) AND (NOT #bHomeClrZ OR #fbMoveZ_HomeClr.Done) THEN
                #bHomeClrX := FALSE; #bHomeClrZ := FALSE;
                // Parked: wait for sheet insertion before engaging ToolHeadLock
                #bSheetWaitPhase2 := FALSE;  // Always start in phase 1 (show prompt)
                #bSheetWaitPhase3 := FALSE;  // Phase 3 must not survive from an aborted cycle
                #State := STATE_SHEET_WAIT;
            ELSIF (#bHomeClrX AND #fbMoveX_HomeClr.Error) OR (#bHomeClrZ AND #fbMoveZ_HomeClr.Error) THEN
                #bHomeClrX := FALSE; #bHomeClrZ := FALSE;
                // Single-writer: queue path keeps the clearance-move context in the displayed text
                "FC_ReportError"(Code := 16#0001,
                                 Details := 'Park move failed - axis could not reach sheet-load position',
                                 Source := 'Process');
                "DB_HMI".ErrorDetail    := 'Axis could not reach sheet-load position - check drive/SheetLoadPos';
                "DB_HMI".ErrorDetail_ES := 'Eje no pudo alcanzar posicion de carga - revisar variador/SheetLoadPos';
                #State := STATE_ERROR;
            END_IF;

        // -----------------------------------------------------------------
        // === STATE_SHEET_WAIT (14) ===
        // Phase 1: SheetHolder extends to hold the form; HMI prompt; wait operator
        //          both-button confirm (Cmd_Start rising edge).
        // Phase 2: MandrelLock extends (open-loop T#5S) to clamp the mandrel.
        // Phase 3: SheetHolder retracts (open-loop T#5S) to clear; then → LOCK_EXTEND_WAIT
        //          so ToolHeadLock engages before RUNNING.
        // -----------------------------------------------------------------
        14: // SHEET_WAIT
            #StatusID := 14;
            IF NOT #bSheetWaitPhase2 AND NOT #bSheetWaitPhase3 THEN
                // Phase 1: extend SheetHolder and prompt operator to insert the sheet.
                // Drop any retract hold left over from the previous cycle first -- the FB
                // gives Cmd_Extend priority anyway, but leaving both asserted is confusing
                // to read online and pointless once we are commanding the other direction.
                // Cmd_Extend itself is driven by the single writer at the bottom of this FB
                // (TRUE while State = SHEET_WAIT AND NOT Ph3).
                #bSheetHolderRetractHold := FALSE;
                "DB_HMI".HasWarning     := TRUE;
                "DB_HMI".WarningText    := 'Insert sheet, then press both start buttons';
                "DB_HMI".WarningText_ES := 'Inserte la lamina y presione ambos botones de inicio';
                IF #fbInputs.Cmd_Start THEN
                    // Operator confirmed — clear prompt
                    "DB_HMI".HasWarning     := FALSE;
                    "DB_HMI".WarningText    := '';
                    "DB_HMI".WarningText_ES := '';
                    IF NOT "DB_MachineConfig".Bypass_MandrelLock THEN
                        // Normal: extend MandrelLock (Ph2), then SheetHolder retracts (Ph3)
                        "DB_Cylinder_MandrelLock".Cmd_Extend := TRUE;
                        #bSheetWaitPhase2 := TRUE;
                    ELSE
                        // Bypass: no MandrelLock cylinder — skip Ph2, go straight to Ph3 (SheetHolder retract).
                        // Setting Ph3 also drops Cmd_Extend via the single writer at the bottom of this FB.
                        #bSheetHolderRetractHold := TRUE;
                        #bSheetWaitPhase3 := TRUE;
                    END_IF;
                END_IF;
            ELSIF #bSheetWaitPhase2 THEN
                // Phase 2: open-loop wait T#5S for MandrelLock full stroke
                // tonMandrelWait is driven by the global timer section below (IN when state=14 AND phase2)
                IF #tonMandrelWait.Q THEN
                    // MandrelLock assumed clamped — retract SheetHolder.
                    // Ph3 drops Cmd_Extend via the single writer at the bottom of this FB.
                    #bSheetHolderRetractHold := TRUE;   // Hold Cmd_Retract → Sol_B drives the piston back
                    #bSheetWaitPhase2 := FALSE;
                    #bSheetWaitPhase3 := TRUE;
                END_IF;
            ELSE
                // Phase 3: open-loop wait T#5S for SheetHolder to fully retract
                // tonSheetHolderRetract driven by global timer section below (IN when state=14 AND phase3)
                IF #tonSheetHolderRetract.Q THEN
                    #State := STATE_LOCK_EXTEND_WAIT;  // ToolHeadLock engages, then → RUNNING
                END_IF;
            END_IF;

        // -----------------------------------------------------------------
        // === STATE_RUNNING (20) ===
        // -----------------------------------------------------------------
        20: // RUNNING
            #StatusID := 3; #bStartSeq := TRUE;
            #timerRunning := TRUE;  // Start cycle timer
            
            // Update HMI
            "DB_HMI".CurrentLine := #fbRecipeHandler.CurrentLine;
            "DB_HMI".ProgressPercent := #fbRecipeHandler.Progress;
            "DB_HMI".FeedrateActive := #fbRecipeHandler.ActiveFeedrate;
            
            IF #bPauseActive THEN #State := STATE_PAUSED; END_IF;
            
            // Tool change request (bypass if no tool axis)
            IF #fbRecipeHandler.ToolChangeReq THEN
                IF "DB_MachineConfig".Bypass_ToolAxis THEN
                    // Skip tool change - clear request and continue
                    #fbRecipeHandler.ToolChangeReq := FALSE;
                ELSIF #fbRecipeHandler.ToolReqNumber = #CurrentTool THEN
                    // Requested tool already in position (e.g. home = slot 1) - skip retract/rotate/extend
                    #fbRecipeHandler.ToolChangeReq := FALSE;
                ELSE
                    #activeToolReq    := #fbRecipeHandler.ToolReqNumber;
                    #bStartSeq        := FALSE;
                    // Release lock before rotating turret: wait T#2S in LOCK_RETRACT_WAIT,
                    // then proceed to STATE_TOOL_CHANGE.
                    #bLockAfterHoming := FALSE;  // LOCK_RETRACT_WAIT exits to STATE_TOOL_CHANGE
                    #State            := STATE_LOCK_RETRACT_WAIT;
                END_IF;
            END_IF;
            
            // Spindle control from recipe
            IF #fbRecipeHandler.SpindleReqStart THEN
                IF #bSpindleDecelWait THEN
                    // Decel timer still running — capture for deferred apply
                    #bSpindlePendingStart := TRUE;
                    #pendingSpindleSpeed  := #fbRecipeHandler.SpindleReqSpeed;
                ELSE
                    #bSpindleStart := TRUE;
                    "DB_Spindle".Cmd_SetSpeed := #fbRecipeHandler.SpindleReqSpeed;
                END_IF;
            END_IF;
            IF #fbRecipeHandler.SpindleReqStop THEN
                #bSpindleStart       := FALSE;  // Drop RunCmd level
                #bSpindleDecelWait   := TRUE;   // Start decel wait
                #bSpindlePendingStart := FALSE; // Cancel any previous pending start
            END_IF;

            // Complete
            IF #fbRecipeHandler.Done THEN 
                #State := 100;  // Go to COMPLETE state, not IDLE
                "DB_HMI".ProgressPercent := 100.0;
                #bSpindleStart := FALSE;  // Drop RunCmd level on completion
                #timerRunning := FALSE; // Stop cycle timer
                #savedLineIndex := -1;  // Clear saved position
                #savedProgram := -1;
            END_IF;
            
            // Error
            IF #fbRecipeHandler.Error THEN 
                #State := STATE_ERROR;
                #newErrorFlag := TRUE; 
                #newErrorCode := #fbRecipeHandler.ErrorID;
            END_IF;

        // -----------------------------------------------------------------
        // === STATE_LOCK_EXTEND_WAIT (17) ===
        // -----------------------------------------------------------------
        17: // LOCK_EXTEND_WAIT -- commanding ToolHeadLock to extend; sensor must confirm before RUNNING
            // Cmd_Extend=TRUE is driven outside the CASE (see ToolHeadLock section below).
            // No timer fallback -- lock MUST be confirmed by sensor before machining starts.

 	     #StatusID := 17;
	      IF "DB_HMI".Bypass_ToolHeadLock THEN
	         // Bypass: no sensor wait -- advance immediately (cylinder still commanded to
	         // extend outside the CASE if physically present, but AtSetpoint is not required).
	         #State := STATE_RUNNING;
	      ELSIF "DB_Cylinder_ToolHeadLock".AtSetpoint THEN
 	         #State := STATE_RUNNING;
 	     ELSIF "DB_Cylinder_ToolHeadLock".Error THEN
  	        // Sensor did not confirm within Timeout_Extend (T#3S) — abort
  	        #newErrorFlag := TRUE;
  	        #newErrorCode := 16#0012;
  	        "DB_Diagnostic".Error_Text := 'LockExtendWait: CylFB.Error=TRUE, AtSetpoint=FALSE - check air supply and magnetic sensor';
   	       "DB_HMI".ErrorDetail    := 'Lock sensor (AtSetpoint) not confirmed - check cylinder/sensor';
   	       "DB_HMI".ErrorDetail_ES := 'Sensor de bloqueo (AtSetpoint) no confirmado - revisar cilindro/sensor';
   	       #State := STATE_ERROR;
   	   END_IF;

        // -----------------------------------------------------------------
        // === STATE_LOCK_RETRACT_WAIT (29) ===
        // -----------------------------------------------------------------
        29: // LOCK_RETRACT_WAIT -- ToolHeadLock releasing (spring return); wait T#2S before proceeding
            // Cmd_Extend=FALSE here (state not RUNNING/PAUSED/LOCK_EXTEND_WAIT); spring retracts.
            // No sensor yet: proceed after timeout regardless.
            // bLockAfterHoming selects exit:
            //   TRUE  = coming from STOPPING → go to STATE_STOPPED (axes already parked at SheetLoadPos)
            //   FALSE = coming from RUNNING (tool change) → go to STATE_TOOL_CHANGE
            #StatusID := 29;
            IF #tonLockWait.Q THEN
                IF #bLockAfterHoming THEN
                    #State := STATE_STOPPED;  // Axes already parked at SheetLoadPos by STOPPING; no homing needed
                ELSE
                    #State := STATE_TOOL_CHANGE;
                END_IF;
            END_IF;

        // -----------------------------------------------------------------
        // === STATE_STOPPING (18) ===
        // -----------------------------------------------------------------
        18: // STOPPING - Stop program without generating an error.
            // Phase 1: recipe executor halts → command spindle stop → start axis park move.
            // Axes move to SheetLoadPos_X/Z (MC_MoveAbsolute, rapid, both simultaneously) in
            // parallel with the spindle decel wait. Target is the sheet-load park, not 0,0:
            // an abort leaves the machine in the same place a normal cycle end does, so the
            // next Start can take the fast path instead of paying for a homing cycle.
            // Phase 2: release MandrelLock once BOTH spindle timer elapsed AND axes done → LOCK_RETRACT_WAIT → STOPPED.
            #StatusID := 18;
            #Running := FALSE;
            #timerRunning := FALSE;
            // Axis return completion check — runs BEFORE the start-trigger so that a stale
            // Done latch from the previous stop cycle (FB_Axis_AbsPos holds Done after Execute
            // drops) cannot immediately cancel bStopMoveX/Z on the same scan they are set.
            // When this check runs first, bStopMoveX/Z are still FALSE on the first scan of
            // STOPPING (no action), and the start-trigger below then sets them correctly.
            IF #bStopMoveX THEN
                IF #fbMoveX_Stop.Done OR #fbMoveX_Stop.Error THEN
                    #bStopMoveX := FALSE;
                END_IF;
            END_IF;
            IF #bStopMoveZ THEN
                IF #fbMoveZ_Stop.Done OR #fbMoveZ_Stop.Error THEN
                    #bStopMoveZ := FALSE;
                END_IF;
            END_IF;
            // Phase 1: wait for recipe executor to finish, then command spindle stop and
            // begin waiting for the spindle to reach zero speed before releasing MandrelLock.
            // MandrelLock stays extended (sheet clamped) while the spindle decelerates --
            // retracting while spinning could throw the sheet at the operator.
            IF NOT #fbRecipeHandler.Busy AND NOT #bWaitingSpindleStop THEN
                #bSpindleStop             := TRUE;
                #bSheetHolderRetractHold  := TRUE;  // Held: release sheet holder (may be extended if stopped during SHEET_WAIT Ph1/2)
                #bSheetWaitPhase2         := FALSE;
                #bSheetWaitPhase3         := FALSE;
                // ITEM-28: capture commanded speed before issuing stop; compute proportional wait time.
                // Cmd_SetSpeed holds the VFD setpoint from the previous scan (FB_SpindleControl not yet called this scan).
                #capturedSpindleRPM := "DB_Spindle".Cmd_SetSpeed;
                IF "DB_MachineConfig".SpindleMaxRPM > 0.0 THEN
                    #spindleStopPT := DINT_TO_TIME(
                        REAL_TO_DINT(
                            DINT_TO_REAL(TIME_TO_DINT("DB_MachineConfig".SpindleStopSafeTime))
                            * (#capturedSpindleRPM / "DB_MachineConfig".SpindleMaxRPM)
                        )
                    );
                ELSE
                    #spindleStopPT := "DB_MachineConfig".SpindleStopSafeTime;  // safe fallback if MaxRPM not configured
                END_IF;
                #bWaitingSpindleStop := TRUE;   // Enable phase 2 (proportional spindle decel wait)
                // fbMoveX/Z_Stop called at bottom of FB with Execute := bStopMoveX/Z,
                // target parkTargetX/Z (= clamped SheetLoadPos) at RapidVelocity.
                // Both axes start simultaneously.
                #bStopMoveX          := TRUE;   // Start X park move immediately (parallel with spindle decel and Z)
                #bStopMoveZ          := TRUE;   // Start Z park move simultaneously with X
            END_IF;
            // Phase 2: release MandrelLock once proportional spindle decel timer has elapsed AND axes are parked.
            // Bypass_MandrelLock: no cylinder on this variant — skip decel wait, go directly to LOCK_RETRACT_WAIT.
            // No physical encoder -- ActualSpeed is a TO estimate only. tonSpindleStopWait is sole release condition.
            IF #bWaitingSpindleStop AND NOT #bStopMoveX AND NOT #bStopMoveZ
               AND ("DB_MachineConfig".Bypass_MandrelLock OR #tonSpindleStopWait.Q) THEN
                IF NOT "DB_MachineConfig".Bypass_MandrelLock THEN
                    "DB_Cylinder_MandrelLock".Cmd_Extend := FALSE;
                    #bMandrelRetractPulse := TRUE;  // One-shot: release mandrel lock
                END_IF;
                #bWaitingSpindleStop   := FALSE;
                #bLockAfterHoming      := TRUE;  // LOCK_RETRACT_WAIT exits to STATE_STOPPED
                #State                 := STATE_LOCK_RETRACT_WAIT;
            END_IF;

        // -----------------------------------------------------------------
        // === STATE_STOP_GOHOME (19) ===
        // -----------------------------------------------------------------
        19: // STOP_GOHOME - Active homing after stop (X then Z, sequential)
            // BUG FIX: Previous implementation homed X and Z simultaneously.
            // Using the same sequential pattern as STATE_HOMING: X first, then Z.
            #StatusID := 19;
            #Running := FALSE;
            IF #homeSeqState = 1 THEN
                // X homing
                #bHomeXExec := TRUE;
                #bHomeZExec := FALSE;
                IF #fbHomeX.Done THEN
                    #bHomeXExec := FALSE;
                    #homeSeqState := 2;
                    #bHomeZExec := TRUE;
                ELSIF #fbHomeX.Error THEN
                    #bHomeXExec := FALSE;
                    #homeSeqState := 0;
                    #State := STATE_ERROR;
                    #newErrorFlag := TRUE;
                    #newErrorCode := 16#0003;
                    "DB_Diagnostic".HomeX_ErrorID := #fbHomeX.ErrorID;
                    "DB_Diagnostic".TO_ErrorText  := "FC_TO_ErrorText"(Code := #fbHomeX.ErrorID);
                    "DB_HMI".ErrorDetail    := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
                    "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
                END_IF;
            ELSIF #homeSeqState = 2 THEN
                // Z homing
                #bHomeXExec := FALSE;
                #bHomeZExec := TRUE;
                IF #fbHomeZ.Done THEN
                    #bHomeZExec := FALSE;
                    IF NOT "DB_MachineConfig".Bypass_ToolAxis THEN
                        // Proceed to tool axis homing (step 3)
                        #homeSeqState := 3;
                        #bHomeToolExec := TRUE;
                    ELSE
                        // Tool axis bypassed -- homing complete
                        #homeSeqState := 0;
                        #State := STATE_STOPPED;
                    END_IF;
                ELSIF #fbHomeZ.Error THEN
                    #bHomeZExec := FALSE;
                    #homeSeqState := 0;
                    #State := STATE_ERROR;
                    #newErrorFlag := TRUE;
                    #newErrorCode := 16#0004;
                    "DB_Diagnostic".HomeZ_ErrorID := #fbHomeZ.ErrorID;
                    "DB_Diagnostic".TO_ErrorText  := "FC_TO_ErrorText"(Code := #fbHomeZ.ErrorID);
                    "DB_HMI".ErrorDetail    := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
                    "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
                END_IF;
            ELSIF #homeSeqState = 3 THEN
                // Homing Tool axis
                #bHomeToolExec := TRUE;
                IF #fbHomeTool.Done THEN
                    #bHomeToolExec := FALSE;
                    #homeSeqState := 0;
                    #State := STATE_STOPPED;
                ELSIF #fbHomeTool.Error THEN
                    #bHomeToolExec := FALSE;
                    #homeSeqState := 0;
                    #State := STATE_ERROR;
                    #newErrorFlag := TRUE;
                    #newErrorCode := 16#0007;
                    "DB_Diagnostic".HomeTool_ErrorID := #fbHomeTool.ErrorID;
                    "DB_Diagnostic".TO_ErrorText     := "FC_TO_ErrorText"(Code := #fbHomeTool.ErrorID);
                    "DB_HMI".ErrorDetail    := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
                    "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'TO:', IN2 := "DB_Diagnostic".TO_ErrorText);
                END_IF;
            ELSE
                // homeSeqState invalid -- safe fallback
                #homeSeqState := 0;
                #bHomeXExec := FALSE;
                #bHomeZExec := FALSE;
                #bHomeToolExec := FALSE;
                #State := STATE_STOPPED;
            END_IF;
            // ITEM-30: independent 120s timeout for STATE_STOP_GOHOME (tonStopHomeTimeout)
            // Previously used tonHomingTimeout which could be nearly exhausted by a preceding STATE_HOMING run.
            IF #tonStopHomeTimeout.Q THEN
                #bHomeXExec := FALSE;
                #bHomeZExec := FALSE;
                #bHomeToolExec := FALSE;
                #homeSeqState := 0;
                #State := STATE_ERROR;
                #newErrorFlag := TRUE;
                #newErrorCode := 16#000B;
                "DB_HMI".ErrorDetail    := 'Post-stop homing did not complete - check reference switch/drive';
                "DB_HMI".ErrorDetail_ES := 'Referenciado post-paro no completado - revisar sensor/variador';
            END_IF;

        // -----------------------------------------------------------------
        // === STATE_STOP_GOTOZERO (21) ===
        // -----------------------------------------------------------------
        21: // STOP_GOTOZERO - Go to position 0 after stop
            #StatusID := 21;
            #Running := FALSE;
            // Has X axis motion completed?
            IF #bStopMoveX AND #fbMoveX_Stop.Done THEN
                #bStopMoveX := FALSE;
            ELSIF #bStopMoveX AND #fbMoveX_Stop.Error THEN
                #bStopMoveX := FALSE;
                #State := STATE_ERROR;
                #newErrorFlag := TRUE;
                #newErrorCode := 16#0001; // X move failed
                "DB_HMI".ErrorDetail    := 'X axis could not return to zero after stop';
                "DB_HMI".ErrorDetail_ES := 'Eje X no pudo retornar a cero despues del paro';
            END_IF;
            // Has Z axis motion completed?
            IF #bStopMoveZ AND #fbMoveZ_Stop.Done THEN
                #bStopMoveZ := FALSE;
            ELSIF #bStopMoveZ AND #fbMoveZ_Stop.Error THEN
                #bStopMoveZ := FALSE;
                #State := STATE_ERROR;
                #newErrorFlag := TRUE;
                #newErrorCode := 16#0002; // Z move failed
                "DB_HMI".ErrorDetail    := 'Z axis could not return to zero after stop';
                "DB_HMI".ErrorDetail_ES := 'Eje Z no pudo retornar a cero despues del paro';
            END_IF;
            // When both axes are done, return to STOPPED
            IF NOT #bStopMoveX AND NOT #bStopMoveZ AND (#State = STATE_STOP_GOTOZERO) THEN
                #State := STATE_STOPPED;
            END_IF;

        // -----------------------------------------------------------------
        // === STATE_PNP_HALT (22) ===
        // -----------------------------------------------------------------
        22: // PNP_HALT -- axis halted at proximity zone; drives ON, reverse jog allowed to escape
            #StatusID := 22;
            #Running := FALSE;
            // Auto-exit: PNP zone cleared (axis has moved away) -- return to STOPPED
            IF NOT #HW_PNP_X_Min AND NOT #HW_PNP_X_Max THEN #bHaltX_PNP := FALSE; END_IF;
            IF NOT #HW_PNP_Z_Min AND NOT #HW_PNP_Z_Max THEN #bHaltZ_PNP := FALSE; END_IF;
            IF NOT #bHaltX_PNP AND NOT #bHaltZ_PNP THEN
                #State := STATE_STOPPED;
            END_IF;
            // Manual exit: operator presses AckError or Reset
            IF (#ackEdge OR #fbInputs.Cmd_Reset) AND (#EStop_OK OR "DB_HMI".Bypass_EStop) THEN
                #bHaltX_PNP := FALSE;
                #bHaltZ_PNP := FALSE;
                #Error := FALSE;
                #prevSafetyError := FALSE;
                #fbAlarmManager(NewError := FALSE, NewErrorCode := 0, AcknowledgeError := TRUE);
                #State := STATE_STOPPED;
            END_IF;
            // Forward spindle commands from recipe handler.
            // When PNP fires during STATE_RUNNING, the RUNNING(20) case is skipped, so
            // bSpindleStart is never updated from fbRecipeHandler signals. Mirror them here.
            // Note: fbRecipeHandler runs AFTER this CASE, so values here are from previous scan.
            IF #fbRecipeHandler.SpindleReqStop THEN
                #bSpindleStart := FALSE;  // Drop RunCmd level
            END_IF;
            IF #fbRecipeHandler.SpindleReqStart THEN
                #bSpindleStart := TRUE;
                "DB_Spindle".Cmd_SetSpeed := #fbRecipeHandler.SpindleReqSpeed;
            END_IF;

        // -----------------------------------------------------------------
        // === STATE_PAUSED (25) ===
        // -----------------------------------------------------------------
        25: // PAUSED
            #StatusID := 88;
            // Stop elapsed time counting while paused
            #timerRunning := FALSE;
            // Spindle is stopped while paused (RunCmd gated off below on State=PAUSED
            // when NOT bResumeSpeedup). On Continue, restart the spindle and wait
            // SpindleResumeSpeedupTime for it to reach speed BEFORE releasing the axes:
            //   • bResumeSpeedup=TRUE  → RunCmd gate re-enables the spindle (spin-up)
            //   • bPauseActive stays TRUE → FB_RecipeHandler holds at the retract point (802)
            // When the timer elapses, drop bPauseActive → FB_RecipeHandler returns to the
            // interruption point (803) and machining resumes.
            // Only Btn_Continue resumes (Pause button does NOT toggle).
            IF #continueEdge THEN
                #bResumeSpeedup := TRUE;
            END_IF;
            IF #bResumeSpeedup AND #tonResumeSpeedup.Q THEN
                #bResumeSpeedup := FALSE;
                #bPauseActive   := FALSE;
                #State          := STATE_RUNNING;
            END_IF;
        
        // -----------------------------------------------------------------
        // === STATE_TOOL_CHANGE (30) ===
        // -----------------------------------------------------------------
        30: // TOOL_CHANGE
            #StatusID := 4; #bToolExecute := TRUE; #State := STATE_TOOL_WAIT;
        
        // -----------------------------------------------------------------
        // === STATE_TOOL_WAIT (35) ===
        // -----------------------------------------------------------------
        35: // TOOL_WAIT
            IF #fbToolChanger.Done THEN
                #bToolExecute := FALSE;
                #CurrentTool := #fbToolChanger.CurrentTool;
                #fbRecipeHandler.ToolChangeReq := FALSE;  // Signal RecipeHandler to continue
                // Tool change done: re-engage lock before resuming machining
                #State := STATE_LOCK_EXTEND_WAIT;
            ELSIF #fbToolChanger.Error THEN
                #bToolExecute := FALSE;
                #State := STATE_ERROR;
                #newErrorFlag := TRUE;
                #newErrorCode := #fbToolChanger.ErrorID;
                "DB_HMI".ErrorDetail    := CONCAT(IN1 := 'Tool ', IN2 := INT_TO_STRING(#activeToolReq));
                "DB_HMI".ErrorDetail_ES := CONCAT(IN1 := 'Herramienta ', IN2 := INT_TO_STRING(#activeToolReq));
            END_IF;
        
        // -----------------------------------------------------------------
        // === STATE_ERROR (999) ===
        // -----------------------------------------------------------------
        999: // ERROR
            #StatusID := 99; #bStartSeq := FALSE; #Error := TRUE;
            #bRecipeLoadExec := FALSE;   // a recipe copy must not stay in flight across an error ack
            #timerRunning := FALSE;  // Stop cycle timer
            #bResumeSpeedup := FALSE;  // Cancel any pending pause spin-up wait (e.g. fault during spin-up)
            // Clear the BackSupport atmosphere valve — de-energises on error.
            // Cmd_Retract is deliberately NOT touched here: the end-of-recipe retract
            // block (bottom of this FB) owns it and needs it held for the retract window.
            "DB_Cylinder_BackSupport".SolAtmo_Cmd := FALSE;
            // Clear BackSupport extend (recipe CMD=40 or manual button/MDI) while faulted
            "DB_Cylinder_BackSupport".Cmd_Extend  := FALSE;
            #bMDI_Cmd40Extend                     := FALSE;
            // CMD=41 edge memory: seed with the live button state while faulted, so a
            // button held through the fault cannot fire a one-shot after acknowledge.
            #prevBtnCmd41Release := "DB_Manual".Btn_Cmd41_Release;
            #prevBtnCmd41AtmoOff := "DB_Manual".Btn_Cmd41_AtmoOff;
            #prevBtnCmd41AtmoOn  := "DB_Manual".Btn_Cmd41_AtmoOn;
            // SheetHolder Cmd_Extend is driven FALSE here by its single writer at the bottom of
            // this FB (State <> SHEET_WAIT), so it cannot hold through an error acknowledge.

            // Save current position for warm restart
            IF #savedLineIndex < 0 THEN
                #savedLineIndex := #fbRecipeHandler.CurrentLine;
                #savedProgram := #activeProgram;
            END_IF;
            "DB_HMI".ResumeLine := #savedLineIndex;   // HMI shows which line will be resumed on next Start
            
            // Debug: populate DB_Diagnostic with error context for easier troubleshooting
            "DB_Diagnostic".Error_ProcessState := #State;
            "DB_Diagnostic".Error_Code := #fbAlarmManager.ActiveErrorCode; // primary error source
            // If recipe handler provided an error line, prefer that
            IF "DB_Diagnostic".Recipe_CurrentLine >= 0 THEN
                "DB_Diagnostic".Error_Line := "DB_Diagnostic".Recipe_CurrentLine;
            END_IF;

            // BUG FIX: Previous implementation transitioned ackEdge → STATE_PAUSED,
            // but the recipe handler remained in its internal STATE_ERROR (999).
            // In PAUSED → Continue → STATE_RUNNING the recipe handler was not running (error state).
            // Fix: All recovery paths go to STATE_STOPPED + recipe handler is reset.
            // When operator presses Start, PRE_SCAN → STARTING → RUNNING flow starts clean.
            // ACK, Continue and Restart are blocked while E-Stop is active.
            // E-Stop must be physically released before any error acknowledgement is accepted.
            IF #ackEdge AND (#EStop_OK OR "DB_HMI".Bypass_EStop) THEN
                // Acknowledge: clear error → STOPPED. savedLineIndex kept for warm restart on next Start.
                #Error := FALSE;
                #bPauseActive := FALSE;
                #bResetRecipe := TRUE;   // Reset recipe handler to IDLE (cannot continue from state 999)
                #prevSafetyError := FALSE;   // Clear safety latch -- fresh evaluation on restart
                #bSheetWaitPhase2         := FALSE;
                #bSheetWaitPhase3         := FALSE;
                IF NOT "DB_MachineConfig".Bypass_MandrelLock THEN
                    #bMandrelRetractPending := TRUE;  // ITEM-32: deferred — spindle may still be spinning; wait SpindleStopSafeTime
                END_IF;
                #bSheetHolderRetractHold  := TRUE;  // Release sheet holder (may be extended from last run)
                #fbAlarmManager(NewError := FALSE, NewErrorCode := 0,
                                AcknowledgeError := TRUE);
                #State := STATE_STOPPED;
            ELSIF #continueEdge AND (#EStop_OK OR "DB_HMI".Bypass_EStop) THEN
                // Continue: resume from savedLineIndex on next Start (warm restart)
                #Error := FALSE;
                #bPauseActive := FALSE;
                #bResetRecipe := TRUE;
                #bSheetWaitPhase2         := FALSE;
                #bSheetWaitPhase3         := FALSE;
                IF NOT "DB_MachineConfig".Bypass_MandrelLock THEN
                    #bMandrelRetractPending := TRUE;  // ITEM-32: deferred — spindle may still be spinning; wait SpindleStopSafeTime
                END_IF;
                #bSheetHolderRetractHold  := TRUE;  // Release sheet holder
                #fbAlarmManager(NewError := FALSE, NewErrorCode := 0,
                                AcknowledgeError := TRUE);
                #State := STATE_STOPPED;
            ELSIF #restartEdge AND (#EStop_OK OR "DB_HMI".Bypass_EStop) THEN
                // Restart: explicit restart from line 0 -- clear saved position
                #Error := FALSE;
                #bPauseActive := FALSE;
                #bResetRecipe := TRUE;
                #savedLineIndex := -1;
                #savedProgram := -1;
                "DB_HMI".ResumeLine := -1;
                #bSheetWaitPhase2         := FALSE;
                #bSheetWaitPhase3         := FALSE;
                IF NOT "DB_MachineConfig".Bypass_MandrelLock THEN
                    #bMandrelRetractPending := TRUE;  // ITEM-32: deferred — spindle may still be spinning; wait SpindleStopSafeTime
                END_IF;
                #bSheetHolderRetractHold  := TRUE;  // Release sheet holder
                #fbAlarmManager(NewError := FALSE, NewErrorCode := 0,
                                AcknowledgeError := TRUE);
                #State := STATE_STOPPED;
            END_IF;
    END_CASE;
    
    // -----------------------------------------------------------------
    // === STATE_COMPLETE (100) ===
    // (handled as IF block outside CASE -- no new constant needed)
    // -----------------------------------------------------------------
    IF #State = 100 THEN
        #StatusID := 100; #bStartSeq := FALSE;
        #Running := FALSE;
        // Clear bSpindleStart: RUNNING no longer runs to clear it, so SpindleReqStart=TRUE
        // from the last CMD_SPINDLE_ON would keep Start=TRUE through PRE_SCAN and STARTING.
        // prevStart is reset inside FB_SpindleControl on halt Done, so the next CMD_SPINDLE_ON
        // in the new recipe generates a clean startEdge.
        // bSpindleStop is intentionally NOT cleared here: line 1567 sets it TRUE on Done to
        // stop the spindle, and clearing it in the same scan (IF State=100 runs same scan as
        // the Done handler in CASE 20) would cancel the stop command before it is consumed.
        #bSpindleStart := FALSE;
        IF NOT "DB_MachineConfig".Bypass_MandrelLock THEN
            "DB_Cylinder_MandrelLock".Cmd_Extend := FALSE;
            #bMandrelRetractPending := TRUE;    // ITEM-32: deferred — spindle still decelerating at program end; wait SpindleStopSafeTime
        END_IF;
        // De-energise the atmosphere valve. Cmd_Retract is left alone -- the
        // end-of-recipe retract block at the bottom of this FB owns it.
        "DB_Cylinder_BackSupport".SolAtmo_Cmd := FALSE;
        "DB_HMI".StatusMsg    := 'Program Complete';
        "DB_HMI".StatusMsg_ES := 'Programa Completado';
        // Single-writer: ErrorText is owned by FB_AlarmManager. Completion is a status,
        // not an error -- StatusMsg above already announces it ('Done!' write removed).
        // ITEM-20: increment CycleCount exactly once per cycle, regardless of how many times
        // Reset/Start is pressed from STATE_COMPLETE.
        IF NOT #bCycleCountDone THEN
            "DB_HMI".CycleCount := "DB_HMI".CycleCount + 1;
            #bCycleCountDone    := TRUE;
        END_IF;
        IF #fbInputs.Cmd_Start OR #restartEdge THEN
            #bResetRecipe := TRUE;      // Reset FB_RecipeHandler (state 99→0) before re-run
            #State := STATE_RECIPE_LOAD; // Restart/Start = immediate re-run, keeps drives on
        ELSIF #fbInputs.Cmd_Reset THEN
            #bResetRecipe := TRUE;      // Also reset recipe handler on manual reset
            #State := STATE_RECIPE_LOAD; // Reset from COMPLETE re-loads then pre-scans (drives stay on)
        END_IF;
    END_IF;

    // =========================================================================
    // REFERENCE-VALIDITY LATCH (bRequireHoming)
    // =========================================================================
    // Forces a full homing cycle on the next auto start after anything that can
    // invalidate the axis reference. This is the ONLY guarantee that an E-Stop is
    // always followed by a re-home: DB_MachineConfig.AlwaysHomeOnAutoStart is an
    // operator convenience switch and must never be able to suppress this.
    //
    // Why not rely on Axis_*.StatusBits.HomingDone alone: whether the TO clears it
    // when MC_Power drops is encoder-type dependent, and an open-loop axis can lose
    // steps while the drive is dead yet still report HomingDone=TRUE on power-up.
    //
    // Placed AFTER the state machine so a STATE_ERROR transition made earlier in this
    // same scan is caught immediately rather than one scan late.
    // Cleared ONLY where a homing sequence actually completes (STATE_HOMING, both the
    // tool-axis and Bypass_ToolAxis exits). Power-up sets it TRUE (bInitDone block); a reset
    // sets it only when pressed from a state where an axis could have been moving.
    IF NOT (#EStop_OK OR "DB_HMI".Bypass_EStop) OR #State = STATE_ERROR THEN
        #bRequireHoming := TRUE;
    END_IF;

    // Drive power removed = reference lost. Level-triggered, so the latch stays TRUE for as
    // long as the drives are down and is only released by a completed homing cycle afterwards.
    //
    // This is the honest detector for the case StatusBits.HomingDone cannot see: these motors
    // are open-loop, so with the contactor open the axis can be pushed by hand or back-driven
    // by gravity while the TO happily keeps reporting the last commanded position. It is also
    // what makes it safe for a Reset pressed in MANUAL to skip homing -- if the operator turned
    // drive power off to move something by hand, this catches it regardless of the state.
    //
    // Covers X and Z only: there is no Btn_Enable_Tool, and Btn_Contactor_Tool is deliberately
    // FALSE whenever Bypass_ToolAxis is set, which would latch this permanently. The tool axis
    // is covered by its own StatusBits.HomingDone term in bRefTrusted.
    //
    // Power-up consequence (intended): DB_HMI is NON_RETAIN, so these are FALSE until the first
    // STATE_STARTING asserts them -- the latch is held TRUE until the machine has been started
    // once and homed, which is exactly the required power-up behaviour.
    IF NOT ("DB_HMI".Btn_Contactor_X AND "DB_HMI".Btn_Enable_X)
       OR NOT ("DB_HMI".Btn_Contactor_Z AND "DB_HMI".Btn_Enable_Z) THEN
        #bRequireHoming := TRUE;
    END_IF;

    "DB_Diagnostic".Require_Homing := #bRequireHoming;  // HMI/diagnostic visibility

    // =========================================================================
    // CYCLE TIMER - runs during RUNNING and PAUSED
    // =========================================================================
    #tonElapsed(IN := #timerRunning, PT := T#24h);
    // Homing timeout: counts only while in STATE_HOMING; auto-resets when state exits
    #tonHomingTimeout(IN := (#State = STATE_HOMING), PT := "DB_MachineConfig".Timeout_Homing);
    // ITEM-30: independent timeout for STATE_STOP_GOHOME — gets a full budget regardless of
    // how much time was consumed by the preceding STATE_HOMING sequence earlier in the same run
    #tonStopHomeTimeout(IN := (#State = STATE_STOP_GOHOME), PT := "DB_MachineConfig".Timeout_Homing);
    // ToolHeadLock wait: counts in both lock wait states; auto-resets on exit
    // tonLockWait: 3s total (1s pre-delay + up to 2s for cylinder stroke). AtSetpoint exits early.
    #tonLockWait(IN := (#State = STATE_LOCK_RETRACT_WAIT),
                 PT := "DB_MachineConfig".CylToolHeadLock_RetractTime);
    #tonLockPreDelay(IN := (#State = STATE_LOCK_EXTEND_WAIT), PT := "DB_MachineConfig".CylToolHeadLock_PreDelay);
    // Spindle-stop wait: safety fallback for MandrelLock retract in STATE_STOPPING.
    // Duration = (capturedSpindleRPM / SpindleMaxRPM) * SpindleStopSafeTime. Fires immediately if speed was 0.
    #tonSpindleStopWait(IN := (#State = STATE_STOPPING AND #bWaitingSpindleStop), PT := #spindleStopPT);
    // MandrelLock stroke wait: open-loop during STATE_SHEET_WAIT phase 2
    #tonMandrelWait(IN := (#State = STATE_SHEET_WAIT AND #bSheetWaitPhase2), PT := "DB_MachineConfig".CylMandrelLock_ClampTime);
    // SheetHolder retract wait: open-loop during STATE_SHEET_WAIT phase 3
    #tonSheetHolderRetract(IN := (#State = STATE_SHEET_WAIT AND #bSheetWaitPhase3), PT := "DB_MachineConfig".CylSheetHolder_RetractTime);
    // ITEM-32: safety gate timer for deferred MandrelLock retract.
    // Six unsafe paths (Reset/Error-ack/Error-restart/Error-continue/Restart-pre-CASE/Complete) set
    // bMandrelRetractPending instead of bMandrelRetractPulse. This timer counts SpindleStopSafeTime
    // to ensure the spindle has physically stopped before the mandrel lock releases.
    // bMandrelRetractPending is NOT cleared by bDoHardReset — it must stay TRUE until the timer fires.
    #tonMandrelRetractWait(IN := #bMandrelRetractPending, PT := "DB_MachineConfig".SpindleStopSafeTime);
    // MandrelLock one-shot retract pulse (still ValveType=1, 5/2 spring return):
    // ValveType=1 + Mode=0 keeps Sol_A=TRUE in State 3 even after Cmd_Extend=FALSE.
    // A one-scan Cmd_Retract=TRUE pulse forces the FB to State 2 (Sol_A=FALSE) → spring retracts.
    // ITEM-32: promote deferred retract to immediate pulse once safety timer has elapsed.
    // STATE_STOPPING uses bMandrelRetractPulse directly (already waited proportional timer) — no change there.
    IF #tonMandrelRetractWait.Q THEN
        #bMandrelRetractPulse   := TRUE;   // Fire the retract this scan
        #bMandrelRetractPending := FALSE;  // Clear pending; timer IN drops next scan → ET resets
    END_IF;
    "DB_Cylinder_MandrelLock".Cmd_Retract  := #bMandrelRetractPulse;
    #bMandrelRetractPulse := FALSE;  // Self-clearing: active for exactly one scan

    // =========================================================================
    // SHEETHOLDER COMMANDS -- single writer for BOTH directions (ITEM-46)
    // =========================================================================
    // ValveType=2, 5/3 blocked centre, PositioningMode=0. There is no spring on this
    // cylinder any more, so:
    //   Cmd_Extend  = TRUE only while the sheet must be held: STATE_SHEET_WAIT Ph1
    //                 (operator inserting) and Ph2 (MandrelLock clamping). FALSE in
    //                 every other state, on every path, without exception.
    //   Cmd_Retract = HELD for the retract stroke, then dropped -> both coils off and
    //                 the blocked centre holds the piston at the retract end.
    //
    // Why Cmd_Extend is written here instead of inside the states (fixes the "retracts,
    // then extends again a second later" stop bug): STATE_SHEET_WAIT Ph1 used to latch
    // Cmd_Extend and only STOPPED / ERROR cleared it. Pressing Stop during Ph1/Ph2 goes
    // to STOPPING (18) -> LOCK_RETRACT_WAIT (29) -> STOPPED, so Cmd_Extend stayed TRUE
    // for several seconds while Cmd_Retract was also held. The cylinder FB retracted,
    // hit Timeout_Retract, landed in State 4, saw Cmd_Extend still TRUE and extended
    // straight back out. Driving Cmd_Extend from the state itself makes that impossible.
    //
    // Why the retract is time-bounded instead of released on FB State 4: in Mode 0 with a
    // 5/3 valve, State 4 keeps Sol_B energised for ever (09_Sensors_Actuators.scl State-4
    // output branch) and is left only on a new extend command -- so the coil stayed live
    // the whole time the machine sat idle, from the first power-up retract onwards. With
    // Timeout_Retract = T#24H the FB now stays in State 2 for the whole hold, and dropping
    // the latch takes it to State 0 (09: "NOT Cmd_Retract") -> both coils off.
    //
    // Deterministic clear path (Reset-Path Rule checkpoints 1-4):
    //   - The TON below always ends the hold, in EVERY state. It is deliberately not a
    //     state test: STOPPED / ERROR are reached mid-retract and the latch commands the
    //     SAFE direction there, so it must be the timer that ends it, never the state.
    //   - Cleared again in STATE_SHEET_WAIT Ph1 before an extend is commanded.
    //   - The timer needs no explicit IN := FALSE: IN is the latch itself, so every path
    //     that clears or re-arms the latch resets ET with it.
    "DB_Cylinder_SheetHolder".Cmd_Extend :=
        (#State = STATE_SHEET_WAIT) AND NOT #bSheetWaitPhase3;

    // Cmd_Release: drop the coil hold WITHOUT moving the piston (5/3 blocked centre).
    //
    // The extend side has the same dead end ITEM-46 fixed on the retract side: with
    // PositioningMode=0 the cylinder FB latches Sol_A ON in State 3 (AT SETPOINT) and the only
    // exits are a new extend or a retract command. The holder reaches State 3 after
    // Timeout_Extend during SHEET_WAIT Ph1 -- correct while the operator is loading, since the
    // blank is being held -- but if the machine faults there, dropping Cmd_Extend is not enough:
    // Sol_A stays energised for however long the machine sits in ERROR waiting for an Ack.
    //
    // Releasing is NOT the same as retracting, and that distinction is the whole point. A retract
    // would let go of a blank that MandrelLock has not clamped yet (a fault in Ph1/Ph2 is exactly
    // when that is true, and it is the only time the holder is extended at all). Cmd_Release takes
    // the FB to State 0 instead: both coils off, and the blocked centre holds the piston exactly
    // where it is. Same physical outcome the machine already accepts on E-Stop, where
    // FB_CylinderControl forces State -1 and de-energises everything.
    //
    // Asserted in ERROR and STOPPED (Reset-Path Rule checkpoints 3 and 4: no actuator override may
    // stay latched in either). In STOPPED it is a no-op on every traced path -- every route to
    // STOPPED runs a retract first, which ends in State 0 anyway -- but it is the deterministic
    // guard if a future path ever leaves the FB holding while the machine is idle.
    // The operator's Ack still performs the actual release: it arms bSheetHolderRetractHold, and
    // State 0 accepts Cmd_Retract normally.
    "DB_Cylinder_SheetHolder".Cmd_Release :=
        (#State = STATE_ERROR) OR (#State = STATE_STOPPED);

    #tonSheetHolderHold(IN := #bSheetHolderRetractHold AND (#EStop_OK OR "DB_HMI".Bypass_EStop),
                        PT := "DB_MachineConfig".CylSheetHolder_RetractTime);
    IF #tonSheetHolderHold.Q THEN
        #bSheetHolderRetractHold := FALSE;
    END_IF;
    "DB_Cylinder_SheetHolder".Cmd_Retract  := #bSheetHolderRetractHold;
    // Drive ready timeout: counts while in STARTING and drives not yet ready; auto-resets on exit
    #tonDriveReady(IN := (#State = STATE_STARTING) AND NOT (#fbPowerX.Status AND #fbPowerZ.Status), PT := "DB_MachineConfig".Timeout_DriveReady);
    // Spindle decel wait: blocks RunCmd from going TRUE until VFD ramp-down completes
    #tonSpindleDecel(IN := #bSpindleDecelWait, PT := "DB_MachineConfig".SpindleDecelTime);
    // Pause resume spin-up wait: counts while bResumeSpeedup (Continue pressed in PAUSED).
    // IN drops to FALSE on reset/stop/error via bResumeSpeedup clears → ET resets, no stale fire.
    #tonResumeSpeedup(IN := #bResumeSpeedup, PT := "DB_MachineConfig".SpindleResumeSpeedupTime);
    IF #tonSpindleDecel.Q THEN
        #bSpindleDecelWait := FALSE;
        IF #bSpindlePendingStart THEN
            "DB_Spindle".Cmd_SetSpeed := #pendingSpindleSpeed;
            #bSpindleStart        := TRUE;
            #bSpindlePendingStart := FALSE;
        END_IF;
    END_IF;
    IF #timerRunning THEN
        "DB_HMI".ElapsedTime := #tonElapsed.ET;
        "DB_HMI".ElapsedSeconds := TIME_TO_DINT(#tonElapsed.ET / 1000);
    END_IF;
    // Reset timer on new program start
    IF #State = STATE_STARTING THEN
        #tonElapsed(IN := FALSE, PT := T#24h);  // Reset
        "DB_HMI".ElapsedTime := T#0s;
        "DB_HMI".ElapsedSeconds := 0;
    END_IF;
    
    // =========================================================================
    // PRODUCTION LOGGING - DB_Production
    // =========================================================================
    // Edge: cycle start (enter PRE_SCAN)
    IF (#State = STATE_PRE_SCAN) AND (#prevState <> STATE_PRE_SCAN) THEN
        "DB_Production".CurrentActive := TRUE;
        "DB_Production".CurrentProgram := #activeProgram;
        "DB_Production".TotalStarted := "DB_Production".TotalStarted + 1;
        #prodTimeStatus := RD_SYS_T(OUT => #prodTimeNow);
        "DB_Production".CurrentStartTime := #prodTimeNow;
    END_IF;
    
    // Edge: OK complete (enter state 100)
    IF (#State = 100) AND (#prevState <> 100) THEN
        "DB_Production".LastResult := 1;  // OK
        "DB_Production".LastProgram := #activeProgram;
        "DB_Production".LastDuration_s := "DB_HMI".ElapsedSeconds;
        "DB_Production".LastErrorCode := 0;
        "DB_Production".LastErrorLine := -1;
        "DB_Production".TotalOK := "DB_Production".TotalOK + 1;
        #prodTimeStatus := RD_SYS_T(OUT => #prodTimeNow);
        "DB_Production".LastEndTime := #prodTimeNow;
        "DB_Production".CurrentActive := FALSE;
        // History ring push removed 2026-07-31 (memory reclaim) -- see DB_Production
        // in 02_DataBlocks.scl. Last* summary above is the surviving record.
    END_IF;

    // Edge: NOK (enter STATE_ERROR with active cycle)
    IF (#State = STATE_ERROR) AND (#prevState <> STATE_ERROR) AND "DB_Production".CurrentActive THEN
        "DB_Production".LastResult := 2;  // NOK
        "DB_Production".LastProgram := #activeProgram;
        "DB_Production".LastDuration_s := "DB_HMI".ElapsedSeconds;
        "DB_Production".LastErrorCode := #fbAlarmManager.ActiveErrorCode;
        "DB_Production".LastErrorLine := "DB_Diagnostic".Error_Line;
        "DB_Production".TotalNOK := "DB_Production".TotalNOK + 1;
        #prodTimeStatus := RD_SYS_T(OUT => #prodTimeNow);
        "DB_Production".LastEndTime := #prodTimeNow;
        "DB_Production".CurrentActive := FALSE;
        // History ring push removed 2026-07-31 (memory reclaim) -- see DB_Production
        // in 02_DataBlocks.scl. Fault detail is retained in DB_AlarmHistory / DB_Error.
    END_IF;

    // Edge: STOPPED via STOP sequence (STOPPING → LOCK_RETRACT_WAIT → STOPPED, or legacy paths)
    IF (#State = STATE_STOPPED) AND
       ((#prevState = STATE_STOPPING) OR (#prevState = STATE_STOP_GOHOME) OR (#prevState = STATE_STOP_GOTOZERO)
        OR (#prevState = STATE_LOCK_RETRACT_WAIT)) AND
       "DB_Production".CurrentActive THEN
        "DB_Production".LastResult := 3;  // STOP
        "DB_Production".LastProgram := #activeProgram;
        "DB_Production".LastDuration_s := "DB_HMI".ElapsedSeconds;
        "DB_Production".LastErrorCode := 0;
        "DB_Production".LastErrorLine := -1;
        "DB_Production".TotalStopped := "DB_Production".TotalStopped + 1;
        #prodTimeStatus := RD_SYS_T(OUT => #prodTimeNow);
        "DB_Production".LastEndTime := #prodTimeNow;
        "DB_Production".CurrentActive := FALSE;
        // History ring push removed 2026-07-31 (memory reclaim) -- see DB_Production
        // in 02_DataBlocks.scl. Last* summary above is the surviving record.
    END_IF;

    // Production RESET: clear counters (history ring removed 2026-07-31)
    IF #prodResetEdge THEN
        "DB_Production".TotalStarted := 0;
        "DB_Production".TotalOK := 0;
        "DB_Production".TotalNOK := 0;
        "DB_Production".TotalStopped := 0;
        // Optionally also clear last cycle summary
        "DB_Production".LastResult := 0;
        "DB_Production".LastProgram := 0;
        "DB_Production".LastDuration_s := 0;
        "DB_Production".LastErrorCode := 0;
        "DB_Production".LastErrorLine := -1;
        "DB_Production".CurrentActive := FALSE;
    END_IF;
    
    // Last-cycle RESET: only clear last cycle summary (counters and history are preserved)
    IF #lastCycleResetEdge THEN
        "DB_Production".LastResult := 0;
        "DB_Production".LastProgram := 0;
        "DB_Production".LastDuration_s := 0;
        "DB_Production".LastErrorCode := 0;
        "DB_Production".LastErrorLine := -1;
    END_IF;
    
    // Update prevState for next cycle
    #prevState := #State;
    
    // =========================================================================
    // RECIPE HANDLER + PRE-SCAN - Execute based on active program
    // =========================================================================
    // Both FBs are called EVERY scan regardless of machine state.
    // fbPreScan: Execute=bPreScanExec is TRUE only inside STATE_PRE_SCAN; all
    // other states call it with FALSE so its internal state machine returns
    // DONE(99) -> IDLE(0) and rearms its rising-edge start for the next run.
    // (BUG FIX: previously called only inside STATE_PRE_SCAN with Execute held
    // TRUE, so validation only ever ran on the first cycle after power-up.)
    // 2026-08-04: was a five-way CASE binding DB_RecipeProgram1..5. Those DBs
    // now live in load memory and cannot be passed as an InOut reference at all.
    // Both FBs bind unconditionally to DB_SelectedRecipe, which STATE_RECIPE_LOAD(11)
    // fills before the pre-scan runs. One call site, no per-program duplication.
    // Reset wiring mirrors fbRecipeHandler below. NOTE: bDoHardReset must NOT be
    // used here -- the hard-reset block clears it earlier in this same scan, so it
    // is always FALSE by the time we get here. bResetRecipe is the one-shot with
    // the right lifecycle: set by the hard reset AND by every start path, consumed
    // here, cleared a few lines further down.
    #fbRecipeLoader(Execute   := #bRecipeLoadExec,
                    ProgramNo := #activeProgram,
                    Reset     := #fbInputs.Cmd_Reset OR #bResetRecipe);

    #fbRecipeHandler(Start := #bStartSeq, Stop := #fbInputs.Cmd_Stop,
                     Pause := #bPauseActive, Reset := #fbInputs.Cmd_Reset OR #bResetRecipe,
                     bStartEdge := #fbInputs.Cmd_Start,
                     StartLine := MAX(IN1 := INT#0, IN2 := #savedLineIndex),
                     LineCount := #activeLineCount,
                     Lines := "DB_SelectedRecipe".Lines,
                     Axis_X := #Axis_X, Axis_Z := #Axis_Z);
    #fbPreScan(Execute := #bPreScanExec, LineCount := #activeLineCount,
               Lines := "DB_SelectedRecipe".Lines);

    // bResetRecipe is a ONE-SHOT: self-cleared here, right after the handler call that
    // consumed it (same pattern as bHaltAllAxes below). Every setter runs earlier in the
    // scan (hard reset, STOPPED/MANUAL Start, ERROR ack/continue/restart, COMPLETE), so
    // the handler always sees it for exactly one scan.
    //
    // BUG FIX 2026-07-31: it used to be cleared ONLY in STATE_PRE_SCAN, so after power-up,
    // after any Cmd_Reset, and after an error acknowledge it stayed TRUE for as long as the
    // machine sat in STOPPED or MANUAL -- i.e. exactly when the operator uses the manual
    // page. FB_RecipeHandler is called every scan and its `IF #Reset THEN` block is level-
    // triggered, so it re-cleared BackSupport Cmd_Extend / Cmd_Retract / SolAtmo_Cmd every
    // scan, wiping the manual CMD=40/CMD=41 buttons and the MDI (both write earlier in the
    // scan, in the STATE_MANUAL branch). Nothing ever reached the OB1 output assignment.
    //
    // 2026-08-04: the program-number guard is gone. It existed because the old
    // five-way CASE called no handler at all outside 1..5, so the flag had to
    // survive to a scan where one ran. fbRecipeHandler is now called every scan
    // unconditionally, so it always consumes the flag immediately.
    #bResetRecipe := FALSE;

    // =========================================================================
    // END-OF-RECIPE BACKSUPPORT RETRACT  (operator spec 2026-08-07)
    // =========================================================================
    // "When a recipe is finished, fail or successful, de-energise Sol_A, Sol_B and
    //  SolAtmo -- retract with Sol_B for 2 s, then turn off -- so every next recipe
    //  can start clean."
    //
    // Deliberately placed AFTER the #fbRecipeHandler call above: the handler's
    // level-triggered `IF #Reset THEN` block also writes BackSupport commands, so
    // FB_Process must be the LAST writer of Cmd_Retract or the two would fight
    // within a single scan.
    //
    // EDGE, not level: STOPPED / ERROR / COMPLETE all run every scan while the
    // machine sits idle, so a level trigger would restart the retract forever.
    // bBSTerminalPrev is seeded TRUE by the bInitDone FIRST-SCAN block, so power-up
    // (which begins in STOPPED) does not fire an unexpected retract.
    //
    // The seed must NOT be moved into the general bDoHardReset block, however natural
    // that reads: bDoHardReset sets State := STOPPED at its top, so a pre-seeded edge
    // memory turns a Reset pressed while RUNNING into terminal->terminal -- no edge, no
    // retract, cylinder frozen mid-recipe. Nor may bDoHardReset clear bBSEndRetract: a
    // Reset landing inside the retract window would abandon the piston mid-stroke.
    // Both mistakes were made and caught on review 2026-08-09; see TODO.md ITEM-48.
    //
    // MANUAL(5) -> STOPPED(0) also fires this, because MANUAL is not a terminal
    // state. That is NOT a bug -- operator confirmed 2026-08-07 that retracting on
    // the way out of manual is wanted. A `#prevState <> STATE_MANUAL` guard was
    // offered and declined. Do not add one.
    #bBSTerminalNow := (#State = STATE_STOPPED) OR (#State = STATE_ERROR) OR (#State = 100);

    IF #bBSTerminalNow AND NOT #bBSTerminalPrev THEN
        #bBSEndRetract := TRUE;               // entered a terminal state this scan
    END_IF;
    IF NOT #bBSTerminalNow THEN
        IF #bBSEndRetract THEN
            // Left a terminal state part-way through the retract window (Start pressed, or
            // MANUAL entered). Drop Cmd_Retract together with the latch: nothing else in
            // this FB clears it, and the MANUAL route never raises bResetRecipe, so without
            // this the cylinder would be held retracting for the whole manual session.
            "DB_Cylinder_BackSupport".Cmd_Retract := FALSE;
        END_IF;
        #bBSEndRetract := FALSE;
    END_IF;
    #bBSTerminalPrev := #bBSTerminalNow;

    // Gated on E-Stop for the same reason as tonSheetHolderHold: FB_CylinderControl forces
    // State -1 and drops every coil while SafetyOK is FALSE (OB1 passes the same signal), so
    // an E-Stop during the window would run the timer out with the piston never moving and
    // leave the BackSupport frozen mid-stroke. Pausing the window instead means the retract
    // completes as soon as the E-Stop is released.
    #tonBSEndRetract(IN := #bBSEndRetract AND (#EStop_OK OR "DB_HMI".Bypass_EStop),
                     PT := "DB_MachineConfig".CylBackSupport_EndRetractTime);

    IF #bBSEndRetract THEN
        "DB_Cylinder_BackSupport".SolAtmo_Cmd := FALSE;   // atmosphere off for the whole sequence
        IF #tonBSEndRetract.Q THEN
            // Retract time elapsed: release Cmd_Retract. FB State 2 -> State 0
            // (09:617-619); Sol_A and Sol_B both drop and the 5/3 blocked centre
            // holds the piston where it stopped. This is the "all coils off" state.
            "DB_Cylinder_BackSupport".Cmd_Retract := FALSE;
            #bBSEndRetract := FALSE;
        ELSE
            // FB State 3 (or 0) -> State 2: Sol_A off, Sol_B on (09:828-830).
            // Cmd_Extend must go first -- State 1 ignores Cmd_Retract while it is held.
            "DB_Cylinder_BackSupport".Cmd_Extend  := FALSE;
            "DB_Cylinder_BackSupport".Cmd_Retract := TRUE;
        END_IF;
    END_IF;

    // Homing -- sequential pattern: STATE_HOMING (startup) and STATE_STOP_GOHOME (post-stop)
    // both use homeSeqState + bHomeXExec/bHomeZExec.
    // Mode SEL: mode 3 (active+zero) is forced in STATE_HOMING; other states use DB_Manual.HomingMode.
    #fbHomeX(
        Execute := #bHomeXExec,
        Mode := SEL(G := (#State = STATE_HOMING AND #bHomeXExec), IN0 := 3, IN1 := "DB_Manual".HomingMode),
        Position := "DB_MachineConfig".HomeOffset_X,
        Axis := #Axis_X
    );
    #fbHomeZ(
        Execute := #bHomeZExec,
        Mode := SEL(G := (#State = STATE_HOMING AND #bHomeZExec), IN0 := 3, IN1 := "DB_Manual".HomingMode),
        Position := "DB_MachineConfig".HomeOffset_Z,
        Axis := #Axis_Z
    );
    #fbHomeTool(
        Execute  := #bHomeToolExec,
        Mode     := SEL(G := (#State = STATE_HOMING AND #bHomeToolExec), IN0 := 3, IN1 := "DB_Manual".HomingMode),
        Position := 0.0,
        Axis     := #Axis_Tool
    );
    // PNP halt FBs: Execute stays TRUE until bHaltX/Z_PNP is cleared (on return to STATE_STOPPED)
    #fbHaltX_PNP(Execute := #bHaltX_PNP, Axis := #Axis_X);
    #fbHaltZ_PNP(Execute := #bHaltZ_PNP, Axis := #Axis_Z);
    // ITEM-31: reset/startup halt — MC_Halt rising edge fires on the scan that bDoHardReset or
    // first-scan startup set bHaltAllAxes TRUE. Aborts any MC_Home command still active in the TO.
    // bHaltAllAxes is self-cleared here (after the calls) so the rising edge occurs for exactly one scan.
    // Must NOT be cleared earlier (e.g. in STATE_STOPPED CASE) — state machine runs before this section.
    #fbHaltX_Reset(Execute    := #bHaltAllAxes, Axis := #Axis_X);
    #fbHaltZ_Reset(Execute    := #bHaltAllAxes, Axis := #Axis_Z);
    #fbHaltTool_Reset(Execute := #bHaltAllAxes, Axis := #Axis_Tool);
    #bHaltAllAxes := FALSE;  // Self-clearing: active for exactly one scan
    
    // Tool changer -- only rotates the turret; axis positioning done by G-code
    #fbToolChanger(Execute := #bToolExecute, ToolNumber := #activeToolReq,
                   Axis_Tool := #Axis_Tool);

    // Belt-and-braces clamp for the clearance/park move target. parkTargetX/Z are already
    // clamped (computed before the state machine); this also covers the STATE_PRE_HOME_CLR
    // target, which is derived from HomeOffset + PostHome_Clearance.
    #clrTargetX  := MIN(IN1 := MAX(IN1 := #clrTargetX,
                                   IN2 := "DB_MachineConfig".SoftLimit_MinX),
                        IN2 := "DB_MachineConfig".SoftLimit_MaxX);
    #clrTargetZ  := MIN(IN1 := MAX(IN1 := #clrTargetZ,
                                   IN2 := "DB_MachineConfig".SoftLimit_MinZ),
                        IN2 := "DB_MachineConfig".SoftLimit_MaxZ);
    // Defensive: every path that sets bHomeClrX/Z also sets clrVelocity in the same scan,
    // but a zero velocity would fail MC_MoveAbsolute rather than move slowly. Never pass 0.
    IF #clrVelocity <= 0.0 THEN
        #clrVelocity := "DB_MachineConfig".RapidVelocity;
    END_IF;

    // Stop/park move -- STATE_STOPPING sends both axes to the sheet-load park position
    // (was hardcoded 0.0 before the sheet-load park change).
    #fbMoveX_Stop(Execute := #bStopMoveX, Position := #parkTargetX, Velocity := "DB_MachineConfig".RapidVelocity, Axis := #Axis_X);
    #fbMoveZ_Stop(Execute := #bStopMoveZ, Position := #parkTargetZ, Velocity := "DB_MachineConfig".RapidVelocity, Axis := #Axis_Z);
    // Clearance / park moves. Target comes from #clrTargetX/Z, set by the caller state:
    //   STATE_PRE_HOME_CLR  (13) -- HomeOffset + PostHome_Clearance (PNP escape before homing)
    //   STATE_POST_HOME_CLR (16) -- SheetLoadPos (park for sheet loading)
    #fbMoveX_HomeClr(Execute  := #bHomeClrX,
                     Position := #clrTargetX,
                     Velocity := #clrVelocity,
                     Axis     := #Axis_X);
    #fbMoveZ_HomeClr(Execute  := #bHomeClrZ,
                     Position := #clrTargetZ,
                     Velocity := #clrVelocity,
                     Axis     := #Axis_Z);
    
    // Manual mode - sync aliases first
    // Soft-limit jog gating (manual): once an axis is HOMED, jogging deeper past a
    // configured soft limit is blocked; jogging back toward the valid range always
    // passes (same escape pattern as PNP below -- never fault, never trap the operator).
    // Un-homed axes are NOT gated: position is meaningless before the reference seek,
    // so soft limits cannot apply. Tool axis (SelectedAxis=2) is never gated here.
    #bJogBlockPlus :=
        ("DB_Manual".SelectedAxis = 0 AND #Axis_X.StatusBits.HomingDone
         AND #Axis_X.ActualPosition >= "DB_MachineConfig".SoftLimit_MaxX) OR
        ("DB_Manual".SelectedAxis = 1 AND #Axis_Z.StatusBits.HomingDone
         AND #Axis_Z.ActualPosition >= "DB_MachineConfig".SoftLimit_MaxZ);
    #bJogBlockMinus :=
        ("DB_Manual".SelectedAxis = 0 AND #Axis_X.StatusBits.HomingDone
         AND #Axis_X.ActualPosition <= "DB_MachineConfig".SoftLimit_MinX) OR
        ("DB_Manual".SelectedAxis = 1 AND #Axis_Z.StatusBits.HomingDone
         AND #Axis_Z.ActualPosition <= "DB_MachineConfig".SoftLimit_MinZ);
    // In STATE_PNP_HALT: additionally block jog direction that would drive the axis
    // deeper into the PNP zone. Jog toward the active PNP zone is blocked; jog away
    // (escape direction) is passed through.
    IF #State = STATE_PNP_HALT THEN
        "DB_Manual".Jog_Plus  := "DB_Manual".Btn_JogPlus AND NOT #bJogBlockPlus AND NOT (
            ("DB_Manual".SelectedAxis = 0 AND #HW_PNP_X_Max) OR
            ("DB_Manual".SelectedAxis = 1 AND #HW_PNP_Z_Max));
        "DB_Manual".Jog_Minus := "DB_Manual".Btn_JogMinus AND NOT #bJogBlockMinus AND NOT (
            ("DB_Manual".SelectedAxis = 0 AND #HW_PNP_X_Min) OR
            ("DB_Manual".SelectedAxis = 1 AND #HW_PNP_Z_Min));
    ELSE
        "DB_Manual".Jog_Plus  := "DB_Manual".Btn_JogPlus  AND NOT #bJogBlockPlus;
        "DB_Manual".Jog_Minus := "DB_Manual".Btn_JogMinus AND NOT #bJogBlockMinus;
    END_IF;
    "DB_Manual".Btn_HomeAxis := "DB_Manual".Btn_Home;

    #fbManualMode(Enable := (#State = STATE_MANUAL OR #State = STATE_PNP_HALT),
                  SelectedAxis := "DB_Manual".SelectedAxis,
                  Jog_Plus := "DB_Manual".Jog_Plus, Jog_Minus := "DB_Manual".Jog_Minus, 
                  JogSpeed := "DB_Manual".JogSpeed,
                  MoveAbsolute := "DB_Manual".Btn_MoveAbsolute, TargetPosition := "DB_Manual".MoveToPosition,
                  HomeAxis := "DB_Manual".Btn_HomeAxis, HomeAll := "DB_Manual".Btn_HomeAll,
                  HomingMode := "DB_Manual".HomingMode, HomePosition := 0.0,
                  GoSafe := "DB_Manual".Btn_GoSafe, GoZero := "DB_Manual".Btn_GoZero,
                  SafeToJog := #fbSafetyMonitor.SafeToJog, Reset := #fbInputs.Cmd_Reset,
                  PNP_X_Min := #HW_PNP_X_Min, PNP_Z_Min := #HW_PNP_Z_Min,
                  ToolStepCW := "DB_Manual".Btn_ToolStepCW, ToolStepCCW := "DB_Manual".Btn_ToolStepCCW,
                  ToolStepAngle := "DB_Manual".ToolStepAngle, ToolStepSpeed := "DB_Manual".ToolStepSpeed,
                  Axis_X := #Axis_X, Axis_Z := #Axis_Z, Axis_Tool := #Axis_Tool, Axis_Spindle := #Axis_Spindle);
    
    // Update manual mode status
    "DB_Manual".JogBusy := #fbManualMode.Busy;
    "DB_Manual".ManualBusy := #fbManualMode.Busy;       // Alias
    "DB_Manual".JogError := #fbManualMode.Error;
    "DB_Manual".ManualError := #fbManualMode.Error;     // Alias
    "DB_Manual".JogErrorID := #fbManualMode.ErrorID;
    "DB_Manual".ManualErrorID := #fbManualMode.ErrorID; // Alias
    "DB_Manual".SelectedAxisPos := SEL(G := "DB_Manual".SelectedAxis = 0, 
                                        IN0 := #Axis_Z.ActualPosition, IN1 := #Axis_X.ActualPosition);
    "DB_Manual".SelectedAxisName := SEL(G := "DB_Manual".SelectedAxis = 0, IN0 := 'Z', IN1 := 'X');
    "DB_Manual".ToolPosition := #Axis_Tool.ActualPosition;
    "DB_Manual".ActiveAxis := #fbManualMode.ActiveAxis;

    // Forward manual mode errors to alarm manager (once, on rising edge)
    IF #fbManualMode.Error AND NOT #prevManualError THEN
        #newErrorFlag := TRUE;
        #newErrorCode := #fbManualMode.ErrorID;
        // Single-writer: ErrorText comes from the FB_AlarmManager CASE table for the code.
        // DB_HMI.ErrorDetail is written directly inside FB_ManualMode at each error point.
    END_IF;
    #prevManualError := #fbManualMode.Error;

    // =========================================================================
    // SPINDLE CONTROL
    // Manual mode spindle control via DB_Manual buttons
    // Recipe handler spindle control via bSpindleStart/bSpindleStop flags
    // =========================================================================
    // Capture inputs BEFORE calling the FB so Diag_* reflects this scan's values.
    "DB_Spindle".Diag_bSpindleStart := #bSpindleStart;
    "DB_Spindle".Diag_bSpindleStop  := #bSpindleStop;
    "DB_Spindle".Diag_EnableInput   := #bDrivesEnable;
    "DB_Spindle".Diag_StartInput    := "DB_Manual".Btn_SpindleStart OR #bSpindleStart;
    "DB_Spindle".Diag_StopInput     := "DB_Manual".Btn_SpindleStop OR #bSpindleStop OR #fbInputs.Cmd_Stop;
    "DB_Spindle".Diag_ReqStart      := #fbRecipeHandler.SpindleReqStart;
    "DB_Spindle".Diag_ReqStop       := #fbRecipeHandler.SpindleReqStop;
    // -------------------------------------------------------------------------
    // Spindle history ring buffer: push snapshot on any meaningful change.
    // Trigger fields: SpindleState, PrevStart, ReqStart, StartEdge.
    // Reading tip: sort Hist_Log[0..19] by .Seq to get chronological order.
    // -------------------------------------------------------------------------
    IF "DB_Spindle".Hist_Clear THEN
        "DB_Spindle".Hist_Head   := 0;
        "DB_Spindle".Hist_Count  := 0;
        "DB_Spindle".Hist_SeqNum := 0;
        "DB_Spindle".Hist_Clear  := FALSE;
    ELSIF ("DB_Spindle".Diag_SpindleState <> #prevSnap_State)
       OR ("DB_Spindle".Diag_PrevStart    <> #prevSnap_PrevStart)
       OR ("DB_Spindle".Diag_ReqStart     <> #prevSnap_ReqStart)
       OR ("DB_Spindle".Diag_StartEdge    <> #prevSnap_StartEdge)
       OR ("DB_Spindle".Diag_MoveVelBusy  <> #prevSnap_MoveVelBusy) THEN
        // Push new entry at Hist_Head
        "DB_Spindle".Hist_Log["DB_Spindle".Hist_Head].Seq          := "DB_Spindle".Hist_SeqNum;
        "DB_Spindle".Hist_Log["DB_Spindle".Hist_Head].MachineState := #State;
        "DB_Spindle".Hist_Log["DB_Spindle".Hist_Head].State        := "DB_Spindle".Diag_SpindleState;
        "DB_Spindle".Hist_Log["DB_Spindle".Hist_Head].ReqStart     := "DB_Spindle".Diag_ReqStart;
        "DB_Spindle".Hist_Log["DB_Spindle".Hist_Head].ReqStop      := "DB_Spindle".Diag_ReqStop;
        "DB_Spindle".Hist_Log["DB_Spindle".Hist_Head].bStart       := "DB_Spindle".Diag_bSpindleStart;
        "DB_Spindle".Hist_Log["DB_Spindle".Hist_Head].bStop        := "DB_Spindle".Diag_bSpindleStop;
        "DB_Spindle".Hist_Log["DB_Spindle".Hist_Head].StartInput   := "DB_Spindle".Diag_StartInput;
        "DB_Spindle".Hist_Log["DB_Spindle".Hist_Head].StopInput    := "DB_Spindle".Diag_StopInput;
        "DB_Spindle".Hist_Log["DB_Spindle".Hist_Head].EnableIn     := "DB_Spindle".Diag_EnableInput;
        "DB_Spindle".Hist_Log["DB_Spindle".Hist_Head].PrevStart    := "DB_Spindle".Diag_PrevStart;
        "DB_Spindle".Hist_Log["DB_Spindle".Hist_Head].StartEdge    := "DB_Spindle".Diag_StartEdge;
        "DB_Spindle".Hist_Log["DB_Spindle".Hist_Head].MoveVelBusy  := "DB_Spindle".Diag_MoveVelBusy;
        "DB_Spindle".Hist_Log["DB_Spindle".Hist_Head].MoveVelInVel := "DB_Spindle".Diag_MoveVelInVel;
        // Advance ring buffer pointer
        "DB_Spindle".Hist_SeqNum := "DB_Spindle".Hist_SeqNum + 1;
        "DB_Spindle".Hist_Head   := ("DB_Spindle".Hist_Head + 1) MOD 20;
        IF "DB_Spindle".Hist_Count < 20 THEN
            "DB_Spindle".Hist_Count := "DB_Spindle".Hist_Count + 1;
        END_IF;
        // Latch current values for next-scan comparison
        #prevSnap_State       := "DB_Spindle".Diag_SpindleState;
        #prevSnap_PrevStart   := "DB_Spindle".Diag_PrevStart;
        #prevSnap_ReqStart    := "DB_Spindle".Diag_ReqStart;
        #prevSnap_StartEdge   := "DB_Spindle".Diag_StartEdge;
        #prevSnap_MoveVelBusy := "DB_Spindle".Diag_MoveVelBusy;
    END_IF;
    // RunCmd is a level signal (TRUE = run).
    // The CALLER must:
    //   • Set SetSpeed before raising RunCmd
    //   • Lower RunCmd to stop (do not change SetSpeed while RunCmd is TRUE)
    //   • For a speed change: lower RunCmd → update SetSpeed → raise RunCmd again
    #fbSpindleControl(
        Enable   := #bDrivesEnable,
        // Spindle stops while paused (State=PAUSED and NOT yet in the resume spin-up
        // window). This drops RunForward only — no MC_Halt — so the PTO keeps pulsing
        // (VFD-safe stop, same mechanism as a normal stop). On Continue, bResumeSpeedup
        // re-enables it for the spin-up wait before the axes return.
        RunCmd   := ("DB_Manual".Btn_SpindleStart OR #bSpindleStart)
                    AND NOT ("DB_Manual".Btn_SpindleStop OR #bSpindleStop OR #fbInputs.Cmd_Stop
                             OR (#State = STATE_PAUSED AND NOT #bResumeSpeedup)),
        SetSpeed := SEL(G := (#State = STATE_MANUAL),
                        IN0 := "DB_Spindle".Cmd_SetSpeed,
                        IN1 := "DB_Manual".Manual_SpindleSpeed),
        SpeedOverride := "DB_Spindle".SpeedOverride,
        Reset    := #fbInputs.Cmd_Reset,
        AckError := #ackEdge OR "DB_Manual".Btn_SpindleAckError,
	RunForward := "PTO_RunForward_AxisS",
        Axis_Spindle := #Axis_Spindle
    );
    // Write FB outputs back to DB_Spindle so HMI tags reflect actual state
    "DB_Spindle".IsRunning    := #fbSpindleControl.Running;
    "DB_Spindle".AtSpeed      := #fbSpindleControl.AtSpeed;
    "DB_Spindle".ActualSpeed  := #fbSpindleControl.ActualSpeed;

    // =========================================================================
    // TOOLHEADLOCK CONTROL
    // Written every scan so FB_CylinderControl (called from OB1) sees the
    // correct command on the next scan.
    //
    // EXTEND (Sol_A ON):  STATE_RUNNING (20), STATE_PAUSED (25), STATE_LOCK_EXTEND_WAIT (17)
    // RETRACT (spring):   all other states -- cylinder retracts automatically via spring return.
    //
    // Safety: spring-return valve retracts on power loss without any PLC action.
    // State 17 checks AtSetpoint for extend confirmation only -- no fallback timer in FB_Process.
    // CylFB Timeout_Extend (T#6S in DB_Cylinder_ToolHeadLock) is the sole timer; on timeout
    // CylFB sets Error=TRUE, state 17 catches it and goes to STATE_ERROR (16#0012).
    // State 29 uses tonLockWait only (spring retract; no retract sensor).
    // =========================================================================
    "DB_Cylinder_ToolHeadLock".Cmd_Extend :=
        (#State = STATE_RUNNING) OR
        (#State = STATE_PAUSED) OR
        (#State = STATE_LOCK_EXTEND_WAIT AND #tonLockPreDelay.Q);

    // Diagnostic output
    "DB_Diagnostic".Process_State        := #State;
    "DB_Diagnostic".Process_SafeToRun    := #SafeToRun;
    "DB_Diagnostic".Process_DrivesEnable := #bDrivesEnable;
    "DB_Diagnostic".Recipe_CurrentProgram := #activeProgram;
    "DB_Diagnostic".Recipe_TotalLines    := #activeLineCount;
    "DB_Diagnostic".Axis_X_Pos           := #Axis_X.ActualPosition;
    "DB_Diagnostic".Axis_Z_Pos           := #Axis_Z.ActualPosition;
    "DB_Diagnostic".Axis_X_Enabled       := #fbPowerX.Status;
    "DB_Diagnostic".Axis_Z_Enabled       := #fbPowerZ.Status;
    "DB_Diagnostic".Axis_X_Homed         := #Axis_X.StatusBits.HomingDone;
    "DB_Diagnostic".Axis_Z_Homed         := #Axis_Z.StatusBits.HomingDone;

    // =========================================================================
    // CONTACTOR CONTROL -- called as the last step of FB_Process.
    // FC_ContactorControl reads DB_HMI.Btn_Contactor_* and Bypass_EStop/HasError.
    // In auto mode STATE_STARTING already sets these flags TRUE; they are reflected to I/O here.
    // Called here rather than from OB1 to ensure contactor logic runs in sync with the process.
    // =========================================================================
    "FC_ContactorControl"();
END_FUNCTION_BLOCK
