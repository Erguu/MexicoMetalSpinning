// =============================================================================
// 02_DataBlocks.scl
// All non-recipe data blocks.
// Recipe program DBs (DB_RecipeProgram1..10) are in 02b_RecipePrograms.scl.
// They live in LOAD memory; the machine runs from DB_SelectedRecipe (this file).
// Target: CPU 1214C (100KB work memory)
// =============================================================================

// -----------------------------------------------------------------------------
// DB_HMI - Human Machine Interface data
// -----------------------------------------------------------------------------
DATA_BLOCK "DB_HMI"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.3
NON_RETAIN
    VAR 
        // ===========================================================
        // BUTTONS (Input) - Version_GCODE compatible
        // ===========================================================
        Btn_Start : Bool;           // Start machine
        Btn_Stop : Bool;            // Stop machine
        Btn_Pause : Bool;           // Pause/Resume toggle
        Btn_Reset : Bool;           // Reset program to beginning
        Btn_ApplyToolConfig : Bool;  // Apply tool-slot codes from HMI to DB_ToolConfig
        Btn_AckError : Bool;        // Acknowledge error → transitions from STATE_ERROR to STOPPED
        Btn_Continue : Bool;        // Continue from pause (PAUSED) -- STATE_PAUSED → RUNNING
        Btn_Restart : Bool;         // STATE_ERROR or PAUSED → STOPPED (restart with Start)
        Btn_ProdReset : Bool;       // Reset production counters + history
        Btn_LastCycleReset : Bool;  // Reset last cycle summary only (counters preserved)
                                    // NOTE: Btn_ProdReset already does this too.
                                    // If not adding both as separate HMI buttons, Btn_LastCycleReset
                                    // is redundant -- do not connect to HMI if unused.
        
        // ===========================================================
        // MODE SELECTION (Input)
        // ===========================================================
        ProductSelect : Int := 1;           // Recipe selector (1-10) -- 10 programs since 2026-08-04
        FeedrateOverride : Real := 100.0;   // Speed % for G1 moves (50-200, 100=normal)
        RapidOverride : Real := 100.0;      // Speed % for G0 rapid moves (50-200)
        SingleStepMode : Bool := FALSE;     // TRUE = stop after each line, wait for StepNext
        StepNext : Bool := FALSE;           // Pulse to advance one step in SingleStepMode
        
        // Program names and validity -- PLC does NOT write to these tags.
        // Written by CAM post-processor or HMI operator.
        // Can be read for displaying the program list on HMI.
        // Extended 1..5 -> 1..10 on 2026-08-04 with the load-memory recipe change.
        // HMI ACTION REQUIRED: the HMI project must be updated to match, or entries
        // 6..10 will be unnamed and unselectable from the program list screen.
        ProgramNames : Array[1..10] of String[20];  // Operator-defined program names
        ProgramValid : Array[1..10] of Bool;        // Is program loaded? (written by HMI/CAM)
        
        // Tool slot codes editable from HMI. Enter external codes like 101, 406 etc.
        // These are copied to DB_ToolConfig.ToolCode_List when operator presses Apply.
        ToolSlotCode : Array[1..4] of Int := [101, 102, 103, 104];
        
        // ===========================================================
        // POSITION DISPLAYS (Output)
        // ===========================================================
        ActualX : Real;             // Current X position (mm)
        ActualZ : Real;             // Current Z position (mm)
        
        // ===========================================================
        // STATUS DISPLAYS (Output)
        // ===========================================================
        StatusMsg : String[50];     // Status message text
        MachineState : Int;         // State machine state
        CurrentLine : Int;          // Current line being executed
        TotalLines : Int;           // Total lines in program
        ProgressPercent : Real;     // Progress 0-100%
        CurrentTool : Int;          // Active tool (1-4)
        FeedrateActive : Real;      // Actual feedrate (mm/min)
        // ⚠️ UNUSED: PLC code does not write to the Axis_Status_* tags below anywhere.
        // They will always be 0 / empty if connected to HMI. Reserved for future use
        // -- do not display on HMI for now.
        Axis_Status_X        : Int;
        Axis_Status_Z        : Int;
        Axis_Status_Spindle  : Int;
        Axis_Status_Toolhead : Int;
        Axis_Status_X_Str        : String[10];
        Axis_Status_Z_Str        : String[10];
        Axis_Status_Spindle_Str  : String[10];
        Axis_Status_Toolhead_Str : String[10];
        // ===========================================================
        // STATUS LAMPS (Output)
        // ===========================================================
        IsRunning : Bool;           // Machine is running
        IsPaused : Bool;            // Machine is paused
        HasError : Bool;            // Error is active
        ElapsedTime : Time;         // Program elapsed time
        ElapsedSeconds : DInt;      // Elapsed time in seconds (for HMI display)
        CycleCount : Int;           // Number of completed programs
        
        // ===========================================================
        // ERROR DISPLAY (Output)
        // ===========================================================
        ErrorID : Word;             // Error code (0=OK)
        ErrorText : String[100];     // Error description
        ErrorDetail : String[120];   // Additional error info

        // ===========================================================
        // WARNING DISPLAY (Output)
        // ===========================================================
        HasWarning : Bool;          // TRUE when a non-blocking warning is active (E-Stop bypass or sheet insert prompt)
        WarningText : String[70];   // Warning message text -- English (E-Stop bypass or operator prompts only)
        ResumeLine : Int := -1;     // Saved recipe line for warm restart (-1 = none). Set in STATE_ERROR, cleared on Btn_Restart.

        // ===========================================================
        // SPANISH TEXT MIRRORS (Output) -- for Mexican operator HMI
        // PLC writes these every scan alongside the English equivalents.
        // Connect to a second-language screen or a language-toggle switch.
        // ===========================================================
        StatusMsg_ES    : String[50];   // Estado actual (Español)
        ErrorText_ES    : String[100];   // Descripcion de error (Español)
        ErrorDetail_ES  : String[120];   // Detalle adicional (Español)
        WarningText_ES  : String[80];   // Advertencia (Español)
        
        // ===========================================================
        // BYPASS SWITCHES (for testing) - Version_GCODE compatible
        // ⚠️ All bypasses reset to FALSE on restart (FC_LoadConfig).
        // All must be FALSE in production.
        // ===========================================================
        Bypass_EStop        : Bool := FALSE;  // Used in FB_SafetyMonitor ✅
        Bypass_Door         : Bool := TRUE;  // Used in FB_SafetyMonitor ✅
        Bypass_AirPressure  : Bool := TRUE;  // Used in FB_SafetyMonitor ✅
        Bypass_Drives       : Bool := FALSE;  // Used in FB_SafetyMonitor ✅
        Bypass_Spindle      : Bool := FALSE;  // Skips spindle commands in recipe (FB_RecipeHandler) -- dry run / commissioning
        Bypass_ToolChanger  : Bool := FALSE;  // ⚠️ UNUSED -- not in safety monitor
        Bypass_MandrelLock  : Bool := FALSE;  // TRUE = machine variant without MandrelLock cylinder (manual clamping)
        Bypass_ToolHeadLock : Bool := FALSE;  // TRUE = skip ToolHeadLock sensor wait in STATE_LOCK_EXTEND_WAIT (no cylinder/sensor); cylinder still commanded if present
        
        // ===========================================================
        // BOUNDING BOX (Output - from pre-scan)
        // ===========================================================
        BoundingBox_MinX : Real;
        BoundingBox_MaxX : Real;
        BoundingBox_MinZ : Real;
        BoundingBox_MaxZ : Real;
        BoundingBox_Valid : Bool;
        PreScanProgress : Real := 0.0;  // Pre-scan progress 0-100% (written during STATE_PRE_SCAN)

        // ===========================================================
        // MANUAL > MANAGE: Contactor & Enable controls (Input)
        // HMI writes these; PLC drives physical outputs in OB1.
        // Buttons are toggles (maintained, not momentary).
        // ===========================================================
        Btn_Contactor_X       : Bool;   // Energize X driver contactor
        Btn_Contactor_Z       : Bool;   // Energize Z driver contactor
        Btn_Contactor_Tool    : Bool;   // Energize Tool driver contactor
        Btn_Contactor_Spindle : Bool;   // Energize Spindle driver contactor
        Btn_Enable_X          : Bool;   // Send enable signal to X drive
        Btn_Enable_Z          : Bool;   // Send enable signal to Z drive

        // MANUAL > MANAGE: Status feedback (Output) for HMI lamps
        // PLC writes these back after applying safety interlock.
        Contactor_X_On       : Bool;
        Contactor_Z_On       : Bool;
        Contactor_Tool_On    : Bool;
        Contactor_Spindle_On : Bool;
        Enable_X_On          : Bool;
        Enable_Z_On          : Bool;

        // ===========================================================
        // E-STOP DUAL CHANNEL STATUS (Output - PLC writes, HMI reads)
        // ===========================================================
        EStop_Ch1_OK      : Bool;   // Channel 1 contact state (TRUE=closed=safe)
        EStop_Ch2_OK      : Bool;   // Channel 2 contact state (TRUE=closed=safe)
        EStop_Discrepancy : Bool;   // Ch1 ≠ Ch2 → contact fault, service required
    END_VAR
BEGIN
END_DATA_BLOCK

// -----------------------------------------------------------------------------
// DB_MachineConfig - Machine configuration parameters
// -----------------------------------------------------------------------------
DATA_BLOCK "DB_MachineConfig"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.2
NON_RETAIN
    VAR
        // =====================================================================
        // HMI-EDITABLE: Machine Physical Limits (mm)
        // These values are NOT overwritten by FC_LoadConfig.
        // Can be changed from HMI Setup screen; preserved on PLC restart.
        // =====================================================================
        SoftLimit_MinX : Real := -30.0;     // X minimum (home=0)
        SoftLimit_MaxX : Real := 500.0;   // X maximum travel (mm)
        SoftLimit_MinZ : Real := -50.0;  // Z minimum (negative = mandrel front / clearance)
        SoftLimit_MaxZ : Real := 500.0;   // Z maximum (forming depth)

        // HMI-EDITABLE: Safe Positions (mm)
        SafePos_X : Real := 0.0;         // "Go Safe" X target
        SafePos_Z : Real := 0.0;        // "Go Safe" Z target (clearance zone)

        // HMI-EDITABLE: Sheet-Load Park Position (mm)
        // The single position the machine parks at whenever it is waiting for the
        // operator to load a sheet. Reached at the end of every program (STATE_COMPLETE
        // is not used -- the park move is the STOPPING/POST_HOME_CLR path), after every
        // homing cycle, and after a Stop. STATE_STARTING compares the live axis position
        // against it to decide whether the homing seek can be skipped (fast cycle mode).
        //
        // SAFETY: this is where the operator reaches in to insert a sheet and where the
        // MandrelLock clamps. Set it only to a position where the tool head does not
        // obstruct loading. Commission conservatively (near 0,0) and walk it in.
        // Targets are clamped to SoftLimit_Min/Max before any move is issued.
        //
        // Deliberately NOT written by FC_LoadConfig, so OB100 does not fight the HMI.
        SheetLoadPos_X : Real := 200.0;    // Sheet-load park X target (mm)
        SheetLoadPos_Z : Real := 170.0;    // Sheet-load park Z target (mm)
        SheetLoadTol   : Real := 2.0;    // +/- window counted as "at the park position" (mm)

        // HMI-EDITABLE: Pause Retract (mm / mm/s)
        // On Pause, X and Z jog by these signed offsets to pull the tool clear
        // (spindle keeps running). On Continue they return to the exact interruption
        // point before the recipe resumes. Retract target is clamped to soft limits.
        // Offset 0 = that axis does not move on pause. See docs/FB_Process_States.md
        // (STATE_PAUSED) for the full pause/resume sequence.
        PauseRetract_X   : Real := -10.0;   // Pause retract offset X (signed, mm)
        PauseRetract_Z   : Real := -10.0;   // Pause retract offset Z (signed, mm)
        PauseRetract_Vel : Real := 20.0;    // Retract/return velocity (mm/s)

        // HMI-EDITABLE: Homing Parameters
        HomeOffset_X : Real := 0.0;       // X set value after homing
        HomeOffset_Z : Real := 0.0;       // Z set value after homing
        HomeVelocity : Real := 10.0;      // Homing clearance velocity (mm/s)
        PostHome_Clearance : Real := 10.0; // Distance to clear PNP zone after homing (mm)
        // HMI-EDITABLE: fast cycle mode master switch.
        //   TRUE  = home all axes on every auto start (legacy behaviour)
        //   FALSE = skip the reference seek when the reference is trusted AND the axes
        //           are parked at SheetLoadPos (see FB_Process STATE_STARTING)
        // This switch can only ever skip homing in the NORMAL case. It never overrides
        // FB_Process bRequireHoming -- an E-Stop, a fault or a power-up always re-homes.
        AlwaysHomeOnAutoStart : Bool := FALSE;

        // ⚠️ UNUSED: The following two parameters are not read anywhere in PLC code.
        // Recipe handler takes its own feedrate from the recipe line.
        // Do not connect to HMI. May be used if manual tool change sequence is added later.
        ToolChangePos_X : Real := 0.0;   // (Unused) Safe X for manual tool change
        ToolChangePos_Z : Real := 0.0;  // (Unused) Safe Z for manual tool change
        DefaultFeedrate : Real := 100.0;  // (Unused) Default feedrate

        // =====================================================================
        // FIXED: Hardware/TO Limits -- must not be changed from HMI
        // FC_LoadConfig (OB100) writes these values on every restart.
        // =====================================================================
        MaxVelocity : Real := 40.0;     // mm/s - TO max velocity
        RapidVelocity : Real := 40.0;   // mm/s - G0 rapid speed
        MinVelocity : Real := 1.0;      // mm/s - TO minimum
        FeedrateConvFactor : Real := 60.0; // divisor to convert recipe F (mm/min) to axis velocity (mm/s)

        // Tool Configuration -- HMI-EDITABLE: active slot count (1-4)
        ToolCount    : Int  := 3;
        ToolVelocity : Real := 50.0;   // deg/s -- turret rotation speed (clamped by TO max)

        // Hardware configuration -- set TRUE if this axis is not physically connected to the machine
        // (different from HMI bypasses: this is a hardware presence flag)
        Bypass_ToolAxis : Bool := FALSE;
	Bypass_MandrelLock : BOOL := FALSE;
        // Spindle deceleration wait: time between RunCmd=FALSE and next RunCmd=TRUE.
        // Set to match VFD deceleration ramp time. HMI-editable.
        SpindleDecelTime : Time := T#2S;
        // Pause resume spin-up wait: on Continue from PAUSED, the spindle is
        // restarted and this time is allowed for it to ramp back up to speed
        // BEFORE the axes return to the interruption point and machining resumes.
        // The axes stay clear of the workpiece (held at the pause-retract position)
        // for this whole window. Set to the measured VFD ramp-up time + margin.
        SpindleResumeSpeedupTime : Time := T#5S;
        // Load-memory recipe copy (FB_RecipeLoader, STATE_RECIPE_LOAD(11)):
        // hang watchdog on the READ_DBL transfer. A 1000-line recipe is ~12 KB
        // and completes in well under a second; this only catches a transfer
        // that never reports BUSY=FALSE. Expiry -> 16#0312, machine goes to
        // STATE_ERROR rather than starting a cycle on a half-copied recipe.
        RecipeLoadTimeout : Time := T#10S;
        // In-place spindle speed change (FB_SpindleControl): how long MC_MoveVelocity
        // Execute is held LOW to regenerate the trigger edge for the new velocity.
        // RunForward (VFD run) stays TRUE throughout -- only the PTO command edge is
        // regenerated. T#0S = one PLC scan. Increase if the VFD needs more settle
        // time before the new velocity command. Tune on-site.
        SpindleSpeedChange_ExecLowTime : Time := T#0S;
        // Speed-change mode selector (VFD-dependent -- confirm on the bench):
        //   FALSE = keep RunForward TRUE during the change (VFD tracks pulse-train
        //           frequency live; this is the documented wiring intent).
        //   TRUE  = also drop RunForward during the Execute-low window, then re-assert
        //           it. Use only if the drive latches its frequency at the RunForward
        //           rising edge and ignores a live frequency change. Safe re: PTO --
        //           the pulse train keeps running; RunForward is the stop signal.
        SpindleSpeedChange_DropRunForward : Bool := FALSE;
        // Proportional MandrelLock release wait (ITEM-28).
        // SpindleStopSafeTime = full-speed stop safety margin (tune to measured VFD decel time + margin).
        // Formula: PT = (capturedRPM / SpindleMaxRPM) * SpindleStopSafeTime
        SpindleMaxRPM       : Real := 2400.0;  // RPM -- denominator for proportional wait (match DB_Spindle.MaxSpeed)
        SpindleStopSafeTime : Time := T#20S;   // Full-speed decel safety margin (tune on-site)

        // ─── Cylinder stroke wait times (open-loop: tuned to physical stroke duration)
        // These are deliberate waits with no sensor feedback. Set slightly above measured stroke time.
        CylMandrelLock_ClampTime    : Time := T#5S;    // STATE_SHEET_WAIT ph.2: MandrelLock clamp stroke
        CylSheetHolder_RetractTime  : Time := T#5S;    // STATE_SHEET_WAIT ph.3: SheetHolder retract stroke
        CylToolHeadLock_PreDelay    : Time := T#1S;    // STATE_LOCK_EXTEND_WAIT: pre-delay before solenoid energises
        CylToolHeadLock_RetractTime : Time := T#3S;    // STATE_LOCK_RETRACT_WAIT: spring-return wait (no sensor)
        CylBackSupport_EndRetractTime : Time := T#2S;  // End-of-recipe BackSupport retract: Sol_B held this long, then all coils off

        // ─── Process timeouts (trigger errors when limits exceeded)
        Timeout_DriveReady     : Time := T#3S;     // STATE_STARTING: drives not ready within this time → error
        Timeout_Homing         : Time := T#120S;   // STATE_HOMING + STATE_STOP_GOHOME combined timeout
        Timeout_Motion         : Time := T#300S;   // Per-line G0/G1 motion timeout in FB_RecipeHandler
        Timeout_SpindleAtSpeed : Time := T#10S;    // CMD=20: spindle must reach target speed within this time
        Timeout_SpindleStop    : Time := T#15S;    // CMD=21: spindle must reach zero within this time
        Timeout_ToolChange     : Time := T#30S;    // Turret rotation must complete within this time
        Timeout_EStopDiscrep   : Time := T#500MS;  // E-Stop dual-channel discrepancy debounce
    END_VAR
BEGIN
END_DATA_BLOCK

// DB_ErrorCodes removed -- error codes are used as inline hex constants.
// Severity: 0=info, 1=warn, 2=error, 3=fatal

// -----------------------------------------------------------------------------
// DB_Error - Centralized error snapshot for debugging (non-invasive to HMI)
// -----------------------------------------------------------------------------
DATA_BLOCK "DB_Error"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
    VAR
        Active    : Bool := FALSE;       // TRUE when an active error is present
        Code      : Word := 0;           // Error code (matches DB_ErrorCodes)
        Severity  : Byte := 0;           // Priority tier: 1=warning, 2=project, 3=motion/TO, 4=safety (higher preempts lower on HMI display)
        Source    : String[20];          // Originating FB or category (e.g. 'Recipe', 'Safety')
        Line      : Int := -1;           // Recipe line (if applicable) or -1
        TimeStamp : DTL;                 // Timestamp captured with RD_SYS_T
        Details   : String[120];          // Free text details / ActiveErrorText
        // History ring buffer (last 10 errors) for post-mortem analysis
        History_Code    : Array[1..10] of Word;
        History_Time    : Array[1..10] of DTL;
        History_Source  : Array[1..10] of String[20];
        // String[40] (was String[80], 2026-07-31 memory reclaim -- saves 400 B).
        // Matches AlarmEntry.ErrorText[40] in DB_AlarmHistory, so both history views
        // truncate identically. Written via LEFT(..., 40) in FB_AlarmManager.
        History_Details : Array[1..10] of String[40];
        History_Index   : Int := 0;      // 1..10
        History_Count   : Int := 0;      // Number of valid entries (<=10)
        TotalErrorCount : DInt := 0;     // Lifetime error count (incremented on each new error)
    END_VAR
BEGIN
END_DATA_BLOCK

// -----------------------------------------------------------------------------
// DB_ToolConfig - Tool changer configuration
// -----------------------------------------------------------------------------
DATA_BLOCK "DB_ToolConfig"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.2
NON_RETAIN
    VAR
        // Slot angles -- automatically calculated by FC_ToolAngleCalc (AutoCalcAngles=TRUE)
        // or manually entered from HMI Tool page (AutoCalcAngles=FALSE).
        // Machine has 3 physical slots: 0 / 120 / 240 deg. Slot 4 is unused (ToolCount=3).
        Tool1_Position : Real := 0.0;     // Slot 1 angle (degrees)
        Tool2_Position : Real := 120.0;   // Slot 2 angle (degrees)
        Tool3_Position : Real := 240.0;   // Slot 3 angle (degrees)
        Tool4_Position : Real := 0.0;     // Slot 4 unused (ToolCount=3)

        // Slot code mapping -- can be entered from HMI Tool page.
        // Operator enters which head code is in which slot.
        ToolCode_List : Array[1..4] of Int := [101, 102, 103, 104];

        CurrentTool : Int := 1;           // Active slot number (1-4)

        // HMI Tool page: automatic angle calculation
        // TRUE = calculate evenly spaced based on ToolCount (3 slots → 0/120/240)
        // FALSE = Tool1..4_Position open for manual entry
        AutoCalcAngles : Bool := TRUE;

        // Calculated step angle -- displayed on HMI for information (e.g. "90°/slot")
        ToolStepAngle_Calc : Real := 120.0;
    END_VAR
BEGIN
END_DATA_BLOCK

// -----------------------------------------------------------------------------
// DB_Spindle - Spindle configuration and status
// -----------------------------------------------------------------------------
DATA_BLOCK "DB_Spindle"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.2
NON_RETAIN
    VAR
        // Configuration
        MinSpeed : Real := 120.0;         // Minimum spindle speed (RPM)
        MaxSpeed : Real := 3000.0;        // Maximum spindle speed (RPM)
        DefaultSpeed : Real := 1200.0;    // Default spindle speed (RPM)
        SpeedTolerance : Real := 5.0;     // Speed tolerance for AtSpeed (%)
        Bypass_AtSpeed : Bool := FALSE;   // TRUE = skip AtSpeed wait (use during commissioning without drive)
        
        // Commands (input from HMI/Program)
        Cmd_SetSpeed : Real;              // Commanded speed
        Cmd_Direction : Int;              // 1=CW, -1=CCW
        SpeedOverride : Real := 100.0;    // Speed override (%)
        
        // Status (output)
        IsRunning : Bool := FALSE;
        AtSpeed : Bool := FALSE;
        ActualSpeed : Real := 0.0;
        CommandedSpeed : Real := 0.0;
        Error : Bool := FALSE;
        ErrorID : Word := 0;

        // =====================================================================
        // DIAGNOSTICS -- written every scan; read from HMI watch table
        // Use these to trace the spindle start chain without TIA Portal online.
        // Chain:  ReqStart → bSpindleStart → StartInput → PrevStart → StartEdge → state
        // =====================================================================
        Diag_SpindleState  : Int;   // FB_SpindleControl state (0=Idle, 10=Starting, 20=Running, 30=Stopping, 999=Error)
        Diag_StartInput    : Bool;  // Actual Start pin arriving at FB_SpindleControl (Manual OR bSpindleStart)
        Diag_StopInput     : Bool;  // Actual Stop pin arriving at FB_SpindleControl
        Diag_EnableInput   : Bool;  // Actual Enable pin (bDrivesEnable)
        Diag_StartEdge     : Bool;  // Rising edge computed inside FB_SpindleControl (TRUE = spindle command accepted)
        Diag_PrevStart     : Bool;  // prevStart latch inside FB_SpindleControl (must go FALSE between starts)
        Diag_bSpindleStart : Bool;  // FB_Process internal flag bSpindleStart (set by recipe or RUNNING state)
        Diag_bSpindleStop  : Bool;  // FB_Process internal flag bSpindleStop
        Diag_ReqStart      : Bool;
        Diag_ReqStop       : Bool;
        Diag_MoveVelBusy   : Bool;  // MC_MoveVelocity.Busy   -- TO is processing the velocity command
        Diag_MoveVelInVel  : Bool;  // MC_MoveVelocity.InVelocity -- motor reached commanded speed

        // =====================================================================
        // HISTORY RING BUFFER -- last 20 state-change snapshots
        // A new entry is pushed whenever SpindleState, PrevStart, ReqStart or
        // StartEdge changes, capturing every meaningful transition in sequence.
        //
        // How to read:
        //   1. Hist_Count tells you how many valid entries exist (0..20).
        //   2. Hist_Head-1 (mod 20) is the MOST RECENT entry.
        //   3. Entries are indexed [0..19]; read them in Seq order.
        //   4. Write Hist_Clear := TRUE from HMI to wipe and start fresh.
        // =====================================================================
        Hist_Head  : Int := 0;          // Next write position (0..19, wraps)
        Hist_Count : Int := 0;          // Number of valid entries (0..20)
        Hist_SeqNum : Int := 0;         // Rolling sequence counter
        Hist_Clear  : Bool := FALSE;    // HMI: write TRUE to clear buffer (auto-resets)
        Hist_Log   : Array[0..19] of "UDT_SpindleSnap";
    END_VAR
BEGIN
END_DATA_BLOCK

// -----------------------------------------------------------------------------
// DB_Diagnostic - Runtime diagnostics and debugging
// -----------------------------------------------------------------------------
DATA_BLOCK "DB_Diagnostic"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
    VAR
        // =========================================================
        // PROCESS STATE
        // =========================================================
        Process_State : Int;
        Process_SafeToRun : Bool;
        Process_DrivesEnable : Bool;

        // =========================================================
        // RECIPE HANDLER STATE
        // =========================================================
        Recipe_CurrentProgram : Int;    // Active program number (1-10)
        // Which recipe is actually sitting in DB_SelectedRecipe (0 = none/invalid).
        // Written by STATE_RECIPE_LOAD(11) after a successful READ_DBL copy.
        // Diagnostic value: if this disagrees with Recipe_CurrentProgram, the
        // buffer is stale and the machine would be cutting the wrong geometry.
        Recipe_LoadedProgram : Int;
        Recipe_CurrentLine : Int;       // Current line being executed
        Recipe_TotalLines : Int;        // Total lines in program
        Recipe_TargetX : Real;          // Current target X
        Recipe_TargetZ : Real;          // Current target Z
        Recipe_Velocity : Real;         // Current velocity
        // Pre-scan results
        PreScan_Complete : Bool;
        PreScan_Valid : Bool;           // No limit violations found
        PreScan_ErrorLine : Int;        // Line with limit error (-1 if none)

        // =========================================================
        // MOVE STATUS
        // =========================================================
        MoveX_Busy : Bool;
        MoveX_Done : Bool;
        MoveX_Error : Bool;
        MoveZ_Busy : Bool;
        MoveZ_Done : Bool;
        MoveZ_Error : Bool;
        bMoveX : Bool;                  // X axis needs to move
        bMoveZ : Bool;                  // Z axis needs to move

        // =========================================================
        // AXIS INFO (commissioning)
        // =========================================================
        Axis_X_Pos : Real;
        Axis_Z_Pos : Real;
        Axis_X_Enabled : Bool;
        Axis_Z_Enabled : Bool;
        Axis_X_Homed : Bool;
        Axis_Z_Homed : Bool;
        // FB_Process bRequireHoming: TRUE = reference suspect, next auto start WILL home
        // regardless of AlwaysHomeOnAutoStart. Useful on the HMI to explain to the
        // operator why a cycle homed when fast cycle mode is enabled.
        Require_Homing : Bool;

        // =========================================================
        // ERROR CONTEXT
        // =========================================================
        Error_ProcessState : Int;
        Error_Line : Int;
        Error_Code : Word;
        // TO error codes -- raw WORD codes from Siemens MC_ function blocks.
        // Converted to readable text via FC_TO_ErrorText; compare with TIA Portal TO Diagnostics.
        MoveX_ErrorID  : Word;    // MC_MoveAbsolute X axis TO code
        MoveZ_ErrorID  : Word;    // MC_MoveAbsolute Z axis TO code
        HomeX_ErrorID  : Word;    // MC_Home X axis TO code
        HomeZ_ErrorID    : Word;   // MC_Home Z axis TO code
        HomeTool_ErrorID : Word;  // MC_Home Tool axis TO code
        Power_X_ErrorID : Word;   // MC_Power X axis TO code
        Power_Z_ErrorID : Word;   // MC_Power Z axis TO code
        Spindle_TO_ErrorID : Word; // MC_Power/MC_MoveVelocity/MC_Halt spindle TO code
        Error_Text   : String[100];
        // Error_Detail removed -- not written anywhere, Error_Text is used instead
        // Readable description for the last TO error code (FC_TO_ErrorText output)
        TO_ErrorText : String[60];

        // =========================================================
        // CYLINDER DIAGNOSTICS -- indexed by cylinder number (1-based, max 8)
        // No new fields needed when adding cylinders -- write to CylDiag[N] in OB1.
        // =========================================================
        CylDiag : Array[1..8] of "UDT_CylDiag";
    END_VAR
BEGIN
END_DATA_BLOCK

// -----------------------------------------------------------------------------
// DB_Manual - Manual mode control
// -----------------------------------------------------------------------------
DATA_BLOCK "DB_Manual"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.3
NON_RETAIN
    VAR
        ManualModeActive : Bool;
        SelectedAxis : Int := 0;        // 0=X, 1=Z, 2=Tool, 3=Spindle
        ActiveAxis : Int := -1;         // Currently active axis (-1 = none)
        JogSpeed : Real := 10.0;        // mm/s
        JogIncrement : Real := 1.0;     // mm per step
        HomingMode : Int := 3;          // 0=Passive, 2=Active, 3=Active+Zero
        HomePosition : Real := 0.0;     // Home position offset
        
        // Jog buttons (both naming conventions)
        Btn_JogPlus : Bool;
        Btn_JogMinus : Bool;
        Jog_Plus : Bool;                // Alias
        Jog_Minus : Bool;               // Alias
        Btn_StepPlus : Bool;            // Incremental step +
        Btn_StepMinus : Bool;           // Incremental step -
        
        // Homing buttons
        Btn_Home : Bool;
        Btn_HomeAxis : Bool;            // Alias for Btn_Home
        Btn_HomeAll : Bool;             // Home all axes
        Btn_GoSafe : Bool;
        Btn_GoZero : Bool;
        
        // Absolute move
        MoveToPosition : Real := 0.0;   // Target position
        Btn_MoveAbsolute : Bool;        // Execute move
        
        // Tool step buttons
        Btn_ToolStepCW : Bool;          // Tool step clockwise
        Btn_ToolStepCCW : Bool;         // Tool step counter-clockwise
        ToolStepAngle : Real := 120.0;  // Manual turret step (deg) -- 3 slots at 120 deg spacing
        ToolStepSpeed : Real := 30.0;   // Tool step velocity (deg/s)
        ToolPosition : Real;            // Current tool position (degrees)
        
        // Spindle manual control
        Btn_SpindleStart : Bool;        // Start spindle
        Btn_SpindleStop : Bool;         // Stop spindle
        Btn_SpindleAckError : Bool;     // Acknowledge spindle error only (machine reset not required)
        Manual_SpindleSpeed : Real := 500.0;  // Spindle speed (RPM)
        Manual_SpindleDir : Int := 1;   // 1=CW, -1=CCW
        
        // Status (multiple naming conventions for HMI compatibility)
        JogBusy : Bool;
        ManualBusy : Bool;              // Alias for JogBusy
        JogError : Bool;
        ManualError : Bool;             // Alias for JogError
        JogErrorID : Word;
        ManualErrorID : Word;           // Alias for JogErrorID
        
        // Selected axis info (output)
        SelectedAxisName : String[20];
        SelectedAxisPos : Real;
        SelectedAxisHomed : Bool;
        SelectedAxisReady : Bool;

        // ===========================================================
        // CYLINDER MANUAL CONTROL
        // One HMI screen controls all cylinders via SelectedCylinder.
        // HMI writes to these fields; FC_CylinderDispatch routes to
        // the correct DB_CylinderX instance each scan.
        // To add a cylinder: add DB_CylinderN in 02_DataBlocks.scl,
        // add OB1 calls, and add a CASE branch in FC_CylinderDispatch.
        // ===========================================================
        SelectedCylinder    : Int  := 1;    // Active cylinder (1..N)
        Btn_CylExtend       : Bool;         // Extend command
        Btn_CylExtendFull   : Bool;         // Full extend (ignore sensor)
        Btn_CylRetract      : Bool;         // Retract command
        Btn_CylRetractFull  : Bool;         // Full retract (bypass sensors, pulse use)
        Btn_CylGotoPos      : Bool;         // Rising edge: go to target (Mode 2 = zone-pulse, Mode 3 = extend to level)
        Cyl_TargetPos       : Real := 0.0;  // [Modes 2+3] Target position (mm)
        Cyl_Tolerance       : Real := 2.0;  // [Mode 2] Tolerance written to cylinder DB on Btn_ApplyType press
        Btn_ApplyType       : Bool;         // Rising edge: write SelCyl_SetType + Cyl_Tolerance → cylinder DB
        SelCyl_SetType      : Int  := 0;    // Desired PositioningMode (0–3) — HMI input field
        prevBtn_ApplyType   : Bool;         // Edge detection (internal, not for HMI)

        // ===========================================================
        // MANUAL CMD=40 / CMD=41 (BackSupport)
        // Manual-page equivalents of the recipe commands. Each button
        // writes exactly what the matching recipe line writes.
        // Handled in FB_Process STATE_MANUAL (5) only -- STATE_STOPPED
        // and STATE_ERROR clear all three target flags every scan.
        // ===========================================================
        Btn_Cmd40_Extend    : Bool;         // = CMD=40      : BackSupport extend (level -- hold to extend)
        Btn_Cmd41_AtmoOn    : Bool;         // = CMD=41 P1   : Sol_B override + atmosphere valve ON
        Btn_Cmd41_AtmoOff   : Bool;         // = CMD=41 P2   : atmosphere valve OFF (Sol_B stays ON)
        Btn_Cmd41_Release   : Bool;         // = CMD=41 P3   : release both overrides

        // ===========================================================
        // MANUAL MDI -- type a CMD number + Param and execute it.
        // Generic entry point for auxiliary recipe commands, so a new
        // CMD only needs a CASE branch in FB_Process STATE_MANUAL --
        // no new DB field and no HMI screen change.
        // Motion commands (CMD=0/1) are deliberately NOT accepted here;
        // use Btn_MoveAbsolute for manual positioning.
        // ===========================================================
        MDI_Cmd             : Int;          // Command number to execute (40, 41, ...)
        MDI_Param           : Int;          // Command parameter (meaning depends on MDI_Cmd)
        Btn_MDI_Execute     : Bool;         // Rising edge: execute MDI_Cmd once
        MDI_Status          : Int;          // 0=idle, 1=accepted/done, 2=unknown CMD, 3=invalid Param, 4=cylinder error
        MDI_StatusText      : String[24];   // Result text (EN)
        MDI_StatusText_ES   : String[28];   // Result text (ES)

        // Selected cylinder status (PLC → HMI)
        SelCyl_Name         : String[20];   // "Cylinder 1" etc.
        SelCyl_State        : Int;          // State code
        SelCyl_StateText    : String[14];   // State text
        SelCyl_AtSetpoint   : Bool;         // Held at setpoint sensor
        SelCyl_AtRetract    : Bool;         // At retract end
        SelCyl_AtTarget     : Bool;         // Ruler mode: within Tolerance
        SelCyl_PosError     : Real;         // Ruler mode: error = actual - target (mm)
        SelCyl_Error        : Bool;         // Active error
        SelCyl_ErrorID      : Word;         // Error code (16#05xx)
        SelCyl_ActualPos    : Real;         // Current position (mm) from analog sensor
        SelCyl_Type         : Int;          // Positioning mode: 0=Full stroke, 1=PNP sensor, 2=Linear ruler
        SelCyl_Toleranse    : Real;         // Position tolerance (mm) - ruler mode only
        SelCyl_MaxPos       : Real;         // Max allowed position (mm) - ruler mode only
        SelCyl_MinPos       : Real;         // Min allowed position (mm) - ruler mode only
    END_VAR
BEGIN
END_DATA_BLOCK

