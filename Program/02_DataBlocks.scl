// -----------------------------------------------------------------------------
// DB_Production - Production counters and last cycles
// -----------------------------------------------------------------------------
// RETENTIVITY (changed 2026-08-15) -- NON_RETAIN was REMOVED from this block, for the
// same reason it was removed from DB_MachineConfig on 2026-08-09.
//
// A block declared NON_RETAIN is non-retentive as a WHOLE -- the per-tag "Retain"
// checkbox in the TIA DB editor is greyed out. So while that keyword was here, the
// production counters could not be made to survive a power cycle no matter what anyone
// ticked, and "reset every restart" was not a choice anybody made, it was a side effect.
//
// Removing the keyword does NOT make anything retentive. It only makes the tick POSSIBLE.
// The tick is a manual TIA step -- source import cannot set per-tag retentivity -- and it
// must be redone and verified after every re-import of this file. See
// Program/docs/RETAINED_TAGS.md for the full list and the procedure.
//
//   Tick Retain on: TotalStarted, TotalOK, TotalNOK, TotalStopped, TotalAborted
//   Leave alone:    CurrentActive / CurrentProgram / CurrentStartTime (in-flight cycle
//                   state -- a cycle cannot survive a power cycle, and a stale
//                   CurrentActive = TRUE would make the next STOPPED edge count a phantom
//                   abort), and the Last* summary (describes a cycle from before the
//                   restart; harmless either way, but not worth retentive memory).
//
// Changing retentivity forces a full DB re-initialisation on the next download, so the
// counters zero once when this lands. They zeroed on every power cycle before, so nothing
// is lost that was not already being lost.
DATA_BLOCK "DB_Production"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.2
    VAR
        // Overall counters.
        // INVARIANT: TotalStarted = TotalOK + TotalNOK + TotalStopped + TotalAborted
        //            + (1 if CurrentActive). Every cycle that starts lands in exactly
        //            one outcome bucket -- see the PRODUCTION LOGGING block in
        //            06_MainProcess.scl. If you add a new way to end a cycle, give it a
        //            bucket there or this stops adding up.
        TotalStarted  : DInt := 0;       // All cycles that entered RECIPE_LOAD (11) -- i.e. every
                                         // accepted Start press. Was PRE_SCAN (12) until 2026-08-15,
                                         // which missed every start that died in the recipe load
                                         // (16#0312 / 16#0314 / 16#0316): not counted as started,
                                         // and not counted as failed either.
        TotalOK       : DInt := 0;       // Completed successfully (STATE=100)
        TotalNOK      : DInt := 0;       // Ended in ERROR (STATE=999)
        TotalStopped  : DInt := 0;       // Operator pressed Stop -- reached STOPPED via the
                                         // STOP sequence (STOPPING / LOCK_RETRACT_WAIT / legacy
                                         // GOHOME / GOTOZERO), so the axes parked cleanly
        TotalAborted  : DInt := 0;       // Cycle ended at STOPPED by any OTHER route -- in practice
                                         // Reset pressed from an active state, which sets
                                         // State := STOPPED directly with no park sequence.
                                         // Added 2026-08-15: these cycles previously hit no bucket
                                         // at all and left CurrentActive stranded TRUE.

        // Current active cycle
        CurrentActive    : Bool := FALSE;
        CurrentProgram   : Int := 0;     // Active program number
        CurrentStartTime : DTL;          // Cycle start timestamp

        // Last cycle summary
        // 0=None, 1=OK, 2=NOK, 3=STOP, 4=ABORT (Reset from an active state)
        LastResult     : Byte := 0;
        LastProgram    : Int := 0;
        LastDuration_s : DInt := 0;      // Duration in seconds
        LastErrorCode  : Word := 0;      // 0 if OK/STOP
        LastErrorLine  : Int := -1;      // -1 if not applicable
        LastEndTime    : DTL;            // End timestamp

        // NOTE (2026-07-31, memory reclaim): the 100-entry cycle history ring
        // (Hist_Index / Hist_Count / Hist_Result / Hist_Program / Hist_Duration_s /
        // Hist_ErrorCode / Hist_ErrorLine / Hist_Time) was removed -- it cost ~2.3 KB
        // of work memory but was write-only: nothing in the SCL ever read it back and
        // no HMI tag was mapped to it (see HMI_Tag_Guide.md).
        // The Total* counters and the last-cycle summary (Last*) are kept and remain the
        // HMI production source. (They were called "lifetime" counters here until
        // 2026-08-15, which was wrong at the time: the block was NON_RETAIN, so every
        // Total* zeroed on a power cycle. That keyword is now gone -- see the block
        // header -- but they only become genuinely lifetime once Retain is ticked per tag
        // in the TIA DB editor. Until then they still count per power-up.) Error-side history is unaffected --
        // DB_AlarmHistory (20 entries) and DB_Error.History_* still hold fault records.
        // To restore: re-add the arrays here and the push block in FB_Process
        // ("PRODUCTION LOGGING" section of 06_MainProcess.scl).
    END_VAR
BEGIN
END_DATA_BLOCK

// -----------------------------------------------------------------------------
// DB_fbSpindle -- FB_SpindleControl instance (NO LONGER CALLED IN OB1)
// Spindle is now controlled exclusively via fbSpindleControl inside FB_Process (fbProcess DB).
// This DB is retained so TIA Portal does not lose the symbol. Do not call from OB1.
// DB_Spindle (separate) → spindle status + HMI outputs (IsRunning, AtSpeed, etc.)
// -----------------------------------------------------------------------------
DATA_BLOCK "DB_fbSpindle"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
"FB_SpindleControl"
BEGIN
END_DATA_BLOCK

// =============================================================================
// PNEUMATIC CYLINDER INSTANCE DATA BLOCKS
// =============================================================================
// Instances of FBs defined in 09_Sensors_Actuators.scl.
// HMI reads/writes these DBs directly -- no separate interface DB needed.
//
// Cylinder map:
//   CylDiag[1] = DB_BackSupport    (full stroke, PositioningMode=0; ruler HW removed on this machine)
//   CylDiag[2] = DB_SheetHolder    (no sensor, PositioningMode=0, ValveType=2)
//   CylDiag[3] = DB_ToolHeadLock   (magnetic sensor, PositioningMode=1, safety lock)
//   CylDiag[4] = DB_MandrelLock    (no sensor, PositioningMode=0)
// =============================================================================

// =============================================================================
// BACKSUPPORT CYLINDER (CylDiag[1]) -- Full stroke, PositioningMode=0
//
// Ruler hardware removed on this machine. CMD=40 triggers a full extension;
// AtSetpoint fires after Timeout_Extend.
// DB_Cylinder_LinearRuler_BackSupport and OB1 ruler call are retained for future use
// if the ruler is re-fitted (switch PositioningMode back to 3 and re-enable in OB1).
// TIA tags:  Output_Cyl_Backsupport_SolA/B/Atmosphere
//
// COIL SEQUENCE (operator spec, 2026-08-07) -- the authority for this cylinder:
//
//   Event                     %Q12.0 Sol_A   %Q12.1 Sol_B   %Q12.7 Atmo
//   ------------------------- -------------- -------------- --------------
//   CMD=40                    ON (held)      off            off
//   CMD=41 P1                 ON (stays)     off            ON (held)
//   CMD=41 P2                 off            ON (retract)   off
//   CMD=41 P3                 off            off            off
//   Recipe end (any outcome)  off            ON 2s -> off   off
//
// Sol_A and Sol_B are NEVER energised together. Before 2026-08-07 they were:
// P1 also switched Sol_B on via an OR-override in OB1, and nothing ever released
// Sol_A (FB State 3 is a dead end for PositioningMode=0). The machine ran for
// months only because P1's wrong Sol_B happened to be the coil P2 needed, and
// Sol_B out-muscled the still-live Sol_A. That balance is pressure-dependent --
// when it tipped, the cylinder stopped retracting. See ITEM-41.
// =============================================================================

// -----------------------------------------------------------------------------
// DB_BackSupport -- FB_CylinderControl instance
// PositioningMode=0 (full stroke, timed), ValveType=2 (5/3 blocked center)
//
// HMI WRITABLE:   Cmd_ExtendFull, Cmd_RetractFull
// HMI READ-ONLY:  Sol_A, Sol_B, State, StateText, AtSetpoint, Error, ErrorID
// CONNECTED IN OB1: SafetyOK, RulerValue, RulerValid (ruler inputs ignored in Mode=0)
// To re-enable ruler: change PositioningMode to 3 and restore ruler tuning fields below.
// -----------------------------------------------------------------------------
DATA_BLOCK "DB_Cylinder_BackSupport"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.5
NON_RETAIN
"FB_CylinderControl"
BEGIN
    ValveType           := 2;           // 5/3 blocked center -- mechanical lock in hold
    PositioningMode     := 0;           // Full stroke: extend on Cmd_Extend, AtSetpoint after Timeout_Extend
    Timeout_Extend      := T#3S;        // Measured extend stroke ~2s + margin. Was T#1S500MS, which was
                                        // SHORTER than the real stroke: STATE_CYL_GOTO_WAIT(71) advanced
                                        // mid-travel and CMD=41 P1 fired into a still-moving cylinder.
    Timeout_Retract     := T#24H;       // DELIBERATE -- do NOT shorten without measuring first.
                                        // The retract is commanded by CMD=41 P2 (Cmd_Retract latched)
                                        // and released by P3, so the window is RECIPE-controlled and
                                        // its upper bound has never been measured. While Cmd_Retract
                                        // is held the FB must stay in State 2 (Sol_A=FALSE, Sol_B=TRUE);
                                        // a timeout expiring mid-sequence would quietly stop driving
                                        // the cylinder back part-way through a P2..P3 window.
                                        // NOTE (2026-08-09): the old reason for this value is gone --
                                        // State 4 no longer latches Sol_B for Mode 0 + 5/3, it drives
                                        // both coils off like every other cylinder. Expiring is
                                        // therefore no longer dangerous, just premature. Once the real
                                        // P2..P3 duration is known this can become a normal timeout.
END_DATA_BLOCK

DATA_BLOCK "DB_Cylinder_Sen_BackSupport_Setpt"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
"FB_DigitalSensor"
BEGIN
    IsNC         := FALSE;
    DebounceTime := T#10ms;
END_DATA_BLOCK

// -----------------------------------------------------------------------------
// DB_Cylinder_LinearRuler_BackSupport -- FB_AnalogSensor instance
// Analog linear ruler for BackSupport cylinder position feedback.
// Connected in OB1: AI_LinearRuler_BackSupport → RulerValue/RulerValid on cylinder FB.
// Calibration is set in FC_LoadConfig Section 6; HMI can adjust at runtime.
// InvertSignal=TRUE: 0V = full extend (~300mm), ~10V = retracted (0mm).
// -----------------------------------------------------------------------------
DATA_BLOCK "DB_Cylinder_LinearRuler_BackSupport"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
"FB_AnalogSensor"
BEGIN
    Raw_Min      := 0;
    Raw_Max      := 31433;      // Measured at full retract -- update after hardware calibration
    Phys_Min     := 0.0;
    Phys_Max     := 300.0;      // Full stroke (mm) -- update if stroke differs
    InvertSignal := TRUE;       // 0V = extended end, ~10V = retracted end
    Hi_Limit     := 295.0;
    Lo_Limit     := 5.0;
END_DATA_BLOCK

// =============================================================================
// SHEETHOLDER CYLINDER (CylDiag[2]) -- No sensor, full stroke (PositioningMode=0)
//
// TIA Portal tags: Output_Cyl_SheetHolder_SolA (extend), Output_Cyl_SheetHolder_SolB (retract)
// Converted from 5/2 spring return to 5/3 blocked centre 2026-08-07 -- Sol_B is now wired.
// =============================================================================

// -----------------------------------------------------------------------------
// DB_SheetHolder -- FB_CylinderControl instance
// ValveType=2 (5/3 blocked centre, twin solenoid):
//   Sol_A=TRUE  → piston extends (sheet held).
//   Sol_B=TRUE  → piston retracts (active -- there is no spring any more).
//   Both FALSE  → blocked centre, piston mechanically locked where it stands.
//   Power loss  → both coils drop → piston LOCKED IN PLACE, it does NOT retract.
// PositioningMode=0: no sensor -- full stroke, timeout = done, no error.
//
// CONSEQUENCE FOR FB_PROCESS: the retract command must be HELD, not pulsed.
// With the old 5/2 the spring did the work, so a one-scan Cmd_Retract pulse was
// enough to kick the FB out of State 3. A one-scan pulse on a blocked centre
// energises Sol_B for a single scan and leaves the piston locked mid-stroke.
// FB_Process therefore holds Cmd_Retract via #bSheetHolderRetractHold for exactly
// DB_MachineConfig.CylSheetHolder_RetractTime, then drops it so BOTH coils
// de-energise and the blocked centre holds the piston at the retract end.
// See 06_MainProcess.scl "SHEETHOLDER COMMANDS -- single writer for BOTH directions".
// -----------------------------------------------------------------------------
DATA_BLOCK "DB_Cylinder_SheetHolder"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.3
NON_RETAIN
"FB_CylinderControl"
BEGIN
    ValveType       := 2;       // 5/3 blocked centre -- twin solenoid, active retract on Sol_B
    PositioningMode := 0;       // No sensor -- full stroke, timeout = done, no error
    Timeout_Extend  := T#5S;
    // Backstop only -- it is NOT what ends the retract.
    //
    // The retract duration is owned by FB_Process: it holds Cmd_Retract for
    // DB_MachineConfig.CylSheetHolder_RetractTime (T#1S) and then drops it, which takes
    // the FB from State 2 to State 0 with both coils off. This value only decides what
    // happens if a retract is ever commanded for LONGER than that -- the FB gives up
    // waiting, calls the stroke done and moves to State 4, which since 2026-08-09 also
    // drives both coils off. So either exit ends with the coil de-energised and the
    // blocked centre holding the piston; the difference is cosmetic.
    //
    // (History: this was T#24H for a few hours during the ITEM-46 work, to dodge the old
    // State 4 behaviour where Mode 0 + 5/3 latched Sol_B ON for ever. That latch has been
    // deleted from FB_CylinderControl, so the dodge is no longer needed and a plain,
    // readable timeout is back. Keep it comfortably above CylSheetHolder_RetractTime.)
    Timeout_Retract := T#5S;
END_DATA_BLOCK

// =============================================================================
// TOOLHEADLOCK CYLINDER (CylDiag[3]) -- Magnetic sensor (PositioningMode=1, safety lock)
//
// LOCK BEHAVIOR (implemented in FB_Process):
//   EXTEND (Sol_A ON)  : states STATE_RUNNING (20) and STATE_PAUSED (25) only.
//   RETRACT (spring)   : all other states -- power loss also retracts (spring return).
//
// SEQUENCE GATES (FB_Process checks sensor before state transition):
//   Before entering RUNNING     : STATE_LOCK_EXTEND_WAIT (17) -- AtSetpoint OR 2s timer fallback.
//   Before TOOL_CHANGE / homing : STATE_LOCK_RETRACT_WAIT (29) -- 2s timer (no retract sensor).
//
// TIA Portal tags: In_Cyl_ToolHeadLock_AtSetpoint, Output_Cyl_ToolHeadLock_SolA
//                  (Sol_B not wired -- ValveType=1)
// =============================================================================

// -----------------------------------------------------------------------------
// DB_ToolHeadLock -- FB_CylinderControl instance
// ValveType=1 (5/2 spring return, single solenoid):
//   Sol_A=TRUE  → piston extends (locked).
//   Sol_A=FALSE → spring retracts (unlocked). Power loss = safe retract.
// Sen_AtSetpoint confirms lock fully engaged; Timeout_Extend=T#6S is error fallback.
// State 17 in FB_Process transitions when AtSetpoint=TRUE (sensor only; no fallback timer in FB_Process).
// Timeout_Extend in this DB is the only timer -- if sensor does not confirm within 6s, CylFB reports Error.
// -----------------------------------------------------------------------------
DATA_BLOCK "DB_Cylinder_ToolHeadLock"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.3
NON_RETAIN
"FB_CylinderControl"
BEGIN
    ValveType       := 1;       // 5/2 spring return -- single solenoid, safe retract on power loss
    PositioningMode := 1;       // Mode 1: magnetic sensor -- AtSetpoint confirms lock engaged
    Timeout_Extend  := T#6S;    // Error 16#0501 if sensor not triggered within 6s of Cmd_Extend (raised from T#3S -- margin for slow pneumatic startup)
    Timeout_Retract := T#2S;    // Spring handles retract; timeout kept for completeness
END_DATA_BLOCK

DATA_BLOCK "DB_Cylinder_Sen_ToolHeadLock_Setpt"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
"FB_DigitalSensor"
BEGIN
    IsNC         := FALSE;
    DebounceTime := T#10ms;
END_DATA_BLOCK

// =============================================================================
// MANDRELLOCK CYLINDER (CylDiag[4]) -- No sensor, full stroke (PositioningMode=0)
//
// TIA Portal tags: Output_Cyl_MandrelLock_SolA, Output_Cyl_MandrelLock_SolB
// =============================================================================

// -----------------------------------------------------------------------------
// DB_MandrelLock -- FB_CylinderControl instance
// -----------------------------------------------------------------------------
DATA_BLOCK "DB_Cylinder_MandrelLock"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
"FB_CylinderControl"
BEGIN
    ValveType       := 1;       // 5/2
    PositioningMode := 0;       // No sensor -- full stroke, timeout = done, no error
    Timeout_Extend  := T#5S;
    Timeout_Retract := T#5S;
END_DATA_BLOCK

// -----------------------------------------------------------------------------
// DB_AlarmHistory - 20-entry alarm ring buffer for HMI history table (ITEM-26)
// NON_RETAIN: cleared on PLC power cycle. Survives Cmd_Reset (soft reset).
// HMI: connect Hist_Log[0..19] to a table, poll Hist_SeqNum for change detection,
//      sort by Timestamp descending. Hist_Clear = TRUE wipes manually.
// -----------------------------------------------------------------------------
DATA_BLOCK "DB_AlarmHistory"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
    VAR
        Hist_Head   : Int  := 0;       // Next write slot (0..19, wraps on overflow)
        Hist_Count  : Int  := 0;       // Number of valid entries (0..20)
        Hist_SeqNum : DInt := 0;       // Monotonically increasing — HMI polls for change detection
        Hist_Clear  : Bool := FALSE;   // HMI writes TRUE to clear history; auto-resets next scan
        Hist_Log    : Array[0..19] of "AlarmEntry";
    END_VAR
BEGIN
END_DATA_BLOCK

// -----------------------------------------------------------------------------
// DB_SelectedRecipe - the ONE recipe buffer the machine actually runs from
//                     (load-memory recipes, 2026-08-04)
//
// DB_RecipeProgram1..50 live in LOAD memory (UNLINKED) and cost no work memory.
// FB_RecipeLoader copies the selected one into here with READ_DBL during
// STATE_RECIPE_LOAD(11), before the pre-scan. FB_RecipePreScan and
// FB_RecipeHandler are then bound to THIS block and nothing else.
//
// { S7_Optimized_Access := 'FALSE' } is MANDATORY, not a style choice:
//   - READ_DBL requires source and destination to share a block access type,
//     and the recipe DBs must be standard (an optimized DB may not contain a
//     STRUCT, and RecipeLine is a UDT).
//   - Change it to 'TRUE' and every recipe load fails at runtime with 16#0312.
//
// This block must NEVER get the UNLINKED / "only store in load memory"
// attribute -- it is the destination, and it has to be readable by the program.
//
// Array bound must stay identical to DB_RecipeProgram*. Work memory cost:
// ~12 KB total, replacing the ~21 KB the five old work-memory recipe DBs used.
// See Program/docs/LOADMEM_COPY_ON_SELECT.md
// -----------------------------------------------------------------------------
DATA_BLOCK "DB_SelectedRecipe"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
    VAR
        Header : "RecipeHeader";                // Copy of the selected recipe's header
        // DO NOT SHRINK THIS ARRAY (user decision 2026-08-10).
        // It is 12,070 B -- 71% of all data-block work memory -- and the recipes in
        // gcodes/ are only 38..314 lines, so this looks like 7 KB of obvious waste.
        // It is not: those are TEST recipes. Production parts are expected to use the
        // full 1000 lines. Shrinking it is a LAST RESORT if no other work-memory
        // reclaim is sufficient, and it is a coupled change -- the recipe DB bound
        // (LINES_PER_RECIPE in tools/gen_recipe_slots.py), the pre-scan guard
        // (06_MainProcess.scl, activeLineCount > 1000) and the SpinningCam output must
        // all move together, or READ_DBL fails on a length mismatch.
        Lines  : Array[0..999] of "RecipeLine"; // Copy of the selected recipe's lines
    END_VAR
BEGIN
END_DATA_BLOCK

