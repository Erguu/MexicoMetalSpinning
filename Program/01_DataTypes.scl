// =============================================================================
// Version_Recipe - 01_DataTypes.scl
// Memory-optimized data types for recipe-based G-code execution
// For CPU 1214C (100KB work memory)
// =============================================================================

// -----------------------------------------------------------------------------
// Recipe Line - Single motion command (12 bytes per line)
// -----------------------------------------------------------------------------
TYPE "RecipeLine"
VERSION : 0.1
    STRUCT
        X : Real;       // 4 bytes - Target X position (mm)
        Z : Real;       // 4 bytes - Target Z position (mm)
        F : Int;        // 2 bytes - Feedrate (mm/min, 0=rapid, 1-9999=feed)
        CMD : Byte;     // 1 byte  - Command: 0=G0, 1=G1, 10=Tool, 20=SpindleOn, 21=SpindleOff, 30=Dwell, 99=End
        Param : Byte;   // 1 byte  - CMD=10:ToolNum, CMD=20:RPM/10, CMD=30:Time*100ms
    END_STRUCT;
END_TYPE

// -----------------------------------------------------------------------------
// Recipe Program Header - Program metadata (48 bytes)
// -----------------------------------------------------------------------------
TYPE "RecipeHeader"
VERSION : 0.2
    STRUCT
        sName : String[20];     // Program name (max 20 chars)
        LineCount : Int;        // Total lines in program (0-1499)
        Valid : Bool;           // Program is valid and loaded
        PreScanned : Bool;      // Pre-scan completed
        // Bounding box (calculated during pre-scan)
        MinX : Real;
        MaxX : Real;
        MinZ : Real;
        MaxZ : Real;
        // ---------------------------------------------------------------------
        // Tool table (CAM-authored, applied on recipe load -- see CAM_TOOL_TABLE_HANDOVER.md)
        // The CAM post-processor is the single source of truth for the turret setup.
        // On Start (STATE_PRE_SCAN) FB_Process copies these into DB_ToolConfig /
        // DB_MachineConfig BEFORE the pre-scan validates tool codes.
        // ProvidesToolConfig MUST be TRUE or the recipe is rejected with 16#0311.
        // ---------------------------------------------------------------------
        ProvidesToolConfig : Bool;              // TRUE = header carries a valid tool table
        ToolCount : Int;                        // Physical slots in use (clamped 1..4 on apply)
        AutoCalcAngles : Bool;                  // TRUE = angles auto-spaced from ToolCount; FALSE = use ToolAngle_List
        ToolCode_List : Array[1..4] of Int;     // External tool code installed in each slot (0 = slot unused)
        ToolAngle_List : Array[1..4] of Real;   // Turret angle per slot (deg); used only when AutoCalcAngles = FALSE
        // ---------------------------------------------------------------------
        // Recipe checksum (CAM-authored, 2026-08-14 -- letter_spinningcam_recipe_checksum.md)
        // The chunked loader proves every line was WRITTEN; it cannot prove the
        // right data arrived. A stale flash image, or chunks reassembled at the
        // wrong stride, passes every check we have. This closes that.
        //
        //   sumA := sumA + CMD + Param + F      per line, global 0..LineCount-1
        //   sumB := sumB + sumA                 running sum -> ORDER-SENSITIVE
        //   Checksum := sumB XOR (sumA + LineCount)
        //
        // All unsigned 32-bit with natural wraparound. F enters as its unsigned
        // 16-bit BIT PATTERN, so a negative F cannot break the conversion on
        // either side. X and Z are deliberately NOT included -- see the letter.
        //
        // ProvidesChecksum = FALSE skips the check, so recipes exported before
        // this field existed still load. Do not use Checksum = 0 to mean "none".
        // APPEND-ONLY: adding fields here changes the block layout and makes
        // every existing recipe export unloadable. Never insert above.
        // ---------------------------------------------------------------------
        ProvidesChecksum : Bool;                // TRUE = Checksum is valid and enforced
        Checksum : UDInt;                       // Verified by FB_RecipeLoader -> 16#0316
    END_STRUCT;
END_TYPE

// -----------------------------------------------------------------------------
// Process Mode Enumeration
// -----------------------------------------------------------------------------
TYPE "ProcessMode"
VERSION : 0.1
    STRUCT
        IDLE : Int := 0;
        MANUAL : Int := 5;
        HOMING : Int := 10;
        PRE_SCAN : Int := 12;
        ENABLE_DRIVES : Int := 15;
        RUNNING : Int := 20;
        PAUSED : Int := 40;
        TOOL_CHANGE : Int := 30;
        COMPLETE : Int := 99;
        ERROR : Int := 999;
    END_STRUCT;
END_TYPE

// -----------------------------------------------------------------------------
// Alarm Entry for history
// -----------------------------------------------------------------------------
TYPE "AlarmEntry"
VERSION : 0.1
    STRUCT
        Timestamp  : DTL;           // RD_SYS_T() at moment of alarm
        ErrorCode  : Word;          // 16#xxxx error code
        ProgramNum : Int;           // Active recipe program at fault time (0 = none)
        LineNum    : Int;           // Active recipe line at fault time (-1 = outside recipe)
        ErrorText  : String[40];    // ITEM-26: English error text snapshot (first 40 chars of DB_HMI.ErrorText)
    END_STRUCT;
END_TYPE

// -----------------------------------------------------------------------------
// Cylinder Diagnostic - Per-cylinder runtime snapshot
// Used as: DB_Diagnostic.CylDiag[1..8]  (indexed by cylinder number)
// Add new cylinders in OB1 without changing DB_Diagnostic.
// -----------------------------------------------------------------------------
TYPE "UDT_CylDiag"
VERSION : 0.1
    STRUCT
        State   : Int;      // FB_CylinderControl state (-1=EStop 0=Idle 1=Ext... 10=Err)
        Pos     : Real;     // Ruler position (mm); 0.0 if no analog sensor connected
        Sol_A   : Bool;     // Solenoid A output (extend coil)
        Sol_B   : Bool;     // Solenoid B output (retract coil)
        Error   : Bool;     // Active error flag
        ErrorID : Word;     // Error code (16#05xx)
    END_STRUCT;
END_TYPE

// -----------------------------------------------------------------------------
// Spindle Diagnostic Snapshot - one entry in the spindle history ring buffer
// DB_Spindle.Hist_Log[0..19] stores the last 20 state-change events.
// A new entry is pushed whenever SpindleState, PrevStart, ReqStart or StartEdge
// changes value -- so the log captures every meaningful transition without
// flooding with identical scans.
// -----------------------------------------------------------------------------
TYPE "UDT_SpindleSnap"
VERSION : 0.1
    STRUCT
        Seq          : Int;   // Rolling sequence number
        MachineState : Int;   // FB_Process.State
        State        : Int;   // FB_SpindleControl state: 0=Idle 20=Running 30=Halt 999=Error
        ReqStart     : Bool;  // FB_RecipeHandler.SpindleReqStart
        ReqStop      : Bool;  // FB_RecipeHandler.SpindleReqStop
        bStart       : Bool;  // FB_Process bSpindleStart
        bStop        : Bool;  // FB_Process bSpindleStop
        StartInput   : Bool;  // Composite Start pin at FB_SpindleControl
        StopInput    : Bool;  // Composite Stop pin
        EnableIn     : Bool;  // bDrivesEnable
        PrevStart    : Bool;  // prevStart latch inside FB_SpindleControl
        StartEdge    : Bool;  // Rising edge accepted by FB_SpindleControl
        MoveVelBusy  : Bool;  // MC_MoveVelocity.Busy  -- TO accepted and processing command
        MoveVelInVel : Bool;  // MC_MoveVelocity.InVelocity -- motor at commanded speed
    END_STRUCT;
END_TYPE
